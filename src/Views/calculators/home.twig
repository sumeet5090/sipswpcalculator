{% extends 'layouts/base.twig' %}

{% block head %}
{% endblock %}

{% block content %}
{% include 'components/theme-glow-blobs.twig' %}
<header class="relative mb-4 sm:mb-6 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 mb-3">
        <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-semibold text-emerald-700 tracking-wide uppercase">Algorithmic Wealth Planning Engine</span>
    </div>

    <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold pb-2 tracking-tight">
        <span class="text-gradient block mb-1.5">SIP SWP Calculator Together</span>
        <span class="text-slate-800 text-xl sm:text-3xl md:text-4xl block font-bold">Step-Up SIP + Lumpsum + Inflation-Adjusted SWP Planner</span>
    </h1>
    
    <p class="text-base sm:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed font-medium mb-4">
        Calculate your combined SIP accumulation and inflation-adjusted SWP retirement cashflows with step-up compounding in one zero-latency simulation studio.
    </p>

    <!-- EEAT Institutional Trust Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-xs sm:text-sm text-slate-500 mb-6 pb-4 border-b border-slate-200/60 max-w-3xl mx-auto">
        <a href="https://www.linkedin.com/in/sumeet-boga/" target="_blank" rel="noopener"
            class="flex items-center gap-2 hover:opacity-80 transition-opacity">
            <img src="/assets/sumeet-boga-56.jpg" alt="Sumeet Boga — Creator of SIP Calculator"
                class="w-7 h-7 rounded-full shadow-sm border border-emerald-100 object-cover" width="28" height="28"
                fetchpriority="high" decoding="async">
            <span>Engineered by <strong class="text-slate-700 font-bold">Sumeet Boga</strong> (Software &amp; Algorithmic Finance)</span>
        </a>
        <span class="hidden sm:inline text-slate-300">|</span>
        <div class="flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full text-xs font-bold border border-emerald-100 shadow-2xs">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Verified for Accuracy: {{ "now"|date("F Y") }}</span>
        </div>
    </div>
</header>

<!-- Quick Answer Box for AI extraction / Featured Snippet -->
<div id="quick-answer" class="relative overflow-hidden bg-gradient-to-r from-emerald-500/10 via-teal-500/5 to-emerald-500/10 backdrop-blur-md border border-emerald-300/60 rounded-3xl p-6 sm:p-7 mb-8 max-w-2xl mx-auto shadow-sm"
    role="complementary" aria-label="Quick Answer">
    <div class="flex items-center justify-between gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-extrabold text-emerald-800 uppercase tracking-widest bg-emerald-100/90 px-2.5 py-0.5 rounded-full border border-emerald-200">
            ⚡ Quick Summary
        </span>
        <span class="text-[11px] font-semibold text-emerald-700/80">AI Verified Estimate</span>
    </div>
    <h3 class="text-base sm:text-lg font-bold text-slate-800 mb-1">How much will a ₹10,000/month SIP grow in 20 years?</h3>
    <p class="text-sm text-slate-600 leading-relaxed">At 12% annual returns with a 10% yearly step-up, a ₹10,000/month SIP will
        grow to approximately <strong class="text-emerald-700 font-extrabold"><span class="dynamic-amount"
                data-amount-inr="19889000">₹1.99 Crore</span></strong> over 20 years. Total invested: <strong class="text-slate-700"><span
            class="dynamic-amount" data-amount-inr="6873000">₹68.73 Lakh</span></strong> • Total compound gains: <strong class="text-emerald-700"><span class="dynamic-amount"
            data-amount-inr="13016000">₹1.30 Crore</span></strong>.</p>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "SIP SWP Calculator Together — Combined Mutual Fund Planner 2026",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["#quick-answer"]
  },
  "url": "{{ site_url }}/"
}
</script>

<section id="calculator-section" class="scroll-mt-32" style="scroll-margin-top: 120px;"
    aria-labelledby="calculator-heading">
    <h2 class="sr-only" id="calculator-heading">Calculate Your SIP & SWP Returns</h2>
    
    <!-- Strategy Starter: 1-Click Blueprints & 3-Step Guided Wizard -->
    {% include 'components/strategy-starter.twig' %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-6">

        <!-- Left Column: Form -->
        <div class="lg:col-span-1 flex flex-col gap-4 lg:sticky lg:self-start" style="top: 100px;">
            {% include 'components/calculator-form.twig' with {'container_id': 'homepage-calc'} %}
        </div> <!-- /left column -->

        <!-- Right Column: Visualization & Scenario Diff -->
        <div class="lg:col-span-2 space-y-4">
            {% include 'components/chart-visualization.twig' %}
            
            <!-- Side-by-Side Scenario Diff Comparison (Unhides when snapshot baseline is taken) -->
            {% include 'components/scenario-comparison.twig' %}
        </div>
    </div><!-- /3-col grid -->

    <!-- Multi-Mode Interactive Analytical Studio (Default: Yearly Breakdown Table) -->
    {% include 'components/analytical-studio.twig' %}
</section><!-- /calculator section -->

<!-- Editorial Knowledge & Research Vault -->
{% include 'components/home-guide-content.twig' %}

<!-- Floating In-Page Discovery Navigation HUD -->
{% include 'components/floating-discovery-hud.twig' %}
{% endblock %}

{% block modals %}
<!-- PDF Generation Modal (native <dialog> with built-in focus trapping & centering) -->
<dialog id="pdfModal" class="fixed inset-0 m-auto z-50 rounded-3xl shadow-2xl p-6 sm:p-8 w-full max-w-lg border border-slate-200 bg-white/95 max-h-[90vh] overflow-y-auto backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm text-slate-800" aria-labelledby="branded-pdf-report">
        <h2 id="branded-pdf-report" class="text-xl sm:text-2xl font-bold text-slate-800 mb-4">Create Branded PDF Report</h2>
        
        <!-- Privacy & Client-Side Sandbox Assurance -->
        <div class="mb-4 p-3 rounded-2xl bg-emerald-50/90 border border-emerald-200/80 flex items-start gap-2.5 text-left">
            <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-black shrink-0 mt-0.5">🔒</span>
            <div class="text-[11px] text-emerald-950 leading-relaxed">
                <strong class="font-bold text-emerald-900 block">100% Client-Side Private Generation</strong>
                Advisor logo, client name, and customized proposals are processed purely within your browser memory. Zero financial data or uploaded files are sent to or stored on any server.
            </div>
        </div>

        <form id="pdfForm" class="space-y-4">
            <div>
                <label for="clientName" class="block text-sm font-medium mb-1 text-slate-600">Client Name</label>
                <input type="text" id="clientName" name="clientName" placeholder="e.g., John Doe"
                    class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm">
            </div>
            <div>
                <label for="advisorName" class="block text-sm font-medium mb-1 text-slate-600">Your Name / Company Name</label>
                <input type="text" id="advisorName" name="advisorName" placeholder="e.g., Jane Smith Financials"
                    class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm">
            </div>
            <div>
                <label for="advisorLogo" class="block text-sm font-medium mb-1 text-slate-600">Your Logo</label>
                <input type="file" id="advisorLogo" name="advisorLogo" accept="image/png, image/jpeg"
                    class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
            </div>
            <div>
                <label for="customDisclaimer" class="block text-sm font-medium mb-1 text-slate-600">Custom Disclaimer / Message</label>
                <textarea id="customDisclaimer" name="customDisclaimer" rows="3"
                    placeholder="e.g., This projection is based on the agreed-upon assumptions..."
                    class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm"></textarea>
            </div>

            <!-- Real-Time Proposal Header Preview Box -->
            <div id="pdf-live-preview-box" class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-left space-y-1.5">
                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Live Proposal Header Preview</div>
                <div class="flex items-center justify-between border-b border-slate-200/80 pb-2">
                    <div>
                        <div id="preview-client-name" class="text-xs font-extrabold text-slate-900">Valued Investor</div>
                        <div class="text-[10px] text-slate-500">Comprehensive Investment &amp; Cashflow Proposal</div>
                    </div>
                    <div id="preview-advisor-name" class="text-[11px] font-bold text-emerald-700">Financial Advisor</div>
                </div>
            </div>

            <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-100">
                <button type="button" id="fastInstantPdfBtn"
                    class="px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold rounded-xl transition text-xs flex items-center gap-1.5 cursor-pointer">
                    <span>⚡</span>
                    <span>1-Click Fast Download</span>
                </button>
                <div class="flex gap-2">
                    <button type="button" id="closePdfModalBtn" onclick="document.getElementById('pdfModal')?.close()"
                        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition text-xs cursor-pointer">Cancel</button>
                    <button type="submit" id="generatePdfBtn"
                        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-md shadow-emerald-600/20 transition text-xs cursor-pointer">Download Custom PDF</button>
                </div>
            </div>
        </form>
</dialog>
{% endblock %}

{% block scripts %}
{% endblock %}
