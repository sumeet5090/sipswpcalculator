{% extends 'layouts/base.twig' %}

{% block head %}
{% endblock %}

{% block content %}
{% include 'components/theme-glow-blobs.twig' %}
<header class="relative z-10 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 pt-7 pb-7 sm:pb-9 mb-5 sm:mb-7 text-center bg-gradient-to-b from-slate-100 via-slate-50 to-white text-slate-900 rounded-b-3xl border-b-2 border-emerald-500/50 shadow-card relative overflow-hidden">
    <!-- Ambient Emerald Shimmer -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-emerald-500/12 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10">
        <div class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100/90 border-2 border-emerald-300/90 mb-3 shadow-flat">
            <span class="relative flex h-2.5 w-2.5">
                <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75 animate-ping"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-600"></span>
            </span>
            <span class="text-micro font-black text-emerald-900 tracking-wide uppercase">Algorithmic Wealth Planning Engine</span>
        </div>

        <h1 class="fluid-h1 font-black pb-1 sm:pb-2 tracking-tight">
            <span class="bg-gradient-to-r from-emerald-800 via-teal-800 to-emerald-900 bg-clip-text text-transparent block mb-1">SIP + SWP Calculator Together</span>
            <span class="text-slate-900 text-ui-xs sm:text-2xl md:text-3xl block font-extrabold mt-1">Accumulation to Retirement Cashflow (with Inflation &amp; Excel)</span>
        </h1>
        
        <p class="text-ui-xs sm:text-base md:text-lg text-slate-700 max-w-2xl mx-auto leading-relaxed font-medium mb-4">
            Plan your complete investment lifecycle: Compound through monthly SIP accumulation, then transition seamlessly into inflation-adjusted SWP retirement cashflows with instant Excel export.
        </p>

        <!-- Compact Institutional Trust & Verification Strip -->
        <div class="hidden sm:flex items-center justify-center gap-3 text-caption text-slate-700 font-medium mb-1 max-w-3xl mx-auto flex-wrap not-prose">
            <a href="https://www.linkedin.com/in/sumeet-boga/" target="_blank" rel="noopener"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white border border-slate-300/90 shadow-flat text-slate-800 font-bold hover:border-emerald-500 transition-colors">
                <img src="/assets/sumeet-boga-56.jpg" alt="Sumeet Boga — Creator of SIP Calculator"
                    class="w-5 h-5 rounded-full shadow-flat border border-slate-200 object-cover" width="20" height="20"
                    fetchpriority="high" decoding="async">
                <span>Engineered by <strong class="text-slate-900 font-bold">Sumeet Boga</strong></span>
            </a>
            <span class="text-slate-300">•</span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-50 border border-emerald-300/80 text-emerald-800 font-extrabold shadow-flat">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Verified: {{ "now"|date("F Y") }}</span>
            </span>
            <span class="text-slate-300">•</span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white border border-slate-300/90 shadow-flat text-micro font-bold text-slate-800">
                <span class="inline-block w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                <span><strong class="font-financial-mono text-slate-900">{{ weekly_calculations|number_format(0, '.', ',') }}+</strong> run this week</span>
            </span>
            <span class="text-slate-300">•</span>
            <button type="button" onclick="document.getElementById('downloadExcelBtn')?.click()"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-ui-xs shadow-card active:scale-95 transition-all cursor-pointer border border-emerald-500"
               aria-label="Download Native Excel (.xlsx) Financial Model">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                <span>Free Excel Model</span>
            </button>
        </div>
    </div>
</header>

<section id="calculator-section" class="scroll-mt-32" style="scroll-margin-top: 120px;"
    aria-labelledby="calculator-heading">
    <h2 class="sr-only" id="calculator-heading">Calculate Your SIP & SWP Returns</h2>
    
    <!-- Strategy Starter: 1-Click Blueprints & 3-Step Guided Wizard -->
    {% include 'components/strategy-starter.twig' %}

    <div class="xl:grid xl:grid-cols-12 xl:grid-rows-[auto_1fr] xl:items-start xl:gap-8 mt-4 sm:mt-6">

        <!-- Row-1 Wrapper (< xl): bounds Child 2 md:sticky strictly to Row 1 height; dissolves at xl+ via xl:contents -->
        <div class="grid grid-cols-1 md:grid-cols-12 items-start gap-5 lg:gap-8 mb-5 lg:mb-8 xl:mb-0 xl:contents">
            <!-- Left Column: Form (Shrink-wrapped to content with sticky gliding on xl+ desktop) -->
            <div class="md:col-span-5 xl:row-span-2 flex flex-col min-h-0 min-w-0 self-start h-fit xl:sticky xl:top-24">
                {% include 'components/calculator-form.twig' %}
            </div> <!-- /left column -->

            <!-- Right Column Top: Summary, Chart, Scenario & Quick Answer (Sticky beside Stage 2 SWP inputs on md..lg tablets, bounded to Row 1) -->
            <div class="md:col-span-7 space-y-4 min-h-0 min-w-0 self-start md:sticky md:top-24 xl:static">
                {% include 'components/chart-visualization.twig' %}
                
                <!-- Side-by-Side Scenario Diff Comparison (Unhides when snapshot baseline is taken) -->
                {% include 'components/scenario-comparison.twig' %}

                <!-- Quick Answer Box for AI extraction / Featured Snippet & Benchmark Baseline -->
                <div id="quick-answer" class="relative overflow-hidden bg-white rounded-2xl border border-slate-200/90 border-l-4 border-l-emerald-600 p-3.5 sm:p-4 shadow-subtle"
                    role="complementary" aria-label="Quick Answer">
                    <details open class="sm:contents fintech-accordion group">
                        <summary class="flex items-center justify-between gap-2 cursor-pointer select-none sm:cursor-default sm:pointer-events-none mb-1 sm:mb-2">
                            <span class="inline-flex items-center text-micro font-bold text-slate-700 uppercase tracking-widest bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200">
                                Regulatory Benchmark
                            </span>
                            <div class="flex items-center gap-1.5">
                                <span class="text-caption font-semibold text-slate-500">AMFI/SEBI Calibrated</span>
                                <span class="sm:hidden accordion-chevron text-micro font-bold text-slate-400 transition-transform">▼</span>
                            </div>
                        </summary>
                        <div class="mt-1 sm:mt-0">
                            <h3 class="text-ui-xs sm:text-ui-sm font-bold text-slate-800 mb-1">How much will a ₹10,000/month SIP grow in 20 years?</h3>
                            <p class="text-caption sm:text-ui-xs text-slate-600 leading-relaxed">At 12% annual returns with a 10% yearly step-up, a ₹10,000/month SIP will
                                grow to approximately <strong class="text-growth-emphasis font-financial-mono font-extrabold"><span class="dynamic-amount"
                                        data-amount-inr="19889000">₹1.99 Crore</span></strong> over 20 years. Total invested: <strong class="text-slate-700 font-financial-mono"><span
                                    class="dynamic-amount" data-amount-inr="6873000">₹68.73 Lakh</span></strong> • Total compound gains: <strong class="text-growth-emphasis font-financial-mono font-extrabold"><span class="dynamic-amount"
                                    data-amount-inr="13016000">₹1.30 Crore</span></strong>.</p>
                        </div>
                    </details>
                </div>
            </div><!-- /right column top -->
        </div>

        <!-- Child 3: Multi-Mode Interactive Analytical Studio (Full-width block below Row 1 on <xl, Right-column Row 2 on xl+) -->
        <div class="xl:col-span-7 xl:col-start-6 min-w-0">
            {% include 'components/analytical-studio.twig' %}
        </div>
    </div><!-- /12-col grid -->
</section><!-- /calculator section -->

<!-- Explore All 17 Institutional Wealth Calculators -->
<div class="mt-8 mb-4">
    <div class="flex items-center justify-between mb-2 px-1">
        <span class="text-caption font-extrabold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
            </svg>
            <span>Explore All 17 Institutional Financial Calculators</span>
        </span>
    </div>
    {% include 'components/calculator-dock.twig' %}
</div>

<!-- Pre-Calculated Scenario & Benchmark Tables for Search & AI Extractability -->
<div class="-mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-10 sm:py-14 bg-slate-50/80 border-y border-slate-200/70 my-8 sm:my-12">
    {% include 'components/scenario-benchmark-table.twig' %}
</div>

<!-- Editorial Knowledge & Research Vault -->
{% include 'components/home-guide-content.twig' %}

<!-- Related Calculators Cross-Links Hub -->
{% include 'components/related-calculators.twig' %}

<!-- Floating In-Page Discovery Navigation HUD -->
{% include 'components/floating-discovery-hud.twig' %}
{% endblock %}

{% block modals %}
{% include 'components/pdf-modal.twig' %}
{% include 'components/embed-modal.twig' %}
{% endblock %}

{% block scripts %}
{% endblock %}
