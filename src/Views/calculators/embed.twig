<!DOCTYPE html>
<html lang="en-IN" class="overflow-x-clip max-w-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <title>{{ page_config.title|default('Financial Calculator') }} — Embed</title>
    <meta name="robots" content="noindex, follow">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Critical CSS & Vite -->
    {{ vite.css('assets/css/app.css')|raw }}
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
            color: #0f172a;
            line-height: 1.5;
            padding: 12px;
            margin: 0;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    </style>
</head>
<body class="bg-slate-50 antialiased text-slate-900">
    <div class="max-w-5xl mx-auto">
        <!-- Embed Header Bar -->
        <header class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200 text-xs text-slate-500">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-md bg-emerald-600 text-white font-bold text-xs">⚡</span>
                <span class="font-bold text-slate-800 text-sm">{{ page_config.title|default('Financial Calculator') }}</span>
            </div>
            <a href="{{ site_url }}/{{ active_page }}" target="_blank" rel="noopener" class="text-emerald-700 font-semibold hover:underline flex items-center gap-1 text-xs">
                <span>Full Screen</span>
                <span>↗</span>
            </a>
        </header>

        <!-- Calculator App Root -->
        <section id="calculator-section" class="relative">
            <script type="application/json" id="calculator-app-state">
                {{ (calc_config|default({})|merge({'theme': theme_tokens}))|json_island }}
            </script>
            <div id="calculator-app"
                 data-js="calculator-app"
                 data-mode="{{ calculator_type }}"
                 class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Left Column: Form Controls -->
                <div class="lg:col-span-1 flex flex-col gap-4">
                    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card p-4 sm:p-5">
                        <form id="calculator-form" class="space-y-4 lg:max-h-[500px] lg:overflow-y-auto custom-scrollbar pr-1" onsubmit="event.preventDefault();">
                            {% if calculator_type == 'all' or calculator_type == 'combo' %}
                                <!-- 3-Mode Segmented Control Bar (Dual vs SIP Only vs SWP Only) -->
                                <div class="py-0.5 mb-2 rounded-2xl">
                                    <div class="flex bg-slate-100/90 p-1 rounded-2xl border border-slate-200/70 shadow-flat gap-1" role="tablist" aria-label="Calculator Mode Selector">
                                        <button type="button" id="tab-combo" role="tab" aria-selected="true"
                                            class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 text-ui-xs font-extrabold uppercase tracking-wider rounded-xl transition-all duration-200 bg-white text-emerald-800 shadow-flat border border-slate-200/60 cursor-pointer">
                                            <span class="flex items-center justify-center w-4 h-4 rounded-full bg-emerald-100 text-emerald-800 text-micro font-extrabold">🚀</span>
                                            <span>Dual</span>
                                        </button>
                                        <button type="button" id="tab-sip" role="tab" aria-selected="false"
                                            class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 text-ui-xs font-bold uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-500 hover:text-slate-900 cursor-pointer">
                                            <span class="flex items-center justify-center w-4 h-4 rounded-full bg-slate-200 text-slate-600 text-micro font-extrabold">⚡</span>
                                            <span>SIP</span>
                                        </button>
                                        <button type="button" id="tab-swp" role="tab" aria-selected="false"
                                            class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 text-ui-xs font-bold uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-500 hover:text-slate-900 cursor-pointer">
                                            <span class="flex items-center justify-center w-4 h-4 rounded-full bg-slate-200 text-slate-600 text-micro font-extrabold">🛡️</span>
                                            <span>SWP</span>
                                        </button>
                                    </div>
                                </div>
                                
                                <div id="panel-sip" role="tabpanel" aria-labelledby="tab-sip">
                                    <div id="stage-1-header" class="flex items-center justify-between px-3 py-1.5 mb-2 rounded-xl bg-gradient-to-r from-emerald-50 via-teal-50/50 to-slate-50 border border-emerald-200/80 shadow-flat">
                                        <div class="flex items-center gap-2">
                                            <span class="flex items-center justify-center w-4 h-4 rounded-full bg-emerald-600 text-white text-micro font-black">1</span>
                                            <span class="text-caption font-extrabold text-emerald-950 uppercase tracking-wider">Accumulation Phase (SIP)</span>
                                        </div>
                                        <span class="text-micro font-bold text-emerald-700 font-financial-mono">Wealth Building</span>
                                    </div>
                                    <div class="space-y-3">
                                        {% include 'components/forms/sip-fields.twig' %}
                                    </div>
                                </div>
                                
                                <div id="stage-transition-divider" class="my-3 flex items-center gap-2">
                                    <div class="flex-1 border-t border-dashed border-slate-300"></div>
                                    <span class="text-micro font-bold uppercase tracking-widest text-slate-400 bg-slate-50 px-2 py-0.5 rounded-full border border-slate-200">Retirement Transition</span>
                                    <div class="flex-1 border-t border-dashed border-slate-300"></div>
                                </div>

                                <div id="panel-swp" role="tabpanel" aria-labelledby="tab-swp">
                                    <div id="stage-2-header" class="flex items-center justify-between px-3 py-1.5 mb-2 rounded-xl bg-gradient-to-r from-rose-50 via-amber-50/50 to-slate-50 border border-rose-200/80 shadow-flat">
                                        <div class="flex items-center gap-2">
                                            <span class="flex items-center justify-center w-4 h-4 rounded-full bg-rose-600 text-white text-micro font-black">2</span>
                                            <span class="text-caption font-extrabold text-rose-950 uppercase tracking-wider">Distribution Phase (SWP)</span>
                                        </div>
                                        <span class="text-micro font-bold text-rose-700 font-financial-mono">Retirement Cashflow</span>
                                    </div>
                                    <div id="swp-standalone-corpus" class="hidden mb-3">
                                        {% include 'components/forms/corpus-field.twig' %}
                                    </div>
                                    <div class="space-y-3">
                                        <div class="py-0.5 mb-1 rounded-xl">
                                            <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-flat">
                                                <span class="text-ui-xs font-extrabold text-rose-600 uppercase tracking-tight">Enable SWP Mode</span>
                                                <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                                                    <input type="checkbox" id="enable_swp" name="enable_swp" class="sr-only peer" aria-label="Enable Systematic Withdrawal Plan (SWP)" aria-controls="swp-fields" aria-expanded="{{ enable_swp ? 'true' : 'false' }}" {% if enable_swp %}checked{% endif %}>
                                                    <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-rose-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-500"></div>
                                                </label>
                                            </div>
                                        </div>
                                        <div id="swp-fields" class="space-y-3" {% if not enable_swp %}style="display: none; opacity: 0.5; pointer-events: none;" aria-hidden="true"{% endif %}>
                                            {% include 'components/forms/swp-fields.twig' %}
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <input type="hidden" id="enable_swp" name="enable_swp" value="{{ calculator_type == 'swp' ? '1' : '0' }}">
                                <div class="space-y-4">
                                    {% if calculator_type in ['sip', 'sip-step-up'] %}
                                        {% include 'components/forms/sip-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'lumpsum' %}
                                        {% include 'components/forms/lumpsum-only-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'target_corpus' %}
                                        {% include 'components/forms/target-corpus-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'swp' %}
                                        {% include 'components/forms/corpus-field.twig' %}
                                        <div id="swp-fields" class="mt-4">
                                            {% include 'components/forms/swp-fields.twig' %}
                                        </div>
                                    {% endif %}
                                    {% if calculator_type == 'compound_interest' %}
                                        {% include 'components/forms/compound-interest-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'cagr' %}
                                        {% include 'components/forms/cagr-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'emi' %}
                                        {% include 'components/forms/emi-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'inflation' %}
                                        {% include 'components/forms/inflation-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'ppf' %}
                                        {% include 'components/forms/ppf-fields.twig' %}
                                    {% endif %}
                                    {% if calculator_type == 'fd' %}
                                        {% include 'components/forms/fd-fields.twig' %}
                                    {% endif %}
                                </div>
                            {% endif %}
                        </form>
                    </div>
                </div>

                <!-- Right Column: Results & Visualization -->
                <div class="lg:col-span-2 space-y-4">
                    {% include 'components/chart-visualization.twig' %}
                </div>
            </div>
        </section>

        <!-- Embed Attribution Footer (Authoritative Backlink) -->
        <footer class="mt-4 pt-3 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-500">
            <div>
                Powered by <a href="{{ site_url }}{% if active_page and active_page != 'home' %}/{{ active_page }}{% else %}/{% endif %}" target="_blank" rel="noopener" class="font-bold text-emerald-700 hover:underline">SIP &amp; SWP Calculator Together</a> — Free Financial Planning in India
            </div>
            <div class="text-slate-400 text-micro">
                🔒 100% Private in Browser • Zero Latency
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    {{ vite.js('assets/js/app.ts')|raw }}
</body>
</html>
