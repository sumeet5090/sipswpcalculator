{% extends 'layouts/base.twig' %}

{% block head %}
<!-- Preconnect to CDN -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

<!-- Critical above-the-fold CSS inlined for instant FCP -->
<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #059669, #047857);
    }

    @font-face {
        font-family: 'Plus Jakarta Sans Fallback';
        src: local('Arial');
        size-adjust: 107%;
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%;
    }

    body {
        background-color: #f1f5f9;
        font-family: 'Plus Jakarta Sans', 'Plus Jakarta Sans Fallback', 'Inter', Arial, sans-serif;
        color: #0f172a;
        -webkit-font-smoothing: antialiased;
    }

    .navbar-glass {
        background: rgba(255, 255, 255, .98);
    }

    .text-gradient {
        color: #047857;
    }

    @supports ((-webkit-background-clip: text) or (background-clip: text)) {
        .text-gradient {
            background-image: var(--gradient-primary, linear-gradient(135deg, #059669 0%, #047857 100%));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
        }
    }
</style>
{% endblock %}

{% block content %}
{% include 'components/theme-glow-blobs.twig' %}

<!-- Visual Breadcrumb Navigation (aligned with JSON-LD BreadcrumbList schema) -->
<nav aria-label="Breadcrumb" class="mb-4 sm:mb-6">
    <ol role="list" class="flex items-center justify-center sm:justify-start space-x-1.5 sm:space-x-2 text-xs text-slate-500 flex-wrap">
        <li>
            <div class="flex items-center">
                <a href="/" class="text-slate-500 hover:text-emerald-700 transition-colors flex items-center gap-1 font-medium">
                    <svg class="h-3.5 w-3.5 flex-shrink-0 text-slate-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z" clip-rule="evenodd" />
                    </svg>
                    <span>Home</span>
                </a>
            </div>
        </li>
        <li>
            <div class="flex items-center">
                <svg class="h-3.5 w-3.5 flex-shrink-0 text-slate-300 mx-0.5 sm:mx-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
                <a href="/#calculator-section" class="text-slate-500 hover:text-emerald-700 transition-colors whitespace-nowrap font-medium">Calculators</a>
            </div>
        </li>
        <li class="min-w-0">
            <div class="flex items-center min-w-0">
                <svg class="h-3.5 w-3.5 flex-shrink-0 text-slate-300 mx-0.5 sm:mx-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-slate-800 font-semibold truncate max-w-[180px] xs:max-w-[260px] sm:max-w-md block" aria-current="page">{{ content_metadata.title|default(page_config.title) }}</span>
            </div>
        </li>
    </ol>
</nav>

<header class="relative z-10 mb-6 sm:mb-10 text-center border-b border-slate-100 pb-6">
    <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-emerald-50 border border-emerald-100 mb-3 sm:mb-4">
        <span class="relative flex h-2.5 w-2.5 sm:h-3 sm:w-3">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 sm:h-3 sm:w-3 bg-emerald-500"></span>
        </span>
        <span class="text-caption sm:text-ui-xs font-semibold text-emerald-700 tracking-wide uppercase">Financial Planning Tool</span>
    </div>

    <h1 class="fluid-h1 font-extrabold pb-2 sm:pb-3 tracking-tight text-slate-900">
        {{ page_config.title }}
    </h1>
    {% if page_config.meta_desc %}
        <p class="text-ui-xs sm:text-body text-slate-500 max-w-2xl mx-auto leading-relaxed font-medium mb-3 sm:mb-4 line-clamp-3 sm:line-clamp-none">
            {{ page_config.meta_desc }}
        </p>
    {% endif %}
</header>

{% include 'components/calculator-dock.twig' %}

<section id="calculator-section" class="scroll-mt-32" style="scroll-margin-top: 120px;" aria-labelledby="calculator-heading">
    <h2 class="sr-only" id="calculator-heading">Calculate Your Returns</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-12 items-start gap-5 lg:gap-8">
        <!-- Left Column: Form (Shrink-wrapped to content with sticky gliding on xl+ desktop) -->
        <div class="md:col-span-5 flex flex-col min-h-0 min-w-0 self-start h-fit xl:sticky xl:top-24">
            {% include 'components/calculator-form.twig' %}
        </div>

        <!-- Right Column: Floating Summary & Chart Visualization -->
        <div class="md:col-span-7 space-y-4 min-w-0 xl:sticky xl:top-24 xl:self-start xl:z-20">
            {% include 'components/chart-visualization.twig' %}
        </div>
    </div>

    <!-- Full-width Yearly Breakdown -->
    <div class="mt-8">
        {% include 'components/yearly-breakdown-table.twig' %}
    </div>
</section>

<!-- Pre-Calculated Scenario & Benchmark Tables for Search & AI Extractability -->
{% include 'components/scenario-benchmark-table.twig' %}

<!-- Markdown Educational Guide with Progressive Disclosure on Mobile -->
<section id="guide-section" class="mt-8 sm:mt-12 max-w-4xl mx-auto border-t border-slate-200 pt-8" aria-labelledby="guide-heading">
    <h2 id="guide-heading" class="sr-only">In-Depth Guide &amp; Technical Notes</h2>
    <details id="guide-accordion" open class="fintech-accordion group rounded-2xl bg-white border border-slate-200/90 shadow-subtle overflow-hidden sm:border-0 sm:shadow-none sm:bg-transparent">
        <summary class="flex sm:hidden items-center justify-between p-4 bg-slate-50/90 hover:bg-slate-100 cursor-pointer select-none border-b border-slate-200/80 font-bold text-slate-900 text-ui-xs">
            <span class="flex items-center gap-2"><span>📖</span> <span>In-Depth Guide &amp; Technical Notes</span></span>
            <span class="accordion-chevron text-micro font-bold text-slate-400 transition-transform">▼</span>
        </summary>
        <div class="p-3 sm:p-0">
            <article class="markdown-content prose prose-slate max-w-4xl mx-auto">
                {{ content_html|raw }}
            </article>
        </div>
    </details>
</section>

{% if faqs is not empty %}
<section id="faq-section" class="mt-8 sm:mt-12 max-w-4xl mx-auto border-t border-slate-200 pt-8 pb-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-6 tracking-tight flex items-center gap-2">
        <span>❓</span>
        <span>Frequently Asked Questions</span>
    </h2>
    <div class="space-y-3">
        {% for faq in faqs %}
        <details class="fintech-accordion group rounded-2xl bg-white/95 border border-slate-200/90 shadow-subtle overflow-hidden transition-all duration-200 hover:shadow-card">
            <summary class="flex items-center justify-between p-4 bg-slate-50/70 hover:bg-slate-100/70 cursor-pointer select-none font-bold text-slate-900 text-ui-xs sm:text-ui-sm">
                <span class="pr-2">{{ faq.q }}</span>
                <span class="accordion-chevron text-micro font-bold text-slate-400 transition-transform shrink-0">▼</span>
            </summary>
            <div class="p-4 pt-2 text-caption sm:text-ui-xs text-slate-600 leading-relaxed border-t border-slate-100/80">
                <p>{{ faq.a }}</p>
            </div>
        </details>
        {% endfor %}
    </div>
</section>
{% endif %}

{# Related Resources — internal linking from calculator pages to blog content and educational pillars #}
<div class="max-w-4xl mx-auto space-y-8">
    {% include 'components/related-pillar-guides.twig' %}
    {% include 'components/related-calculators.twig' %}
    {% include 'components/related-resources.twig' with {
        all_posts: all_posts,
        seo_category: seo_category
    } %}
</div>

{% endblock %}

{% block modals %}
<!-- PDF Generation Modal (native <dialog> with built-in focus trapping & centering) -->
<dialog id="pdfModal" class="fixed inset-0 m-auto z-modal rounded-3xl shadow-modal p-6 sm:p-8 w-full max-w-lg border border-slate-200 bg-white/95 max-h-[90vh] overflow-y-auto backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm text-slate-800" aria-labelledby="branded-pdf-report">
    <h2 id="branded-pdf-report" class="text-xl sm:text-2xl font-bold text-slate-800 mb-6">Create Branded PDF Report</h2>
    <form id="pdfForm" class="space-y-4">
        <div>
            <label for="clientName" class="block text-sm font-medium mb-1 text-slate-600">Client Name</label>
            <input type="text" id="clientName" name="clientName" placeholder="e.g., John Doe"
                class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm">
        </div>
        <div>
            <label for="advisorName" class="block text-sm font-medium mb-1 text-slate-600">Your Name / Company</label>
            <input type="text" id="advisorName" name="advisorName" placeholder="e.g., Jane Smith Financials"
                class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm">
        </div>
        <div>
            <label for="customDisclaimer" class="block text-sm font-medium mb-1 text-slate-600">Custom Notes / Disclaimer (Optional)</label>
            <textarea id="customDisclaimer" name="customDisclaimer" rows="2" placeholder="e.g., Return projections assume 12% equity CAGR."
                class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm"></textarea>
        </div>

        <!-- Real-Time Proposal Header Preview Box -->
        <div id="pdf-live-preview-box" class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-left space-y-1.5">
            <div class="text-micro font-bold uppercase tracking-wider text-slate-500">Live Proposal Header Preview</div>
            <div class="flex items-center justify-between border-b border-slate-200/80 pb-2">
                <div>
                    <div id="preview-client-name" class="text-xs font-extrabold text-slate-900">Valued Investor</div>
                    <div class="text-micro text-slate-500">Comprehensive Investment &amp; Cashflow Proposal</div>
                </div>
                <div id="preview-advisor-name" class="text-caption font-bold text-emerald-700">Financial Advisor</div>
            </div>
        </div>

        <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-100">
            <button type="button" id="fastInstantPdfBtn"
                class="px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold rounded-xl transition text-xs flex items-center gap-1.5 cursor-pointer">
                <span>⚡</span>
                <span>1-Click Fast Download</span>
            </button>
            <div class="flex gap-2">
                <button type="button" id="closePdfModalBtn" onclick="document.getElementById('pdfModal')?.close()"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition text-xs cursor-pointer">Cancel</button>
                <button type="submit" id="generatePdfBtn"
                    class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-card shadow-emerald-600/20 transition text-xs cursor-pointer">Download Custom PDF</button>
            </div>
        </div>
    </form>
</dialog>

{% include 'components/embed-modal.twig' %}
{% endblock %}

{% block scripts %}
{% if page_config.scripts %}
    {% for script in page_config.scripts %}
        <script type="module" src="{{ script }}"></script>
    {% endfor %}
{% endif %}
{% endblock %}
