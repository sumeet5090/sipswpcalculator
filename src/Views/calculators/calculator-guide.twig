{% extends 'layouts/base.twig' %}

{% block head %}
{{ page_config.additional_head|raw }}



<!-- Preconnect to CDN -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

<!-- Critical above-the-fold CSS inlined for instant FCP -->
<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #059669, #047857);
        --glass-bg: rgba(255, 255, 255, .9);
        --glass-border: 1px solid rgba(255, 255, 255, .5);
        --glass-shadow: 0 8px 32px 0 rgba(5, 150, 105, .1);
        --color-bg: #f8fafc;
        --color-text-primary: #0f172a;
        --color-text-secondary: #64748b;
        --color-border: #e2e8f0
    }

    @font-face {
        font-family: 'Plus Jakarta Sans Fallback';
        src: local('Arial');
        size-adjust: 107%;
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%
    }

    body {
        background-color: var(--color-bg);
        font-family: 'Plus Jakarta Sans', 'Plus Jakarta Sans Fallback', 'Inter', Arial, sans-serif;
        color: var(--color-text-primary);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased
    }

    .navbar-glass {
        background: rgba(255, 255, 255, .85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px)
    }

    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 1rem;
        position: relative
    }

    .text-gradient {
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-image: var(--gradient-primary)
    }
</style>
{% endblock %}

{% block content %}
{% include 'components/theme-glow-blobs.twig' %}
<header class="relative mb-6 sm:mb-10 text-center border-b border-slate-100 pb-6">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 border border-emerald-100 mb-4">
        <span class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <span class="text-sm font-semibold text-emerald-700 tracking-wide uppercase">Financial Planning Tool</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold pb-3 tracking-tight text-slate-900">
        {{ page_config.title }}
    </h1>
    {% if page_config.meta_desc %}
        <p class="text-lg sm:text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed font-medium mb-4">
            {{ page_config.meta_desc }}
        </p>
    {% endif %}
</header>

<section id="calculator-section" class="scroll-mt-32" style="scroll-margin-top: 120px;" aria-labelledby="calculator-heading">
    <h2 class="sr-only" id="calculator-heading">Calculate Your Returns</h2>
    
    <script type="application/json" id="calculator-app-state">
        {{ (calc_config|default({})|merge({'theme': theme_tokens}))|json_island }}
    </script>
    <div id="calculator-app"
         data-js="calculator-app"
         data-mode="{{ calculator_type }}"
         class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: Form -->
        <div class="lg:col-span-1 flex flex-col gap-4 lg:sticky lg:self-start" style="top: 100px;">
            <div class="glass-card p-4 sm:p-5">
                <form id="calculator-form" class="space-y-6" onsubmit="event.preventDefault();">
                    {% if calculator_type == 'all' or calculator_type == 'combo' %}
                        <!-- Combo Form (SIP + SWP Tabs) -->
                        <div class="flex rounded-xl overflow-hidden border border-slate-200 mb-4" role="tablist">
                            <button type="button" id="tab-sip" role="tab" aria-selected="true"
                                class="flex-1 flex items-center justify-center gap-1.5 py-2.5 text-xs font-bold uppercase tracking-widest transition-all duration-200 bg-emerald-500 text-white">
                                SIP Details
                            </button>
                            <button type="button" id="tab-swp" role="tab" aria-selected="false"
                                class="flex-1 flex items-center justify-center gap-1.5 py-2.5 text-xs font-bold uppercase tracking-widest transition-all duration-200 bg-white text-slate-500 hover:bg-rose-50 hover:text-rose-500">
                                SWP Details
                            </button>
                        </div>
                        
                        <div id="panel-sip" role="tabpanel" aria-labelledby="tab-sip">
                            <div class="space-y-4">
                                {% include 'components/forms/lumpsum-fields.twig' %}
                                {% include 'components/forms/sip-fields.twig' %}
                            </div>
                        </div>
                        
                        <div id="panel-swp" role="tabpanel" aria-labelledby="tab-swp" class="hidden">
                            <div class="space-y-4">
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-xs font-bold text-rose-400 tracking-widest uppercase">Enable SWP</span>
                                    <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" id="enable_swp" name="enable_swp" class="sr-only peer" aria-label="Enable Systematic Withdrawal Plan (SWP)" aria-controls="swp-fields" aria-expanded="{{ enable_swp ? 'true' : 'false' }}" {% if enable_swp %}checked{% endif %}>
                                        <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-rose-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-500"></div>
                                    </label>
                                </div>
                                <div id="swp-fields" {% if not enable_swp %}style="display: none; opacity: 0.5; pointer-events: none;" aria-hidden="true"{% endif %}>
                                    {% include 'components/forms/swp-fields.twig' %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <!-- Single Calculator Forms -->
                        <input type="hidden" id="enable_swp" name="enable_swp" value="{{ calculator_type == 'swp' ? '1' : '0' }}">
                        <div class="space-y-4">
                            {% if calculator_type == 'sip' %}
                                <div class="mb-2">
                                    <span class="text-xs font-bold text-emerald-600 tracking-widest uppercase">SIP Details</span>
                                </div>
                                {% include 'components/forms/sip-fields.twig' %}
                            {% endif %}

                            {% if calculator_type == 'lumpsum' %}
                                <div class="mb-2">
                                    <span class="text-xs font-bold text-emerald-600 tracking-widest uppercase">Lumpsum Details</span>
                                </div>
                                {% include 'components/forms/lumpsum-only-fields.twig' %}
                            {% endif %}

                            {% if calculator_type == 'target_corpus' %}
                                <div class="mb-2">
                                    <span class="text-xs font-bold text-emerald-600 tracking-widest uppercase">Target Goal Details</span>
                                </div>
                                {% include 'components/forms/target-corpus-fields.twig' %}
                            {% endif %}

                            {% if calculator_type == 'swp' %}
                                <div class="mb-2">
                                    <span class="text-xs font-bold text-rose-500 tracking-widest uppercase">Your Corpus</span>
                                </div>
                                {% include 'components/forms/corpus-field.twig' %}
                                <div class="mb-2 mt-4">
                                    <span class="text-xs font-bold text-rose-500 tracking-widest uppercase">SWP Details</span>
                                </div>
                                <div id="swp-fields">
                                    {% include 'components/forms/swp-fields.twig' %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </form>
            </div>
        </div>

        <div class="lg:col-span-2 space-y-4 lg:sticky lg:top-[90px] lg:self-start">
            {% include 'components/chart-visualization.twig' %}
        </div>
    </div>

    <!-- Full-width Yearly Breakdown -->
    <div class="mt-8">
        {% include 'components/yearly-breakdown-table.twig' %}
    </div>
</section>

<!-- Markdown Educational Guide -->
<article class="markdown-content prose prose-slate max-w-4xl mx-auto border-t border-slate-200 pt-10">
    {{ content_html|raw }}
</article>

{% if faqs is not empty %}
<section class="mt-12 max-w-4xl mx-auto border-t border-slate-200 pt-8 pb-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-6 tracking-tight flex items-center gap-2">
        <span>❓</span>
        <span>Frequently Asked Questions</span>
    </h2>
    <div class="space-y-4">
        {% for faq in faqs %}
        <div class="fintech-glass-card p-5 border border-slate-200/90 rounded-2xl shadow-flat transition-all duration-300 hover:shadow-card">
            <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-2">{{ faq.q }}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{{ faq.a }}</p>
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}

{# Related Resources — internal linking from calculator pages to blog content #}
<div class="max-w-4xl mx-auto">
    {% include 'components/related-resources.twig' with {
        all_posts: all_posts,
        seo_category: seo_category
    } %}
</div>

{% endblock %}

{% block modals %}
<!-- PDF Generation Modal (native <dialog> with built-in focus trapping & centering) -->
<dialog id="pdfModal" class="fixed inset-0 m-auto z-50 rounded-3xl shadow-2xl p-6 sm:p-8 w-full max-w-lg border border-slate-200 bg-white/95 max-h-[90vh] overflow-y-auto backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm text-slate-800" aria-labelledby="branded-pdf-report">
    <h2 id="branded-pdf-report" class="text-xl sm:text-2xl font-bold text-slate-800 mb-6">Create Branded PDF Report</h2>
    <form id="pdfForm" class="space-y-4">
        <div>
            <label for="clientName" class="block text-sm font-medium mb-1 text-slate-600">Client Name</label>
            <input type="text" id="clientName" name="clientName" placeholder="e.g., John Doe"
                class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm">
        </div>
        <div>
            <label for="advisorName" class="block text-sm font-medium mb-1 text-slate-600">Your Name / Company</label>
            <input type="text" id="advisorName" name="advisorName" placeholder="e.g., Jane Smith Financials"
                class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm">
        </div>
        <div>
            <label for="customDisclaimer" class="block text-sm font-medium mb-1 text-slate-600">Custom Notes / Disclaimer (Optional)</label>
            <textarea id="customDisclaimer" name="customDisclaimer" rows="2" placeholder="e.g., Return projections assume 12% equity CAGR."
                class="w-full px-4 py-2 rounded-xl bg-slate-50 border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition text-sm"></textarea>
        </div>

        <!-- Real-Time Proposal Header Preview Box -->
        <div id="pdf-live-preview-box" class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-left space-y-1.5">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Live Proposal Header Preview</div>
            <div class="flex items-center justify-between border-b border-slate-200/80 pb-2">
                <div>
                    <div id="preview-client-name" class="text-xs font-extrabold text-slate-900">Valued Investor</div>
                    <div class="text-[10px] text-slate-500">Comprehensive Investment &amp; Cashflow Proposal</div>
                </div>
                <div id="preview-advisor-name" class="text-[11px] font-bold text-emerald-700">Financial Advisor</div>
            </div>
        </div>

        <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-100">
            <button type="button" id="fastInstantPdfBtn"
                class="px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold rounded-xl transition text-xs flex items-center gap-1.5 cursor-pointer">
                <span>⚡</span>
                <span>1-Click Fast Download</span>
            </button>
            <div class="flex gap-2">
                <button type="button" id="closePdfModalBtn" onclick="document.getElementById('pdfModal')?.close()"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition text-xs cursor-pointer">Cancel</button>
                <button type="submit" id="generatePdfBtn"
                    class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-md shadow-emerald-600/20 transition text-xs cursor-pointer">Download Custom PDF</button>
            </div>
        </div>
    </form>
</dialog>
{% endblock %}

{% block scripts %}
{% if page_config.scripts %}
    {% for script in page_config.scripts %}
        <script type="module" src="{{ script }}"></script>
    {% endfor %}
{% endif %}
{% endblock %}
