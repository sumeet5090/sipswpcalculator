<div class="bg-white border border-slate-200 rounded-3xl shadow-flat hover:shadow-card transition-all duration-300 p-6 flex flex-col justify-between h-full">
    <div class="flex justify-between items-start mb-4">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">{{ title }}</h3>
        {% if icon %}
        <div class="text-slate-400 w-6 h-6">
            {{ icon|raw }}
        </div>
        {% endif %}
    </div>
    <div class="mt-auto">
        <div class="text-3xl font-extrabold text-slate-900">{{ value }}</div>
        {% if subtitle %}
        <div class="text-xs text-slate-400 mt-1.5 font-medium">{{ subtitle }}</div>
        {% endif %}
    </div>
</div>
