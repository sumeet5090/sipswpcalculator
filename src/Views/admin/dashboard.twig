{% extends 'admin/layouts/admin.twig' %}

{% block content %}
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Dashboard Overview</h1>
        <p class="text-slate-500 text-sm mt-1">Real-time usage statistics and telemetry metrics (Asia/Kolkata IST)</p>
    </div>
    
    <div class="flex flex-wrap items-center gap-3">
        <!-- Range Filters -->
        <div class="flex gap-2">
            {% for key, range in time_ranges %}
                <a href="?range={{ key }}" 
                   class="px-4 py-2 text-sm font-semibold rounded-xl transition-all duration-300 border 
                   {% if current_range_key == key %}
                       bg-emerald-600 text-white border-emerald-600 shadow-card shadow-emerald-600/15
                   {% else %}
                       bg-white text-slate-600 border-slate-200 hover:bg-slate-50 hover:text-slate-950
                   {% endif %}">
                    {{ range.label }}
                </a>
            {% endfor %}
        </div>
    </div>
</div>

<!-- KPI Stats Row 1 -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    {% include 'admin/components/stat_card.twig' with {
        title: 'Total Calculations',
        value: totalCalculations
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Step-Up',
        value: avgStepUpPct ~ '%',
        subtitle: 'Of all SIPs with step-up > 0'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Table View Depth',
        value: tableViewEngagement ~ '%',
        subtitle: 'Users inspecting breakdown table'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Return Multiplier',
        value: avgWealthMultiplier ~ 'x',
        subtitle: 'End Corpus / Total Invested'
    } %}
</div>

<!-- KPI Stats Row 2 (Advanced Privacy, SEO & Intent Signals) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
    {% include 'admin/components/stat_card.twig' with {
        title: 'B2B Advisor Rate',
        value: b2bAdvisorRate ~ '%',
        subtitle: 'PDF reports with custom branding'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Inflation Adjusted',
        value: inflationRate ~ '%',
        subtitle: 'Calculations with inflation toggle'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Scenario Iterations',
        value: avgIterations,
        subtitle: 'Input adjustments per session'
    } %}

    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Scroll Depth',
        value: avgScrollDepth ~ '%',
        subtitle: 'Editorial content reading depth'
    } %}

    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Dwell Time',
        value: avgDwellTime ~ 's',
        subtitle: 'Active user engagement time'
    } %}
</div>

<!-- Charts Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {% include 'admin/components/chart_card.twig' with {
        title: 'Daily Volume (' ~ current_range.label ~ ')',
        description: 'Calculations run over time. Helps monitor overall site engagement.',
        canvas_id: 'volumeChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Search & Traffic Attribution',
        description: 'Organic search engines, AI search, social, and direct referral distribution.',
        canvas_id: 'referrerChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: 'Interactive Studio Modules',
        description: 'User engagement across City FIRE, Amortization Table, Roadmap, and Stress-Test.',
        canvas_id: 'studioTabChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: '1-Click Strategy Blueprints',
        description: 'Adoption rate of preset financial goals (First ₹1 Cr, FIRE, Education).',
        canvas_id: 'strategyStarterChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: 'Device Form Factor',
        description: 'Mobile vs Desktop usage split. Guides UX optimization priorities.',
        canvas_id: 'deviceChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Goal Mode Distribution',
        description: 'Wealth Creation (Grow) vs Target Corpus back-calculation mode.',
        canvas_id: 'goalModeChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: 'SIP Type Breakdown',
        description: 'Step-Up vs Flat SIP ratio. Shows user preference for active vs flat growth planning.',
        canvas_id: 'stepUpChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Duration Distribution',
        description: 'Compounding span. Higher projection years suggest users with long-term goals.',
        canvas_id: 'durationChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Wealth Goals (Ambition)',
        description: 'Calculated target sizes. Gauges user financial ambition categories.',
        canvas_id: 'ambitionChart'
    } %}
</div>
{% endblock %}

{% block scripts %}
<script type="application/json" id="admin-dashboard-data">{{ chartPayload|json_island }}</script>
{{ vite_js('assets/js/admin/AdminDashboardApp.ts') }}
{% endblock %}

