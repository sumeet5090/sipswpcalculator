{% extends 'admin/layouts/admin.twig' %}

{% block content %}
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Dashboard Overview</h1>
        <p class="text-slate-500 text-sm mt-1">Real-time usage statistics and telemetry metrics</p>
    </div>
    
    <div class="flex flex-wrap items-center gap-3">
        <!-- Range Filters -->
        <div class="flex gap-2">
            {% for key, range in time_ranges %}
                <a href="?range={{ key }}" 
                   class="px-4 py-2 text-sm font-semibold rounded-xl transition-all duration-300 border 
                   {% if current_range_key == key %}
                       bg-emerald-600 text-white border-emerald-600 shadow-md shadow-emerald-600/15
                   {% else %}
                       bg-white text-slate-600 border-slate-200 hover:bg-slate-50 hover:text-slate-950
                   {% endif %}">
                    {{ range.label }}
                </a>
            {% endfor %}
        </div>

        <!-- Run Migrations Trigger -->
        <button id="btn-run-migrations" 
                class="flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-white text-slate-700 hover:text-emerald-700 border border-slate-200 rounded-xl hover:bg-emerald-50 transition-all duration-300 shadow-sm cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.58 4 8 4s8-1.79 8-4M4 7c0-2.21 3.58-4 8-4s8 1.79 8 4m0 5c0 2.21-3.58 4-8 4s-8-1.79-8-4" />
            </svg>
            Update Database Schema
        </button>
    </div>
</div>

<!-- KPI Stats Row 1 -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    {% include 'admin/components/stat_card.twig' with {
        title: 'Total Calculations',
        value: totalCalculations
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Step-Up',
        value: avgStepUpPct ~ '%',
        subtitle: 'Of all SIPs with step-up > 0'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Table View Depth',
        value: tableViewEngagement ~ '%',
        subtitle: 'Users inspecting breakdown table'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Return Multiplier',
        value: avgWealthMultiplier ~ 'x',
        subtitle: 'End Corpus / Total Invested'
    } %}
</div>

<!-- KPI Stats Row 2 (Advanced Privacy & B2B Signals) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    {% include 'admin/components/stat_card.twig' with {
        title: 'B2B Advisor Rate',
        value: b2bAdvisorRate ~ '%',
        subtitle: 'PDF reports with custom branding'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Inflation Adjusted',
        value: inflationRate ~ '%',
        subtitle: 'Calculations considering inflation'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Scenario Iterations',
        value: avgIterations,
        subtitle: 'Input adjustments per session'
    } %}
</div>

<!-- Charts Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {% include 'admin/components/chart_card.twig' with {
        title: 'Daily Volume (' ~ current_range.label ~ ')',
        description: 'Calculations run over time. Helps monitor overall site engagement.',
        canvas_id: 'volumeChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Device Form Factor',
        description: 'Mobile vs Desktop usage split. Guides UX optimization priorities.',
        canvas_id: 'deviceChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Goal Mode Distribution',
        description: 'Wealth Creation (Grow) vs Target Corpus back-calculation mode.',
        canvas_id: 'goalModeChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: 'SIP Type Breakdown',
        description: 'Step-Up vs Flat SIP ratio. Shows user preference for active vs flat growth planning.',
        canvas_id: 'stepUpChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Duration Distribution',
        description: 'Compounding span. Higher projection years suggest users with long-term goals.',
        canvas_id: 'durationChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Wealth Goals (Ambition)',
        description: 'Calculated target sizes. Gauges user financial ambition categories.',
        canvas_id: 'ambitionChart'
    } %}
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    Chart.defaults.color = '#64748b'; // Slate 500
    Chart.defaults.borderColor = 'rgba(226, 232, 240, 0.8)'; // Slate 200
    Chart.defaults.font.family = 'Plus Jakarta Sans, Inter, system-ui, sans-serif';

    const commonOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                labels: { color: '#475569', padding: 20, font: { weight: '600' } }
            }
        }
    };

    // 1. Volume Line Chart
    new Chart(document.getElementById('volumeChart'), {
        type: 'line',
        data: {
            labels: {{ volumeLabels|raw }},
            datasets: [{
                label: 'Calculations',
                data: {{ volumeData|raw }},
                borderColor: '#059669', // Emerald 600
                backgroundColor: 'rgba(5, 150, 105, 0.05)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#059669'
            }]
        },
        options: {
            ...commonOptions,
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                x: { grid: { display: false } }
            }
        }
    });

    // 2. Device Form Factor Doughnut Chart
    const deviceEl = document.getElementById('deviceChart');
    if (deviceEl) {
        new Chart(deviceEl, {
            type: 'doughnut',
            data: {
                labels: {{ deviceLabels|raw }},
                datasets: [{
                    data: {{ deviceData|raw }},
                    backgroundColor: ['#059669', '#6366f1', '#f59e0b'], // Emerald 600, Indigo 500, Amber 500
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                ...commonOptions,
                cutout: '65%'
            }
        });
    }

    // 3. Goal Mode Bar Chart
    const goalModeEl = document.getElementById('goalModeChart');
    if (goalModeEl) {
        new Chart(goalModeEl, {
            type: 'bar',
            data: {
                labels: {{ goalModeLabels|raw }},
                datasets: [{
                    label: 'Calculations by Mode',
                    data: {{ goalModeData|raw }},
                    backgroundColor: ['#10b981', '#6366f1'],
                    borderRadius: 6
                }]
            },
            options: {
                ...commonOptions,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    // 3. SIP Type Doughnut Chart
    new Chart(document.getElementById('stepUpChart'), {
        type: 'doughnut',
        data: {
            labels: ['Step-Up SIP', 'Flat SIP'],
            datasets: [{
                data: {{ stepUpDoughnutData|raw }},
                backgroundColor: ['#10b981', '#14b8a6'], // Emerald 500 & Teal 500
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            ...commonOptions,
            cutout: '70%'
        }
    });

    // 4. Duration Histogram
    new Chart(document.getElementById('durationChart'), {
        type: 'bar',
        data: {
            labels: {{ durationLabels|raw }},
            datasets: [{
                label: 'Frequency',
                data: {{ durationData|raw }},
                backgroundColor: '#047857', // Emerald 700
                borderRadius: 6
            }]
        },
        options: {
            ...commonOptions,
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                x: { grid: { display: false } }
            }
        }
    });

    // 5. Ambition Index Bar Chart
    new Chart(document.getElementById('ambitionChart'), {
        type: 'bar',
        data: {
            labels: {{ ambitionLabels|raw }},
            datasets: [{
                label: 'Calculations',
                data: {{ ambitionData|raw }},
                backgroundColor: '#0f766e', // Teal 700
                borderRadius: 6
            }]
        },
        options: {
            ...commonOptions,
            indexAxis: 'y',
            scales: {
                x: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                y: { grid: { display: false } }
            }
        }
    });

    // 6. Run Migrations AJAX Trigger
    const migrateBtn = document.getElementById('btn-run-migrations');
    if (migrateBtn) {
        migrateBtn.addEventListener('click', function () {
            if (!confirm('Are you sure you want to update the database schema?')) {
                return;
            }
            
            migrateBtn.disabled = true;
            const originalText = migrateBtn.innerHTML;
            migrateBtn.innerHTML = 'Updating...';

            fetch('/admin_insights/migrate')
                .then(response => response.json())
                .then(data => {
                    alert(data.message || 'Action completed.');
                    if (data.status === 'success') {
                        window.location.reload();
                    }
                })
                .catch(error => {
                    alert('Error running database upgrade: ' + error.message);
                })
                .finally(() => {
                    migrateBtn.disabled = false;
                    migrateBtn.innerHTML = originalText;
                });
        });
    }
</script>
{% endblock %}
