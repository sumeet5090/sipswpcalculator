{% extends 'admin/layouts/admin.twig' %}

{% block content %}
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Dashboard Overview</h1>
        <p class="text-slate-500 text-sm mt-1">Real-time usage statistics and telemetry metrics (Asia/Kolkata IST)</p>
    </div>
    
    <div class="flex flex-wrap items-center gap-3">
        <!-- Range Filters -->
        <div class="flex gap-2">
            {% for key, range in time_ranges %}
                <a href="?range={{ key }}" 
                   class="px-4 py-2 text-sm font-semibold rounded-xl transition-all duration-300 border 
                   {% if current_range_key == key %}
                       bg-emerald-600 text-white border-emerald-600 shadow-md shadow-emerald-600/15
                   {% else %}
                       bg-white text-slate-600 border-slate-200 hover:bg-slate-50 hover:text-slate-950
                   {% endif %}">
                    {{ range.label }}
                </a>
            {% endfor %}
        </div>
    </div>
</div>

<!-- KPI Stats Row 1 -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    {% include 'admin/components/stat_card.twig' with {
        title: 'Total Calculations',
        value: totalCalculations
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Step-Up',
        value: avgStepUpPct ~ '%',
        subtitle: 'Of all SIPs with step-up > 0'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Table View Depth',
        value: tableViewEngagement ~ '%',
        subtitle: 'Users inspecting breakdown table'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Return Multiplier',
        value: avgWealthMultiplier ~ 'x',
        subtitle: 'End Corpus / Total Invested'
    } %}
</div>

<!-- KPI Stats Row 2 (Advanced Privacy, SEO & Intent Signals) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
    {% include 'admin/components/stat_card.twig' with {
        title: 'B2B Advisor Rate',
        value: b2bAdvisorRate ~ '%',
        subtitle: 'PDF reports with custom branding'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Inflation Adjusted',
        value: inflationRate ~ '%',
        subtitle: 'Calculations with inflation toggle'
    } %}
    
    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Scenario Iterations',
        value: avgIterations,
        subtitle: 'Input adjustments per session'
    } %}

    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Scroll Depth',
        value: avgScrollDepth ~ '%',
        subtitle: 'Editorial content reading depth'
    } %}

    {% include 'admin/components/stat_card.twig' with {
        title: 'Avg Dwell Time',
        value: avgDwellTime ~ 's',
        subtitle: 'Active user engagement time'
    } %}
</div>

<!-- Charts Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {% include 'admin/components/chart_card.twig' with {
        title: 'Daily Volume (' ~ current_range.label ~ ')',
        description: 'Calculations run over time. Helps monitor overall site engagement.',
        canvas_id: 'volumeChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Search & Traffic Attribution',
        description: 'Organic search engines, AI search, social, and direct referral distribution.',
        canvas_id: 'referrerChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: 'Interactive Studio Modules',
        description: 'User engagement across City FIRE, Amortization Table, Roadmap, and Stress-Test.',
        canvas_id: 'studioTabChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: '1-Click Strategy Blueprints',
        description: 'Adoption rate of preset financial goals (First ₹1 Cr, FIRE, Education).',
        canvas_id: 'strategyStarterChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: 'Device Form Factor',
        description: 'Mobile vs Desktop usage split. Guides UX optimization priorities.',
        canvas_id: 'deviceChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Goal Mode Distribution',
        description: 'Wealth Creation (Grow) vs Target Corpus back-calculation mode.',
        canvas_id: 'goalModeChart'
    } %}

    {% include 'admin/components/chart_card.twig' with {
        title: 'SIP Type Breakdown',
        description: 'Step-Up vs Flat SIP ratio. Shows user preference for active vs flat growth planning.',
        canvas_id: 'stepUpChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Duration Distribution',
        description: 'Compounding span. Higher projection years suggest users with long-term goals.',
        canvas_id: 'durationChart'
    } %}
    
    {% include 'admin/components/chart_card.twig' with {
        title: 'Wealth Goals (Ambition)',
        description: 'Calculated target sizes. Gauges user financial ambition categories.',
        canvas_id: 'ambitionChart'
    } %}
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    Chart.defaults.color = '#64748b'; // Slate 500
    Chart.defaults.borderColor = 'rgba(226, 232, 240, 0.8)'; // Slate 200
    Chart.defaults.font.family = 'Plus Jakarta Sans, Inter, system-ui, sans-serif';

    const commonPlugins = {
        legend: {
            labels: { color: '#475569', padding: 20, font: { weight: '600' } }
        }
    };

    // 1. Volume Line Chart
    const volumeEl = document.getElementById('volumeChart');
    if (volumeEl) {
        new Chart(volumeEl, {
            type: 'line',
            data: {
                labels: {{ volumeLabels|raw }},
                datasets: [{
                    label: 'Calculations',
                    data: {{ volumeData|raw }},
                    borderColor: '#059669', // Emerald 600
                    backgroundColor: 'rgba(5, 150, 105, 0.05)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#059669'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: commonPlugins,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    // 2. Search & Referrer Distribution Doughnut
    const referrerEl = document.getElementById('referrerChart');
    if (referrerEl) {
        const refData = {{ referrerData|raw }};
        const refTotal = (refData || []).reduce((a, b) => a + b, 0);
        const hasRefData = refTotal > 0;

        new Chart(referrerEl, {
            type: 'doughnut',
            data: {
                labels: hasRefData ? {{ referrerLabels|raw }} : ['Direct / None'],
                datasets: [{
                    data: hasRefData ? refData : [1],
                    backgroundColor: hasRefData
                        ? ['#059669', '#0284c7', '#8b5cf6', '#f59e0b', '#ec4899', '#64748b']
                        : ['#e2e8f0'],
                    borderWidth: 0,
                    hoverOffset: hasRefData ? 4 : 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    ...commonPlugins,
                    tooltip: { enabled: hasRefData }
                },
                cutout: '65%'
            }
        });
    }

    // 3. Interactive Studio Modules Bar Chart
    const studioTabEl = document.getElementById('studioTabChart');
    if (studioTabEl) {
        new Chart(studioTabEl, {
            type: 'bar',
            data: {
                labels: {{ studioTabLabels|raw }},
                datasets: [{
                    label: 'Views',
                    data: {{ studioTabData|raw }},
                    backgroundColor: '#0d9488', // Teal 600
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: commonPlugins,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    // 4. Strategy Starter Presets Bar Chart
    const strategyStarterEl = document.getElementById('strategyStarterChart');
    if (strategyStarterEl) {
        new Chart(strategyStarterEl, {
            type: 'bar',
            data: {
                labels: {{ strategyStarterLabels|raw }},
                datasets: [{
                    label: 'Preset Clicks',
                    data: {{ strategyStarterData|raw }},
                    backgroundColor: '#6366f1', // Indigo 500
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: commonPlugins,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    // 5. Device Form Factor Doughnut Chart
    const deviceEl = document.getElementById('deviceChart');
    if (deviceEl) {
        const deviceData = {{ deviceData|raw }};
        const deviceTotal = (deviceData || []).reduce((a, b) => a + b, 0);
        const hasDeviceData = deviceTotal > 0;

        new Chart(deviceEl, {
            type: 'doughnut',
            data: {
                labels: hasDeviceData ? {{ deviceLabels|raw }} : ['No Activity Recorded'],
                datasets: [{
                    data: hasDeviceData ? deviceData : [1],
                    backgroundColor: hasDeviceData
                        ? ['#059669', '#6366f1', '#f59e0b']
                        : ['#e2e8f0'],
                    borderWidth: 0,
                    hoverOffset: hasDeviceData ? 4 : 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    ...commonPlugins,
                    tooltip: { enabled: hasDeviceData }
                },
                cutout: '65%'
            }
        });
    }

    // 6. Goal Mode Bar Chart
    const goalModeEl = document.getElementById('goalModeChart');
    if (goalModeEl) {
        new Chart(goalModeEl, {
            type: 'bar',
            data: {
                labels: {{ goalModeLabels|raw }},
                datasets: [{
                    label: 'Calculations by Mode',
                    data: {{ goalModeData|raw }},
                    backgroundColor: ['#10b981', '#6366f1'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: commonPlugins,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    // 7. SIP Type Doughnut Chart
    const stepUpEl = document.getElementById('stepUpChart');
    if (stepUpEl) {
        const stepUpData = {{ stepUpDoughnutData|raw }};
        const stepUpTotal = (stepUpData || []).reduce((a, b) => a + b, 0);
        const hasStepUpData = stepUpTotal > 0;

        new Chart(stepUpEl, {
            type: 'doughnut',
            data: {
                labels: hasStepUpData ? ['Step-Up SIP', 'Flat SIP'] : ['No Activity Recorded'],
                datasets: [{
                    data: hasStepUpData ? stepUpData : [1],
                    backgroundColor: hasStepUpData
                        ? ['#10b981', '#14b8a6']
                        : ['#e2e8f0'],
                    borderWidth: 0,
                    hoverOffset: hasStepUpData ? 4 : 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    ...commonPlugins,
                    tooltip: { enabled: hasStepUpData }
                },
                cutout: '70%'
            }
        });
    }

    // 8. Duration Histogram
    const durationEl = document.getElementById('durationChart');
    if (durationEl) {
        new Chart(durationEl, {
            type: 'bar',
            data: {
                labels: {{ durationLabels|raw }},
                datasets: [{
                    label: 'Frequency',
                    data: {{ durationData|raw }},
                    backgroundColor: '#047857', // Emerald 700
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: commonPlugins,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    // 9. Ambition Index Bar Chart
    const ambitionEl = document.getElementById('ambitionChart');
    if (ambitionEl) {
        new Chart(ambitionEl, {
            type: 'bar',
            data: {
                labels: {{ ambitionLabels|raw }},
                datasets: [{
                    label: 'Calculations',
                    data: {{ ambitionData|raw }},
                    backgroundColor: '#0f766e', // Teal 700
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: commonPlugins,
                scales: {
                    x: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.8)' } },
                    y: { grid: { display: false } }
                }
            }
        });
    }
</script>
{% endblock %}
