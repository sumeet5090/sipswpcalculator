<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard - SIP & SWP Calculator</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {{ vite_client() }}
    {{ vite_css('resources/js/app.ts') }}
    <style>
        body {
            font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
            background-color: #f8fafc;
            background-image: radial-gradient(at 0% 0%, rgba(16, 185, 129, 0.05) 0, transparent 50%), radial-gradient(at 50% 0%, rgba(20, 184, 166, 0.03) 0, transparent 50%);
            background-attachment: fixed;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 antialiased flex flex-col">

    {% if request.session('admin_authenticated') %}
    <nav class="bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <span class="text-xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-emerald-600 to-teal-500">
                        Admin Insights
                    </span>
                </div>
                <div class="flex items-center space-x-4">
                    <form method="POST" action="/admin_insights/logout" class="inline m-0">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="text-sm font-semibold text-slate-600 hover:text-emerald-600 bg-slate-100 hover:bg-emerald-50 px-3.5 py-2 rounded-xl transition-all duration-300 cursor-pointer border-0">
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>
    {% endif %}

    <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {% block content %}{% endblock %}
    </main>

    <script type="module" src="{{ vite_asset('resources/js/app.ts') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
