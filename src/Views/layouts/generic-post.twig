{% extends 'layouts/base.twig' %}

{% block content %}
{% include 'components/theme-glow-blobs.twig' %}

{% set cat_slug = seo_category|default('growth') %}
{% set cat_accent = 'emerald' %}
{% set cat_name = 'Wealth Growth' %}
{% set cat_icon = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>' %}
{% set gradient_glow = 'from-emerald-500 to-teal-500' %}
{% set badge_classes = 'bg-emerald-50 text-emerald-700 border border-emerald-100' %}

{% if cat_slug == 'retirement' %}
    {% set cat_accent = 'indigo' %}
    {% set cat_name = 'Retirement Planning' %}
    {% set cat_icon = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' %}
    {% set gradient_glow = 'from-indigo-500 to-purple-500' %}
    {% set badge_classes = 'bg-indigo-50 text-indigo-700 border border-indigo-100' %}
{% elseif cat_slug == 'comparison' %}
    {% set cat_accent = 'amber' %}
    {% set cat_name = 'Strategy & Comparisons' %}
    {% set cat_icon = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>' %}
    {% set gradient_glow = 'from-amber-500 to-orange-500' %}
    {% set badge_classes = 'bg-amber-50 text-amber-700 border border-amber-100' %}
{% endif %}

<div class="doc-layout-grid relative">
    <aside class="doc-sidebar doc-sidebar-left pl-4 pr-6">
        <div class="sticky top-28 pt-4 pb-8">
            <div class="flex flex-col gap-8">
                <nav aria-label="Related Posts Navigation">
                    <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-3 px-3">
                        {{ cat_name }}
                    </h3>
                    <ul class="space-y-1 text-sm font-medium">
                        {% if all_posts is defined and all_posts is not empty %}
                            {% for post in all_posts %}
                                {% if post.category == cat_slug %}
                                    <li>
                                        <a href="{{ post.href }}" class="block px-3 py-1.5 {% if request.server('REQUEST_URI') == post.href %}text-emerald-700 bg-emerald-50 border-l-2 border-emerald-500{% else %}text-slate-600 hover:bg-slate-100 hover:text-slate-900 border-l-2 border-transparent{% endif %} transition-colors">
                                            {{ post.title }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <li><a href="/resource/growth/sip-for-beginners" class="block px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 border-l-2 border-transparent transition-colors">SIP for Beginners</a></li>
                            <li><a href="/resource/retirement/swp-retirement-planning" class="block px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 border-l-2 border-transparent transition-colors">SWP Retirement Planning</a></li>
                            <li><a href="/resource/comparison/mutual-fund-tax-2026" class="block px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 border-l-2 border-transparent transition-colors">Mutual Fund Tax 2026</a></li>
                        {% endif %}
                    </ul>
                </nav>

                <div aria-label="Social Sharing">
                    <h3 class="text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-3 px-3">Connect</h3>
                    <div class="flex items-center gap-4 px-3">
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ ('https://sipswpcalculator.com' ~ request.server('REQUEST_URI'))|url_encode }}" class="text-slate-400 hover:text-blue-600 transition-colors" title="Share on LinkedIn" target="_blank" rel="noopener">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
                            </svg>
                        </a>
                        <a href="https://twitter.com/intent/tweet?url={{ ('https://sipswpcalculator.com' ~ request.server('REQUEST_URI'))|url_encode }}" class="text-slate-400 hover:text-blue-400 transition-colors" title="Share on Twitter" target="_blank" rel="noopener">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <main class="doc-main-content px-6 lg:px-10 xl:px-12 py-8 pb-16">
        <div class="max-w-4xl mx-auto">
            <!-- Breadcrumbs -->
            <nav aria-label="Breadcrumb" class="mb-6">
                <ol role="list" class="flex items-center space-x-2 text-sm text-slate-500">
                    <li>
                        <div class="flex items-center">
                            <a href="/" class="hover:text-emerald-600 transition-colors">
                                <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z" clip-rule="evenodd" />
                                </svg>
                                <span class="sr-only">Home</span>
                            </a>
                        </div>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="h-4 w-4 flex-shrink-0 text-slate-300 mx-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                            <a href="/resources" class="hover:text-emerald-600 transition-colors">Resources</a>
                        </div>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="h-4 w-4 flex-shrink-0 text-slate-300 mx-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                            <span class="text-slate-700 font-medium truncate max-w-[200px] sm:max-w-xs" aria-current="page">{{ content_metadata.title|default(page_config.title) }}</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <!-- Article Body -->
            <article class="prose prose-slate max-w-none prose-headings:scroll-mt-28 category-{{ cat_accent }}">
                <header class="relative mb-12 p-8 sm:p-10 rounded-3xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
                    <!-- Decorative Category Glow -->
                    <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br {{ gradient_glow }} rounded-full blur-3xl opacity-[0.07] -mr-20 -mt-20 pointer-events-none"></div>
                    
                    <!-- Metadata Badges -->
                    <div class="relative z-10 flex flex-wrap items-center gap-2.5 mb-6">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider {{ badge_classes }}">
                            {{ cat_icon|raw }}
                            {{ cat_name }}
                        </span>
                        {% if post_metadata.tag is defined and post_metadata.tag is not empty %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 uppercase tracking-wider border border-slate-200/50">
                                {{ post_metadata.tag }}
                            </span>
                        {% endif %}
                    </div>

                    <!-- Title -->
                    <h1 class="relative z-10 text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 mb-4 leading-[1.15]">
                        {{ content_metadata.title|default(page_config.title) }}
                    </h1>

                    <!-- Subtitle -->
                    {% if content_metadata.subtitle is defined and content_metadata.subtitle is not empty %}
                        <p class="relative z-10 text-lg sm:text-xl text-slate-500 font-medium leading-relaxed mb-8 max-w-3xl">{{ content_metadata.subtitle }}</p>
                    {% endif %}

                    <!-- Author and Publish Details -->
                    <div class="relative z-10 flex flex-wrap items-center justify-between gap-6 pt-6 border-t border-slate-100">
                        <div class="flex items-center gap-3">
                            <img src="/assets/sumeet-boga-56.jpg" alt="Sumeet Boga"
                                class="w-10 h-10 rounded-full shadow-sm border border-slate-100 object-cover"
                                width="40" height="40">
                            <div>
                                <span class="block font-black text-slate-800 leading-tight">Sumeet Boga</span>
                                <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Engineer &amp; Finance Analyst</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-4 text-xs font-bold text-slate-400 uppercase tracking-widest">
                            <div class="flex flex-col gap-1">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    <span>Published: {{ date_published|default(post_metadata.date|default('March 2026'))|date("M j, Y") }}</span>
                                </div>
                                {% if date_modified and date_modified != date_published %}
                                <div class="flex items-center gap-1.5 text-[10px] text-slate-400">
                                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                    <span>Updated: {{ date_modified|date("M j, Y") }}</span>
                                </div>
                                {% endif %}
                            </div>
                            {% if post_metadata.read_time is defined and post_metadata.read_time is not empty %}
                            <div class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <span>{{ post_metadata.read_time }} read</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </header>

                <div class="entry-content">
                    {{ content_html|raw }}
                </div>

                <!-- Author Bio Card -->
                <footer class="mt-16 pt-8 border-t border-slate-200">
                    <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200/60 flex flex-col sm:flex-row items-start sm:items-center gap-6">
                        <img src="/assets/sumeet-boga-56.jpg" alt="Sumeet Boga" class="w-20 h-20 rounded-full border border-slate-200 object-cover" width="80" height="80" loading="lazy" decoding="async">
                        <div>
                            <h4 class="text-lg font-black text-slate-800 mb-1">About the Author: Sumeet Boga</h4>
                            <p class="text-sm text-slate-600 leading-relaxed">
                                Sumeet is a Software Engineer and Finance Analyst specializing in mutual fund analysis, retirement algorithms, and tax planning. He builds free, transparent tools to help Indian investors reach their wealth milestones.
                            </p>
                        </div>
                    </div>
                </footer>

                {# Related Resources & Calculator CTA — internal linking for SEO #}
                {% include 'components/related-resources.twig' with {
                    all_posts: all_posts,
                    seo_category: cat_slug
                } %}
            </article>
        </div>
    </main>
</div>
{% endblock %}
