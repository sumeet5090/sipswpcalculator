<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <title>{{ page_config.title|default('SIP & SWP Calculator') }}</title>
    <meta name="description" content="{{ page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.') }}">
    {% if page_config.keywords is defined %}
    <meta name="keywords" content="{{ page_config.keywords }}">
    {% endif %}
    
    {% set current_uri = request.server('REQUEST_URI', '/') %}
    {% set canonical_url = page_config.canonical|default(site_url ~ current_uri) %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="{{ page_config.robots|default('index, follow') }}">

    <meta name="author" content="{{ page_config.author|default('Sumeet Boga') }}">

    <link rel="alternate" hreflang="en-IN" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    <meta property="og:type" content="{{ page_config.og_type|default('website') }}">
    <meta property="og:site_name" content="SIP & SWP Calculator">
    <meta property="og:locale" content="en_IN">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta property="og:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta property="og:image" content="{{ page_config.og_image|default(site_url ~ '/assets/og-image-main.jpg') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="{{ page_config.twitter_creator|default('@sumeetboga') }}">
    <meta name="twitter:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta name="twitter:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta name="twitter:image" content="{{ page_config.og_image|default(site_url ~ '/assets/og-image-main.jpg') }}">

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="manifest" href="/manifest.json">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    </noscript>

    <!-- Speculation Rules: Instant Hover Prefetch for Calculators & Instant Home Navigation -->
    <script type="speculationrules">
    {
      "prefetch": [
        {
          "source": "list",
          "urls": ["/"],
          "eagerness": "eager"
        },
        {
          "source": "document",
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": "/admin/*" } },
              { "not": { "href_matches": "/api/*" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
    </script>

    {# ── Vite Asset Integration: HMR client (dev) & compiled CSS links (prod) ── #}
    {{ vite_client() }}
    {{ vite_css('resources/js/app.ts') }}

    {{ page_config.additional_head|default('')|raw }}

    {% if env == 'production' %}
        <!-- Sentry Error Monitoring -->
        <script src="https://js-de.sentry-cdn.com/475d8af2dda1d5fc4e23fd8923e5f908.min.js" crossorigin="anonymous" defer></script>

        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-C3P1ZCY6GR"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-C3P1ZCY6GR');
        </script>

        <!-- Ahrefs Webmaster Analytics -->
        <script src="https://analytics.ahrefs.com/analytics.js" data-key="V/q2C7ChUAUvu14EWk7USQ" async></script>

        <!-- Microsoft Clarity -->
        <script type="text/javascript">
            (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "y1ed7um9dp");
        </script>
    {% endif %}
    
    {% block head %}{% endblock %}
</head>
<body class="{{ page_config.body_class|default('bg-slate-50 text-slate-900 font-sans antialiased selection:bg-emerald-500/20 selection:text-emerald-900') }} overflow-x-hidden" style="{{ page_config.body_style|default('background-image: var(--gradient-surface); background-attachment: fixed;') }}">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:p-3 focus:bg-emerald-600 focus:text-white focus:rounded-lg focus:shadow-floating focus:z-popover font-bold transition-all">Skip to main content</a>
    <div id="calculator-a11y-live-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    
    {% include 'layouts/header.twig' %}
    
    <!-- Compact Mobile Floating Mini-HUD (Glides in when primary summary cards scroll off-screen on mobile) -->
    <div id="mobile-sticky-mini-hud" class="sm:hidden fixed top-16 left-0 right-0 z-header bg-white/95 backdrop-blur-md border-b border-emerald-200/80 px-4 py-2 flex items-center justify-between shadow-flat transform -translate-y-full opacity-0 pointer-events-none transition-all duration-300">
        <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-xs shrink-0">💎</span>
            <span class="text-caption font-bold text-slate-600 shrink-0">Corpus:</span>
            <span id="mini-hud-corpus" class="text-xs font-extrabold text-emerald-700 font-financial-mono tabular-nums whitespace-nowrap shrink-0">₹ --</span>
        </div>
        <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-caption font-bold text-slate-600 shrink-0">Gain:</span>
            <span id="mini-hud-gain" class="text-xs font-extrabold text-emerald-700 font-financial-mono tabular-nums whitespace-nowrap shrink-0">+₹ --</span>
        </div>
    </div>

    <!-- spacer to prevent content from being hidden behind fixed header -->
    <div class="h-16"></div>
    
    <main id="main-content" class="container mt-6 mx-auto px-4 sm:px-6 lg:px-8 {{ page_config.container_class|default('max-w-7xl') }}">
        {% block content %}{% endblock %}
    </main>

    <!-- Bottom spacer for mobile action dock occlusion prevention (F5.1) -->
    <div class="sm:hidden h-16"></div>

    {% include 'layouts/footer.twig' %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Enable :active pseudo-class on iOS Safari (F6.2)
            document.addEventListener('touchstart', function() {}, { passive: true });

            // Mobile Menu Toggle
            var btn = document.getElementById('mobile-menu-btn');
            var menu = document.getElementById('mobile-menu');
            var hamburger = document.getElementById('hamburger-icon');
            var closeIcon = document.getElementById('close-icon');
            if (btn && menu) {
                btn.addEventListener('click', function () {
                    var isOpen = !menu.classList.contains('hidden');
                    menu.classList.toggle('hidden');
                    hamburger.classList.toggle('hidden');
                    closeIcon.classList.toggle('hidden');
                    btn.setAttribute('aria-expanded', !isOpen);
                });
            }

            // Mobile Soft-Keyboard Occlusion Defense for Action Dock & Keyboard Preview (F3.1, F3.4)
            if (window.visualViewport) {
                var dock = document.getElementById('mobile-action-dock');
                var preview = document.getElementById('keyboard-docked-preview');
                var keyboardTimer = null;
                window.visualViewport.addEventListener('resize', function () {
                    if (keyboardTimer) clearTimeout(keyboardTimer);
                    keyboardTimer = setTimeout(function () {
                        var keyboardHeight = window.innerHeight - window.visualViewport.height;
                        var isKeyboardOpen = keyboardHeight > 150;
                        if (dock) {
                            dock.style.display = isKeyboardOpen ? 'none' : 'flex';
                        }
                        if (preview) {
                            if (isKeyboardOpen) {
                                preview.classList.remove('hidden');
                                preview.style.bottom = keyboardHeight + 8 + 'px';
                                requestAnimationFrame(function() {
                                    preview.classList.remove('opacity-0', 'pointer-events-none');
                                });
                            } else {
                                preview.classList.add('opacity-0', 'pointer-events-none');
                                setTimeout(function() {
                                    preview.classList.add('hidden');
                                }, 200);
                            }
                        }
                    }, 80);
                });
            }
        });
    </script>
    <script type="module" src="{{ vite_asset('resources/js/app.ts') }}"></script>
    
    {% if page_config.scripts is defined %}
        {% for script in page_config.scripts %}
            <script src="{{ script }}" defer></script>
        {% endfor %}
    {% endif %}
    
    <!-- Keyboard-Aware Floating Micro-Preview Capsule (Glides above virtual keyboard during text typing on mobile) -->
    <div id="keyboard-docked-preview" class="hidden opacity-0 pointer-events-none fixed z-modal left-4 right-4 bg-white/95 text-slate-900 border border-emerald-300 shadow-modal rounded-2xl px-4 py-2.5 flex items-center justify-between transition-all duration-200 backdrop-blur-md">
        <div class="flex items-center gap-2">
            <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs font-semibold text-slate-700">Live Projected Corpus:</span>
        </div>
        <span id="keyboard-preview-corpus" class="text-sm font-extrabold text-emerald-700 font-mono">₹ --</span>
    </div>

    <!-- Ergonomic Mobile Sticky Action Dock (Visible only on <sm viewports) -->
    <div id="mobile-action-dock" class="sm:hidden fixed bottom-0 left-0 right-0 z-header bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] px-4 py-2 flex items-center justify-around gap-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]">
        <button type="button" id="dock-pdf-btn" onclick="document.getElementById('openPdfModalBtn')?.click()"
            class="flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 text-caption font-bold active:scale-95 transition-all cursor-pointer">
            <span class="text-xs">📄</span>
            <span>PDF Plan</span>
        </button>
        <button type="button" class="whatsapp-share-btn flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-800 text-caption font-bold active:scale-95 transition-all cursor-pointer"
            aria-label="Share plan directly on WhatsApp">
            <span class="text-xs">💬</span>
            <span>WhatsApp</span>
        </button>
        <button type="button" id="dock-share-btn" onclick="document.getElementById('shareCalcBtn')?.click()"
            class="flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 text-caption font-bold active:scale-95 transition-all cursor-pointer">
            <span class="text-xs">🔗</span>
            <span>Link</span>
        </button>
        <button type="button" id="dock-snapshot-btn" onclick="document.getElementById('snapshot-scenario-btn')?.click()"
            class="flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 text-caption font-bold active:scale-95 transition-all cursor-pointer">
            <span class="text-xs">📸</span>
            <span>Snapshot</span>
        </button>
        <button type="button" id="dock-tax-btn" onclick="document.getElementById('open-tax-waterfall-btn')?.click()"
            class="flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-violet-50 hover:bg-violet-100 border border-violet-200 text-violet-800 text-caption font-bold active:scale-95 transition-all cursor-pointer">
            <span class="text-xs">⚖️</span>
            <span>Tax</span>
        </button>
    </div>

    <!-- Floating Scroll-to-Top FAB (replaces dock slot, appears after scroll) -->
    <button type="button" id="mobile-scroll-top-fab"
        class="sm:hidden fixed bottom-20 right-4 z-sticky w-10 h-10 rounded-full bg-white/95 backdrop-blur-md border border-slate-200/90 shadow-card text-slate-600 text-sm font-bold flex items-center justify-center active:scale-90 transition-all cursor-pointer opacity-0 pointer-events-none"
        onclick="document.getElementById('calculator-section')?.scrollIntoView({behavior: 'smooth'})"
        aria-label="Scroll to calculator inputs">
        ↑
    </button>
    <script>
        // Show FAB after 300px scroll, hide near top
        (function() {
            var fab = document.getElementById('mobile-scroll-top-fab');
            if (!fab) return;
            var lastScroll = 0;
            window.addEventListener('scroll', function() {
                var st = window.scrollY;
                if (st > 300) {
                    fab.style.opacity = '1';
                    fab.style.pointerEvents = 'auto';
                } else {
                    fab.style.opacity = '0';
                    fab.style.pointerEvents = 'none';
                }
                lastScroll = st;
            }, { passive: true });
        })();
    </script>

    {% include 'components/command-palette.twig' %}
    {% include 'components/tax-waterfall-modal.twig' %}
    {% include 'components/goal-commitment-modal.twig' %}
    {% include 'components/qr-share-modal.twig' %}
    {% include 'components/sebibenchmark-modal.twig' %}
    {% block modals %}{% endblock %}
    {% block scripts %}{% endblock %}
</body>
</html>
