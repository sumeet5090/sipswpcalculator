<!DOCTYPE html>
<html lang="en-IN" class="overflow-x-clip max-w-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <title>{{ page_config.title|default('SIP & SWP Calculator') }}</title>
    <meta name="description" content="{{ page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.') }}">
    {% if page_config.keywords is defined %}
    <meta name="keywords" content="{{ page_config.keywords }}">
    {% endif %}
    
    {% set current_uri = request.getUri() %}
    {% set canonical_url = page_config.canonical|default(site_url ~ current_uri) %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="{{ page_config.robots|default('index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1') }}">

    <meta name="author" content="{{ page_config.author|default('Sumeet Boga') }}">

    <link rel="alternate" hreflang="en-IN" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    <meta property="og:type" content="{{ page_config.og_type|default('website') }}">
    <meta property="og:site_name" content="SIP & SWP Calculator">
    <meta property="og:locale" content="en_IN">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta property="og:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta property="og:image" content="{{ page_config.og_image|default(site_url ~ '/assets/og-image-main.jpg') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="{{ page_config.twitter_creator|default('@sumeetboga') }}">
    <meta name="twitter:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta name="twitter:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta name="twitter:image" content="{{ page_config.og_image|default(site_url ~ '/assets/og-image-main.jpg') }}">

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="manifest" href="/manifest.json">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    </noscript>

    <!-- Speculation Rules: Instant Hover Prefetch for Calculators & Instant Home Navigation -->
    <script type="speculationrules">
    {
      "prefetch": [
        {
          "source": "list",
          "urls": ["/"],
          "eagerness": "eager"
        },
        {
          "source": "document",
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": "/admin/*" } },
              { "not": { "href_matches": "/api/*" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
    </script>

    {# ── Vite Asset Integration: HMR client (dev) & compiled CSS links (prod) ── #}
    {{ vite_client() }}
    {{ vite_css('resources/js/app.ts') }}

    {{ page_config.additional_head|default('')|raw }}

    {% if env == 'production' %}
        <!-- Sentry Error Monitoring -->
        <script src="https://js-de.sentry-cdn.com/475d8af2dda1d5fc4e23fd8923e5f908.min.js" crossorigin="anonymous" defer></script>

        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-C3P1ZCY6GR"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-C3P1ZCY6GR');
        </script>

        <!-- Deferred Analytics (Ahrefs & Microsoft Clarity via requestIdleCallback to protect FCP & TBT) -->
        <script>
            (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            })(window, document, "clarity");

            function loadDeferredAnalytics() {
                var clarityScript = document.createElement("script");
                clarityScript.async = true;
                clarityScript.src = "https://www.clarity.ms/tag/y1ed7um9dp";
                document.head.appendChild(clarityScript);

                var ahrefsScript = document.createElement("script");
                ahrefsScript.async = true;
                ahrefsScript.src = "https://analytics.ahrefs.com/analytics.js";
                ahrefsScript.setAttribute("data-key", "V/q2C7ChUAUvu14EWk7USQ");
                document.head.appendChild(ahrefsScript);
            }

            if ('requestIdleCallback' in window) {
                window.requestIdleCallback(loadDeferredAnalytics, { timeout: 3000 });
            } else {
                window.addEventListener('load', function() {
                    setTimeout(loadDeferredAnalytics, 2000);
                });
            }
        </script>
    {% endif %}
    
    {% block head %}{% endblock %}
</head>
<body class="{{ page_config.body_class|default('bg-slate-50 text-slate-900 font-sans antialiased selection:bg-emerald-500/20 selection:text-emerald-900') }} overflow-x-clip max-w-full relative" style="{{ page_config.body_style|default('background-image: var(--gradient-surface); background-attachment: fixed;') }}">
    {% set is_calculator_route = is_calculator|default(false) or (active_page|default('') in ['home', 'sip-calculator', 'swp-calculator', 'sip-step-up-calculator', 'lumpsum-calculator', 'retirement-calculator', 'my-first-crore-calculator', 'target-corpus-calculator', 'compound-interest-calculator', 'cagr-calculator', 'emi-calculator', 'inflation-calculator', 'ppf-calculator', 'fd-calculator']) %}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:p-3 focus:bg-emerald-600 focus:text-white focus:rounded-lg focus:shadow-floating focus:z-popover font-bold transition-all">Skip to main content</a>
    <div id="calculator-a11y-live-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    
    {% include 'layouts/header.twig' %}
    
    {% if is_calculator_route %}
    <!-- Compact Mobile Floating Mini-HUD (Glides in when primary summary cards scroll off-screen on mobile) -->
    <div id="mobile-sticky-mini-hud" class="sm:hidden fixed top-16 left-0 right-0 z-header bg-white/95 backdrop-blur-md border-b border-emerald-200/80 px-4 py-2 flex items-center justify-between shadow-flat transform -translate-y-full opacity-0 pointer-events-none transition-all duration-300">
        <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-xs shrink-0">💎</span>
            <span class="text-caption font-bold text-slate-600 shrink-0">Corpus:</span>
            <span id="mini-hud-corpus" class="text-xs font-extrabold text-emerald-700 font-financial-mono tabular-nums whitespace-nowrap shrink-0">₹ --</span>
        </div>
        <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-caption font-bold text-slate-600 shrink-0">Gain:</span>
            <span id="mini-hud-gain" class="text-xs font-extrabold text-emerald-700 font-financial-mono tabular-nums whitespace-nowrap shrink-0">+₹ --</span>
        </div>
    </div>
    {% endif %}

    <!-- spacer to prevent content from being hidden behind fixed header -->
    <div class="h-16"></div>
    
    <main id="main-content" class="container mt-6 mx-auto px-4 sm:px-6 lg:px-8 {{ page_config.container_class|default('max-w-7xl') }}">
        {% block content %}{% endblock %}
    </main>

    {% include 'layouts/footer.twig' %}

    {% if is_calculator_route %}
    <!-- Bottom spacer for mobile action dock occlusion prevention (F5.1) -->
    <div class="sm:hidden h-20" aria-hidden="true"></div>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Enable :active pseudo-class on iOS Safari (F6.2)
            document.addEventListener('touchstart', function() {}, { passive: true });

            // Mobile Menu Toggle
            var btn = document.getElementById('mobile-menu-btn');
            var menu = document.getElementById('mobile-menu');
            var hamburger = document.getElementById('hamburger-icon');
            var closeIcon = document.getElementById('close-icon');
            if (btn && menu) {
                btn.addEventListener('click', function () {
                    var isOpen = !menu.classList.contains('hidden');
                    menu.classList.toggle('hidden');
                    hamburger.classList.toggle('hidden');
                    closeIcon.classList.toggle('hidden');
                    btn.setAttribute('aria-expanded', !isOpen);
                });
            }
        });
    </script>
    <script type="module" src="{{ vite_asset('resources/js/app.ts') }}"></script>
    
    {% if page_config.scripts is defined %}
        {% for script in page_config.scripts %}
            <script src="{{ script }}" defer></script>
        {% endfor %}
    {% endif %}
    
    {% if is_calculator_route %}
    <!-- Keyboard-Aware Floating Micro-Preview Capsule (Glides above virtual keyboard during text typing on mobile) -->
    <div id="keyboard-docked-preview" class="hidden opacity-0 pointer-events-none fixed z-modal left-2.5 right-2.5 sm:left-4 sm:right-4 bg-white/98 text-slate-900 border border-emerald-300 shadow-modal rounded-2xl px-3 sm:px-4 py-2 flex items-center justify-between transition-all duration-200 backdrop-blur-xl">
        <div class="flex items-center gap-1.5 min-w-0">
            <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
            <span class="text-micro font-bold text-slate-500 uppercase shrink-0">Live Corpus:</span>
            <span id="keyboard-preview-corpus" class="text-ui-xs sm:text-ui-sm font-black text-emerald-800 font-financial-mono tabular-nums whitespace-nowrap truncate">₹ --</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0 ml-2">
            <button type="button" id="keyboard-prev-input" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-ui-xs flex items-center justify-center active:scale-95 transition-all cursor-pointer border border-slate-200/80" aria-label="Previous Field">↑</button>
            <button type="button" id="keyboard-next-input" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-ui-xs flex items-center justify-center active:scale-95 transition-all cursor-pointer border border-slate-200/80" aria-label="Next Field">↓</button>
            <button type="button" id="keyboard-done-btn" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-ui-xs shadow-flat active:scale-95 transition-all cursor-pointer">Done</button>
        </div>
    </div>

    <!-- Ergonomic Mobile Sticky Action Dock (Visible only on <sm viewports on calculator pages) -->
    <div id="mobile-action-dock" class="sm:hidden fixed bottom-0 left-0 right-0 z-header bg-white/95 backdrop-blur-xl border-t border-slate-200/90 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] px-3 py-2 flex flex-col gap-1.5 pb-[max(0.6rem,env(safe-area-inset-bottom))] transition-all duration-200">
        <!-- Live Financial Outcome & Strategy Bar -->
        <div class="flex items-center justify-between px-2.5 py-1 bg-slate-50/90 rounded-xl border border-slate-200/70 text-ui-xs">
            <div class="flex items-center gap-1.5 min-w-0">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
                <span class="text-micro font-bold text-slate-500 uppercase shrink-0">Corpus:</span>
                <span id="dock-glance-corpus" class="text-ui-xs font-black text-emerald-800 font-financial-mono tabular-nums whitespace-nowrap truncate">₹ --</span>
                <span id="mobile-deck-corpus-val" class="hidden">₹ --</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
                <button type="button" onclick="document.getElementById('summary-cards-grid')?.scrollIntoView({ behavior: 'smooth', block: 'center' })" class="text-micro font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-0.5 cursor-pointer bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/60">
                    <span>Summary ↑</span>
                </button>
                <div class="flex items-center gap-0.5">
                    <button type="button" id="mobile-deck-sip-btn" class="px-2 py-0.5 rounded-md text-micro font-extrabold bg-emerald-600 text-white shadow-flat cursor-pointer transition-all">SIP</button>
                    <button type="button" id="mobile-deck-swp-btn" class="px-2 py-0.5 rounded-md text-micro font-bold bg-slate-200/80 text-slate-600 hover:text-slate-900 cursor-pointer transition-all">SWP</button>
                </div>
            </div>
        </div>

        <!-- High-Conversion Action Pod: 3-Zone Architecture (Apple HIG 44px minimum) -->
        <div class="flex items-center gap-2">
            <!-- 1. Hero Action: Institutional PDF Plan -->
            <button type="button" id="dock-pdf-btn" onclick="document.getElementById('openPdfModalBtn')?.click()"
                class="flex-[2] min-h-[44px] py-2 px-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white text-ui-xs font-extrabold active:scale-95 transition-all shadow-card flex items-center justify-center gap-1.5 cursor-pointer">
                <span class="text-sm">📄</span>
                <span>PDF Plan</span>
            </button>
            <!-- 2. Viral Indian FinTech Conversion: WhatsApp Proposal -->
            <button type="button" id="mobile-deck-share-btn" class="whatsapp-share-btn flex-[1.4] min-h-[44px] py-2 px-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-800 text-ui-xs font-extrabold active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                aria-label="Share plan directly on WhatsApp">
                <span class="text-sm">💬</span>
                <span>WhatsApp</span>
            </button>
            <!-- 3. Secondary Hub Trigger: Native Bottom Sheet Drawer -->
            <button type="button" id="mobile-more-actions-btn" onclick="document.getElementById('mobile-actions-sheet')?.showModal()"
                class="w-11 min-h-[44px] rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-200/90 text-slate-700 font-extrabold text-ui-xs active:scale-95 transition-all flex items-center justify-center cursor-pointer"
                aria-label="More Options">
                <span>•••</span>
            </button>
        </div>
    </div>

    <!-- Mobile Secondary Action Drawer (Native Bottom Sheet) -->
    <dialog id="mobile-actions-sheet" class="rounded-3xl border border-slate-200 bg-white/98 text-slate-800 p-0 overflow-hidden shadow-modal max-w-sm w-full">
        <div class="p-4 space-y-3">
            <div class="w-10 h-1 bg-slate-300 rounded-full mx-auto mb-1"></div>
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                <span class="text-ui-xs font-extrabold text-slate-900 flex items-center gap-1.5">
                    <span>⚡</span><span>Quick Financial Actions</span>
                </span>
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close()" class="text-slate-400 hover:text-slate-700 p-1 text-ui-xs cursor-pointer" aria-label="Close">✕</button>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <!-- CSV Export -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('downloadCsvBtn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">📊</span>
                    <span>Export CSV</span>
                </button>
                <!-- Save Plan -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('saveCalculationBtn')?.click()"
                    class="p-2.5 rounded-xl bg-amber-50/70 hover:bg-amber-100/70 border border-amber-200 text-amber-900 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">💾</span>
                    <span>Save Plan</span>
                </button>
                <!-- Social Card -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('downloadSocialCardBtn')?.click()"
                    class="p-2.5 rounded-xl bg-teal-50/70 hover:bg-teal-100/70 border border-teal-200 text-teal-900 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">🖼️</span>
                    <span>Share Card</span>
                </button>
                <!-- Copy Link -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('shareCalcBtn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">🔗</span>
                    <span>Copy Link</span>
                </button>
                <!-- Snapshot Scenario -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('snapshot-scenario-btn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">📸</span>
                    <span>Snapshot</span>
                </button>
                <!-- §112A Tax Waterfall -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('open-tax-waterfall-btn')?.click()"
                    class="p-2.5 rounded-xl bg-violet-50 hover:bg-violet-100 border border-violet-200 text-violet-900 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">⚖️</span>
                    <span>§112A Tax</span>
                </button>
                <!-- Embed Calculator -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('open-embed-modal-btn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">💻</span>
                    <span>Embed</span>
                </button>
                <!-- AMFI Regulatory Rules -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('sebiBenchmarkModal')?.showModal()"
                    class="p-2.5 rounded-xl bg-emerald-50/70 hover:bg-emerald-100/70 border border-emerald-200 text-emerald-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <span class="text-ui-sm">📜</span>
                    <span>AMFI Rules</span>
                </button>
            </div>
        </div>
    </dialog>
    {% endif %}

    <!-- Floating Scroll-to-Top FAB (appears on scroll up to prevent text occlusion) -->
    <button type="button" id="mobile-scroll-top-fab"
        class="sm:hidden fixed {% if is_calculator_route %}bottom-20{% else %}bottom-8{% endif %} right-3.5 z-sticky w-9 h-9 rounded-full bg-white/95 backdrop-blur-md border border-slate-200/90 shadow-card text-slate-600 text-xs font-black flex items-center justify-center active:scale-90 transition-all duration-300 cursor-pointer opacity-0 pointer-events-none translate-y-2"
        onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
        aria-label="Scroll to top">
        ↑
    </button>
    <script>
        // Direction-aware FAB: shows on upward scroll or deep in page to never occlude reading content
        (function() {
            var fab = document.getElementById('mobile-scroll-top-fab');
            if (!fab) return;
            var lastScroll = 0;
            var ticking = false;
            window.addEventListener('scroll', function() {
                if (!ticking) {
                    window.requestAnimationFrame(function() {
                        var st = window.scrollY;
                        var isScrollingUp = st < lastScroll - 5;
                        var isDeepInPage = st > 1200;
                        if (st > 350 && (isScrollingUp || isDeepInPage)) {
                            fab.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
                            fab.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
                        } else {
                            fab.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
                            fab.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
                        }
                        lastScroll = st;
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        })();
    </script>

    {% include 'components/command-palette.twig' %}
    {% include 'components/tax-waterfall-modal.twig' %}
    {% include 'components/goal-commitment-modal.twig' %}
    {% include 'components/qr-share-modal.twig' %}
    {% include 'components/sebibenchmark-modal.twig' %}
    <script>
        if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/sw.js').catch(function(err) {
                    console.debug('SW registration skipped:', err);
                });
            });
        }
    </script>
    {% block modals %}{% endblock %}
    {% block scripts %}{% endblock %}
</body>
</html>
