<!DOCTYPE html>
<html lang="en-IN" class="overflow-x-clip max-w-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <title>{{ page_config.title|default('SIP & SWP Calculator') }}</title>
    <meta name="description" content="{{ page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.') }}">
    {% if page_config.keywords is defined %}
    <meta name="keywords" content="{{ page_config.keywords }}">
    {% endif %}
    
    {% set current_uri = request.getUri() %}
    {% set canonical_url = page_config.canonical|default(site_url ~ current_uri) %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="{{ page_config.robots|default('index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1') }}">

    <meta name="author" content="{{ page_config.author|default('Sumeet Boga') }}">

    <link rel="alternate" hreflang="en-IN" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    <meta property="og:type" content="{{ page_config.og_type|default('website') }}">
    <meta property="og:site_name" content="SIP & SWP Calculator">
    <meta property="og:locale" content="en_IN">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta property="og:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta property="og:image" content="{{ page_config.og_image|default(site_url ~ '/assets/og-image-main.jpg') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="{{ page_config.twitter_creator|default('@sumeetboga') }}">
    <meta name="twitter:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta name="twitter:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta name="twitter:image" content="{{ page_config.og_image|default(site_url ~ '/assets/og-image-main.jpg') }}">

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="manifest" href="/manifest.json">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    </noscript>

    <!-- Speculation Rules: Instant Hover Prefetch for Calculators & Instant Home Navigation -->
    <script type="speculationrules">
    {
      "prefetch": [
        {
          "source": "list",
          "urls": ["/"],
          "eagerness": "eager"
        },
        {
          "source": "document",
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": "/admin/*" } },
              { "not": { "href_matches": "/api/*" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
    </script>

    {# ── Vite Asset Integration: HMR client (dev) & compiled CSS links (prod) ── #}
    {{ vite_client() }}
    {{ vite_css('resources/js/app.ts') }}

    {{ page_config.additional_head|default('')|raw }}

    <script>
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };
        window.__IS_PROD_HOST__ = (window.location.hostname === 'sipswpcalculator.com' || window.location.hostname === 'www.sipswpcalculator.com');
    </script>
    {% if env == 'production' %}
        <!-- Production-Only Telemetry & Error Monitoring (Gated by canonical hostname allowlist) -->
        <script>
            if (window.__IS_PROD_HOST__) {
                var sentryScript = document.createElement("script");
                sentryScript.src = "https://js-de.sentry-cdn.com/475d8af2dda1d5fc4e23fd8923e5f908.min.js";
                sentryScript.crossOrigin = "anonymous";
                sentryScript.defer = true;
                document.head.appendChild(sentryScript);

                var gtagScript = document.createElement("script");
                gtagScript.async = true;
                gtagScript.src = "https://www.googletagmanager.com/gtag/js?id=G-C3P1ZCY6GR";
                document.head.appendChild(gtagScript);

                gtag('js', new Date());
                gtag('config', 'G-C3P1ZCY6GR');

                (function(c,l,a,r,i,t,y){
                    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                })(window, document, "clarity");

                function loadDeferredAnalytics() {
                    var clarityScript = document.createElement("script");
                    clarityScript.async = true;
                    clarityScript.src = "https://www.clarity.ms/tag/y1ed7um9dp";
                    document.head.appendChild(clarityScript);

                    var ahrefsScript = document.createElement("script");
                    ahrefsScript.async = true;
                    ahrefsScript.src = "https://analytics.ahrefs.com/analytics.js";
                    ahrefsScript.setAttribute("data-key", "V/q2C7ChUAUvu14EWk7USQ");
                    document.head.appendChild(ahrefsScript);
                }

                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(loadDeferredAnalytics, { timeout: 3000 });
                } else {
                    window.addEventListener('load', function() {
                        setTimeout(loadDeferredAnalytics, 2000);
                    });
                }
            }
        </script>
    {% endif %}
    
    {% block head %}{% endblock %}
</head>
<body class="{{ page_config.body_class|default('bg-slate-50 text-slate-900 font-sans antialiased selection:bg-emerald-500/20 selection:text-emerald-900') }} overflow-x-clip max-w-full relative" style="{{ page_config.body_style|default('background-image: var(--gradient-surface);') }}">
    {% set is_calculator_route = is_calculator|default(false) or is_calculator_route(active_page|default('')) %}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:p-3 focus:bg-emerald-600 focus:text-white focus:rounded-lg focus:shadow-floating focus:z-popover font-bold transition-all">Skip to main content</a>
    <div id="calculator-a11y-live-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    
    {% include 'layouts/header.twig' %}
    
    {% if is_calculator_route %}
    <!-- Compact Tablet/Desktop Floating Mini-HUD Capsule (Glides in when primary summary cards scroll off-screen on >= md viewports) -->
    <div id="mini-hud-anchor" class="hidden md:flex fixed top-20 inset-x-0 justify-center z-header pointer-events-none">
        <div id="mobile-sticky-mini-hud" class="pointer-events-auto bg-white/98 border border-slate-200/90 shadow-floating hover:shadow-card-hover rounded-full px-4 sm:px-5 py-2 flex items-center gap-3 sm:gap-4 divide-x divide-slate-200/80 transform -translate-y-4 opacity-0 pointer-events-none transition-all duration-300 ease-out">
            <!-- Live Signal Pulse -->
            <div class="flex items-center gap-1.5 shrink-0 pr-1">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                </span>
                <span class="text-micro font-black uppercase text-slate-500 tracking-wider">Live</span>
            </div>

            <!-- Corpus Metric -->
            <div class="flex items-center gap-2 pl-3 sm:pl-4 min-w-0">
                <span class="text-caption font-bold text-slate-500 shrink-0">Corpus</span>
                <span id="mini-hud-corpus" class="text-xs sm:text-sm font-black text-emerald-700 font-financial-mono tabular-nums whitespace-nowrap shrink-0">{{ initial_kpis and initial_kpis.corpus_compact ? initial_kpis.corpus_compact : '₹ --' }}</span>
            </div>

            <!-- Gains / Returns Metric -->
            <div class="flex items-center gap-2 pl-3 sm:pl-4 min-w-0">
                <span class="text-caption font-bold text-slate-500 shrink-0">Gains</span>
                <span id="mini-hud-gain" class="text-xs sm:text-sm font-extrabold text-teal-700 font-financial-mono tabular-nums whitespace-nowrap shrink-0">{{ initial_kpis and initial_kpis.maturity_compact ? '+' ~ initial_kpis.maturity_compact : '+₹ --' }}</span>
            </div>

            <!-- Invested Metric (lg screens) -->
            <div class="hidden lg:flex items-center gap-2 pl-3 sm:pl-4 min-w-0">
                <span class="text-caption font-bold text-slate-500 shrink-0">Invested</span>
                <span id="mini-hud-invested" class="text-xs sm:text-sm font-bold text-slate-700 font-financial-mono tabular-nums whitespace-nowrap shrink-0">{{ initial_kpis and initial_kpis.invested_compact ? initial_kpis.invested_compact : '₹ --' }}</span>
            </div>

            <!-- Quick Jump to Calculator Form -->
            <div class="pl-2.5 sm:pl-3 shrink-0">
                <a href="#calculator-section" class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-500 hover:text-emerald-700 transition-colors" title="Jump to Calculator Inputs" aria-label="Jump to Calculator Inputs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
                </a>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- spacer to prevent content from being hidden behind fixed header -->
    <div class="h-16"></div>
    
    <main id="main-content" class="container mt-6 mx-auto px-4 sm:px-6 lg:px-8 {{ page_config.container_class|default('max-w-7xl') }}">
        {% block content %}{% endblock %}
    </main>

    {% include 'layouts/footer.twig' %}

    {% if is_calculator_route %}
    <!-- Bottom spacer for mobile action dock occlusion prevention (F5.1) -->
    <div class="md:hidden h-36" aria-hidden="true"></div>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Enable :active pseudo-class on iOS Safari (F6.2)
            document.addEventListener('touchstart', function() {}, { passive: true });

            // Mobile Menu Toggle
            var btn = document.getElementById('mobile-menu-btn');
            var menu = document.getElementById('mobile-menu');
            var hamburger = document.getElementById('hamburger-icon');
            var closeIcon = document.getElementById('close-icon');
            if (btn && menu) {
                btn.addEventListener('click', function () {
                    var isOpen = !menu.classList.contains('hidden');
                    menu.classList.toggle('hidden');
                    hamburger.classList.toggle('hidden');
                    closeIcon.classList.toggle('hidden');
                    btn.setAttribute('aria-expanded', !isOpen);
                });
            }
        });
    </script>
    <script type="module" src="{{ vite_asset('resources/js/app.ts') }}"></script>
    
    {% if page_config.scripts is defined %}
        {% for script in page_config.scripts %}
            <script src="{{ script }}" defer></script>
        {% endfor %}
    {% endif %}
    
    {% if is_calculator_route %}
    <!-- Keyboard-Aware Floating Micro-Preview Capsule (Glides above virtual keyboard during text typing on mobile) -->
    <div id="keyboard-docked-preview" class="hidden opacity-0 pointer-events-none fixed z-modal left-2.5 right-2.5 sm:left-4 sm:right-4 bg-white text-slate-900 border border-emerald-300 shadow-modal rounded-2xl px-3 sm:px-4 py-2 flex items-center justify-between transition-all duration-200">
        <div class="flex items-center gap-1.5 min-w-0">
            <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
            <span class="text-micro font-bold text-slate-500 uppercase shrink-0">Live Corpus:</span>
            <span id="keyboard-preview-corpus" class="text-ui-xs sm:text-ui-sm font-black text-emerald-800 font-financial-mono tabular-nums whitespace-nowrap truncate">{{ initial_kpis and initial_kpis.corpus_compact ? initial_kpis.corpus_compact : '₹ --' }}</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0 ml-2">
            <button type="button" id="keyboard-prev-input" class="touch-target-expanded w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-ui-xs flex items-center justify-center active:scale-95 transition-all cursor-pointer border border-slate-200/80" aria-label="Previous Field">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" id="keyboard-next-input" class="touch-target-expanded w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-ui-xs flex items-center justify-center active:scale-95 transition-all cursor-pointer border border-slate-200/80" aria-label="Next Field">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
            <button type="button" id="keyboard-done-btn" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-ui-xs shadow-flat active:scale-95 transition-all cursor-pointer">Done</button>
        </div>
    </div>

    <!-- Ergonomic Mobile Sticky Action Dock (Visible only on <md viewports on calculator pages) -->
    <div id="mobile-action-dock" class="md:hidden fixed bottom-0 left-0 right-0 z-dock bg-white/95 backdrop-blur-md text-slate-900 border-t border-slate-200/90 shadow-floating px-3 py-2 flex items-center justify-between gap-2 pb-[max(0.625rem,env(safe-area-inset-bottom))] transition-all duration-300">
        <!-- Left: Net Financial Outcome Glance (Corpus + Gains Badge) -->
        <div class="flex items-center gap-2 min-w-0 flex-1">
            <div class="flex flex-col justify-center min-w-0">
                <span class="text-micro font-extrabold text-slate-500 uppercase tracking-tight flex items-center gap-1">
                    <span>Corpus</span>
                    <span id="dock-glance-gains" class="text-micro font-extrabold text-growth-emphasis bg-growth-surface border border-growth-border px-1.5 py-0.2 rounded font-financial-mono">{{ initial_kpis and initial_kpis.maturity_compact ? '+' ~ initial_kpis.maturity_compact : '+₹ --' }}</span>
                </span>
                <span id="dock-glance-corpus" class="text-ui-base font-black text-slate-900 font-financial-mono tabular-nums truncate leading-tight">{{ initial_kpis and initial_kpis.corpus_compact ? initial_kpis.corpus_compact : '₹ --' }}</span>
            </div>
            <!-- Hidden telemetry nodes to satisfy DOM and controller contracts -->
            <div class="hidden" aria-hidden="true">
                <span id="dock-glance-invested">{{ initial_kpis and initial_kpis.invested_compact ? initial_kpis.invested_compact : '₹ --' }}</span>
                <span id="dock-glance-cashflow-label">Cashflow</span>
                <span id="dock-glance-cashflow">{{ initial_kpis and initial_kpis.withdrawn_compact ? initial_kpis.withdrawn_compact : '₹ --' }}</span>
                <span id="mobile-deck-corpus-val">{{ initial_kpis and initial_kpis.corpus_compact ? initial_kpis.corpus_compact : '₹ --' }}</span>
                <button type="button" id="mobile-deck-sip-btn"></button>
                <button type="button" id="mobile-deck-swp-btn"></button>
            </div>
        </div>

        <!-- Right: Action Pod (View Chart Jump + PDF Trigger + More Options Sheet) -->
        <div class="flex items-center gap-1.5 shrink-0">
            <!-- 1. Jump to Chart Action -->
            <a href="#chart-visualization"
                class="min-h-[40px] py-1.5 px-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-200/90 text-slate-700 hover:text-slate-900 text-ui-xs font-bold active:scale-95 transition-all shadow-flat flex items-center justify-center gap-1 cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
                <span>Chart</span>
            </a>

            <!-- 2. Hero Action: PDF Report -->
            <button type="button" id="dock-pdf-btn" onclick="document.getElementById('openPdfModalBtn')?.click()"
                class="min-h-[40px] py-1.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-ui-xs font-extrabold active:scale-95 transition-all shadow-card flex items-center justify-center gap-1 cursor-pointer">
                <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>PDF</span>
            </button>

            <!-- 3. WhatsApp proposal trigger -->
            <button type="button" id="mobile-deck-share-btn" class="whatsapp-share-btn min-h-[40px] px-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-800 text-ui-xs font-extrabold active:scale-95 transition-all flex items-center justify-center cursor-pointer"
                aria-label="Share plan directly on WhatsApp">
                <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                </svg>
            </button>

            <!-- 4. Secondary Hub Trigger: Native Bottom Sheet Drawer -->
            <button type="button" id="mobile-more-actions-btn" onclick="document.getElementById('mobile-actions-sheet')?.showModal()"
                class="w-9 min-h-[40px] rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-200/90 text-slate-700 hover:text-slate-900 font-extrabold text-ui-xs active:scale-95 transition-all flex items-center justify-center cursor-pointer"
                aria-label="More Options">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Secondary Action Drawer (Native Bottom Sheet) -->
    <dialog id="mobile-actions-sheet" class="rounded-3xl border border-slate-200 bg-white/98 text-slate-800 p-0 overflow-hidden shadow-modal max-w-sm w-full">
        <div class="p-4 space-y-3">
            <div class="modal-drag-handle cursor-grab active:cursor-grabbing select-none pt-1 pb-2">
                <div class="w-10 h-1 bg-slate-300 rounded-full mx-auto mb-2"></div>
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <span class="text-ui-xs font-extrabold text-slate-900 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                        <span>Quick Financial Actions</span>
                    </span>
                    <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close()" class="text-slate-400 hover:text-slate-700 p-1 text-ui-xs cursor-pointer" aria-label="Close">✕</button>
                </div>
            </div>

            <!-- In-Page Section Anchors -->
            <div class="border-b border-slate-100 pb-2.5">
                <span class="text-caption font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Jump to Section</span>
                <div class="grid grid-cols-2 gap-1.5">
                    <a href="#calculator-section" onclick="document.getElementById('mobile-actions-sheet')?.close()"
                        class="px-2.5 py-1.5 rounded-lg bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 text-ui-xs font-bold border border-slate-200/80 transition-colors flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        <span>Calculator</span>
                    </a>
                    <a href="#breakdown-studio" onclick="document.getElementById('mobile-actions-sheet')?.close()"
                        class="px-2.5 py-1.5 rounded-lg bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 text-ui-xs font-bold border border-slate-200/80 transition-colors flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Breakdown</span>
                    </a>
                    <a href="#math-formulas" onclick="document.getElementById('mobile-actions-sheet')?.close()"
                        class="px-2.5 py-1.5 rounded-lg bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 text-ui-xs font-bold border border-slate-200/80 transition-colors flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                        <span>Formulas</span>
                    </a>
                    <a href="#faq-section" onclick="document.getElementById('mobile-actions-sheet')?.close()"
                        class="px-2.5 py-1.5 rounded-lg bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 text-ui-xs font-bold border border-slate-200/80 transition-colors flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>FAQs</span>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <!-- Excel (.xlsx) Export -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('downloadExcelBtn')?.click()"
                    class="p-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-900 text-ui-xs font-extrabold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span>Excel (.xlsx)</span>
                </button>
                <!-- CSV Export -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('downloadCsvBtn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    <span>Export CSV</span>
                </button>
                <!-- Save Plan -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('saveCalculationBtn')?.click()"
                    class="p-2.5 rounded-xl bg-amber-50/70 hover:bg-amber-100/70 border border-amber-200 text-amber-900 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                    <span>Save Plan</span>
                </button>
                <!-- Social Card -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('downloadSocialCardBtn')?.click()"
                    class="p-2.5 rounded-xl bg-teal-50/70 hover:bg-teal-100/70 border border-teal-200 text-teal-900 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span>Share Card</span>
                </button>
                <!-- Copy Link -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('shareCalcBtn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    <span>Copy Link</span>
                </button>
                <!-- Snapshot Scenario -->
                {% if supports_snapshot(calculator_type|default('all')) %}
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('snapshot-scenario-btn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>Snapshot</span>
                </button>
                {% endif %}
                <!-- §112A Tax Waterfall -->
                {% if supports_tax_waterfall(calculator_type|default('all')) %}
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('open-tax-waterfall-btn')?.click()"
                    class="p-2.5 rounded-xl bg-violet-50 hover:bg-violet-100 border border-violet-200 text-violet-900 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-violet-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
                    <span>§112A Tax</span>
                </button>
                {% endif %}
                <!-- Embed Calculator -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('open-embed-modal-btn')?.click()"
                    class="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                    <span>Embed</span>
                </button>
                <!-- AMFI Regulatory Rules -->
                {% if supports_amfi_badge(calculator_type|default('all')) %}
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.close(); document.getElementById('sebiBenchmarkModal')?.showModal()"
                    class="p-2.5 rounded-xl bg-emerald-50/70 hover:bg-emerald-100/70 border border-emerald-200 text-emerald-800 text-ui-xs font-bold active:scale-95 transition-all flex flex-col items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span>AMFI Rules</span>
                </button>
                {% endif %}
            </div>
        </div>
    </dialog>
    {% endif %}

    <!-- Floating Scroll-to-Top FAB (appears on scroll up to prevent text occlusion) -->
    <button type="button" id="mobile-scroll-top-fab"
        class="sm:hidden fixed {% if is_calculator_route or active_page|default('') == 'blog_post' %}bottom-32{% else %}bottom-8{% endif %} right-3.5 z-sticky w-9 h-9 rounded-full bg-white border border-slate-200/90 shadow-card text-slate-600 text-xs font-black flex items-center justify-center active:scale-90 transition-all duration-300 cursor-pointer opacity-0 pointer-events-none translate-y-2"
        onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
        aria-label="Scroll to top">
        ↑
    </button>
    <script>
        // Direction-aware FAB: shows on upward scroll or deep in page to never occlude reading content
        (function() {
            var fab = document.getElementById('mobile-scroll-top-fab');
            if (!fab) return;
            var lastScroll = 0;
            var ticking = false;
            window.addEventListener('scroll', function() {
                if (!ticking) {
                    window.requestAnimationFrame(function() {
                        var st = window.scrollY;
                        var isScrollingUp = st < lastScroll - 5;
                        var isDeepInPage = st > 1200;
                        if (st > 350 && (isScrollingUp || isDeepInPage)) {
                            fab.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
                            fab.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
                        } else {
                            fab.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
                            fab.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
                        }
                        lastScroll = st;
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        })();
    </script>

    {% include 'components/command-palette.twig' %}
    {% include 'components/tax-waterfall-modal.twig' %}
    {% include 'components/goal-commitment-modal.twig' %}
    {% include 'components/qr-share-modal.twig' %}
    {% include 'components/sebibenchmark-modal.twig' %}
    <script>
        if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
            var isLocalDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' || window.location.hostname.endsWith('.local');
            if (isLocalDev) {
                // Ensure local development is never hijacked or polluted by stale SW caches
                navigator.serviceWorker.getRegistrations().then(function(registrations) {
                    for (var i = 0; i < registrations.length; i++) {
                        registrations[i].unregister();
                    }
                });
            } else {
                window.addEventListener('load', function() {
                    navigator.serviceWorker.register('/sw.js').catch(function(err) {
                        console.debug('SW registration skipped:', err);
                    });
                });
            }
        }
    </script>
    {% block modals %}{% endblock %}
    {% block scripts %}{% endblock %}
</body>
</html>
