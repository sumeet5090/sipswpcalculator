<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>{{ page_config.title|default('SIP & SWP Calculator') }}</title>
    <meta name="description" content="{{ page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.') }}">
    {% if page_config.keywords is defined %}
    <meta name="keywords" content="{{ page_config.keywords }}">
    {% endif %}
    
    {% set current_uri = request.server('REQUEST_URI', '/') %}
    {% set canonical_url = page_config.canonical|default('https://sipswpcalculator.com' ~ current_uri) %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="{{ page_config.robots|default('index, follow') }}">

    <link rel="alternate" hreflang="en-IN" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="SIP & SWP Calculator">
    <meta property="og:locale" content="en_IN">
    <meta property="og:url" content="{{ page_config.canonical|default('https://sipswpcalculator.com' ~ current_uri) }}">
    <meta property="og:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta property="og:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta property="og:image" content="{{ page_config.og_image|default('https://sipswpcalculator.com/assets/og-image-main.jpg') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_config.og_title|default(page_config.title|default('SIP & SWP Calculator')) }}">
    <meta name="twitter:description" content="{{ page_config.og_desc|default(page_config.meta_desc|default('Free SIP & SWP calculator with step-up compounding.')) }}">
    <meta name="twitter:image" content="{{ page_config.og_image|default('https://sipswpcalculator.com/assets/og-image-main.jpg') }}">

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="manifest" href="/manifest.json">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    </noscript>

    {{ vite_client() }}
    {{ vite_css('resources/js/app.ts') }}

    {{ page_config.additional_head|default('')|raw }}

    {% if env == 'production' %}
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-P5PLFTW4E7"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-P5PLFTW4E7');
        </script>
        <script src="https://analytics.ahrefs.com/analytics.js" data-key="WiDGDiqV9F0xelXDCYFUfw" async></script>

        <!-- Microsoft Clarity -->
        <script type="text/javascript">
            (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "y1ed7um9dp");
        </script>
    {% endif %}
    
    {% block head %}{% endblock %}
</head>
<body class="{{ page_config.body_class|default('bg-gray-50 text-gray-800 font-sans antialiased') }} overflow-x-hidden" style="{{ page_config.body_style|default('background-image: var(--gradient-surface); background-attachment: fixed;') }}">
    
    {% include 'layouts/header.twig' %}
    
    <!-- spacer to prevent content from being hidden behind fixed header -->
    <div class="h-16"></div>
    
    <div class="container mt-6 mx-auto px-4 sm:px-6 lg:px-8 {{ page_config.container_class|default('max-w-7xl') }}">
        {% block content %}{% endblock %}
    </div>

    {% include 'layouts/footer.twig' %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Mobile Menu Toggle
            var btn = document.getElementById('mobile-menu-btn');
            var menu = document.getElementById('mobile-menu');
            var hamburger = document.getElementById('hamburger-icon');
            var closeIcon = document.getElementById('close-icon');
            if (btn && menu) {
                btn.addEventListener('click', function () {
                    var isOpen = !menu.classList.contains('hidden');
                    menu.classList.toggle('hidden');
                    hamburger.classList.toggle('hidden');
                    closeIcon.classList.toggle('hidden');
                    btn.setAttribute('aria-expanded', !isOpen);
                });
            }
        });
    </script>
    <script type="module" src="{{ vite_asset('resources/js/app.ts') }}"></script>
    
    {% if page_config.scripts is defined %}
        {% for script in page_config.scripts %}
            <script src="{{ script }}" defer></script>
        {% endfor %}
    {% endif %}
    
    {% block modals %}{% endblock %}
    {% block scripts %}{% endblock %}
</body>
</html>
