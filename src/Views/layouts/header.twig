{% set nav_calculator_groups = [
    {
        'title': 'Core Calculators',
        'badge': 'Tier 1',
        'items': [
            {'label': 'SIP + SWP Dual Planner', 'href': '/', 'desc': 'Lifetime accumulation & pension cashflow'},
            {'label': 'SIP Calculator', 'href': '/sip-calculator', 'desc': 'Standard wealth accumulation & compounding'},
            {'label': 'SWP Calculator', 'href': '/swp-calculator', 'desc': 'Systematic withdrawal & retirement income'},
            {'label': 'Lumpsum Calculator', 'href': '/lumpsum-calculator', 'desc': 'One-time investment compounding'},
            {'label': 'Target Corpus Calculator', 'href': '/target-corpus-calculator', 'desc': 'Find monthly SIP for wealth goal'},
            {'label': 'Step-Up SIP Calculator', 'href': '/sip-step-up-calculator', 'desc': 'Annual salary appraisal escalation'},
            {'label': 'Retirement FIRE Calculator', 'href': '/retirement-calculator', 'desc': 'Nest egg longevity & safe withdrawal'}
        ]
    },
    {
        'title': 'Milestone Blueprints',
        'badge': 'Curated',
        'monthly_sips': [
            {'label': '₹5k/mo SIP', 'href': '/sip-5000-per-month'},
            {'label': '₹10k/mo SIP', 'href': '/sip-10000-per-month'},
            {'label': '₹15k/mo SIP', 'href': '/sip-15000-per-month'},
            {'label': '₹20k/mo SIP', 'href': '/sip-20000-per-month'},
            {'label': '₹25k/mo SIP', 'href': '/sip-25000-per-month'},
            {'label': '₹50k/mo SIP', 'href': '/sip-50000-per-month'},
            {'label': '₹1L/mo SIP', 'href': '/sip-1-lakh-per-month'}
        ],
        'goals_and_swp': [
            {'label': '1 Crore SIP Goal', 'href': '/my-first-crore-calculator'},
            {'label': '2 Crore SIP Plan', 'href': '/2-crore-sip-calculator'},
            {'label': '3 Crore SIP Plan', 'href': '/3-crore-sip-calculator'},
            {'label': '5 Crore SIP Plan', 'href': '/reach-5-crore-via-sip'},
            {'label': '25 Lakh SWP Pension', 'href': '/25-lakh-swp-calculator'},
            {'label': '50 Lakh SWP Pension', 'href': '/50-lakh-swp-calculator'},
            {'label': '75 Lakh SWP Pension', 'href': '/75-lakh-swp-calculator'},
            {'label': '1 Crore SWP Pension', 'href': '/1-crore-swp-calculator'},
            {'label': '2 Crore SWP Pension', 'href': '/2-crore-swp-calculator'}
        ]
    },
    {
        'title': 'Utilities & Comparisons',
        'badge': 'Tools',
        'items': [
            {'label': 'Compound Interest', 'href': '/compound-interest-calculator'},
            {'label': 'CAGR Calculator', 'href': '/cagr-calculator'},
            {'label': 'Inflation Calculator', 'href': '/inflation-calculator'},
            {'label': 'Loan EMI Calculator', 'href': '/emi-calculator'},
            {'label': 'PPF Scheme', 'href': '/ppf-calculator'},
            {'label': 'Bank Fixed Deposit', 'href': '/fd-calculator'},
            {'label': 'Gratuity Calculator', 'href': '/gratuity-calculator'},
            {'label': 'EPF & VPF Calculator', 'href': '/epf-calculator'},
            {'label': 'NPS Calculator', 'href': '/nps-calculator'},
            {'label': 'Post-Retirement Planner', 'href': '/post-retirement-calculator'},
            {'label': 'SWP vs Life Annuity', 'href': '/swp-vs-annuity'}
        ]
    }
] %}

{% set primary_nav_links = [
    {'label': 'Resources', 'href': '/resources', 'id': 'resources'},
    {'label': 'Glossary', 'href': '/glossary', 'id': 'glossary'},
    {'label': 'FAQ', 'href': '/faq', 'id': 'faq'},
    {'label': 'About Me', 'href': '/about', 'id': 'about'}
] %}

<style>
    /* Desktop Guides dropdown - pure CSS hover */
    .nav-dropdown .nav-dropdown-menu {
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px);
        transition: opacity 0.2s, visibility 0.2s, transform 0.2s;
    }

    .nav-dropdown:hover .nav-dropdown-menu,
    .nav-dropdown:focus-within .nav-dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .nav-dropdown:hover .nav-chevron,
    .nav-dropdown:focus-within .nav-chevron {
        transform: rotate(180deg);
    }
</style>

<header class="navbar-glass fixed w-full z-50 top-0 start-0 border-b border-slate-200 bg-white/98 transition-all duration-300 shadow-flat">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between py-4">
        <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse group">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width: 40px; height: 40px;"
                class="rounded-xl shadow-card-hover shadow-emerald-500/30 transition-transform duration-300 group-hover:scale-105"
                role="img" aria-label="SIP SWP Calculator Logo">
                <rect width="24" height="24" rx="6" fill="url(#logo-grad-header)" />
                <defs>
                    <linearGradient id="logo-grad-header" x1="0%" y1="100%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#059669" />
                        <stop offset="100%" stop-color="#2dd4bf" />
                    </linearGradient>
                </defs>
                <path fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                    d="M4 13l5-5 3.5 3.5 7.5-7.5" />
                <path fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                    d="M15 4h5v5" />
                <path fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                    stroke-opacity="0.5" d="M4 17l5-5 3.5 3.5 7.5-7.5" />
                <path fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                    stroke-opacity="0.25" d="M4 21l5-5 3.5 3.5 7.5-7.5" />
            </svg>
            <span class="self-center text-xl font-heading font-extrabold whitespace-nowrap tracking-tight text-slate-800">SIP &amp;
                SWP <span class="text-emerald-500 font-medium">Calculator</span></span>
        </a>

        <!-- Desktop nav (visible on >= 1024px) -->
        <nav class="hidden lg:flex items-center gap-6 text-sm font-medium" aria-label="Main navigation">
            <!-- Tier 1 Clustered Calculators Mega-Menu -->
            <div class="relative nav-dropdown py-2">
                <button aria-haspopup="true" aria-expanded="false" class="{{ is_calculator_route|default(false) ? 'text-emerald-600 font-semibold' : 'text-slate-600 hover:text-emerald-600' }} transition-colors inline-flex items-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 rounded">
                    <span>Calculators</span>
                    <svg class="w-4 h-4 nav-chevron transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div role="menu" class="absolute -left-12 xl:left-0 mt-2 w-[760px] rounded-2xl bg-white shadow-modal ring-1 ring-black/5 nav-dropdown-menu p-4 border border-slate-200/90 z-50">
                    <div class="grid grid-cols-12 gap-4">
                        <!-- Column 1: Core Calculators (Tier 1 Pillars) -->
                        <div class="col-span-5 border-r border-slate-100 pr-3">
                            <div class="flex items-center justify-between mb-2 pb-1 border-b border-slate-100">
                                <span class="text-micro font-black uppercase tracking-wider text-slate-500">Core Engines</span>
                                <span class="text-micro font-extrabold text-emerald-800 bg-emerald-50 border border-emerald-200/80 px-1.5 py-0.2 rounded-full">Tier 1</span>
                            </div>
                            <div class="space-y-1">
                                {% for core in nav_calculator_groups[0].items %}
                                    <a href="{{ core.href }}" role="menuitem" class="group/item block p-1.5 rounded-xl hover:bg-emerald-50/80 transition-colors">
                                        <div class="text-xs font-bold text-slate-900 group-hover/item:text-emerald-700 flex items-center justify-between">
                                            <span>{{ core.label }}</span>
                                            <span class="text-slate-300 group-hover/item:text-emerald-600 text-micro">→</span>
                                        </div>
                                        <p class="text-micro text-slate-500 line-clamp-1 mt-0.5">{{ core.desc }}</p>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Column 2: Milestone Blueprints -->
                        <div class="col-span-4 border-r border-slate-100 pr-3">
                            <div class="flex items-center justify-between mb-2 pb-1 border-b border-slate-100">
                                <span class="text-micro font-black uppercase tracking-wider text-slate-500">Milestone Hubs</span>
                                <span class="text-micro font-extrabold text-amber-800 bg-amber-50 border border-amber-200/80 px-1.5 py-0.2 rounded-full">Curated</span>
                            </div>
                            <div class="mb-2.5">
                                <span class="text-micro font-bold text-slate-400 uppercase tracking-wider block mb-1">Monthly SIPs</span>
                                <div class="grid grid-cols-2 gap-1">
                                    {% for sip in nav_calculator_groups[1].monthly_sips %}
                                        <a href="{{ sip.href }}" role="menuitem" class="block px-2 py-1 rounded-lg text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 truncate transition-colors">{{ sip.label }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                            <div>
                                <span class="text-micro font-bold text-slate-400 uppercase tracking-wider block mb-1">Goals &amp; SWP Payouts</span>
                                <div class="space-y-0.5">
                                    {% for goal in nav_calculator_groups[1].goals_and_swp %}
                                        <a href="{{ goal.href }}" role="menuitem" class="block px-2 py-1 rounded-lg text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 truncate transition-colors">{{ goal.label }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                        <!-- Column 3: Utilities & Tax Comparisons -->
                        <div class="col-span-3">
                            <div class="flex items-center justify-between mb-2 pb-1 border-b border-slate-100">
                                <span class="text-micro font-black uppercase tracking-wider text-slate-500">Utilities</span>
                                <span class="text-micro font-extrabold text-slate-700 bg-slate-100 px-1.5 py-0.2 rounded-full">Tools</span>
                            </div>
                            <div class="space-y-0.5">
                                {% for util in nav_calculator_groups[2].items %}
                                    <a href="{{ util.href }}" role="menuitem" class="block px-2 py-1 rounded-lg text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 truncate transition-colors">{{ util.label }}</a>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Mega Menu Footer Action -->
                        <div class="col-span-12 pt-2.5 mt-1 border-t border-slate-100 flex items-center justify-between text-caption text-slate-500">
                            <span>Explore all 27 specialized calculators &amp; benchmarks</span>
                            <button type="button" onclick="document.getElementById('open-command-palette-btn')?.click()" class="inline-flex items-center gap-1.5 font-bold text-emerald-700 hover:text-emerald-800 cursor-pointer">
                                <span>Quick Search</span>
                                <kbd class="text-micro font-bold px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-600">⌘K</kbd>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {% for item in primary_nav_links %}
                {% set is_active = (active_page|default('') == item.id) or (item.id == 'resources' and active_page|default('') == 'blog_post') %}
                <a href="{{ item.href }}"
                    class="{{ is_active ? 'text-emerald-600 font-semibold' : 'text-slate-600 hover:text-emerald-600' }} transition-colors">
                    {{ item.label }}
                </a>
            {% endfor %}
        </nav>

        <!-- Actions (Search, QR & Audio Toggle - visible on >= 1024px) -->
        <div class="hidden lg:flex items-center gap-2">
            <button type="button" id="open-qr-modal-btn"
                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200/90 bg-slate-50/80 hover:bg-slate-100/90 text-slate-500 hover:text-slate-800 text-xs font-semibold shadow-flat transition-all cursor-pointer"
                title="Scan Plan on Mobile"
                aria-label="Scan Plan on Mobile">
                <span class="text-xs">📱</span>
                <span class="hidden xl:inline text-caption">QR Sync</span>
            </button>

            <button type="button" id="open-command-palette-btn"
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200/90 bg-slate-50/80 hover:bg-slate-100/90 text-slate-500 hover:text-slate-800 text-xs font-semibold shadow-flat transition-all cursor-pointer group"
                aria-label="Open Command Palette (Cmd + K)">
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <span>Search...</span>
                <kbd class="hidden md:inline-block text-micro font-bold px-1.5 py-0.5 rounded bg-white border border-slate-200 text-slate-500 shadow-flat">⌘K</kbd>
            </button>

            <button type="button" id="sound-toggle-btn"
                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200/90 bg-slate-50/80 hover:bg-slate-100/90 text-slate-500 hover:text-slate-700 text-xs font-semibold shadow-flat transition-all cursor-pointer"
                title="Toggle UI Sound Effects"
                aria-label="Toggle UI Sound Effects">
                <span class="sound-icon text-xs">🔇</span>
                <span class="sound-text hidden lg:inline text-caption">Muted</span>
            </button>
        </div>

        <!-- Mobile & Tablet hamburger button (visible on < 1024px) -->
        <button id="mobile-menu-btn" type="button"
            class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-500 hover:text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
            aria-controls="mobile-menu" aria-expanded="false" aria-label="Toggle navigation menu">
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile & Tablet menu dropdown (Contained Scroll, visible on < 1024px) -->
    <div id="mobile-menu" class="lg:hidden hidden border-t border-slate-200 bg-white max-h-[calc(100vh-4.5rem)] overflow-y-auto custom-scrollbar shadow-modal overscroll-contain">
        <div class="px-4 py-3 space-y-3">
            <!-- Mobile Category: Core Engines -->
            <div>
                <div class="text-slate-500 font-extrabold px-3 py-1.5 text-xs uppercase tracking-wider flex items-center justify-between">
                    <span>Core Calculators</span>
                    <span class="text-micro font-bold text-emerald-800 bg-emerald-50 px-1.5 py-0.2 rounded-full">Tier 1</span>
                </div>
                <div class="space-y-0.5 pl-2">
                    {% for core in nav_calculator_groups[0].items %}
                        <a href="{{ core.href }}" class="block px-3 py-2 rounded-lg text-sm font-semibold text-slate-800 hover:text-emerald-700 hover:bg-emerald-50/60 transition-colors">
                            {{ core.label }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Mobile Category: Milestone Hubs -->
            <div class="pt-2 border-t border-slate-100">
                <div class="text-slate-500 font-extrabold px-3 py-1.5 text-xs uppercase tracking-wider flex items-center justify-between">
                    <span>Milestone Blueprints</span>
                    <span class="text-micro font-bold text-amber-800 bg-amber-50 px-1.5 py-0.2 rounded-full">Curated</span>
                </div>
                <div class="grid grid-cols-2 gap-1 pl-2">
                    {% for sip in nav_calculator_groups[1].monthly_sips %}
                        <a href="{{ sip.href }}" class="block px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/60 truncate transition-colors">
                            {{ sip.label }}
                        </a>
                    {% endfor %}
                    {% for goal in nav_calculator_groups[1].goals_and_swp %}
                        <a href="{{ goal.href }}" class="block px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/60 truncate transition-colors">
                            {{ goal.label }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Mobile Category: Utilities & Comparisons -->
            <div class="pt-2 border-t border-slate-100">
                <div class="text-slate-500 font-extrabold px-3 py-1.5 text-xs uppercase tracking-wider">
                    <span>Utilities &amp; Tools</span>
                </div>
                <div class="grid grid-cols-2 gap-1 pl-2">
                    {% for util in nav_calculator_groups[2].items %}
                        <a href="{{ util.href }}" class="block px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/60 truncate transition-colors">
                            {{ util.label }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Mobile Primary Links -->
            <div class="pt-2 border-t border-slate-100 space-y-0.5">
                {% for item in primary_nav_links %}
                    {% set is_active = (active_page|default('') == item.id) or (item.id == 'resources' and active_page|default('') == 'blog_post') %}
                    <a href="{{ item.href }}"
                        class="block px-3 py-2 rounded-lg text-sm font-semibold {{ is_active ? 'text-emerald-600 bg-emerald-50 font-bold' : 'text-slate-700 hover:text-emerald-600 hover:bg-emerald-50/50' }} transition-colors">
                        {{ item.label }}
                    </a>
                {% endfor %}
            </div>

            <!-- Mobile & Tablet Quick Actions -->
            <div class="pt-3 border-t border-slate-200/80 grid grid-cols-1 sm:grid-cols-2 gap-2">
                <button type="button"
                    class="open-qr-modal-btn flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 text-sm font-bold shadow-flat transition-all cursor-pointer touch-manipulation"
                    aria-label="Scan or Share Plan via QR Code">
                    <span>📱</span>
                    <span>Scan / Share Plan (QR)</span>
                </button>
                <button type="button"
                    class="open-command-palette-btn flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-sm font-semibold shadow-flat transition-all cursor-pointer touch-manipulation"
                    aria-label="Search Calculators and Resources">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <span>Search Calculators...</span>
                </button>
            </div>
        </div>
    </div>
</header>
