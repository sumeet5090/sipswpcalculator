{#
  scenario-benchmark-table.twig
  Static pre-calculated scenario benchmark tables for SEO, Google rich snippets, and AI grounding (Gemini / Copilot).
  Enforces pure light-mode fintech aesthetic and Indian currency localization.
#}

{% set calc_mode = calculator_type|default('home') %}

<section id="scenario-benchmarks" class="mt-8 sm:mt-12 max-w-5xl mx-auto border-t border-slate-200/80 pt-8" aria-labelledby="benchmark-tables-heading" itemscope itemtype="https://schema.org/Table">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-micro font-bold uppercase tracking-wider mb-2">
                <span>📊</span>
                <span>Pre-Calculated Scenario Benchmarks</span>
            </div>
            <h2 id="benchmark-tables-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
                {% if calc_mode == 'swp' %}
                    SWP Withdrawal &amp; Corpus Longevity Benchmark Table
                {% elseif calc_mode == 'lumpsum' %}
                    Lumpsum Investment Growth Matrix (AMFI Standard @ 12% CAGR)
                {% elseif calc_mode == 'cagr' %}
                    Historical Asset Class CAGR Benchmarks in India (2010–2026)
                {% elseif calc_mode == 'sip-step-up' %}
                    Step-Up SIP vs. Regular SIP Wealth Generation Comparison
                {% else %}
                    SIP &amp; SWP Growth Benchmark Reference Table
                {% endif %}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
                Definitive numerical projections calculated using AMFI-compliant compounding formulas and Indian mutual fund standards.
            </p>
        </div>
        <div class="shrink-0 flex items-center gap-2">
            <span class="text-micro font-bold text-slate-400 uppercase tracking-wider bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200">
                100% Client Math Verified
            </span>
        </div>
    </div>

    {% if calc_mode == 'swp' %}
