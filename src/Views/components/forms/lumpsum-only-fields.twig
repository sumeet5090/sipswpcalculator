{% import "components/form/input-range-pair.twig" as inputs %}

<!-- Hidden SIP & Stepup to satisfy the MathEngine JS -->
<input type="hidden" id="sip" name="sip" value="0">
<input type="hidden" id="stepup" name="stepup" value="0">

<div class="space-y-4">
    <!-- Initial Lumpsum -->
    {{ inputs.renderInputRangePair({
        'id': 'lumpsum',
        'label': 'Investment Amount',
        'min': 0,
        'max': 10000000,
        'slider_max': 100000,
        'step': 5000,
        'value': 100000,
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹50k', 'value': 50000},
            {'label': '₹1L', 'value': 100000},
            {'label': '₹5L', 'value': 500000},
            {'label': '₹10L', 'value': 1000000},
            {'label': '₹25L', 'value': 2500000}
        ]
    }) }}

    <!-- Period (Yrs) -->
    {{ inputs.renderInputRangePair({
        'id': 'years',
        'label': calc_config.years.label,
        'min': calc_config.years.min,
        'max': calc_config.years.max,
        'slider_max': calc_config.years.slider_max,
        'step': calc_config.years.step,
        'value': years,
        'suffix': 'Yrs',
        'theme': 'emerald',
        'input_text_color': 'text-slate-700 focus:border-emerald-500 focus:ring-emerald-500/30 focus:ring-1',
        'presets': [
            {'label': '5Y', 'value': 5},
            {'label': '10Y', 'value': 10},
            {'label': '15Y', 'value': 15},
            {'label': '20Y', 'value': 20},
            {'label': '25Y', 'value': 25}
        ]
    }) }}

    <!-- Expected Return -->
    {% set rateLabelHtml %}
    <div class="flex items-center justify-between mb-1.5">
        <label for="rate" class="text-micro font-bold text-slate-500 uppercase tracking-widest">
            Expected Return
        </label>
    </div>
    {% endset %}

    {{ inputs.renderInputRangePair({
        'id': 'rate',
        'label': calc_config.rate.label,
        'label_html': rateLabelHtml,
        'min': calc_config.rate.min,
        'max': calc_config.rate.max,
        'slider_max': calc_config.rate.slider_max,
        'step': calc_config.rate.step,
        'value': rate,
        'suffix': '%',
        'theme': 'emerald',
        'input_text_color': 'text-slate-700 focus:border-emerald-500 focus:ring-emerald-500/30 focus:ring-1',
        'presets': [
            {'label': '10%', 'value': 10},
            {'label': '12%', 'value': 12},
            {'label': '14%', 'value': 14},
            {'label': '15%', 'value': 15}
        ]
    }) }}

    <!-- Adjustments & Inflation Options -->
    <div class="space-y-4 pt-3 border-t border-slate-100/90">
        <div class="flex items-center gap-2">
            <span class="text-micro font-bold text-slate-400 uppercase tracking-widest">Adjustments & Inflation</span>
            <div class="h-px flex-1 bg-slate-100"></div>
        </div>

        <!-- Expected Inflation -->
        {{ inputs.renderInputRangePair({
            'id': 'inflation',
            'label': calc_config.inflation.label|default('Expected Inflation'),
            'min': calc_config.inflation.min|default(0),
            'max': calc_config.inflation.max|default(15),
            'slider_max': calc_config.inflation.slider_max|default(12),
            'step': calc_config.inflation.step|default(0.5),
            'value': inflation|default(0),
            'suffix': '%',
            'theme': 'emerald',
            'presets': [
                {'label': '0%', 'value': 0},
                {'label': '6%', 'value': 6},
                {'label': '7%', 'value': 7},
                {'label': '8%', 'value': 8}
            ]
        }) }}
    </div>
</div>
