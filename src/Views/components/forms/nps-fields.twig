{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Monthly Contribution (Tier-1) -->
    {{ inputs.renderInputRangePair({
        'id': 'nps_monthly_contribution',
        'label': 'Monthly Contribution (Tier-1)',
        'tooltip': 'Your regular monthly deposit into NPS Tier-1 account. Eligible for Section 80CCD(1B) additional ₹50,000 tax deduction.',
        'min': calc_config.nps_monthly_contribution.min|default(500),
        'max': calc_config.nps_monthly_contribution.max|default(150000),
        'slider_max': calc_config.nps_monthly_contribution.slider_max|default(50000),
        'step': calc_config.nps_monthly_contribution.step|default(500),
        'value': nps_monthly_contribution|default(calc_config.nps_monthly_contribution.default|default(5000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹3,000', 'value': 3000},
            {'label': '₹5,000 (Default)', 'value': 5000},
            {'label': '₹10,000', 'value': 10000},
            {'label': '₹25,000', 'value': 25000},
            {'label': '₹50,000', 'value': 50000}
        ]
    }) }}

    <!-- Current Age & Retirement Age Grid -->
    <div class="space-y-3">
        <!-- Current Age -->
        {{ inputs.renderInputRangePair({
            'id': 'nps_current_age',
            'label': 'Current Age',
            'tooltip': 'Your current age in years. NPS enrollment is open to Indian citizens between 18 and 65 years.',
            'min': calc_config.nps_current_age.min|default(18),
            'max': calc_config.nps_current_age.max|default(65),
            'slider_max': calc_config.nps_current_age.slider_max|default(60),
            'step': calc_config.nps_current_age.step|default(1),
            'value': nps_current_age|default(calc_config.nps_current_age.default|default(30)),
            'suffix': 'Yrs',
            'theme': 'emerald',
            'presets': [
                {'label': '25 Yrs', 'value': 25},
                {'label': '30 Yrs (Avg)', 'value': 30},
                {'label': '35 Yrs', 'value': 35},
                {'label': '45 Yrs', 'value': 45}
            ]
        }) }}

        <!-- Retirement Age -->
        {{ inputs.renderInputRangePair({
            'id': 'nps_retirement_age',
            'label': 'Retirement Age',
            'tooltip': 'Superannuation age when you exit NPS. Normal retirement age is 60 years, extendable up to 75 years.',
            'min': calc_config.nps_retirement_age.min|default(35),
            'max': calc_config.nps_retirement_age.max|default(75),
            'slider_max': calc_config.nps_retirement_age.slider_max|default(70),
            'step': calc_config.nps_retirement_age.step|default(1),
            'value': nps_retirement_age|default(calc_config.nps_retirement_age.default|default(60)),
            'suffix': 'Yrs',
            'theme': 'emerald',
            'presets': [
                {'label': '55 Yrs', 'value': 55},
                {'label': '60 Yrs (Default)', 'value': 60},
                {'label': '65 Yrs', 'value': 65},
                {'label': '70 Yrs', 'value': 70}
            ]
        }) }}
    </div>

    <!-- Expected Return (p.a.) -->
    {{ inputs.renderInputRangePair({
        'id': 'nps_expected_return',
        'label': 'Expected Return (p.a.)',
        'tooltip': 'Expected annualized growth rate across your Equity (E), Corporate Debt (C), and Government Securities (G) asset allocation. Historical returns average 9%–12%.',
        'min': calc_config.nps_expected_return.min|default(5.0),
        'max': calc_config.nps_expected_return.max|default(15.0),
        'slider_max': calc_config.nps_expected_return.slider_max|default(15.0),
        'step': calc_config.nps_expected_return.step|default(0.5),
        'value': nps_expected_return|default(calc_config.nps_expected_return.default|default(10.0)),
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '8% (Conservative)', 'value': 8.0},
            {'label': '10% (Balanced)', 'value': 10.0},
            {'label': '12% (Aggressive)', 'value': 12.0},
            {'label': '14%', 'value': 14.0}
        ]
    }) }}

    <!-- Annuity Allocation & Yield Grid -->
    <div class="space-y-3">
        <!-- Annuity Percent -->
        {{ inputs.renderInputRangePair({
            'id': 'nps_annuity_percent',
            'label': 'Annuity Reinvestment Share',
            'tooltip': 'Statutory minimum 40% of maturity corpus must be annuitized. The remaining (up to 60%) is 100% tax-free lump sum under Section 10(12A).',
            'min': calc_config.nps_annuity_percent.min|default(40),
            'max': calc_config.nps_annuity_percent.max|default(100),
            'slider_max': calc_config.nps_annuity_percent.slider_max|default(100),
            'step': calc_config.nps_annuity_percent.step|default(5),
            'value': nps_annuity_percent|default(calc_config.nps_annuity_percent.default|default(40)),
            'suffix': '%',
            'theme': 'emerald',
            'presets': [
                {'label': '40% (Min / Max Cash)', 'value': 40},
                {'label': '50%', 'value': 50},
                {'label': '60%', 'value': 60},
                {'label': '100% (Max Pension)', 'value': 100}
            ]
        }) }}

        <!-- Annuity Rate -->
        {{ inputs.renderInputRangePair({
            'id': 'nps_annuity_rate',
            'label': 'Expected Annuity Rate (p.a.)',
            'tooltip': 'Annual pension yield paid by the insurance provider (e.g. LIC, SBI Life) on the annuitized corpus. Current market rates range from 5.5% to 6.5%.',
            'min': calc_config.nps_annuity_rate.min|default(4.0),
            'max': calc_config.nps_annuity_rate.max|default(10.0),
            'slider_max': calc_config.nps_annuity_rate.slider_max|default(10.0),
            'step': calc_config.nps_annuity_rate.step|default(0.25),
            'value': nps_annuity_rate|default(calc_config.nps_annuity_rate.default|default(6.0)),
            'suffix': '%',
            'theme': 'emerald',
            'presets': [
                {'label': '5.5%', 'value': 5.5},
                {'label': '6.0% (Current)', 'value': 6.0},
                {'label': '6.5%', 'value': 6.5},
                {'label': '7.0%', 'value': 7.0}
            ]
        }) }}
    </div>
</div>
