{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Current Cost or Living Expense -->
    {{ inputs.renderInputRangePair({
        'id': 'inf_amount',
        'label': calc_config.inf_amount.label|default('Current Cost / Expense'),
        'tooltip': 'Today\'s cost of the target expense, lifestyle budget, or asset value.',
        'min': calc_config.inf_amount.min|default(1000),
        'max': calc_config.inf_amount.max|default(10000000),
        'slider_max': calc_config.inf_amount.slider_max|default(500000),
        'step': calc_config.inf_amount.step|default(1000),
        'value': inf_amount|default(calc_config.inf_amount.default|default(50000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹25k', 'value': 25000},
            {'label': '₹50k', 'value': 50000},
            {'label': '₹1L', 'value': 100000},
            {'label': '₹2L', 'value': 200000},
            {'label': '₹5L', 'value': 500000}
        ]
    }) }}

    <!-- Expected Inflation Rate -->
    {{ inputs.renderInputRangePair({
        'id': 'inf_rate',
        'label': calc_config.inf_rate.label|default('Expected Inflation'),
        'tooltip': 'Projected annual cost-of-living increase (historically 6.0% CPI in India).',
        'min': calc_config.inf_rate.min|default(1.0),
        'max': calc_config.inf_rate.max|default(20.0),
        'slider_max': calc_config.inf_rate.slider_max|default(15.0),
        'step': calc_config.inf_rate.step|default(0.5),
        'value': inf_rate|default(calc_config.inf_rate.default|default(6.0)),
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '5.0%', 'value': 5.0},
            {'label': '6.0% (CPI)', 'value': 6.0},
            {'label': '7.0%', 'value': 7.0},
            {'label': '8.0%', 'value': 8.0},
            {'label': '10.0%', 'value': 10.0}
        ]
    }) }}

    <!-- Time Horizon (Years) -->
    {{ inputs.renderInputRangePair({
        'id': 'inf_years',
        'label': calc_config.inf_years.label|default('Time Horizon'),
        'tooltip': 'Number of years into the future when the expense will be incurred.',
        'min': calc_config.inf_years.min|default(1),
        'max': calc_config.inf_years.max|default(40),
        'slider_max': calc_config.inf_years.slider_max|default(30),
        'step': calc_config.inf_years.step|default(1),
        'value': inf_years|default(calc_config.inf_years.default|default(15)),
        'suffix': 'Yrs',
        'theme': 'emerald',
        'presets': [
            {'label': '5Y', 'value': 5},
            {'label': '10Y', 'value': 10},
            {'label': '15Y', 'value': 15},
            {'label': '20Y', 'value': 20},
            {'label': '25Y', 'value': 25}
        ]
    }) }}
</div>
