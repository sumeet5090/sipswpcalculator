{% import "components/form/input-range-pair.twig" as inputs %}

<!-- Hidden legacy fields to prevent JS errors -->
<input type="hidden" id="sip" name="sip" value="0">
<input type="hidden" id="stepup" name="stepup" value="0">
<input type="hidden" id="lumpsum" name="lumpsum" value="0">

<div class="space-y-4">
    <div class="mb-2">
        <span class="text-xs font-bold text-emerald-600 tracking-widest uppercase">Inflation Parameters</span>
    </div>

    <!-- Current Cost or Living Expense -->
    {{ inputs.renderInputRangePair({
        'id': 'inf_amount',
        'label': 'Today\'s Cost or Monthly Expense',
        'min': 1000,
        'max': 10000000,
        'slider_max': 500000,
        'step': 1000,
        'value': 50000,
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹25k', 'value': 25000},
            {'label': '₹50k', 'value': 50000},
            {'label': '₹1L', 'value': 100000},
            {'label': '₹2L', 'value': 200000},
            {'label': '₹5L', 'value': 500000}
        ]
    }) }}

    <!-- Expected Inflation Rate -->
    {{ inputs.renderInputRangePair({
        'id': 'inf_rate',
        'label': 'Expected Inflation Rate (% p.a.)',
        'min': 1.0,
        'max': 20.0,
        'slider_max': 15.0,
        'step': 0.5,
        'value': 6.0,
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '5.0%', 'value': 5.0},
            {'label': '6.0% (CPI)', 'value': 6.0},
            {'label': '7.0%', 'value': 7.0},
            {'label': '8.0%', 'value': 8.0},
            {'label': '10.0%', 'value': 10.0}
        ]
    }) }}

    <!-- Time Horizon (Years) -->
    {{ inputs.renderInputRangePair({
        'id': 'inf_years',
        'label': 'Future Time Horizon',
        'min': 1,
        'max': 40,
        'slider_max': 30,
        'step': 1,
        'value': 15,
        'suffix': 'Yrs',
        'theme': 'emerald',
        'presets': [
            {'label': '5Y', 'value': 5},
            {'label': '10Y', 'value': 10},
            {'label': '15Y', 'value': 15},
            {'label': '20Y', 'value': 20},
            {'label': '25Y', 'value': 25}
        ]
    }) }}
</div>
