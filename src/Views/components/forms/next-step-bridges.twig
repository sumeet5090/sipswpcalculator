{# Compact zero-JS in-form contextual next-step bridges #}
{% if bridges is defined and bridges|length > 0 %}
{% set currentPath = current_path|default('') %}
<div class="mt-3 pt-3 border-t border-slate-200/80">
    <div class="rounded-2xl bg-slate-50/90 border border-slate-200/85 p-3">
        <p class="text-micro font-extrabold uppercase tracking-wider text-slate-500 mb-2">Next Step</p>
        <div class="flex flex-wrap gap-1.5">
            {% for item in bridges %}
                {% if currentPath == '' or currentPath != item.href %}
                <a href="{{ item.href }}" class="inline-flex items-center gap-1 rounded-xl bg-white hover:bg-emerald-50/90 border border-slate-200/90 hover:border-emerald-300 px-2.5 py-1.5 text-micro font-semibold text-slate-700 hover:text-emerald-800 transition-colors shadow-flat">
                    <span>{{ item.label }}</span>
                    <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}
