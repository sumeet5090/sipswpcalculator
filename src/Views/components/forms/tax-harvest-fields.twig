{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Current Equity MF Portfolio Value -->
    {{ inputs.renderInputRangePair({
        'id': 'tax_portfolio_value',
        'label': 'Current Equity MF Portfolio Value',
        'tooltip': 'Current market value of your equity mutual fund or stock holdings held for > 12 months (long-term).',
        'min': calc_config.tax_portfolio_value.min|default(100000),
        'max': calc_config.tax_portfolio_value.max|default(100000000),
        'slider_max': calc_config.tax_portfolio_value.slider_max|default(20000000),
        'step': calc_config.tax_portfolio_value.step|default(50000),
        'value': tax_portfolio_value|default(calc_config.tax_portfolio_value.default|default(2500000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹10L', 'value': 1000000},
            {'label': '₹25L (Default)', 'value': 2500000},
            {'label': '₹50L', 'value': 5000000},
            {'label': '₹1 Cr', 'value': 10000000},
            {'label': '₹2 Cr', 'value': 20000000}
        ]
    }) }}

    <!-- Original Purchase Cost -->
    {{ inputs.renderInputRangePair({
        'id': 'tax_invested_cost',
        'label': 'Original Purchase Cost (Cost Basis)',
        'tooltip': 'Total actual capital invested to acquire the units. Unrealized gain = Current Value minus Purchase Cost.',
        'min': calc_config.tax_invested_cost.min|default(50000),
        'max': calc_config.tax_invested_cost.max|default(100000000),
        'slider_max': calc_config.tax_invested_cost.slider_max|default(20000000),
        'step': calc_config.tax_invested_cost.step|default(50000),
        'value': tax_invested_cost|default(calc_config.tax_invested_cost.default|default(1500000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹5L', 'value': 500000},
            {'label': '₹15L (Default)', 'value': 1500000},
            {'label': '₹30L', 'value': 3000000},
            {'label': '₹50L', 'value': 5000000}
        ]
    }) }}

    <!-- Expected Annual Return & Future Holding Horizon Grid -->
    <div class="space-y-3">
        <!-- Expected Annual Return -->
        {{ inputs.renderInputRangePair({
            'id': 'tax_expected_return',
            'label': 'Expected Return (CAGR)',
            'tooltip': 'Expected annual portfolio compounding rate over your remaining investment horizon.',
            'min': calc_config.tax_expected_return.min|default(4.0),
            'max': calc_config.tax_expected_return.max|default(25.0),
            'slider_max': calc_config.tax_expected_return.slider_max|default(20.0),
            'step': calc_config.tax_expected_return.step|default(0.5),
            'value': tax_expected_return|default(calc_config.tax_expected_return.default|default(12.0)),
            'suffix': '%',
            'theme': 'emerald',
            'presets': [
                {'label': '10%', 'value': 10},
                {'label': '12% (Nifty)', 'value': 12},
                {'label': '14%', 'value': 14}
            ]
        }) }}

        <!-- Future Holding Horizon -->
        {{ inputs.renderInputRangePair({
            'id': 'tax_holding_years',
            'label': 'Harvesting Horizon',
            'tooltip': 'Number of future financial years over which you systematically harvest up to ₹1.25 Lakh LTCG tax-free.',
            'min': calc_config.tax_holding_years.min|default(1),
            'max': calc_config.tax_holding_years.max|default(30),
            'slider_max': calc_config.tax_holding_years.slider_max|default(25),
            'step': calc_config.tax_holding_years.step|default(1),
            'value': tax_holding_years|default(calc_config.tax_holding_years.default|default(10)),
            'suffix': 'Yrs',
            'theme': 'emerald',
            'presets': [
                {'label': '5 Yrs', 'value': 5},
                {'label': '10 Yrs', 'value': 10},
                {'label': '15 Yrs', 'value': 15},
                {'label': '20 Yrs', 'value': 20}
            ]
        }) }}
    </div>

    <!-- Optional Jan 31, 2018 Grandfathered FMV -->
    {{ inputs.renderInputRangePair({
        'id': 'tax_grandfather_fmv',
        'label': 'Jan 31, 2018 FMV (Optional Grandfathering)',
        'tooltip': 'Leave at ₹0 for post-2018 purchases. For pre-Feb 2018 units, enter Fair Market Value on 31-Jan-2018 to step up your tax-free cost basis.',
        'min': calc_config.tax_grandfather_fmv.min|default(0),
        'max': calc_config.tax_grandfather_fmv.max|default(100000000),
        'slider_max': calc_config.tax_grandfather_fmv.slider_max|default(10000000),
        'step': calc_config.tax_grandfather_fmv.step|default(50000),
        'value': tax_grandfather_fmv|default(calc_config.tax_grandfather_fmv.default|default(0)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹0 (Post-2018)', 'value': 0},
            {'label': '₹10L FMV', 'value': 1000000},
            {'label': '₹20L FMV', 'value': 2000000}
        ]
    }) }}

    <!-- 4% Health & Education Cess Toggle -->
    <div class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl bg-slate-50/90 border border-slate-200/80 shadow-flat">
        <div class="pr-2">
            <label for="tax_include_cess" class="text-ui-xs font-extrabold text-slate-800 cursor-pointer block">
                Include 4% Health &amp; Education Cess (13.0% Effective LTCG)
            </label>
            <p class="text-micro text-slate-500 mt-0.5">
                Section 112A base rate is 12.5% above ₹1.25L/FY; adding statutory 4% cess gives 13.0% effective tax.
            </p>
        </div>
        <input type="checkbox" id="tax_include_cess" name="tax_include_cess" value="1" checked
            class="w-4 h-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer shrink-0">
    </div>
</div>
