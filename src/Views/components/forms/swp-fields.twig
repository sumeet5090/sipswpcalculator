{% import "components/form/input-range-pair.twig" as inputs %}

<!-- Lifecycle Accumulation Bridge (Transfer Matured SIP Corpus to SWP Starting Corpus) -->
<div id="swp-accumulation-bridge" class="p-3 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-indigo-50 border border-emerald-200/90 flex items-center justify-between gap-2 shadow-2xs mb-4">
    <div>
        <div class="text-[10px] font-extrabold text-emerald-800 uppercase tracking-wider">SIP Matured Corpus Bridge</div>
        <div class="text-xs font-bold text-slate-800">Seed with Matured Corpus (<span id="bridge-matured-corpus-val" class="font-mono text-emerald-700 font-extrabold">₹ --</span>)?</div>
    </div>
    <button type="button" id="apply-sip-to-swp-btn" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold shadow-xs active:scale-95 transition-all cursor-pointer whitespace-nowrap">
        Sync Corpus
    </button>
</div>

<!-- Monthly Withdrawal -->
{{ inputs.renderInputRangePair({
    'id': 'swp_withdrawal',
    'label': calc_config.swp_withdrawal.label,
    'min': calc_config.swp_withdrawal.min,
    'max': calc_config.swp_withdrawal.max,
    'slider_max': calc_config.swp_withdrawal.slider_max,
    'step': calc_config.swp_withdrawal.step,
    'value': swp_withdrawal,
    'prefix': '₹',
    'theme': 'rose',
    'presets': [
        {'label': '₹10k', 'value': 10000},
        {'label': '₹25k', 'value': 25000},
        {'label': '₹50k', 'value': 50000},
        {'label': '₹75k', 'value': 75000},
        {'label': '₹1L', 'value': 100000}
    ]
}) }}

<!-- Withdrawal Duration -->
{{ inputs.renderInputRangePair({
    'id': 'swp_years',
    'label': calc_config.swp_years.label,
    'min': calc_config.swp_years.min,
    'max': calc_config.swp_years.max,
    'slider_max': calc_config.swp_years.slider_max,
    'step': calc_config.swp_years.step,
    'value': swp_years_input,
    'suffix': 'Yrs',
    'theme': 'rose',
    'input_text_color': 'text-slate-700 focus:border-rose-400 focus:ring-rose-400/30 focus:ring-1',
    'presets': [
        {'label': '5Y', 'value': 5},
        {'label': '10Y', 'value': 10},
        {'label': '15Y', 'value': 15},
        {'label': '20Y', 'value': 20},
        {'label': '25Y', 'value': 25},
        {'label': '30Y', 'value': 30}
    ]
}) }}

<!-- SWP Expected Return -->
{{ inputs.renderInputRangePair({
    'id': 'swp_rate',
    'label': calc_config.swp_rate.label,
    'min': calc_config.swp_rate.min,
    'max': calc_config.swp_rate.max,
    'slider_max': calc_config.swp_rate.slider_max,
    'step': calc_config.swp_rate.step,
    'value': swp_rate,
    'suffix': '%',
    'theme': 'rose',
    'presets': [
        {'label': '6%', 'value': 6},
        {'label': '7%', 'value': 7},
        {'label': '8%', 'value': 8},
        {'label': '9%', 'value': 9}
    ]
}) }}

<!-- SWP Inflation Escalation -->
<div class="space-y-4 pt-3 border-t border-slate-100/90">
    <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Inflation Escalation</span>
        <div class="h-px flex-1 bg-slate-100"></div>
    </div>

    <!-- Withdrawal Hike -->
    {{ inputs.renderInputRangePair({
        'id': 'swp_stepup',
        'label': calc_config.swp_stepup.label,
        'min': calc_config.swp_stepup.min,
        'max': calc_config.swp_stepup.max,
        'slider_max': calc_config.swp_stepup.slider_max,
        'step': calc_config.swp_stepup.step,
        'value': swp_stepup,
        'suffix': '%',
        'theme': 'rose',
        'input_text_color': 'text-slate-700 focus:border-rose-400 focus:ring-rose-400/30 focus:ring-1',
        'presets': [
            {'label': '0%', 'value': 0},
            {'label': '5%', 'value': 5},
            {'label': '6%', 'value': 6},
            {'label': '8%', 'value': 8}
        ]
    }) }}
</div>
