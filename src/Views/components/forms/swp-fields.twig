{% import "components/form/input-range-pair.twig" as inputs %}

{% if calculator_type != 'swp' %}
<!-- Lifecycle Accumulation Bridge (Transfer Matured SIP Corpus to SWP Starting Corpus) -->
<div id="swp-accumulation-bridge" class="p-2.5 sm:p-3 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-indigo-50 border border-emerald-200/90 flex items-center justify-between gap-2 shadow-subtle">
    <div class="min-w-0">
        <div class="text-micro font-bold text-growth-emphasis uppercase tracking-wider">SIP Matured Corpus Bridge</div>
        <div class="text-ui-xs font-bold text-slate-800 flex-wrap">Seed with Matured Corpus (<span id="bridge-matured-corpus-val" class="font-financial-mono text-growth-emphasis font-extrabold whitespace-nowrap">₹ --</span>)?</div>
    </div>
    <button type="button" id="apply-sip-to-swp-btn" class="px-2.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-ui-xs font-extrabold shadow-flat active:scale-95 transition-all cursor-pointer whitespace-nowrap shrink-0">
        Sync Corpus
    </button>
</div>
{% endif %}

<!-- Monthly Withdrawal -->
{{ inputs.renderInputRangePair({
    'id': 'swp_withdrawal',
    'label': calc_config.swp_withdrawal.label,
    'min': calc_config.swp_withdrawal.min,
    'max': calc_config.swp_withdrawal.max,
    'slider_max': calc_config.swp_withdrawal.slider_max,
    'step': calc_config.swp_withdrawal.step,
    'value': swp_withdrawal,
    'prefix': '₹',
    'theme': 'blue',
    'presets': [
        {'label': '₹10k', 'value': 10000},
        {'label': '₹25k', 'value': 25000},
        {'label': '₹50k', 'value': 50000},
        {'label': '₹75k', 'value': 75000},
        {'label': '₹1L', 'value': 100000}
    ]
}) }}

<!-- Withdrawal Duration -->
{{ inputs.renderInputRangePair({
    'id': 'swp_years',
    'label': calc_config.swp_years.label,
    'min': calc_config.swp_years.min,
    'max': calc_config.swp_years.max,
    'slider_max': calc_config.swp_years.slider_max,
    'step': calc_config.swp_years.step,
    'value': swp_years_input,
    'suffix': 'Yrs',
    'theme': 'blue',
    'input_text_color': 'text-slate-900 focus:border-blue-500 focus:ring-blue-500/20',
    'presets': [
        {'label': '5Y', 'value': 5},
        {'label': '10Y', 'value': 10},
        {'label': '15Y', 'value': 15},
        {'label': '20Y', 'value': 20},
        {'label': '25Y', 'value': 25},
        {'label': '30Y', 'value': 30}
    ]
}) }}

<!-- SWP Expected Return -->
{{ inputs.renderInputRangePair({
    'id': 'swp_rate',
    'label': calc_config.swp_rate.label,
    'min': calc_config.swp_rate.min,
    'max': calc_config.swp_rate.max,
    'slider_max': calc_config.swp_rate.slider_max,
    'step': calc_config.swp_rate.step,
    'value': swp_rate,
    'suffix': '%',
    'theme': 'blue',
    'input_text_color': 'text-slate-900 focus:border-blue-500 focus:ring-blue-500/20',
    'presets': [
        {'label': '6%', 'value': 6},
        {'label': '7%', 'value': 7},
        {'label': '8%', 'value': 8},
        {'label': '9%', 'value': 9}
    ]
}) }}

<!-- SWP Inflation Escalation -->
<div class="rounded-2xl bg-slate-50/70 border border-slate-200/90 p-2.5 space-y-2 shadow-subtle mt-1">
    <div class="flex items-center justify-between gap-2">
        <span class="text-caption font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>Inflation Escalation</span>
        </span>
        <span class="text-micro font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-full shadow-flat">
            Annual Hikes
        </span>
    </div>

    <!-- Withdrawal Hike -->
    {{ inputs.renderInputRangePair({
        'id': 'swp_stepup',
        'label': calc_config.swp_stepup.label,
        'tooltip': 'Increases your monthly withdrawal by X% each year to counter inflation and preserve your living standard in retirement.',
        'min': calc_config.swp_stepup.min,
        'max': calc_config.swp_stepup.max,
        'slider_max': calc_config.swp_stepup.slider_max,
        'step': calc_config.swp_stepup.step,
        'value': swp_stepup,
        'suffix': '%',
        'theme': 'blue',
        'enterkeyhint': 'done',
        'input_text_color': 'text-slate-900 focus:border-blue-500 focus:ring-blue-500/20',
        'presets': [
            {'label': '0%', 'value': 0},
            {'label': '5%', 'value': 5},
            {'label': '6%', 'value': 6},
            {'label': '8%', 'value': 8}
        ]
    }) }}
</div>


