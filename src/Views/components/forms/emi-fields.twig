{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Loan Principal Amount -->
    {{ inputs.renderInputRangePair({
        'id': 'emi_principal',
        'label': calc_config.emi_principal.label|default('Loan Amount'),
        'tooltip': 'Total principal borrowed from the financial lender.',
        'min': calc_config.emi_principal.min|default(50000),
        'max': calc_config.emi_principal.max|default(50000000),
        'slider_max': calc_config.emi_principal.slider_max|default(10000000),
        'step': calc_config.emi_principal.step|default(25000),
        'value': emi_principal|default(calc_config.emi_principal.default|default(3000000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹10L', 'value': 1000000},
            {'label': '₹25L', 'value': 2500000},
            {'label': '₹30L', 'value': 3000000},
            {'label': '₹50L', 'value': 5000000},
            {'label': '₹75L', 'value': 7500000}
        ]
    }) }}

    <!-- Annual Interest Rate -->
    {{ inputs.renderInputRangePair({
        'id': 'emi_rate',
        'label': calc_config.emi_rate.label|default('Interest Rate'),
        'tooltip': 'Annual interest rate charged by your lender on the borrowing.',
        'min': calc_config.emi_rate.min|default(5.0),
        'max': calc_config.emi_rate.max|default(25.0),
        'slider_max': calc_config.emi_rate.slider_max|default(18.0),
        'step': calc_config.emi_rate.step|default(0.1),
        'value': emi_rate|default(calc_config.emi_rate.default|default(8.5)),
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '8.25%', 'value': 8.25},
            {'label': '8.50%', 'value': 8.50},
            {'label': '9.00%', 'value': 9.00},
            {'label': '10.5%', 'value': 10.5},
            {'label': '12.0%', 'value': 12.0}
        ]
    }) }}

    <!-- Loan Tenure (Years) -->
    {{ inputs.renderInputRangePair({
        'id': 'emi_years',
        'label': calc_config.emi_years.label|default('Loan Tenure'),
        'tooltip': 'Total repayment duration in years.',
        'min': calc_config.emi_years.min|default(1),
        'max': calc_config.emi_years.max|default(30),
        'slider_max': calc_config.emi_years.slider_max|default(30),
        'step': calc_config.emi_years.step|default(1),
        'value': emi_years|default(calc_config.emi_years.default|default(20)),
        'suffix': 'Yrs',
        'theme': 'emerald',
        'presets': [
            {'label': '5Y', 'value': 5},
            {'label': '10Y', 'value': 10},
            {'label': '15Y', 'value': 15},
            {'label': '20Y', 'value': 20},
            {'label': '25Y', 'value': 25}
        ]
    }) }}
</div>
