{% import "components/form/input-range-pair.twig" as inputs %}

<!-- Hidden legacy fields to prevent JS errors -->
<input type="hidden" id="sip" name="sip" value="0">
<input type="hidden" id="stepup" name="stepup" value="0">
<input type="hidden" id="lumpsum" name="lumpsum" value="0">

<div class="space-y-4">
    <div class="mb-2">
        <span class="text-xs font-bold text-emerald-600 tracking-widest uppercase">Loan Parameters</span>
    </div>

    <!-- Loan Principal Amount -->
    {{ inputs.renderInputRangePair({
        'id': 'emi_principal',
        'label': 'Loan Amount (Principal)',
        'min': 50000,
        'max': 50000000,
        'slider_max': 10000000,
        'step': 25000,
        'value': 3000000,
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹10L', 'value': 1000000},
            {'label': '₹25L', 'value': 2500000},
            {'label': '₹30L', 'value': 3000000},
            {'label': '₹50L', 'value': 5000000},
            {'label': '₹75L', 'value': 7500000}
        ]
    }) }}

    <!-- Annual Interest Rate -->
    {{ inputs.renderInputRangePair({
        'id': 'emi_rate',
        'label': 'Interest Rate (% p.a.)',
        'min': 5.0,
        'max': 25.0,
        'slider_max': 18.0,
        'step': 0.1,
        'value': 8.5,
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '8.25%', 'value': 8.25},
            {'label': '8.50%', 'value': 8.50},
            {'label': '9.00%', 'value': 9.00},
            {'label': '10.5%', 'value': 10.5},
            {'label': '12.0%', 'value': 12.0}
        ]
    }) }}

    <!-- Loan Tenure (Years) -->
    {{ inputs.renderInputRangePair({
        'id': 'emi_years',
        'label': 'Repayment Tenure',
        'min': 1,
        'max': 30,
        'slider_max': 30,
        'step': 1,
        'value': 20,
        'suffix': 'Yrs',
        'theme': 'emerald',
        'presets': [
            {'label': '5Y', 'value': 5},
            {'label': '10Y', 'value': 10},
            {'label': '15Y', 'value': 15},
            {'label': '20Y', 'value': 20},
            {'label': '25Y', 'value': 25}
        ]
    }) }}
</div>
