{% import "components/form/input-range-pair.twig" as inputs %}

<!-- Monthly Investment -->
<div id="sip_container">
{{ inputs.renderInputRangePair({
    'id': 'sip',
    'label': calc_config.sip.label,
    'min': calc_config.sip.min,
    'max': calc_config.sip.max,
    'slider_max': calc_config.sip.slider_max,
    'step': calc_config.sip.step,
    'value': sip,
    'prefix': '₹',
    'theme': 'emerald',
    'presets': [
        {'label': '₹5k', 'value': 5000},
        {'label': '₹10k', 'value': 10000},
        {'label': '₹25k', 'value': 25000},
        {'label': '₹50k', 'value': 50000},
        {'label': '₹1L', 'value': 100000}
    ]
}) }}
</div>

<!-- Period (Yrs) -->
{{ inputs.renderInputRangePair({
    'id': 'years',
    'label': calc_config.years.label,
    'min': calc_config.years.min,
    'max': calc_config.years.max,
    'slider_max': calc_config.years.slider_max,
    'step': calc_config.years.step,
    'value': years,
    'suffix': 'Yrs',
    'theme': 'emerald',
    'input_text_color': 'text-slate-700 focus:border-emerald-500 focus:ring-emerald-500/30 focus:ring-1',
    'presets': [
        {'label': '5Y', 'value': 5},
        {'label': '10Y', 'value': 10},
        {'label': '15Y', 'value': 15},
        {'label': '20Y', 'value': 20},
        {'label': '25Y', 'value': 25},
        {'label': '30Y', 'value': 30}
    ]
}) }}

<!-- Expected Return -->
{% set rateLabelHtml %}
<div class="relative flex items-center justify-between mb-1.5">
    <label for="rate" class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">
        Expected Return
    </label>
    <!-- Smart Nudge trigger -->
    <div class="relative">
        <button type="button" id="rate-nudge-btn"
            class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-500 hover:text-emerald-700 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded cursor-pointer"
            aria-haspopup="true" aria-expanded="false"
            aria-controls="rate-nudge-popover">
            <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Not sure?
        </button>

        <!-- Rate Nudge AMFI Guidelines Popover -->
        <div id="rate-nudge-popover" class="hidden absolute right-0 sm:right-auto sm:left-0 top-full mt-2 w-72 sm:w-80 max-w-[calc(100vw-2.5rem)] p-3.5 bg-white/98 backdrop-blur-md rounded-2xl border border-slate-200/90 shadow-2xl z-50 text-left space-y-2.5 animate-in fade-in zoom-in-95 duration-150" role="dialog" aria-label="Historical Return Guidance">
            <div class="flex items-center justify-between border-b border-slate-100 pb-1.5">
                <span class="text-xs font-bold text-slate-900 flex items-center gap-1">
                    <span>📈</span> <span>AMFI Category Guidance</span>
                </span>
                <button type="button" id="rate-nudge-close" class="text-slate-400 hover:text-slate-700 p-1 text-xs cursor-pointer" aria-label="Close Popover">✕</button>
            </div>
            <div class="space-y-1.5 text-[11px]">
                <button type="button" class="smart-rate-option w-full p-2 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-200/80 hover:border-emerald-300 text-left transition-all cursor-pointer flex items-center justify-between shadow-2xs" data-rate="12">
                    <div>
                        <strong class="text-slate-900 block font-bold text-xs">12% • Large Cap / Index</strong>
                        <span class="text-[10px] text-slate-500">Nifty 50 15Y historical benchmark</span>
                    </div>
                    <span class="text-xs font-extrabold text-emerald-700">12%</span>
                </button>
                <button type="button" class="smart-rate-option w-full p-2 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-200/80 hover:border-emerald-300 text-left transition-all cursor-pointer flex items-center justify-between shadow-2xs" data-rate="14">
                    <div>
                        <strong class="text-slate-900 block font-bold text-xs">14% • Flexi / Mid Cap</strong>
                        <span class="text-[10px] text-slate-500">Active equity portfolio growth</span>
                    </div>
                    <span class="text-xs font-extrabold text-emerald-700">14%</span>
                </button>
                <button type="button" class="smart-rate-option w-full p-2 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-200/80 hover:border-emerald-300 text-left transition-all cursor-pointer flex items-center justify-between shadow-2xs" data-rate="9">
                    <div>
                        <strong class="text-slate-900 block font-bold text-xs">9% • Balanced Advantage</strong>
                        <span class="text-[10px] text-slate-500">Dynamic equity/debt hybrid</span>
                    </div>
                    <span class="text-xs font-extrabold text-teal-700">9%</span>
                </button>
                <button type="button" class="smart-rate-option w-full p-2 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-200/80 hover:border-emerald-300 text-left transition-all cursor-pointer flex items-center justify-between shadow-2xs" data-rate="7">
                    <div>
                        <strong class="text-slate-900 block font-bold text-xs">7% • Conservative Debt</strong>
                        <span class="text-[10px] text-slate-500">Fixed income capital preservation</span>
                    </div>
                    <span class="text-xs font-extrabold text-slate-700">7%</span>
                </button>
            </div>
        </div>
    </div>
</div>
{% endset %}

{{ inputs.renderInputRangePair({
    'id': 'rate',
    'label': calc_config.rate.label,
    'label_html': rateLabelHtml,
    'min': calc_config.rate.min,
    'max': calc_config.rate.max,
    'slider_max': calc_config.rate.slider_max,
    'step': calc_config.rate.step,
    'value': rate,
    'suffix': '%',
    'theme': 'emerald',
    'input_text_color': 'text-slate-700 focus:border-emerald-500 focus:ring-emerald-500/30 focus:ring-1',
    'presets': [
        {'label': '10%', 'value': 10},
        {'label': '12%', 'value': 12},
        {'label': '14%', 'value': 14},
        {'label': '15%', 'value': 15}
    ]
}) }}

<!-- Adjustments & Inflation Options -->
<div class="bg-slate-50/70 p-3.5 sm:p-4 rounded-2xl border border-slate-200/80 space-y-4 shadow-2xs mt-2">
    <div class="flex items-center justify-between gap-2 mb-1">
        <span class="text-[11px] font-extrabold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
            <span>⚡</span>
            <span>Adjustments & Inflation</span>
        </span>
        <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100/90 border border-emerald-200/80 px-2 py-0.5 rounded-full">
            Accelerators
        </span>
    </div>

    <!-- Yearly Step-up -->
    {{ inputs.renderInputRangePair({
        'id': 'stepup',
        'label': calc_config.stepup.label,
        'min': calc_config.stepup.min,
        'max': calc_config.stepup.max,
        'slider_max': calc_config.stepup.slider_max,
        'step': calc_config.stepup.step,
        'value': stepup,
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '0%', 'value': 0},
            {'label': '5%', 'value': 5},
            {'label': '10%', 'value': 10},
            {'label': '15%', 'value': 15}
        ]
    }) }}

    <!-- Corporate Salary Appraisal Step-Up Optimizer Callout -->
    <div id="salary-stepup-nudge-box" class="p-2.5 rounded-xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/90 flex items-center justify-between gap-2 shadow-2xs">
        <div class="text-[11px] text-emerald-950 font-medium leading-tight">
            <span>💡 <strong>Career Appraisal:</strong> Step up 10% annually</span>
        </div>
        <button type="button" id="apply-10pct-stepup-btn"
            class="px-2.5 py-1 text-[10px] font-bold rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white shadow-2xs transition-all active:scale-95 cursor-pointer whitespace-nowrap">
            +10% Boost
        </button>
    </div>

    <!-- Expected Inflation -->
    {{ inputs.renderInputRangePair({
        'id': 'inflation',
        'label': calc_config.inflation.label|default('Expected Inflation'),
        'min': calc_config.inflation.min|default(0),
        'max': calc_config.inflation.max|default(15),
        'slider_max': calc_config.inflation.slider_max|default(12),
        'step': calc_config.inflation.step|default(0.5),
        'value': inflation|default(0),
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '0%', 'value': 0},
            {'label': '6%', 'value': 6},
            {'label': '7%', 'value': 7},
            {'label': '8%', 'value': 8}
        ]
    }) }}
</div>
