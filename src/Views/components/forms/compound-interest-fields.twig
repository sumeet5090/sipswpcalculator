{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Principal Deposit Amount -->
    {{ inputs.renderInputRangePair({
        'id': 'ci_principal',
        'label': calc_config.ci_principal.label|default('Initial Principal'),
        'tooltip': 'Initial lump sum deposited or invested.',
        'min': calc_config.ci_principal.min|default(10000),
        'max': calc_config.ci_principal.max|default(10000000),
        'slider_max': calc_config.ci_principal.slider_max|default(5000000),
        'step': calc_config.ci_principal.step|default(10000),
        'value': ci_principal|default(calc_config.ci_principal.default|default(500000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹50k', 'value': 50000},
            {'label': '₹1L', 'value': 100000},
            {'label': '₹5L', 'value': 500000},
            {'label': '₹10L', 'value': 1000000},
            {'label': '₹25L', 'value': 2500000}
        ]
    }) }}

    <!-- Annual Interest Rate -->
    {{ inputs.renderInputRangePair({
        'id': 'ci_rate',
        'label': calc_config.ci_rate.label|default('Annual Rate'),
        'tooltip': 'Nominal annual return rate or interest percentage.',
        'min': calc_config.ci_rate.min|default(1),
        'max': calc_config.ci_rate.max|default(30),
        'slider_max': calc_config.ci_rate.slider_max|default(25),
        'step': calc_config.ci_rate.step|default(0.5),
        'value': ci_rate|default(calc_config.ci_rate.default|default(12)),
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '6%', 'value': 6},
            {'label': '8%', 'value': 8},
            {'label': '10%', 'value': 10},
            {'label': '12%', 'value': 12},
            {'label': '15%', 'value': 15}
        ]
    }) }}

    <!-- Time Period (Years) -->
    {{ inputs.renderInputRangePair({
        'id': 'ci_years',
        'label': calc_config.ci_years.label|default('Investment Duration'),
        'tooltip': 'Total investment period in years.',
        'min': calc_config.ci_years.min|default(1),
        'max': calc_config.ci_years.max|default(40),
        'slider_max': calc_config.ci_years.slider_max|default(30),
        'step': calc_config.ci_years.step|default(1),
        'value': ci_years|default(calc_config.ci_years.default|default(10)),
        'suffix': 'Yrs',
        'theme': 'emerald',
        'presets': [
            {'label': '5Y', 'value': 5},
            {'label': '10Y', 'value': 10},
            {'label': '15Y', 'value': 15},
            {'label': '20Y', 'value': 20},
            {'label': '25Y', 'value': 25}
        ]
    }) }}

    <!-- Compounding Frequency Selector -->
    <div class="group/field relative rounded-2xl bg-white/95 border border-slate-200/90 hover:border-slate-300 p-2.5 sm:p-3 transition-all duration-200 shadow-subtle hover:shadow-card">
        <label for="ci_frequency" class="block text-ui-xs font-bold tracking-tight text-slate-800 select-none mb-2">
            Compounding Frequency
        </label>
        <select id="ci_frequency" name="ci_frequency" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-sm rounded-xl px-3 py-2 font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all cursor-pointer">
            <option value="1">Annually (1 time/year)</option>
            <option value="2">Semi-Annually (2 times/year)</option>
            <option value="4">Quarterly (4 times/year - Bank FD Standard)</option>
            <option value="12" selected>Monthly (12 times/year)</option>
        </select>
        <p class="text-micro text-slate-500 mt-1 font-medium">
            Higher frequencies accelerate compounding yield.
        </p>
    </div>
</div>
