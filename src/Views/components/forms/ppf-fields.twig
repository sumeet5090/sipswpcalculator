{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Annual PPF Deposit -->
    {{ inputs.renderInputRangePair({
        'id': 'ppf_deposit',
        'label': calc_config.ppf_deposit.label|default('Yearly Deposit'),
        'tooltip': 'Annual deposit to your PPF account (Statutory limit: ₹500 to ₹1,50,000 / FY).',
        'min': calc_config.ppf_deposit.min|default(500),
        'max': calc_config.ppf_deposit.max|default(150000),
        'slider_max': calc_config.ppf_deposit.slider_max|default(150000),
        'step': calc_config.ppf_deposit.step|default(500),
        'value': ppf_deposit|default(calc_config.ppf_deposit.default|default(150000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹10k', 'value': 10000},
            {'label': '₹25k', 'value': 25000},
            {'label': '₹50k', 'value': 50000},
            {'label': '₹1L', 'value': 100000},
            {'label': '₹1.5L (Max)', 'value': 150000}
        ]
    }) }}

    <!-- Statutory Interest Rate -->
    {{ inputs.renderInputRangePair({
        'id': 'ppf_rate',
        'label': calc_config.ppf_rate.label|default('Interest Rate'),
        'tooltip': 'Current Govt of India notified PPF interest rate (compounded annually).',
        'min': calc_config.ppf_rate.min|default(5.0),
        'max': calc_config.ppf_rate.max|default(12.0),
        'slider_max': calc_config.ppf_rate.slider_max|default(10.0),
        'step': calc_config.ppf_rate.step|default(0.1),
        'value': ppf_rate|default(calc_config.ppf_rate.default|default(7.1)),
        'suffix': '%',
        'theme': 'emerald',
        'presets': [
            {'label': '7.1% (Govt Rate)', 'value': 7.1},
            {'label': '7.5%', 'value': 7.5},
            {'label': '7.9%', 'value': 7.9},
            {'label': '8.0%', 'value': 8.0}
        ]
    }) }}

    <!-- Tenure with 5-Year Extensions -->
    {{ inputs.renderInputRangePair({
        'id': 'ppf_years',
        'label': calc_config.ppf_years.label|default('PPF Duration'),
        'tooltip': 'Mandatory 15-year base period, extendable in 5-year blocks.',
        'min': calc_config.ppf_years.min|default(15),
        'max': calc_config.ppf_years.max|default(35),
        'slider_max': calc_config.ppf_years.slider_max|default(35),
        'step': calc_config.ppf_years.step|default(5),
        'value': ppf_years|default(calc_config.ppf_years.default|default(15)),
        'suffix': 'Yrs',
        'theme': 'emerald',
        'presets': [
            {'label': '15Y (Base)', 'value': 15},
            {'label': '20Y (+1 Block)', 'value': 20},
            {'label': '25Y (+2 Blocks)', 'value': 25},
            {'label': '30Y (+3 Blocks)', 'value': 30},
            {'label': '35Y (+4 Blocks)', 'value': 35}
        ]
    }) }}

    <!-- Deposit Timing Option -->
    <div class="group/field relative rounded-2xl bg-white/95 border border-slate-200/90 hover:border-slate-300 p-2.5 sm:p-3 transition-all duration-200 shadow-subtle hover:shadow-card">
        <label for="ppf_timing" class="block text-ui-xs font-bold tracking-tight text-slate-800 select-none mb-2">
            Deposit Timing (5th of the Month Rule)
        </label>
        <select id="ppf_timing" name="ppf_timing" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-sm rounded-xl px-3 py-2 font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all cursor-pointer">
            <option value="beginning" selected>Lump Sum before April 5th (Max 12-month interest)</option>
            <option value="monthly">Monthly Installments (before 5th of each month)</option>
        </select>
        <p class="text-micro text-slate-500 mt-1 font-medium">
            Deposits made before the 5th earn interest for that full month.
        </p>
    </div>
</div>
