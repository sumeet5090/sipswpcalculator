{% import "components/form/input-range-pair.twig" as inputs %}
<!-- Initial Lumpsum — only rendered when show_lumpsum is true -->
{% if show_lumpsum %}
{{ inputs.renderInputRangePair({
    'id': 'lumpsum',
    'label': calc_config.lumpsum.label,
    'min': calc_config.lumpsum.min,
