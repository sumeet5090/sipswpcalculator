{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Monthly Basic Salary + DA -->
    {{ inputs.renderInputRangePair({
        'id': 'epf_basic_salary',
        'label': 'Monthly Basic Salary + DA',
        'tooltip': 'Your monthly Basic Pay plus Dearness Allowance (DA). EPF contributions are calculated at 12% of Basic + DA.',
        'min': calc_config.epf_basic_salary.min|default(5000),
        'max': calc_config.epf_basic_salary.max|default(500000),
        'slider_max': calc_config.epf_basic_salary.slider_max|default(200000),
        'step': calc_config.epf_basic_salary.step|default(2500),
        'value': epf_basic_salary|default(calc_config.epf_basic_salary.default|default(50000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹25k', 'value': 25000},
            {'label': '₹50k (Default)', 'value': 50000},
            {'label': '₹75k', 'value': 75000},
            {'label': '₹1L', 'value': 100000},
            {'label': '₹1.5L', 'value': 150000}
        ]
    }) }}

    <!-- Current Age & Retirement Age Grid -->
    <div class="space-y-3">
        <!-- Current Age -->
        {{ inputs.renderInputRangePair({
            'id': 'epf_current_age',
            'label': 'Current Age',
            'tooltip': 'Your current age in years. Salaried employees enrolled in EPFO can contribute until retirement age (58–60).',
            'min': calc_config.epf_current_age.min|default(18),
            'max': calc_config.epf_current_age.max|default(57),
            'slider_max': calc_config.epf_current_age.slider_max|default(55),
            'step': calc_config.epf_current_age.step|default(1),
            'value': epf_current_age|default(calc_config.epf_current_age.default|default(28)),
            'suffix': 'Yrs',
            'theme': 'emerald',
            'presets': [
                {'label': '23 Yrs', 'value': 23},
                {'label': '28 Yrs (Avg)', 'value': 28},
                {'label': '35 Yrs', 'value': 35},
                {'label': '42 Yrs', 'value': 42}
            ]
        }) }}

        <!-- Retirement Age -->
        {{ inputs.renderInputRangePair({
            'id': 'epf_retirement_age',
            'label': 'Retirement Age',
            'tooltip': 'Age at which you retire and withdraw your EPF corpus. Statutory EPFO pension/retirement age is 58 years (extendable to 60).',
            'min': calc_config.epf_retirement_age.min|default(40),
            'max': calc_config.epf_retirement_age.max|default(60),
            'slider_max': calc_config.epf_retirement_age.slider_max|default(60),
            'step': calc_config.epf_retirement_age.step|default(1),
            'value': epf_retirement_age|default(calc_config.epf_retirement_age.default|default(58)),
            'suffix': 'Yrs',
            'theme': 'emerald',
            'presets': [
                {'label': '50 Yrs (Early)', 'value': 50},
                {'label': '55 Yrs', 'value': 55},
                {'label': '58 Yrs (Std)', 'value': 58},
                {'label': '60 Yrs', 'value': 60}
            ]
        }) }}
    </div>

    <!-- VPF % & Annual Salary Hike Grid -->
    <div class="space-y-3">
        <!-- Additional VPF % -->
        {{ inputs.renderInputRangePair({
            'id': 'epf_vpf_percent',
            'label': 'Voluntary PF (VPF %)',
            'tooltip': 'Optional extra contribution above mandatory 12% EPF. Combined Employee EPF + VPF up to ₹2.5L/year earns tax-free interest.',
            'min': calc_config.epf_vpf_percent.min|default(0),
            'max': calc_config.epf_vpf_percent.max|default(50),
            'slider_max': calc_config.epf_vpf_percent.slider_max|default(30),
            'step': calc_config.epf_vpf_percent.step|default(1),
            'value': epf_vpf_percent|default(calc_config.epf_vpf_percent.default|default(0)),
            'suffix': '%',
            'theme': 'emerald',
            'presets': [
                {'label': '0% (EPF Only)', 'value': 0},
                {'label': '5% VPF', 'value': 5},
                {'label': '10% VPF', 'value': 10},
                {'label': '20% VPF', 'value': 20}
            ]
        }) }}

        <!-- Annual Salary Hike -->
        {{ inputs.renderInputRangePair({
            'id': 'epf_salary_hike',
            'label': 'Annual Salary Hike',
            'tooltip': 'Expected yearly increment in Basic + DA. Since EPF is 12% of Basic, your monthly contribution scales with your salary.',
            'min': calc_config.epf_salary_hike.min|default(0),
            'max': calc_config.epf_salary_hike.max|default(20),
            'slider_max': calc_config.epf_salary_hike.slider_max|default(15),
            'step': calc_config.epf_salary_hike.step|default(0.5),
            'value': epf_salary_hike|default(calc_config.epf_salary_hike.default|default(7.0)),
            'suffix': '%',
            'theme': 'emerald',
            'presets': [
                {'label': '0% (Flat)', 'value': 0},
                {'label': '5%', 'value': 5},
                {'label': '7% (Avg)', 'value': 7},
                {'label': '10%', 'value': 10}
            ]
        }) }}
    </div>

    <!-- EPFO Interest Rate & Existing Balance Grid -->
    <div class="space-y-3">
        <!-- EPFO Interest Rate -->
        {{ inputs.renderInputRangePair({
            'id': 'epf_interest_rate',
            'label': 'EPFO Interest Rate',
            'tooltip': 'Annual interest rate declared by EPFO (8.25% for FY 2024-25). Accrued on monthly running balance, credited annually.',
            'min': calc_config.epf_interest_rate.min|default(6.0),
            'max': calc_config.epf_interest_rate.max|default(12.0),
            'slider_max': calc_config.epf_interest_rate.slider_max|default(10.0),
            'step': calc_config.epf_interest_rate.step|default(0.05),
            'value': epf_interest_rate|default(calc_config.epf_interest_rate.default|default(8.25)),
            'suffix': '%',
            'theme': 'emerald',
            'presets': [
                {'label': '8.15%', 'value': 8.15},
                {'label': '8.25% (Current)', 'value': 8.25},
                {'label': '8.50%', 'value': 8.50}
            ]
        }) }}

        <!-- Current EPF Balance -->
        {{ inputs.renderInputRangePair({
            'id': 'epf_current_balance',
            'label': 'Current EPF Balance',
            'tooltip': 'Existing accumulated balance in your UAN / EPF passbook today.',
            'min': calc_config.epf_current_balance.min|default(0),
            'max': calc_config.epf_current_balance.max|default(50000000),
            'slider_max': calc_config.epf_current_balance.slider_max|default(2500000),
            'step': calc_config.epf_current_balance.step|default(25000),
            'value': epf_current_balance|default(calc_config.epf_current_balance.default|default(0)),
            'prefix': '₹',
            'theme': 'emerald',
            'presets': [
                {'label': '₹0', 'value': 0},
                {'label': '₹2L', 'value': 200000},
                {'label': '₹5L', 'value': 500000},
                {'label': '₹10L', 'value': 1000000}
            ]
        }) }}
    </div>

    <!-- Statutory EPS ₹15,000 Wage Ceiling Toggle -->
    <div class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl bg-slate-50/90 border border-slate-200/80 shadow-flat">
        <div class="pr-2">
            <label for="epf_cap_eps" class="text-ui-xs font-extrabold text-slate-800 cursor-pointer block">
                Cap Employer EPS at ₹15,000 Wage Ceiling
            </label>
            <p class="text-micro text-slate-500 mt-0.5">
                Standard EPFO rule: 8.33% EPS capped at ₹1,250/mo; remaining employer 12% stays in EPF.
            </p>
        </div>
        <input type="checkbox" id="epf_cap_eps" name="epf_cap_eps" value="1" checked
            class="w-4 h-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer shrink-0">
    </div>
</div>
