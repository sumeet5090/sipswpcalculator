{% import "components/form/input-range-pair.twig" as inputs %}
{#
  corpus-field.twig
  Dedicated starting corpus input for the SWP-only calculator.
  Semantically distinct from lumpsum-fields.twig:
    - lumpsum = optional one-time contribution alongside SIP (accumulation phase)
    - corpus  = total wealth to start monthly withdrawals from (withdrawal phase)
#}
{{ inputs.renderInputRangePair({
    'id': 'corpus',
    'label': calc_config.corpus.label,
    'min': calc_config.corpus.min,
    'max': calc_config.corpus.max,
    'slider_max': calc_config.corpus.slider_max,
    'step': calc_config.corpus.step,
    'value': (corpus is defined and corpus > 0) ? corpus : calc_config.corpus.default|default(5000000),
    'prefix': '₹',
    'theme': 'amber',
    'presets': [
        {'label': '₹25L', 'value': 2500000},
        {'label': '₹50L', 'value': 5000000},
        {'label': '₹1 Cr', 'value': 10000000},
        {'label': '₹2 Cr', 'value': 20000000},
        {'label': '₹5 Cr', 'value': 50000000}
    ]
}) }}

<!-- Contextual Corpus Milestone Bridge (Reactive In-Flow Link) -->
<div id="contextual-corpus-milestone-bridge" class="hidden my-2 p-2 sm:p-2.5 rounded-2xl bg-amber-50/80 border border-amber-200/85 shadow-flat transition-all" role="region" aria-label="Related SWP Milestone Blueprint">
    <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-1.5 text-micro sm:text-ui-xs font-bold text-slate-800 min-w-0">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-amber-600 text-white shadow-flat shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
            </span>
            <span id="corpus-bridge-message" class="truncate font-semibold text-slate-900">Dedicated Corpus Blueprint available</span>
        </div>
        <a id="corpus-bridge-link" href="#" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-extrabold text-caption shadow-flat shrink-0 transition-transform active:scale-95">
            <span id="corpus-bridge-action">View Guide</span>
            <span>↗</span>
        </a>
    </div>
</div>
