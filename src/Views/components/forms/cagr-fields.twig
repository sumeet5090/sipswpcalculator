{% import "components/form/input-range-pair.twig" as inputs %}

<div class="space-y-3">
    <!-- Initial Investment Value (V_begin) -->
    {{ inputs.renderInputRangePair({
        'id': 'cagr_initial',
        'label': calc_config.cagr_initial.label|default('Initial Investment'),
        'tooltip': 'Starting portfolio value or capital invested at the beginning of the holding period.',
        'min': calc_config.cagr_initial.min|default(1000),
        'max': calc_config.cagr_initial.max|default(10000000),
        'slider_max': calc_config.cagr_initial.slider_max|default(2500000),
        'step': calc_config.cagr_initial.step|default(5000),
        'value': cagr_initial|default(calc_config.cagr_initial.default|default(100000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹25k', 'value': 25000},
            {'label': '₹50k', 'value': 50000},
            {'label': '₹1L', 'value': 100000},
            {'label': '₹5L', 'value': 500000},
            {'label': '₹10L', 'value': 1000000}
        ]
    }) }}

    <!-- Final Investment Value (V_final) -->
    {{ inputs.renderInputRangePair({
        'id': 'cagr_final',
        'label': calc_config.cagr_final.label|default('Target / Final Value'),
        'tooltip': 'Current portfolio valuation or targeted final accumulated wealth.',
        'min': calc_config.cagr_final.min|default(1000),
        'max': calc_config.cagr_final.max|default(50000000),
        'slider_max': calc_config.cagr_final.slider_max|default(10000000),
        'step': calc_config.cagr_final.step|default(10000),
        'value': cagr_final|default(calc_config.cagr_final.default|default(250000)),
        'prefix': '₹',
        'theme': 'emerald',
        'presets': [
            {'label': '₹1L', 'value': 100000},
            {'label': '₹2.5L', 'value': 250000},
            {'label': '₹5L', 'value': 500000},
            {'label': '₹10L', 'value': 1000000},
            {'label': '₹25L', 'value': 2500000}
        ]
    }) }}

    <!-- Holding Duration (Years) -->
    {{ inputs.renderInputRangePair({
        'id': 'cagr_years',
        'label': calc_config.cagr_years.label|default('Investment Duration'),
        'tooltip': 'Total number of years between your initial investment and final value.',
        'min': calc_config.cagr_years.min|default(0.5),
        'max': calc_config.cagr_years.max|default(40),
        'slider_max': calc_config.cagr_years.slider_max|default(25),
        'step': calc_config.cagr_years.step|default(0.5),
        'value': cagr_years|default(calc_config.cagr_years.default|default(5.0)),
        'suffix': 'Yrs',
        'theme': 'emerald',
        'presets': [
            {'label': '1Y', 'value': 1.0},
            {'label': '3Y', 'value': 3.0},
            {'label': '5Y', 'value': 5.0},
            {'label': '7Y', 'value': 7.0},
            {'label': '10Y', 'value': 10.0}
        ]
    }) }}

    {% include 'components/forms/next-step-bridges.twig' with {
        'bridges': [
            {'href': '/sip-calculator', 'label': 'Project monthly SIP at this rate'},
            {'href': '/inflation-calculator', 'label': 'Check real return after inflation'},
            {'href': '/ltcg-tax-calculator', 'label': 'Calculate 12.5% LTCG tax'}
        ]
    } %}
</div>
