{% macro renderInputRangePair(config) %}
    {% set id = config.id %}
    {% set name = config.name|default(id) %}
    {% set label = config.label %}
    {% set min = config.min|default(0) %}
    {% set max = config.max|default(100) %}
    {% set sliderMax = config.slider_max|default(max) %}
    {% set step = config.step|default(1) %}
    {% set sliderStep = config.slider_step|default(step) %}
    {% set value = config.value|default(0) %}
    {% set prefix = config.prefix|default(null) %}
    {% set suffix = config.suffix|default(null) %}
    {% set enterKeyHint = config.enterkeyhint|default('next') %}
    {% set inputMode = prefix == '₹' ? 'numeric' : 'decimal' %}
    
    {% set theme = config.theme|default('emerald') %}
    
    {% set inputFocusBorder = theme == 'rose' 
        ? 'focus-within:border-rose-500 focus-within:ring-rose-500/20' 
        : 'focus-within:border-emerald-500 focus-within:ring-emerald-500/20' %}
        
    {% set rangeColorClass = theme == 'rose' ? 'accent-rose-600' : 'accent-emerald-600' %}
    {% set labelHtml = config.label_html|default(null) %}
    
    {% set presets = config.presets|default(null) %}
    {% set activeChipClass = theme == 'rose' 
        ? 'is-active-rose bg-rose-600 text-white border-rose-600 shadow-flat' 
        : 'is-active bg-emerald-600 text-white border-emerald-600 shadow-flat' %}
    {% set tooltip = config.tooltip|default(null) %}
    
    <div class="group/field relative rounded-2xl bg-white/95 border border-slate-200/90 hover:border-slate-300 p-2.5 sm:p-3 transition-all duration-200 shadow-subtle hover:shadow-card" data-field-id="{{ id }}">
        <!-- Row 1: Label & Stepper Pill (Groww / Zerodha High-Density Inline Pattern) -->
        <div class="flex items-center justify-between gap-2 min-w-0">
            <!-- Left: Label, Tooltip & Word Badge -->
            <div class="flex items-center gap-1.5 min-w-0 flex-1">
                {% if labelHtml %}
                    {{ labelHtml|raw }}
                {% else %}
                    <label for="{{ id }}" id="{{ id }}_label" class="field-label text-ui-xs font-bold tracking-tight text-slate-800 normal-case whitespace-nowrap select-none cursor-pointer hover:text-growth transition-colors leading-snug" title="{{ label }} · Double-click to reset to default">
                        {{ label }}
                    </label>
                    {% if tooltip %}
                        <div class="relative inline-flex items-center group/tip shrink-0">
                            <button type="button" 
                                class="relative w-5 h-5 sm:w-3.5 sm:h-3.5 rounded-full bg-slate-100 hover:bg-growth-surface text-slate-400 hover:text-growth text-micro font-bold inline-flex items-center justify-center border border-slate-200/80 transition-colors cursor-help focus:outline-none focus:ring-1 focus:ring-emerald-500 before:content-[''] before:absolute before:-inset-2.5 before:z-[1]"
                                aria-label="Help: {{ label }}">
                                ℹ
                            </button>
                            <div role="tooltip" 
                                class="absolute left-0 sm:left-1/2 sm:-translate-x-1/2 bottom-full mb-2 hidden group-hover/tip:block group-focus-within/tip:block w-64 max-w-[80vw] p-2.5 bg-white/98 backdrop-blur-md text-slate-700 text-caption leading-relaxed rounded-xl shadow-modal border border-slate-200/90 z-50 pointer-events-none transition-all">
                                <strong class="text-slate-900 block font-bold mb-0.5">{{ label }}</strong>
                                {{ tooltip }}
                            </div>
                        </div>
                    {% endif %}
                    <span id="{{ id }}_word_badge" class="hidden text-micro font-bold text-growth-emphasis bg-growth-surface border border-growth-border px-1.5 py-0.5 rounded-md font-financial-mono transition-all whitespace-nowrap shrink-0"></span>
                {% endif %}
            </div>

            <!-- Right: Integrated Stepper Capsule (Apple HIG 48px Touch Target Hitbox) -->
            <div class="relative inline-flex items-center rounded-xl bg-slate-50/90 border border-slate-200/90 {{ inputFocusBorder }} focus-within:bg-white focus-within:ring-2 transition-all shadow-flat overflow-hidden shrink-0">
                <!-- Decrement Stepper Button -->
                <button type="button" 
                    class="stepper-btn stepper-dec relative w-8 h-8 sm:w-7 sm:h-7 flex items-center justify-center bg-slate-100/90 hover:bg-slate-200 text-slate-600 hover:text-slate-900 active:bg-slate-300 active:scale-95 transition-all select-none cursor-pointer border-r border-slate-200/90 focus:outline-none shrink-0 touch-target-expanded before:content-[''] before:absolute before:-inset-2 before:z-[1]"
                    data-step-action="dec"
                    data-step-for="{{ id }}"
                    data-step-val="{{ step }}"
                    aria-label="Decrease {{ label }}">
                    <svg class="w-3.5 h-3.5 stroke-[2.8] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5"/>
                    </svg>
                </button>

                <!-- Numeric Well (text-body prevents iOS Safari zoom) -->
                <div class="flex items-center justify-center px-1 py-0.5 w-16 sm:w-20 shrink-0">
                    {% if prefix %}
                        <span class="currency-symbol text-caption sm:text-ui-xs font-black text-slate-400 mr-0.5 select-none pointer-events-none shrink-0">{{ prefix }}</span>
                    {% endif %}
                    <input type="text" inputmode="{{ inputMode }}" enterkeyhint="{{ enterKeyHint }}" id="{{ id }}" name="{{ name }}"
                        class="stepper-input w-full !p-0 !border-0 !rounded-none !shadow-none !bg-transparent text-center text-body font-black font-financial-mono tabular-nums text-slate-900 focus:outline-none focus:ring-0 tracking-tight min-w-0"
                        required value="{{ value }}" data-min="{{ min }}" data-max="{{ max }}" data-step="{{ step }}"
                        autocomplete="off" spellcheck="false"
                        aria-describedby="{{ id }}_error">
                    {% if suffix %}
                        <span class="text-caption font-bold text-slate-400 ml-0.5 select-none pointer-events-none shrink-0">{{ suffix }}</span>
                    {% endif %}
                </div>

                <!-- Increment Stepper Button -->
                <button type="button" 
                    class="stepper-btn stepper-inc relative w-8 h-8 sm:w-7 sm:h-7 flex items-center justify-center bg-slate-100/90 hover:bg-slate-200 text-slate-600 hover:text-slate-900 active:bg-slate-300 active:scale-95 transition-all select-none cursor-pointer border-l border-slate-200/90 focus:outline-none shrink-0 touch-target-expanded before:content-[''] before:absolute before:-inset-2 before:z-[1]"
                    data-step-action="inc"
                    data-step-for="{{ id }}"
                    data-step-val="{{ step }}"
                    aria-label="Increase {{ label }}">
                    <svg class="w-3.5 h-3.5 stroke-[2.8] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Dynamic Live Subtext Hint (Indian words notation · Zero-CLS) -->
        <div id="{{ id }}_subtext" class="field-unit-hint text-caption font-bold text-growth-emphasis min-h-[14px] leading-tight select-none mt-0.5 whitespace-normal break-words"></div>

        {# Inline validation error #}
        <p id="{{ id }}_error" role="alert" aria-live="polite"
           class="hidden text-micro font-bold text-payout mt-0.5 field-error"></p>

        <!-- Low-Profile Range Slider Track -->
        <div class="mt-1 px-0.5">
            <input type="range" id="{{ id }}_range" min="{{ min }}" max="{{ sliderMax }}" step="{{ sliderStep }}"
                value="{{ value }}"
                aria-labelledby="{{ id }}_label"
                aria-valuenow="{{ value }}"
                aria-valuemin="{{ min }}"
                aria-valuemax="{{ sliderMax }}"
                class="w-full h-2 bg-slate-200 rounded-full appearance-none cursor-pointer {{ rangeColorClass }}">
        </div>

        {% if presets %}
            <!-- Mobile Horizontal Swipeable Strip / Desktop Flex Row -->
            <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-0.5 mt-1 sm:flex-wrap" role="group" aria-label="{{ label }} quick presets">
                {% for preset in presets %}
                    {% set p_label = preset.label|default(preset) %}
                    {% set p_val = preset.value|default(preset) %}
                    <button type="button" 
                        class="preset-chip text-caption font-bold px-2 py-0.5 min-h-[36px] sm:min-h-[30px] rounded-lg border border-slate-200/90 bg-slate-50 text-slate-700 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-1 focus-visible:ring-emerald-500 transition-all cursor-pointer select-none active:scale-95 shadow-flat text-center justify-center flex items-center shrink-0 whitespace-nowrap {{ value == p_val ? activeChipClass : '' }}"
                        data-preset-for="{{ id }}"
                        data-preset-val="{{ p_val }}"
                        aria-pressed="{{ value == p_val ? 'true' : 'false' }}">
                        {{ p_label }}
                    </button>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endmacro %}
