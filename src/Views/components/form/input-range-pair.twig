{% macro renderInputRangePair(config) %}
    {% set id = config.id %}
    {% set name = config.name|default(id) %}
    {% set label = config.label %}
    {% set min = config.min|default(0) %}
    {% set max = config.max|default(100) %}
    {% set sliderMax = config.slider_max|default(max) %}
    {% set step = config.step|default(1) %}
    {% set sliderStep = config.slider_step|default(step) %}
    {% set value = config.value|default(0) %}
    {% set prefix = config.prefix|default(null) %}
    {% set suffix = config.suffix|default(null) %}
    
    {% set theme = config.theme|default('emerald') %}
    
    {% set inputColorClass = theme == 'rose' 
        ? 'text-rose-700 focus:border-rose-500 focus:ring-rose-500/20' 
        : 'text-emerald-800 focus:border-emerald-500 focus:ring-emerald-500/20' %}
        
    {% set rangeColorClass = theme == 'rose' ? 'accent-rose-600' : 'accent-emerald-600' %}
    {% set textClass = config.input_text_color|default(inputColorClass) %}
    {% set labelHtml = config.label_html|default(null) %}
    
    {% set presets = config.presets|default(null) %}
    {% set activeChipClass = theme == 'rose' ? 'is-active-rose bg-rose-600 text-white border-rose-600 shadow-2xs' : 'is-active bg-emerald-600 text-white border-emerald-600 shadow-2xs' %}
    
    <div class="group/field p-3 sm:p-3.5 rounded-2xl bg-white/95 border border-slate-200/90 shadow-2xs transition-all hover:border-slate-300 hover:shadow-xs" data-field-id="{{ id }}">
        {% if labelHtml %}
            {{ labelHtml|raw }}
        {% else %}
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-1.5 min-w-0">
                    <label for="{{ id }}" id="{{ id }}_label" class="text-xs font-black text-slate-900 tracking-tight block select-none cursor-pointer hover:text-emerald-700 transition-colors" title="Double-click to reset to default">
                        {{ label }}
                    </label>
                    <span id="{{ id }}_word_badge" class="hidden text-[10px] font-extrabold text-emerald-800 bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-md font-mono transition-all truncate"></span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 font-mono tracking-tight select-none shrink-0">
                    {{ prefix }}{{ min }}{{ suffix }} – {{ prefix }}{{ sliderMax }}{{ suffix }}
                </span>
            </div>
        {% endif %}

        <!-- Input & Stepper Dock -->
        <div class="relative flex items-center">
            <button type="button" 
                class="stepper-btn stepper-dec absolute left-1.5 z-10 w-8 h-8 flex items-center justify-center rounded-xl bg-slate-100/90 text-slate-700 hover:bg-slate-200 hover:text-slate-900 active:scale-90 transition-all text-sm font-black select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 cursor-pointer shadow-2xs"
                data-step-action="dec"
                data-step-for="{{ id }}"
                data-step-val="{{ step }}"
                aria-label="Decrease {{ label }}">
                −
            </button>
            {% if prefix %}
                <span class="currency-symbol absolute left-11 sm:left-11 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 pointer-events-none">{{ prefix }}</span>
            {% endif %}
            <input type="text" inputmode="decimal" id="{{ id }}" name="{{ name }}"
                class="w-full bg-slate-50/70 border border-slate-200/90 rounded-xl {{ prefix ? 'pl-14' : 'pl-11' }} {{ suffix ? 'pr-14' : 'pr-11' }} py-2 sm:py-2 text-center text-sm sm:text-base font-black font-mono tabular-nums {{ textClass }} focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all shadow-inner"
                required value="{{ value }}" data-min="{{ min }}" data-max="{{ max }}" data-step="{{ step }}"
                autocomplete="off" spellcheck="false"
                aria-describedby="{{ id }}_error">
            {% if suffix %}
                <span class="absolute right-11 sm:right-11 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 pointer-events-none">{{ suffix }}</span>
            {% endif %}
            <button type="button" 
                class="stepper-btn stepper-inc absolute right-1.5 z-10 w-8 h-8 flex items-center justify-center rounded-xl bg-slate-100/90 text-slate-700 hover:bg-slate-200 hover:text-slate-900 active:scale-90 transition-all text-sm font-black select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 cursor-pointer shadow-2xs"
                data-step-action="inc"
                data-step-for="{{ id }}"
                data-step-val="{{ step }}"
                aria-label="Increase {{ label }}">
                +
            </button>
        </div>

        {# Inline validation error — shown by JS when value is out of bounds #}
        <p id="{{ id }}_error" role="alert" aria-live="polite"
           class="hidden text-[10px] font-bold text-rose-600 mt-1 field-error"></p>
        
        {# Dynamic Live Subtext Hint (e.g. ₹25,000 / mo • ₹3.0 Lakh / yr) #}
        <div id="{{ id }}_subtext" class="field-unit-hint text-[10.5px] font-semibold text-slate-500 mt-1.5 min-h-[16px] transition-all"></div>

        <!-- Range Slider Track -->
        <input type="range" id="{{ id }}_range" min="{{ min }}" max="{{ sliderMax }}" step="{{ sliderStep }}"
            value="{{ value }}"
            aria-labelledby="{{ id }}_label"
            aria-valuenow="{{ value }}"
            aria-valuemin="{{ min }}"
            aria-valuemax="{{ sliderMax }}"
            class="w-full h-2 bg-slate-200/90 rounded-full appearance-none cursor-pointer {{ rangeColorClass }} mt-1.5">

        {% if presets %}
            <div class="flex flex-wrap items-center gap-1.5 mt-2.5" role="group" aria-label="{{ label }} quick presets">
                {% for preset in presets %}
                    {% set p_label = preset.label|default(preset) %}
                    {% set p_val = preset.value|default(preset) %}
                    <button type="button" 
                        class="preset-chip relative text-[10.5px] font-bold px-2.5 py-1 rounded-lg border border-slate-200/90 bg-slate-50 text-slate-700 hover:border-slate-300 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer select-none active:scale-95 shadow-2xs {{ value == p_val ? activeChipClass : '' }}"
                        data-preset-for="{{ id }}"
                        data-preset-val="{{ p_val }}"
                        aria-pressed="{{ value == p_val ? 'true' : 'false' }}">
                        {{ p_label }}
                    </button>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endmacro %}
