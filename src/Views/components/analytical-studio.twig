<!-- Multi-Mode Interactive Analytical Studio -->
<div id="breakdown-studio" class="mt-10 scroll-mt-24">
    <!-- Studio Header & Tab Navigation Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4 pb-2 border-b border-slate-200/80">
        <div>
            <div class="flex items-center gap-2">
                <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-black">📈</span>
                <h3 class="text-base sm:text-lg font-extrabold text-slate-900">Interactive Analytical Studio</h3>
                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Live Simulation</span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">Explore your detailed amortization cashflows, wealth milestones, stress-testing, and FIRE benchmarks</p>
        </div>

        <!-- Studio Segmented Tab Navigation -->
        <nav id="studio-tabs-nav" role="tablist" aria-label="Analytical Studio Modules"
            class="flex items-center gap-1.5 p-1 rounded-2xl bg-slate-100/90 border border-slate-200/80 overflow-x-auto max-w-full custom-scrollbar">
            <!-- Tab 1: Yearly Breakdown Table (Default Active) -->
            <button type="button" role="tab" id="tab-yearly-breakdown" aria-controls="panel-yearly-breakdown" aria-selected="true" tabindex="0"
                class="studio-tab-btn px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition-all cursor-pointer bg-white text-emerald-800 shadow-xs border border-slate-200/90 font-bold flex items-center gap-1.5">
                <span>📊</span>
                <span>Yearly Breakdown</span>
            </button>

            <!-- Tab 2: City FIRE Benchmark -->
            <button type="button" role="tab" id="tab-city-benchmark" aria-controls="panel-city-benchmark" aria-selected="false" tabindex="-1"
                class="studio-tab-btn px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition-all cursor-pointer text-slate-500 hover:text-slate-800 font-medium border border-transparent flex items-center gap-1.5">
                <span>🏙️</span>
                <span>City FIRE Benchmark</span>
            </button>

            <!-- Tab 3: Milestone Roadmap -->
            <button type="button" role="tab" id="tab-milestone-roadmap" aria-controls="panel-milestone-roadmap" aria-selected="false" tabindex="-1"
                class="studio-tab-btn px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition-all cursor-pointer text-slate-500 hover:text-slate-800 font-medium border border-transparent flex items-center gap-1.5">
                <span>🎯</span>
                <span>Milestone Roadmap</span>
            </button>

            <!-- Tab 4: Stress-Test Simulator -->
            <button type="button" role="tab" id="tab-stress-test" aria-controls="panel-stress-test" aria-selected="false" tabindex="-1"
                class="studio-tab-btn px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition-all cursor-pointer text-slate-500 hover:text-slate-800 font-medium border border-transparent flex items-center gap-1.5">
                <span>🛡️</span>
                <span>Crash Stress-Test</span>
            </button>

            <!-- Tab 5: Asset Allocation -->
            <button type="button" role="tab" id="tab-asset-rebalance" aria-controls="panel-asset-rebalance" aria-selected="false" tabindex="-1"
                class="studio-tab-btn px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition-all cursor-pointer text-slate-500 hover:text-slate-800 font-medium border border-transparent flex items-center gap-1.5">
                <span>🔄</span>
                <span>Asset Rebalancing</span>
            </button>
        </nav>
    </div>

    <!-- Studio Tab Panels (All server-rendered in DOM for complete search indexing) -->
    <div class="space-y-4">
        <!-- Panel 1: Yearly Breakdown Table (Default Active) -->
        <div id="panel-yearly-breakdown" role="tabpanel" aria-labelledby="tab-yearly-breakdown" class="studio-tab-panel">
            {% include 'components/yearly-breakdown-table.twig' %}
        </div>

        <!-- Panel 2: City FIRE Benchmark -->
        <div id="panel-city-benchmark" role="tabpanel" aria-labelledby="tab-city-benchmark" class="studio-tab-panel hidden">
            {% include 'components/city-fire-benchmark.twig' %}
        </div>

        <!-- Panel 3: Milestone Roadmap -->
        <div id="panel-milestone-roadmap" role="tabpanel" aria-labelledby="tab-milestone-roadmap" class="studio-tab-panel hidden">
            {% include 'components/wealth-roadmap.twig' %}
        </div>

        <!-- Panel 4: Stress-Test Simulator -->
        <div id="panel-stress-test" role="tabpanel" aria-labelledby="tab-stress-test" class="studio-tab-panel hidden">
            {% include 'components/stress-test-simulator.twig' %}
        </div>

        <!-- Panel 5: Asset Rebalance -->
        <div id="panel-asset-rebalance" role="tabpanel" aria-labelledby="tab-asset-rebalance" class="studio-tab-panel hidden">
            {% include 'components/asset-rebalancing.twig' %}
        </div>
    </div>
</div>
