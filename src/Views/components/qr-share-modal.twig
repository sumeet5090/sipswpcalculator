<!-- Instant Client Proposal QR Code & Mobile Sync Studio Modal -->
<dialog id="qr-share-modal" 
    role="dialog" aria-modal="true"
    class="rounded-3xl border border-slate-200 bg-white/98 backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm shadow-modal text-slate-800 overflow-hidden max-w-lg w-full" 
    aria-labelledby="qr-modal-title">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80 shrink-0">
        <div class="flex items-center gap-2.5 text-left">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-growth-surface text-growth-emphasis border border-growth-border text-ui-xs font-black shadow-flat">✨</span>
            <div>
                <h3 id="qr-modal-title" class="text-ui-sm sm:text-body font-extrabold text-slate-900">Share Wealth Plan</h3>
                <p class="text-caption text-slate-500 font-medium">Wealth Horizon Pass & Mobile Proposal Sync</p>
            </div>
        </div>
        <button type="button" id="close-qr-modal-btn" onclick="document.getElementById('qr-share-modal')?.close()" class="text-slate-400 hover:text-slate-700 p-2 rounded-xl bg-slate-100 hover:bg-slate-200 transition-all cursor-pointer" aria-label="Close Modal">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="p-6 text-center overflow-y-auto custom-scrollbar flex-1 space-y-5 max-h-[85vh]">
        <!-- Pillar 6: Viral Wealth Horizon Pass Studio Section -->
        <div class="p-4 rounded-2xl bg-gradient-to-br from-white via-emerald-50/30 to-teal-50/20 border border-emerald-500/30 shadow-subtle text-left space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-ui-sm">💳</span>
                    <h4 class="text-ui-xs font-extrabold text-slate-900">Wealth Horizon Pass</h4>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-financial-mono text-micro font-bold border border-emerald-200">
                    1200×630 Retina
                </span>
            </div>
            
            <p class="text-caption text-slate-600 leading-relaxed">
                Generate an Apple Wallet-style branded card formatted perfectly for WhatsApp, LinkedIn, and social feeds.
            </p>

            <!-- Discreet Privacy Mode Toggle -->
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/90 border border-slate-200/80 shadow-flat">
                <div class="flex items-center gap-2">
                    <span class="text-ui-xs">🕶️</span>
                    <div>
                        <div class="text-ui-xs font-bold text-slate-800">Discreet Privacy Mode</div>
                        <div class="text-micro text-slate-500">Mask exact amounts into milestone badges (₹**,**,***)</div>
                    </div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer select-none">
                    <input type="checkbox" id="discreet-share-toggle" class="sr-only peer" aria-label="Toggle Discreet Privacy Mode">
                    <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 shadow-flat"></div>
                </label>
            </div>

            <!-- Wealth Pass Trigger Button -->
            <button type="button" id="shareWealthPassBtn" 
                class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-ui-xs shadow-flat transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-2">
                <span>✨</span>
                <span>Generate & Share Wealth Horizon Pass</span>
            </button>
        </div>

        <div class="relative flex items-center justify-center">
            <div class="border-t border-slate-200 w-full"></div>
            <span class="bg-white px-3 text-micro font-bold uppercase text-slate-400 absolute">or scan & sync</span>
        </div>

        <!-- QR Code Pure White Quiet-Zone Container -->
        <div class="p-3 rounded-2xl bg-white border border-slate-200/90 shadow-card inline-block relative z-10">
            <div id="qr-code-canvas-container" class="w-40 h-40 flex items-center justify-center bg-white rounded-xl p-1">
                <!-- QR Code Canvas rendered dynamically by QrShareModalController -->
            </div>
        </div>

        <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-growth-surface text-growth-emphasis border border-growth-border text-micro font-financial-mono font-bold shadow-flat mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Zero-Loss State Encoded</span>
            </div>
            <p class="text-caption text-slate-600 leading-relaxed max-w-xs mx-auto">
                Scan with your phone to open and adjust this plan on mobile.
            </p>
        </div>

        <!-- QR Image Actions -->
        <div class="grid grid-cols-2 gap-2.5">
            <button type="button" id="download-qr-image-btn" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-ui-xs font-bold border border-slate-200 transition-all cursor-pointer flex items-center justify-center gap-1.5 shadow-flat active:scale-95">
                <span>📥</span> <span>Save QR</span>
            </button>
            <button type="button" id="copy-qr-image-btn" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-ui-xs font-bold border border-slate-200 transition-all cursor-pointer flex items-center justify-center gap-1.5 shadow-flat active:scale-95">
                <span>🖼️</span> <span>Copy QR</span>
            </button>
        </div>

        <!-- Copy URL Input & Action -->
        <div class="flex items-center gap-2 pt-1">
            <input type="text" id="qr-share-url-input" readonly 
                class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-ui-xs text-slate-700 font-financial-mono truncate focus:outline-none focus:ring-1 focus:ring-emerald-500 shadow-flat" 
                value="" aria-label="Plan URL">
            <button type="button" id="copy-qr-url-btn" 
                class="px-3.5 py-2 rounded-xl bg-growth hover:bg-growth-emphasis text-white text-ui-xs font-extrabold shadow-flat transition-all active:scale-95 cursor-pointer whitespace-nowrap">
                <span>📋 Copy Link</span>
            </button>
        </div>
    </div>
</dialog>

