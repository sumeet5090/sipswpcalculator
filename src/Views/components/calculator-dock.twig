{#
  Calculator Quick-Switcher Dock
  Above-the-fold horizontal tab navigation providing 1-tap switching across all 17 calculators.
  Clean institutional underline tab design (Zerodha / Stripe style) with zero visual clash.
#}
{% set current_slug = active_page|default('home') %}

{% set dock_calculators = [
    {
        'slug': 'home',
        'href': '/',
        'icon_type': 'dual',
        'short_title': 'SIP + SWP Dual',
        'badge': 'Core'
    },
    {
        'slug': 'sip-calculator',
        'href': '/sip-calculator',
        'icon_type': 'sip',
        'short_title': 'SIP Calculator',
        'badge': null
    },
    {
        'slug': 'swp-calculator',
        'href': '/swp-calculator',
        'icon_type': 'swp',
        'short_title': 'SWP Pension',
        'badge': 'Retire'
    },
    {
        'slug': 'sip-step-up-calculator',
        'href': '/sip-step-up-calculator',
        'icon_type': 'stepup',
        'short_title': 'Step-Up SIP',
        'badge': 'Top-Up'
    },
    {
        'slug': 'my-first-crore-calculator',
        'href': '/my-first-crore-calculator',
        'icon_type': 'target',
        'short_title': '1 Cr SIP Goal',
        'badge': 'Goal'
    },
    {
        'slug': 'reach-5-crore-via-sip',
        'href': '/reach-5-crore-via-sip',
        'icon_type': 'target',
        'short_title': '5 Cr SIP Plan',
        'badge': null
    },
    {
        'slug': 'sip-5000-per-month',
        'href': '/sip-5000-per-month',
        'icon_type': 'sip',
        'short_title': '₹5k/mo SIP',
        'badge': null
    },
    {
        'slug': 'sip-10000-per-month',
        'href': '/sip-10000-per-month',
        'icon_type': 'sip',
        'short_title': '₹10k/mo SIP',
        'badge': null
    },
    {
        'slug': 'compound-interest-calculator',
        'href': '/compound-interest-calculator',
        'icon_type': 'cagr',
        'short_title': 'Compound Interest',
        'badge': null
    },
    {
        'slug': 'inflation-calculator',
        'href': '/inflation-calculator',
        'icon_type': 'inflation',
        'short_title': 'Inflation & CPI',
        'badge': null
    },
    {
        'slug': 'lumpsum-calculator',
        'href': '/lumpsum-calculator',
        'icon_type': 'lumpsum',
        'short_title': 'Lumpsum',
        'badge': null
    },
    {
        'slug': 'retirement-calculator',
        'href': '/retirement-calculator',
        'icon_type': 'fire',
        'short_title': 'Retirement FIRE',
        'badge': null
    },
    {
        'slug': 'target-corpus-calculator',
        'href': '/target-corpus-calculator',
        'icon_type': 'target',
        'short_title': 'Target Corpus',
        'badge': null
    },
    {
        'slug': 'cagr-calculator',
        'href': '/cagr-calculator',
        'icon_type': 'cagr',
        'short_title': 'CAGR Return',
        'badge': null
    },
    {
        'slug': 'emi-calculator',
        'href': '/emi-calculator',
        'icon_type': 'emi',
        'short_title': 'Loan EMI',
        'badge': null
    },
    {
        'slug': 'ppf-calculator',
        'href': '/ppf-calculator',
        'icon_type': 'ppf',
        'short_title': 'PPF Scheme',
        'badge': 'Tax-Free'
    },
    {
        'slug': 'fd-calculator',
        'href': '/fd-calculator',
        'icon_type': 'fd',
        'short_title': 'Fixed Deposit',
        'badge': null
    }
] %}

<nav aria-label="Financial Calculators Quick Switcher" class="relative mb-2.5 sm:mb-3 not-prose border-b border-slate-200/90">
    <!-- Horizontal Scrollable Underline Tab Track (Institutional Stripe/Zerodha Style) -->
    <div id="calculator-dock-track" class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto no-scrollbar scroll-smooth -mb-px">
        {% for item in dock_calculators %}
            {% set is_active = (current_slug == item.slug) %}
            <a href="{{ item.href }}"
               id="dock-pill-{{ item.slug }}"
               class="shrink-0 flex items-center gap-1.5 px-3 sm:px-3.5 py-2.5 text-ui-xs transition-all duration-150 whitespace-nowrap {{ is_active ? 'border-b-2 border-emerald-600 text-slate-900 font-extrabold' : 'border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 font-semibold' }}"
               {% if is_active %}aria-current="page"{% endif %}
               title="{{ item.short_title }} — Indian Financial Calculator">
                <span class="inline-flex items-center shrink-0 {{ is_active ? 'text-emerald-700' : 'text-slate-400 group-hover:text-slate-600' }}" aria-hidden="true">
                    {% if item.icon_type == 'dual' %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                    {% elseif item.icon_type == 'sip' or item.icon_type == 'stepup' or item.icon_type == 'cagr' %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    {% elseif item.icon_type == 'swp' %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    {% elseif item.icon_type == 'target' %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><circle cx="12" cy="12" r="5" stroke-width="2"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
                    {% elseif item.icon_type == 'inflation' %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
                    {% elseif item.icon_type == 'lumpsum' or item.icon_type == 'fd' %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {% elseif item.icon_type == 'emi' or item.icon_type == 'ppf' %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    {% else %}
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {% endif %}
                </span>
                <span>{{ item.short_title }}</span>
                {% if item.badge %}
                    <span class="text-micro font-extrabold uppercase px-1.5 py-0.2 rounded-full tracking-wider leading-none {{ is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' }}">
                        {{ item.badge }}
                    </span>
                {% endif %}
            </a>
        {% endfor %}
    </div>
</nav>

<script>
    // Smooth auto-scroll active dock pill into viewport on load
    (function () {
        function scrollActiveDockPill() {
            var activePill = document.querySelector('#calculator-dock-track a[aria-current="page"]');
            var track = document.getElementById('calculator-dock-track');
            if (activePill && track) {
                var trackRect = track.getBoundingClientRect();
                var pillRect = activePill.getBoundingClientRect();
                if (pillRect.left < trackRect.left || pillRect.right > trackRect.right) {
                    activePill.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                }
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scrollActiveDockPill);
        } else {
            scrollActiveDockPill();
        }
    })();
</script>
