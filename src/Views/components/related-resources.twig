{# Related Resources Component
   Displays cross-category related posts to strengthen internal linking and reader discovery.
   Expected variables:
     - all_posts: array of all blog posts (from BlogRepository::getAllPosts)
     - seo_category: current post's category slug (growth, retirement, comparison)
     - current_href: current post's href (optional, to exclude self)
#}

{% set current_href = current_href|default(request.server('REQUEST_URI', '/')) %}
{% set current_cat = seo_category|default(category|default('')) %}

{# Related Resources — cross-category posts for internal link equity #}
{% if all_posts is defined and all_posts is not empty %}
    {% set related = [] %}
    {% for post in all_posts %}
        {% set post_cat = post.seo_category|default(post.category|default('')) %}
        {# Pick posts from OTHER categories, excluding the current post #}
        {% if post_cat != current_cat and post.href != current_href and related|length < 3 %}
            {% set related = related|merge([post]) %}
        {% endif %}
    {% endfor %}

    {# If we didn't get 3 from other categories, fill with same-category posts #}
    {% if related|length < 3 %}
        {% for post in all_posts %}
            {% if post.href != current_href and post not in related and related|length < 3 %}
                {% set related = related|merge([post]) %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if related|length > 0 %}
    <section class="mt-8 mb-12" aria-label="Related Resources">
        <h3 class="text-lg font-extrabold text-slate-800 mb-5 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
            </svg>
            Continue Reading
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {% for post in related %}
                {% set border_hover = 'hover:border-emerald-200' %}
                {% set tag_badge = 'bg-emerald-50 text-emerald-700 border-emerald-100' %}
                {% set title_hover = 'group-hover:text-emerald-700' %}
                {% set post_cat = post.seo_category|default(post.category|default('')) %}
                {% if post_cat == 'retirement' %}
                    {% set border_hover = 'hover:border-indigo-200' %}
                    {% set tag_badge = 'bg-indigo-50 text-indigo-700 border-indigo-100' %}
                    {% set title_hover = 'group-hover:text-indigo-700' %}
                {% elseif post_cat == 'comparison' %}
                    {% set border_hover = 'hover:border-amber-200' %}
                    {% set tag_badge = 'bg-amber-50 text-amber-700 border-amber-100' %}
                    {% set title_hover = 'group-hover:text-amber-700' %}
                {% endif %}

                <a href="{{ post.href }}"
                    class="group block p-5 rounded-xl border border-slate-200/80 bg-white hover:shadow-card {{ border_hover }} transition-all duration-200">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-micro font-black uppercase tracking-wider {{ tag_badge }} mb-3">
                        {{ post.tag|default('Guide') }}
                    </span>
                    <h4 class="text-sm font-bold text-slate-800 {{ title_hover }} transition-colors leading-snug mb-2 line-clamp-2">
                        {{ post.title }}
                    </h4>
                    <p class="text-xs text-slate-400 flex items-center gap-2">
                        <span>{{ post.read_time|default('5 min') }} read</span>
                        <span>&middot;</span>
                        <span>{{ post.date|default('2026') }}</span>
                    </p>
                </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}
{% endif %}
