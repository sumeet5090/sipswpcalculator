{# Related Resources Component
   Displays a calculator CTA and cross-category related posts to strengthen internal linking.
   Expected variables:
     - all_posts: array of all blog posts (from BlogRepository::getAllPosts)
     - seo_category: current post's category slug (growth, retirement, comparison)
     - current_href: current post's href (optional, to exclude self)
#}

{% set current_href = current_href|default(request.server('REQUEST_URI', '/')) %}
{% set current_cat = seo_category|default(category|default('')) %}

{# Irresistible Interactive Wealth Projection Sandbox CTA #}
{% if is_calculator_route is not defined or not is_calculator_route %}
<section class="mt-12 mb-8" aria-label="Simulate Your Wealth Journey">
    <div class="relative overflow-hidden rounded-3xl bg-white/95 backdrop-blur-md border border-slate-200/90 shadow-card hover:shadow-card-hover transition-all duration-300 p-6 sm:p-8 md:p-10">
        <!-- Ambient Aurora Depth Glow (Pure Light Mode) -->
        <div class="absolute top-0 right-0 w-80 h-80 bg-gradient-to-br from-emerald-400/12 via-teal-300/8 to-transparent rounded-full blur-3xl -mr-24 -mt-24 pointer-events-none" aria-hidden="true"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-gradient-to-tr from-cyan-400/10 via-emerald-300/6 to-transparent rounded-full blur-2xl -ml-20 -mb-20 pointer-events-none" aria-hidden="true"></div>

        <div class="relative z-elevated">
            <!-- Eyebrow & Live Pulse Badge -->
            <div class="flex flex-wrap items-center gap-2.5 mb-3.5">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-100/80">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                    </span>
                    {% if current_cat == 'retirement' %}
                        Retirement Longevity Sandbox
                    {% elseif current_cat == 'comparison' %}
                        Returns &amp; Tax Alpha Engine
                    {% else %}
                        Live Compounding Simulator
                    {% endif %}
                </span>
                <span class="text-caption font-bold text-slate-500 hidden xs:inline-flex items-center gap-1">
                    <span>⚡ Real-Time Instant Math</span>
                    <span>&bull;</span>
                    <span>Zero Sign-Up Required</span>
                </span>
            </div>

            <!-- Value Hook Headline & Dynamic Copy -->
            <div class="max-w-3xl mb-6">
                <h3 class="text-xl sm:text-2xl md:text-3xl font-heading font-black text-slate-900 tracking-tight leading-snug mb-2">
                    {% if current_cat == 'retirement' %}
                        How long will your corpus last with monthly SWP?
                    {% elseif current_cat == 'comparison' %}
                        Mutual Fund SIP vs FD vs Lumpsum: Run the real numbers
                    {% else %}
                        What could your ₹10,000/month SIP grow into?
                    {% endif %}
                </h3>
                <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
                    {% if current_cat == 'retirement' %}
                        Model safe withdrawal rates, inflation-adjusted step-up income, and capital longevity with institutional Section 112A tax waterfall analytics.
                    {% elseif current_cat == 'comparison' %}
                        Compare post-tax returns, inflation drag, and compounding trajectories under Finance (No. 2) Act, 2024 capital gains rules down to the paisa.
                    {% else %}
                        See how adding a simple 10% annual salary step-up turns modest monthly savings into multi-crore wealth with zero market timing stress.
                    {% endif %}
                </p>
            </div>

            <!-- Stylized Interactive Micro-Preview Sandbox -->
            <div class="mb-7 p-4 sm:p-5 rounded-2xl bg-slate-50/90 border border-slate-200/80 grid grid-cols-1 sm:grid-cols-3 gap-3.5 sm:gap-4 items-center">
                {% if current_cat == 'retirement' %}
                    <div class="flex flex-col">
                        <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Starting Corpus</span>
                        <span class="text-base sm:text-lg font-black text-slate-900 font-financial-mono">₹1.00 Crore</span>
                        <span class="text-caption text-slate-400">Equity/Hybrid allocation</span>
                    </div>
                    <div class="flex items-center gap-2 border-y sm:border-y-0 sm:border-x border-slate-200/60 py-2 sm:py-0 sm:px-4">
                        <div class="flex flex-col">
                            <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Monthly SWP Pension</span>
                            <span class="text-base sm:text-lg font-black text-emerald-700 font-financial-mono">₹50,000 / mo</span>
                            <span class="text-caption text-emerald-600 font-bold">+5% Annual hike</span>
                        </div>
                    </div>
                    <div class="flex flex-col sm:items-end">
                        <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Corpus Longevity</span>
                        <span class="text-base sm:text-lg font-extrabold text-indigo-700 font-financial-mono">32+ Years</span>
                        <span class="text-caption text-indigo-600 font-bold">Capital Preserved ✨</span>
                    </div>
                {% elseif current_cat == 'comparison' %}
                    <div class="flex flex-col">
                        <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">₹10,000/mo for 10 Yrs</span>
                        <span class="text-base sm:text-lg font-black text-slate-900 font-financial-mono">₹12.0L Invested</span>
                        <span class="text-caption text-slate-400">Disciplined capital</span>
                    </div>
                    <div class="flex items-center gap-2 border-y sm:border-y-0 sm:border-x border-slate-200/60 py-2 sm:py-0 sm:px-4">
                        <div class="flex flex-col">
                            <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Bank FD (Post-Tax)</span>
                            <span class="text-base sm:text-lg font-black text-slate-700 font-financial-mono">~₹17.4 Lakhs</span>
                            <span class="text-caption text-slate-400">30% Tax slab drag</span>
                        </div>
                    </div>
                    <div class="flex flex-col sm:items-end">
                        <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Equity SIP (12% CAGR)</span>
                        <span class="text-base sm:text-lg font-extrabold text-emerald-700 font-financial-mono">~₹23.2 Lakhs</span>
                        <span class="text-caption text-emerald-600 font-bold">+₹5.8 Lakhs Alpha ✨</span>
                    </div>
                {% else %}
                    <div class="flex flex-col">
                        <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Monthly SIP</span>
                        <span class="text-base sm:text-lg font-black text-slate-900 font-financial-mono">₹10,000 / mo</span>
                        <span class="text-caption text-slate-400">With 10% annual step-up</span>
                    </div>
                    <div class="flex items-center gap-2 border-y sm:border-y-0 sm:border-x border-slate-200/60 py-2 sm:py-0 sm:px-4">
                        <div class="flex flex-col">
                            <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Tenure &amp; Return</span>
                            <span class="text-base sm:text-lg font-black text-slate-800 font-financial-mono">15 Yrs @ 12%</span>
                            <span class="text-caption text-slate-500">₹38.1L Total Invested</span>
                        </div>
                    </div>
                    <div class="flex flex-col sm:items-end">
                        <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Expected Future Corpus</span>
                        <span class="text-base sm:text-lg font-extrabold text-emerald-700 font-financial-mono">₹82.68 Lakhs</span>
                        <span class="text-caption text-emerald-600 font-bold">+₹44.5L Wealth Gain ✨</span>
                    </div>
                {% endif %}
            </div>

            <!-- Action Dispatcher & Trust Signals -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-2 border-t border-slate-100">
                <div class="flex items-center gap-4 text-ui-xs font-bold text-slate-500">
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>SEBI / AMFI Formula Certified</span>
                    </span>
                    <span class="hidden md:inline-flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-teal-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        <span>100% Client-Side Privacy</span>
                    </span>
                </div>

                <a href="{% if current_cat == 'retirement' %}/swp-calculator{% else %}/#calculator-card{% endif %}"
                    class="group inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 hover:from-emerald-500 hover:to-teal-600 text-white font-extrabold text-sm sm:text-base shadow-card hover:shadow-card-hover transition-all duration-200 active:scale-[0.98] min-h-[48px] touch-manipulation">
                    <span>
                        {% if current_cat == 'retirement' %}
                            Simulate My Retirement Drawdown
                        {% elseif current_cat == 'comparison' %}
                            Launch Head-to-Head Comparison
                        {% else %}
                            Simulate My Compounding Goals
                        {% endif %}
                    </span>
                    <svg class="w-4 h-4 text-white group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</section>
{% endif %}

{# Related Resources — cross-category posts for internal link equity #}
{% if all_posts is defined and all_posts is not empty %}
    {% set related = [] %}
    {% for post in all_posts %}
        {% set post_cat = post.seo_category|default(post.category|default('')) %}
        {# Pick posts from OTHER categories, excluding the current post #}
        {% if post_cat != current_cat and post.href != current_href and related|length < 3 %}
            {% set related = related|merge([post]) %}
        {% endif %}
    {% endfor %}

    {# If we didn't get 3 from other categories, fill with same-category posts #}
    {% if related|length < 3 %}
        {% for post in all_posts %}
            {% if post.href != current_href and post not in related and related|length < 3 %}
                {% set related = related|merge([post]) %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if related|length > 0 %}
    <section class="mt-8 mb-12" aria-label="Related Resources">
        <h3 class="text-lg font-extrabold text-slate-800 mb-5 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
            </svg>
            Continue Reading
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {% for post in related %}
                {% set border_hover = 'hover:border-emerald-200' %}
                {% set tag_badge = 'bg-emerald-50 text-emerald-700 border-emerald-100' %}
                {% set title_hover = 'group-hover:text-emerald-700' %}
                {% set post_cat = post.seo_category|default(post.category|default('')) %}
                {% if post_cat == 'retirement' %}
                    {% set border_hover = 'hover:border-indigo-200' %}
                    {% set tag_badge = 'bg-indigo-50 text-indigo-700 border-indigo-100' %}
                    {% set title_hover = 'group-hover:text-indigo-700' %}
                {% elseif post_cat == 'comparison' %}
                    {% set border_hover = 'hover:border-amber-200' %}
                    {% set tag_badge = 'bg-amber-50 text-amber-700 border-amber-100' %}
                    {% set title_hover = 'group-hover:text-amber-700' %}
                {% endif %}

                <a href="{{ post.href }}"
                    class="group block p-5 rounded-xl border border-slate-200/80 bg-white hover:shadow-card {{ border_hover }} transition-all duration-200">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-micro font-black uppercase tracking-wider {{ tag_badge }} mb-3">
                        {{ post.tag|default('Guide') }}
                    </span>
                    <h4 class="text-sm font-bold text-slate-800 {{ title_hover }} transition-colors leading-snug mb-2 line-clamp-2">
                        {{ post.title }}
                    </h4>
                    <p class="text-xs text-slate-400 flex items-center gap-2">
                        <span>{{ post.read_time|default('5 min') }} read</span>
                        <span>&middot;</span>
                        <span>{{ post.date|default('2026') }}</span>
                    </p>
                </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}
{% endif %}
