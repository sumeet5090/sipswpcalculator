            <!-- Tier-2 Cities -->
            <button type="button" class="city-choice-btn group p-3 rounded-2xl bg-slate-50/90 border border-slate-200/90 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all duration-200 cursor-pointer col-span-2 sm:col-span-1"
