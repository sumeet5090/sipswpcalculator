        <!-- ========================================================================= -->
        <!-- ACTION POD: ADOPT TARGET AS SCENARIO GOAL (NON-DESTRUCTIVE CONFIRMATION)  -->
        <!-- ========================================================================= -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-1">
            <p class="text-xs text-slate-500 font-medium">
