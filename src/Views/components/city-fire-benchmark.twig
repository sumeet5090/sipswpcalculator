                    <strong class="text-xs font-black text-slate-900 group-hover:text-emerald-900">Tier-2 Cities</strong>
                    <span class="w-2 h-2 rounded-full bg-slate-300 group-hover:bg-slate-400"></span>
                </div>
                <div class="text-[11px] font-extrabold text-slate-700 font-mono city-expense-label">₹45k/mo</div>
                <div class="text-[9.5px] text-slate-500 font-medium">Kochi/Indore/Jaipur</div>
