<!-- Indian City Cost of Living & FIRE Retirement Benchmark Studio -->
<div id="city-fire-benchmark-card" class="p-5 sm:p-6 rounded-3xl bg-white/95 backdrop-blur-md text-slate-800 border border-slate-200 shadow-xl relative overflow-hidden spotlight-card">
    <!-- Ambient Glow -->
    <div class="absolute -right-16 -top-16 w-56 h-56 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2.5">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200 text-sm font-black">🏙️</span>
                <div>
                    <h4 class="text-xs sm:text-sm font-extrabold text-slate-900">City Cost of Living &amp; FIRE Benchmark</h4>
                    <p class="text-[11px] text-slate-500">Calculate exact FIRE retirement corpus for your city</p>
                </div>
            </div>
            <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                25× Rule Matrix
            </span>
        </div>

        <!-- City Selector Buttons -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-4" role="tablist" aria-label="City Selection">
            <button type="button" class="city-choice-btn p-2.5 rounded-xl bg-white border-2 border-emerald-500 text-slate-900 text-left transition-all cursor-pointer shadow-sm" data-city="mumbai" data-expense="85000" data-corpus="25500000" data-sip="36800">
                <strong class="text-xs block">Mumbai</strong>
                <span class="text-[10px] text-slate-500">₹85k / mo exp</span>
            </button>
            <button type="button" class="city-choice-btn p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all cursor-pointer" data-city="bengaluru" data-expense="75000" data-corpus="22500000" data-sip="32500">
                <strong class="text-xs block">Bengaluru</strong>
                <span class="text-[10px] text-slate-500">₹75k / mo exp</span>
            </button>
            <button type="button" class="city-choice-btn p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all cursor-pointer" data-city="delhi" data-expense="70000" data-corpus="21000000" data-sip="30300">
                <strong class="text-xs block">Delhi NCR</strong>
                <span class="text-[10px] text-slate-500">₹70k / mo exp</span>
            </button>
            <button type="button" class="city-choice-btn p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all cursor-pointer" data-city="pune" data-expense="60000" data-corpus="18000000" data-sip="26000">
                <strong class="text-xs block">Pune / Hyd</strong>
                <span class="text-[10px] text-slate-500">₹60k / mo exp</span>
            </button>
            <button type="button" class="city-choice-btn p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all cursor-pointer col-span-2 sm:col-span-1" data-city="tier2" data-expense="45000" data-corpus="13500000" data-sip="19500">
                <strong class="text-xs block">Tier-2 Cities</strong>
                <span class="text-[10px] text-slate-500">₹45k / mo exp</span>
            </button>
        </div>

        <!-- Metrics Preview Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80 mb-4">
            <div>
                <div class="text-[10px] uppercase font-bold text-slate-500">Monthly Living Cost</div>
                <div id="city-preview-expense" class="text-sm font-extrabold text-slate-900 font-mono mt-0.5">₹85,000 / mo</div>
            </div>
            <div>
                <div class="text-[10px] uppercase font-bold text-slate-500">25× Target FIRE Corpus</div>
                <div id="city-preview-corpus" class="text-sm font-extrabold text-emerald-700 font-mono mt-0.5">₹2.55 Crore</div>
            </div>
            <div>
                <div class="text-[10px] uppercase font-bold text-slate-500">15-Yr SIP Required (@12%)</div>
                <div id="city-preview-sip" class="text-sm font-extrabold text-teal-700 font-mono mt-0.5">₹36,800 / mo</div>
            </div>
        </div>

        <button type="button" id="apply-city-benchmark-btn"
            class="w-full py-2.5 px-4 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-500 active:scale-98 text-white shadow-md shadow-emerald-600/20 transition-all cursor-pointer text-xs flex items-center justify-center gap-2">
            <span>⚡ Apply This City Strategy to Calculator</span>
        </button>
    </div>
</div>
