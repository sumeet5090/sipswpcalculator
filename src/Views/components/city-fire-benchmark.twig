<!-- Indian City Cost of Living & FIRE Retirement Benchmark Studio -->
<div id="city-fire-benchmark-card" class="p-5 sm:p-6 rounded-3xl bg-white/95 backdrop-blur-md text-slate-900 border border-slate-200/90 shadow-sm relative overflow-hidden">
