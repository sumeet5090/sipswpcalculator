            <!-- Delhi NCR -->
            <button type="button" class="city-choice-btn group p-3 rounded-2xl bg-slate-50/90 border border-slate-200/90 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all duration-200 cursor-pointer"
                data-city="delhi" data-base-expense="70000" data-inflation="7.0">
                <div class="flex items-center justify-between mb-1">
                    <strong class="text-xs font-black text-slate-900 group-hover:text-emerald-900">Delhi NCR</strong>
                    <span class="w-2 h-2 rounded-full bg-slate-300 group-hover:bg-slate-400"></span>
