<!-- Interactive Goal Commitment & Investor Pledge Studio Modal -->
<div id="goal-commitment-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-md hidden" role="dialog" aria-modal="true" aria-labelledby="pledge-modal-title">
    <div class="relative w-full max-w-xl bg-slate-900 text-white rounded-3xl border border-slate-700/80 shadow-2xl overflow-hidden p-6 sm:p-8 animate-in fade-in zoom-in-95 duration-200">
        <!-- Ambient Glow -->
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Header -->
        <div class="flex items-center justify-between gap-3 mb-6 relative z-10">
            <div class="flex items-center gap-2.5">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-sm font-black">📜</span>
                <div>
                    <h3 id="pledge-modal-title" class="text-xs sm:text-sm font-extrabold text-white">Investor Goal Commitment Certificate</h3>
                    <p class="text-[11px] text-slate-400">Anchor your long-term compounding discipline with a signed pledge</p>
                </div>
            </div>
            <button type="button" id="close-pledge-modal-btn" class="text-slate-400 hover:text-white p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 transition-all cursor-pointer" aria-label="Close Modal">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Certificate Card Body -->
        <div id="pledge-certificate-card" class="p-6 rounded-2xl bg-gradient-to-b from-slate-800/90 to-slate-800/40 border-2 border-emerald-500/40 relative z-10 mb-6 shadow-inner text-center space-y-4">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 text-[10px] font-extrabold uppercase tracking-wider">
                🛡️ SOVEREIGN DISCIPLINE CONTRACT
            </div>

            <div class="text-sm font-medium text-slate-300">
                I, <input type="text" id="pledge-investor-name" value="Disciplined Investor" class="text-center font-extrabold text-white bg-slate-900/80 border-b-2 border-emerald-400 px-2 py-0.5 rounded focus:outline-none focus:ring-1 focus:ring-emerald-400 transition-all text-sm inline-block max-w-[200px]" placeholder="Your Name" aria-label="Investor Name">, hereby pledge to systematically invest:
            </div>

            <div class="py-2">
                <div id="pledge-sip-display" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono tracking-tight">₹25,000 / month</div>
                <div class="text-xs text-slate-400 mt-1">Every month without emotional interruption</div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-left pt-2 border-t border-slate-700/60">
                <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-700/60">
                    <div class="text-[10px] uppercase font-bold text-slate-400">Target Horizon</div>
                    <div id="pledge-horizon-display" class="text-xs font-extrabold text-white font-mono mt-0.5">15 Years</div>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-700/60">
                    <div class="text-[10px] uppercase font-bold text-slate-400">Target Corpus</div>
                    <div id="pledge-target-display" class="text-xs font-extrabold text-emerald-400 font-mono mt-0.5">₹1.26 Crore</div>
                </div>
            </div>

            <div class="text-[10px] text-slate-400 italic pt-1">
                "Market volatility is the fee for exceptional long-term wealth compounding."
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-end gap-2.5 relative z-10">
            <button type="button" id="copy-pledge-btn" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5">
                <span>📋 Copy Text Pledge</span>
            </button>
            <button type="button" id="print-pledge-btn" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold shadow-md shadow-emerald-900/40 transition-all cursor-pointer flex items-center gap-1.5">
                <span>🖨️ Print / Save PDF</span>
            </button>
        </div>
    </div>
</div>
