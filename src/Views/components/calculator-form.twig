{% import "components/form/input-range-pair.twig" as inputs %}

<script type="application/json" id="calculator-app-state">
    {{ (calc_config|default({})|merge({'theme': theme_tokens}))|json_island }}
</script>

<div id="{{ container_id|default('calculator-app') }}"
     data-js="calculator-app"
     data-mode="{{ calculator_type|default('combo') }}"
     class="bg-white/95 rounded-3xl border border-slate-200/90 shadow-card backdrop-blur-xl p-3.5 sm:p-4 relative flex flex-col flex-1 min-h-0 md:h-full">
    <!-- Ambient Aurora Glow (Pure Light Mode: Emerald & Teal Accents) -->
    <div class="absolute -right-16 -top-16 w-48 h-48 bg-emerald-400/8 rounded-full blur-3xl pointer-events-none"></div>

    <form method="post" novalidate id="calculator-form" class="relative z-10 flex flex-col flex-1 min-h-0 space-y-3">
        <!-- SECURITY: Honeypot field (hidden from real users, catches bots) -->
        <div style="position: absolute; left: -9999px; top: -9999px;" aria-hidden="true">
            <label for="website_url">Leave this field empty</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
        </div>

        <!-- Privacy & Client-Side Sandbox Seal (Desktop; mobile is covered by dock) -->
        <div class="hidden sm:flex flex-wrap items-center justify-between px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200/80 text-caption gap-2">
            <div class="flex items-center gap-1.5 text-slate-700 min-w-0">
                <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <span class="font-extrabold text-slate-800 truncate">100% Client-Side Private</span>
            </div>
            <span class="text-micro text-growth-emphasis font-bold bg-growth-surface px-2 py-0.5 rounded-md border border-growth-border whitespace-nowrap shrink-0"
                  title="Calculations execute entirely in your browser sandbox. Zero PII transmitted.">
                Zero PII Transmitted
            </span>
        </div>

        <!-- 3-Mode Segmented Control Bar (Dual vs SIP Only vs SWP Only) -->
        <div class="py-0.5 mb-2 rounded-2xl">
            <div class="flex bg-slate-100/90 p-1 rounded-2xl border border-slate-200/70 shadow-flat gap-1" role="tablist" aria-label="Calculator Mode Selector">
                <button type="button" id="tab-combo" role="tab" aria-selected="{% if calculator_type|default('combo') == 'combo' %}true{% else %}false{% endif %}"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 text-ui-xs font-extrabold uppercase tracking-wider rounded-xl transition-all duration-200 {% if calculator_type|default('combo') == 'combo' %}bg-white text-emerald-900 shadow-flat border border-slate-200/60{% else %}text-slate-500 hover:text-slate-900{% endif %} cursor-pointer">
                    <span class="w-2 h-2 rounded-full {% if calculator_type|default('combo') == 'combo' %}bg-emerald-600{% else %}bg-slate-300{% endif %}"></span>
                    <span>Dual (SIP+SWP)</span>
                </button>
                <button type="button" id="tab-sip" role="tab" aria-selected="{% if calculator_type|default('combo') == 'sip' %}true{% else %}false{% endif %}"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 text-ui-xs font-bold uppercase tracking-wider rounded-xl transition-all duration-200 {% if calculator_type|default('combo') == 'sip' %}bg-white text-emerald-900 shadow-flat border border-slate-200/60{% else %}text-slate-500 hover:text-slate-900{% endif %} cursor-pointer">
                    <span class="w-2 h-2 rounded-full {% if calculator_type|default('combo') == 'sip' %}bg-emerald-600{% else %}bg-slate-300{% endif %}"></span>
                    <span>SIP Only</span>
                </button>
                <button type="button" id="tab-swp" role="tab" aria-selected="{% if calculator_type|default('combo') == 'swp' %}true{% else %}false{% endif %}"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 text-ui-xs font-bold uppercase tracking-wider rounded-xl transition-all duration-200 {% if calculator_type|default('combo') == 'swp' %}bg-white text-blue-900 shadow-flat border border-slate-200/60{% else %}text-slate-500 hover:text-slate-900{% endif %} cursor-pointer">
                    <span class="w-2 h-2 rounded-full {% if calculator_type|default('combo') == 'swp' %}bg-blue-600{% else %}bg-slate-300{% endif %}"></span>
                    <span>SWP Only</span>
                </button>
            </div>
        </div>

        <!-- Scrollable Form Panels Container -->
        <div class="space-y-3 flex-1 min-h-0 overflow-y-auto overflow-x-hidden custom-scrollbar pr-1.5 scroll-smooth">
            
            <!-- Stage 1 / SIP Panel -->
            <div id="panel-sip" role="tabpanel" aria-labelledby="tab-sip" class="space-y-2.5 border-t-4 border-emerald-500 rounded-2xl bg-gradient-to-b from-emerald-50/70 via-emerald-50/40 to-teal-50/20 p-2 sm:p-2.5 border border-emerald-200/80 shadow-subtle transition-all">
                <!-- Stage 1 Header (Visible in Dual Mode) -->
                <div id="stage-1-header" class="{% if calculator_type|default('combo') != 'combo' %}hidden {% endif %}flex items-center justify-between px-3 py-2 rounded-xl bg-emerald-100/90 border border-emerald-300/80 shadow-flat">
                    <div class="flex items-center gap-1.5 text-slate-800">
                        <span class="flex items-center justify-center w-4 h-4 rounded-full bg-emerald-600 text-white text-micro font-black">1</span>
                        <span class="text-ui-xs font-extrabold text-emerald-950">Stage 1:</span>
                        <span class="text-ui-xs font-bold text-slate-700">Accumulation (SIP)</span>
                    </div>
                    <span class="text-micro font-extrabold text-emerald-950 bg-emerald-200/90 border border-emerald-300 px-2.5 py-0.5 rounded-full shadow-flat">
                        Phase 1
                    </span>
                </div>

                <!-- SIP Fields -->
                {% include 'components/forms/sip-fields.twig' %}
            </div><!-- /panel-sip -->

            <!-- Stage Transition Indicator (Visible only in Dual Mode) -->
            <div id="stage-transition-divider" class="{% if calculator_type|default('combo') != 'combo' %}hidden {% endif %}flex items-center gap-2 py-1.5 select-none">
                <div class="flex-1 h-px bg-gradient-to-r from-emerald-300 to-indigo-200"></div>
                <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-100/90 border border-indigo-300/90 text-micro font-extrabold text-indigo-950 shadow-flat">
                    <svg class="w-3.5 h-3.5 text-indigo-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    <span>Matured SIP Seeds Retirement SWP</span>
                    <span class="text-indigo-600">↓</span>
                </div>
                <div class="flex-1 h-px bg-gradient-to-r from-indigo-200 to-blue-300"></div>
            </div>

            <!-- Stage 2 / SWP Panel -->
            <div id="panel-swp" role="tabpanel" aria-labelledby="tab-swp" class="space-y-3 border-t-4 border-blue-500 rounded-2xl bg-gradient-to-b from-blue-50/70 via-blue-50/40 to-indigo-50/20 p-2 sm:p-2.5 border border-blue-200/80 shadow-subtle transition-all">
                <!-- Stage 2 Header (Visible in Dual Mode) -->
                <div id="stage-2-header" class="{% if calculator_type|default('combo') != 'combo' %}hidden {% endif %}flex items-center justify-between px-3 py-2 rounded-xl bg-blue-100/90 border border-blue-300/80 shadow-flat">
                    <div class="flex items-center gap-1.5 text-slate-800">
                        <span class="flex items-center justify-center w-4 h-4 rounded-full bg-blue-600 text-white text-micro font-black">2</span>
                        <span class="text-ui-xs font-extrabold text-blue-950">Stage 2:</span>
                        <span class="text-ui-xs font-bold text-slate-700">Retirement Cashflow (SWP)</span>
                    </div>
                    <span class="text-micro font-extrabold text-blue-950 bg-blue-200/90 border border-blue-300 px-2.5 py-0.5 rounded-full shadow-flat">
                        Phase 2
                    </span>
                </div>

                <!-- Dedicated Starting Corpus for SWP-Only Mode (Hidden in Dual Mode where SIP seeds corpus) -->
                <div id="swp-standalone-corpus" class="{% if calculator_type|default('combo') != 'swp' %}hidden {% endif %}space-y-2">
                    <div class="mb-1">
                        <span class="text-caption font-bold text-rose-600 tracking-wider uppercase">Your Starting Wealth</span>
                    </div>
                    {% include 'components/forms/corpus-field.twig' %}
                </div>

                <!-- Compatibility SWP toggle element -->
                <div class="hidden">
                    <input type="checkbox" id="enable_swp" name="enable_swp"
                        aria-label="Enable Systematic Withdrawal Plan (SWP)"
                        aria-controls="swp-fields"
                        aria-expanded="true"
                        checked>
                </div>

                <div id="swp-fields" class="space-y-3">
                    <!-- SWP Fields -->
                    {% include 'components/forms/swp-fields.twig' %}
                </div>
            </div><!-- /panel-swp -->
        </div>
    </form>

    <!-- Bottom Scroll Fade Overlay Affordance -->
    <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 rounded-b-3xl bg-gradient-to-t from-white/90 to-transparent z-10 hidden lg:block"></div>
</div>
