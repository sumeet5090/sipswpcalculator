{% import "components/form/input-range-pair.twig" as inputs %}

<script type="application/json" id="calculator-app-state">
    {{ (calc_config|default({})|merge({'theme': theme_tokens}))|json_island }}
</script>

<div id="{{ container_id|default('calculator-app') }}"
     data-js="calculator-app"
     data-mode="sip"
     class="bg-white/95 rounded-3xl border border-slate-200/90 shadow-card backdrop-blur-xl p-3.5 sm:p-4 relative">
    <!-- Ambient Aurora Glow (Pure Light Mode: Emerald & Teal Accents) -->
    <div class="absolute -right-16 -top-16 w-48 h-48 bg-emerald-400/8 rounded-full blur-3xl pointer-events-none"></div>

    <form method="post" novalidate id="calculator-form" class="relative z-10 space-y-3">
        <!-- SECURITY: Honeypot field (hidden from real users, catches bots) -->
        <div style="position: absolute; left: -9999px; top: -9999px;" aria-hidden="true">
            <label for="website_url">Leave this field empty</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
        </div>

        <!-- Privacy & Client-Side Sandbox Seal -->
        <div class="flex flex-wrap items-center justify-between px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200/80 text-caption gap-2">
            <div class="flex items-center gap-1.5 text-slate-700 min-w-0">
                <span class="text-ui-xs shrink-0">🔒</span>
                <span class="font-extrabold text-slate-800 truncate">100% Client-Side Private</span>
            </div>
            <span class="text-micro text-growth-emphasis font-bold bg-growth-surface px-2 py-0.5 rounded-md border border-growth-border whitespace-nowrap shrink-0"
                  title="Calculations execute entirely in your browser sandbox. Zero PII transmitted.">
                Zero PII Transmitted
            </span>
        </div>

        <!-- Segmented Tab Bar (Wealth Creation vs Retirement Income) -->
        <div class="sticky top-[84px] z-20 bg-white/95 backdrop-blur-md py-1 -my-1 rounded-2xl">
            <div class="flex bg-slate-100/90 p-1 rounded-2xl border border-slate-200/70 shadow-flat" role="tablist">
                <button type="button" id="tab-sip" role="tab" aria-selected="true"
                    class="flex-1 flex items-center justify-center gap-1.5 py-1.5 text-ui-xs font-extrabold uppercase tracking-wider rounded-xl transition-all duration-200 bg-white text-growth-emphasis shadow-flat border border-slate-200/60 cursor-pointer">
                    <span class="flex items-center justify-center w-4 h-4 rounded-full bg-growth-surface text-growth-emphasis text-micro font-extrabold">⚡</span>
                    <span>SIP Wealth</span>
                </button>
                <button type="button" id="tab-swp" role="tab" aria-selected="false"
                    class="flex-1 flex items-center justify-center gap-1.5 py-1.5 text-ui-xs font-bold uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-500 hover:text-slate-900 cursor-pointer">
                    <span class="flex items-center justify-center w-4 h-4 rounded-full bg-slate-200 text-slate-600 text-micro font-extrabold">🛡️</span>
                    <span>SWP Cashflow</span>
                </button>
            </div>
        </div>

        <!-- SIP Panel -->
        <div id="panel-sip" role="tabpanel" aria-labelledby="tab-sip" class="space-y-2.5 lg:max-h-[500px] xl:max-h-[530px] lg:overflow-y-auto lg:overflow-x-hidden custom-scrollbar pr-1 scroll-smooth">
            <!-- Initial Lumpsum -->
            {% include 'components/forms/lumpsum-fields.twig' %}

            <!-- SIP Fields -->
            {% include 'components/forms/sip-fields.twig' %}
        </div><!-- /panel-sip -->

        <!-- SWP Panel -->
        <div id="panel-swp" role="tabpanel" aria-labelledby="tab-swp" class="hidden space-y-3 lg:max-h-[500px] xl:max-h-[530px] lg:overflow-y-auto lg:overflow-x-hidden custom-scrollbar pr-1 scroll-smooth">
            <div class="sticky top-[134px] z-10 bg-white/95 backdrop-blur-md py-1 -my-1 rounded-2xl">
                <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-flat">
                    <div>
                        <span class="text-ui-xs font-extrabold text-payout uppercase tracking-tight block">Enable SWP Mode</span>
                        <span class="text-caption text-slate-500 font-medium">Switch from accumulation to regular monthly cashflow</span>
                    </div>
                    <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="enable_swp" name="enable_swp"
                            class="sr-only peer"
                            aria-label="Enable Systematic Withdrawal Plan (SWP)"
                            aria-controls="swp-fields"
                            aria-expanded="{{ enable_swp ? 'true' : 'false' }}"
                            {% if enable_swp %}checked{% endif %}>
                        <div class="w-10 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-rose-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-600">
                        </div>
                    </label>
                </div>
            </div>

            <div id="swp-fields" class="space-y-3 transition-all duration-300" {% if not enable_swp %}style="display: none; opacity: 0.5; pointer-events: none;" aria-hidden="true"{% endif %}>
                <!-- SWP Fields -->
                {% include 'components/forms/swp-fields.twig' %}
            </div>
        </div><!-- /panel-swp -->
    </form>
</div>


