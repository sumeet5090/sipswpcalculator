{% import "components/form/input-range-pair.twig" as inputs %}

<script type="application/json" id="calculator-app-state">
    {{ (calc_config|default({})|merge({'theme': theme_tokens}))|json_island }}
</script>

<div id="{{ container_id|default('calculator-app') }}"
     data-js="calculator-app"
     data-mode="{{ calculator_type|default('combo') }}"
     class="bg-white/95 backdrop-blur-md rounded-3xl border border-slate-200/90 shadow-card p-3 xl:p-4 relative flex flex-col min-h-0 h-fit">
    <!-- Ambient Aurora Glow (Pure Light Mode: Emerald & Teal Accents) -->
    <div class="absolute -right-16 -top-16 w-48 h-48 bg-emerald-400/8 rounded-full blur-3xl pointer-events-none"></div>

    <form method="post" novalidate id="calculator-form" class="relative z-10 flex flex-col flex-1 min-h-0 space-y-2 xl:space-y-3" onsubmit="event.preventDefault();">
        <input type="hidden" id="calculator_type" name="calculator_type" value="{{ calculator_type|default('combo') }}">
        <!-- SECURITY: Honeypot field (hidden from real users, catches bots) -->
        <div style="position: absolute; left: -9999px; top: -9999px;" aria-hidden="true">
            <label for="website_url">Leave this field empty</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
        </div>

        <!-- Privacy & Client-Side Sandbox Seal (Desktop; mobile is covered by dock) -->
        <div class="hidden sm:flex flex-wrap items-center justify-between px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200/80 text-caption gap-2">
            <div class="flex items-center gap-1.5 text-slate-700 min-w-0">
                <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <span class="font-extrabold text-slate-800 truncate">100% Client-Side Private</span>
            </div>
            <span class="text-micro text-growth-emphasis font-bold bg-growth-surface px-2 py-0.5 rounded-md border border-growth-border whitespace-nowrap shrink-0"
                  title="Calculations execute entirely in your browser sandbox. Zero PII transmitted.">
                Zero PII Transmitted
            </span>
        </div>

        {% if calculator_type|default('combo') in ['combo', 'all'] %}
        <!-- 3-Mode Segmented Control Bar (Dual vs SIP Only vs SWP Only) -->
        <div class="py-0.5 mb-1 xl:mb-2 rounded-2xl">
            <div class="flex bg-slate-100/90 p-1 rounded-2xl border border-slate-200/70 shadow-flat gap-1" role="tablist" aria-label="Calculator Mode Selector">
                <button type="button" id="tab-combo" role="tab" aria-selected="{% if calculator_type|default('combo') == 'combo' %}true{% else %}false{% endif %}"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1.5 text-ui-xs font-extrabold uppercase tracking-normal xl:tracking-wider rounded-xl transition-all duration-200 {% if calculator_type|default('combo') == 'combo' %}bg-white text-emerald-950 shadow-flat border border-slate-200/60{% else %}text-slate-500 hover:text-slate-900{% endif %} cursor-pointer">
                    <span class="w-2 h-2 rounded-full {% if calculator_type|default('combo') == 'combo' %}bg-emerald-700{% else %}bg-slate-300{% endif %}"></span>
                    <span>Dual (SIP+SWP)</span>
                </button>
                <button type="button" id="tab-sip" role="tab" aria-selected="{% if calculator_type|default('combo') == 'sip' %}true{% else %}false{% endif %}"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1.5 text-ui-xs font-bold uppercase tracking-normal xl:tracking-wider rounded-xl transition-all duration-200 {% if calculator_type|default('combo') == 'sip' %}bg-white text-emerald-950 shadow-flat border border-slate-200/60{% else %}text-slate-500 hover:text-slate-900{% endif %} cursor-pointer">
                    <span class="w-2 h-2 rounded-full {% if calculator_type|default('combo') == 'sip' %}bg-emerald-700{% else %}bg-slate-300{% endif %}"></span>
                    <span>SIP Only</span>
                </button>
                <button type="button" id="tab-swp" role="tab" aria-selected="{% if calculator_type|default('combo') == 'swp' %}true{% else %}false{% endif %}"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1.5 text-ui-xs font-bold uppercase tracking-normal xl:tracking-wider rounded-xl transition-all duration-200 {% if calculator_type|default('combo') == 'swp' %}bg-white text-amber-950 shadow-flat border border-slate-200/60{% else %}text-slate-500 hover:text-slate-900{% endif %} cursor-pointer">
                    <span class="w-2 h-2 rounded-full {% if calculator_type|default('combo') == 'swp' %}bg-amber-700{% else %}bg-slate-300{% endif %}"></span>
                    <span>SWP Only</span>
                </button>
            </div>
        </div>

        <!-- Form Panels Container (No nested scroll trap) -->
        <div class="space-y-2.5 xl:space-y-3 flex-1 min-h-0">
            
            <!-- Stage 1 / SIP Panel -->
            <div id="panel-sip" role="tabpanel" aria-labelledby="tab-sip" class="space-y-2 xl:space-y-2.5 rounded-2xl bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-emerald-600 p-2.5 xl:p-3 shadow-flat transition-all">
                <!-- Stage 1 Header (Visible in Dual Mode) -->
                <div id="stage-1-header" class="{% if calculator_type|default('combo') != 'combo' %}hidden {% endif %}flex items-center justify-between px-3 py-2 rounded-xl bg-emerald-50/90 text-emerald-950 border border-emerald-200/80 shadow-flat">
                    <div class="flex items-center gap-2">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-600 text-white text-micro font-black shadow-flat">1</span>
                        <span class="text-ui-xs font-black text-emerald-950">Stage 1:</span>
                        <span class="text-ui-xs font-bold text-slate-700">Accumulation (SIP)</span>
                    </div>
                    <span class="text-micro font-extrabold text-emerald-800 bg-white border border-emerald-200/80 px-2.5 py-0.5 rounded-full shadow-flat">
                        Phase 1
                    </span>
                </div>

                <!-- SIP Fields -->
                {% include 'components/forms/sip-fields.twig' %}
            </div><!-- /panel-sip -->

            <!-- Stage Transition Indicator (Visible only in Dual Mode) -->
            <div id="stage-transition-divider" class="{% if calculator_type|default('combo') != 'combo' %}hidden {% endif %}flex items-center gap-2 py-1 xl:py-1.5 select-none">
                <div class="flex-1 h-px bg-gradient-to-r from-emerald-400 via-teal-500 to-amber-500"></div>
                <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-white text-slate-800 border border-slate-200/90 text-micro font-extrabold shadow-flat">
                    <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    <span>Matured SIP Seeds Retirement SWP</span>
                    <span class="text-amber-600 font-black">↓</span>
                </div>
                <div class="flex-1 h-px bg-gradient-to-r from-amber-500 to-amber-600"></div>
            </div>

            <!-- Stage 2 / SWP Panel -->
            <div id="panel-swp" role="tabpanel" aria-labelledby="tab-swp" class="space-y-2 xl:space-y-3 rounded-2xl bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-amber-600 p-2.5 xl:p-3 shadow-flat transition-all">
                <!-- Stage 2 Header (Visible in Dual Mode) -->
                <div id="stage-2-header" class="{% if calculator_type|default('combo') != 'combo' %}hidden {% endif %}flex items-center justify-between px-3 py-2 rounded-xl bg-amber-50/90 text-amber-950 border border-amber-200/80 shadow-flat">
                    <div class="flex items-center gap-2">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-amber-600 text-white text-micro font-black shadow-flat">2</span>
                        <span class="text-ui-xs font-black text-amber-950">Stage 2:</span>
                        <span class="text-ui-xs font-bold text-slate-700">Retirement Cashflow (SWP)</span>
                    </div>
                    <span class="text-micro font-extrabold text-amber-900 bg-white border border-amber-200/80 px-2.5 py-0.5 rounded-full shadow-flat">
                        Phase 2
                    </span>
                </div>

                <!-- Dedicated Starting Corpus for SWP-Only Mode (Hidden in Dual Mode where SIP seeds corpus) -->
                <div id="swp-standalone-corpus" class="{% if calculator_type|default('combo') != 'swp' %}hidden {% endif %}space-y-2">
                    <div class="mb-1">
                        <span class="text-caption font-bold text-amber-800 tracking-wider uppercase">Your Starting Wealth</span>
                    </div>
                    {% include 'components/forms/corpus-field.twig' %}
                </div>

                <!-- Compatibility SWP toggle element -->
                <div class="hidden">
                    <input type="checkbox" id="enable_swp" name="enable_swp"
                        aria-label="Enable Systematic Withdrawal Plan (SWP)"
                        aria-controls="swp-fields"
                        aria-expanded="true"
                        checked>
                </div>

                <div id="swp-fields" class="space-y-3">
                    <!-- SWP Fields -->
                    {% include 'components/forms/swp-fields.twig' %}
                </div>
            </div><!-- /panel-swp -->
        </div>

        {% elseif calculator_type in ['sip', 'sip-step-up'] %}
        <input type="hidden" id="enable_swp" name="enable_swp" value="0">
        <div class="space-y-3 flex-1 min-h-0">
            <div id="panel-sip" class="space-y-2.5 rounded-2xl bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-emerald-600 p-2.5 sm:p-3 shadow-flat transition-all">
                <div id="stage-1-header" class="flex items-center justify-between px-3 py-2 rounded-xl bg-emerald-50/90 border border-emerald-200/80 shadow-flat">
                    <div class="flex items-center gap-2 text-slate-800">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-600 text-white text-micro font-black shadow-flat">
                            {% if calculator_type == 'sip-step-up' %}↗{% else %}1{% endif %}
                        </span>
                        <span class="text-ui-xs font-black text-emerald-950">
                            {% if calculator_type == 'sip-step-up' %}Step-Up SIP:{% else %}Stage 1:{% endif %}
                        </span>
                        <span class="text-ui-xs font-bold text-slate-700">
                            {% if calculator_type == 'sip-step-up' %}Top-Up Growth Model{% else %}Accumulation (SIP){% endif %}
                        </span>
                    </div>
                    <span class="text-micro font-extrabold text-emerald-800 bg-white border border-emerald-200/80 px-2.5 py-0.5 rounded-full shadow-flat">
                        {% if calculator_type == 'sip-step-up' %}10% Step-Up{% else %}Phase 1{% endif %}
                    </span>
                </div>
                {% include 'components/forms/sip-fields.twig' %}
            </div>
        </div>

        {% elseif calculator_type == 'swp' %}
        <input type="hidden" id="enable_swp" name="enable_swp" value="1">
        <div class="space-y-3 flex-1 min-h-0">
            <div id="panel-swp" class="space-y-3 rounded-2xl bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-amber-600 p-2.5 sm:p-3 shadow-flat transition-all">
                <div id="stage-2-header" class="flex items-center justify-between px-3 py-2 rounded-xl bg-amber-50/90 border border-amber-200/80 shadow-flat">
                    <div class="flex items-center gap-2 text-slate-800">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-amber-600 text-white text-micro font-black shadow-flat">2</span>
                        <span class="text-ui-xs font-black text-amber-950">Stage 2:</span>
                        <span class="text-ui-xs font-bold text-slate-700">Retirement Cashflow (SWP)</span>
                    </div>
                    <span class="text-micro font-extrabold text-amber-900 bg-white border border-amber-200/80 px-2.5 py-0.5 rounded-full shadow-flat">
                        Phase 2
                    </span>
                </div>

                <div id="swp-standalone-corpus" class="space-y-1.5 mb-2">
                    <span class="text-caption font-bold text-amber-800 tracking-wider uppercase">Your Starting Wealth</span>
                    {% include 'components/forms/corpus-field.twig' %}
                </div>

                <div id="swp-fields" class="space-y-3">
                    {% include 'components/forms/swp-fields.twig' %}
                </div>
            </div>
        </div>

        {% elseif calculator_type == 'lumpsum' %}
        <input type="hidden" id="enable_swp" name="enable_swp" value="0">
        <div class="space-y-3 flex-1 min-h-0">
            <div class="space-y-3 rounded-2xl bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-emerald-600 p-2.5 sm:p-3 shadow-flat transition-all">
                <div class="flex items-center justify-between px-3 py-2 rounded-xl bg-emerald-50/90 border border-emerald-200/80 shadow-flat">
                    <div class="flex items-center gap-2 text-slate-800">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-600 text-white text-micro font-black shadow-flat">✦</span>
                        <span class="text-ui-xs font-black text-emerald-950">One-Time Capital:</span>
                        <span class="text-ui-xs font-bold text-slate-700">Lumpsum Growth</span>
                    </div>
                    <span class="text-micro font-extrabold text-emerald-800 bg-white border border-emerald-200/80 px-2.5 py-0.5 rounded-full shadow-flat">
                        Single Deposit
                    </span>
                </div>
                {% include 'components/forms/lumpsum-only-fields.twig' %}
            </div>
        </div>

        {% elseif calculator_type == 'target_corpus' %}
        <input type="hidden" id="enable_swp" name="enable_swp" value="0">
        <div class="space-y-3 flex-1 min-h-0">
            <div class="space-y-3 rounded-2xl bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-emerald-600 p-2.5 sm:p-3 shadow-flat transition-all">
                <div class="flex items-center justify-between px-3 py-2 rounded-xl bg-emerald-50/90 border border-emerald-200/80 shadow-flat">
                    <div class="flex items-center gap-2 text-slate-800">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-600 text-white shadow-flat">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" stroke-width="2.2"/>
                                <circle cx="12" cy="12" r="4" stroke-width="2.2"/>
                            </svg>
                        </span>
                        <span class="text-ui-xs font-black text-emerald-950">Goal-Seek Engine:</span>
                        <span class="text-ui-xs font-bold text-slate-700">Target Corpus</span>
                    </div>
                    <span class="text-micro font-extrabold text-emerald-800 bg-white border border-emerald-200/80 px-2.5 py-0.5 rounded-full shadow-flat">
                        Inverse Math
                    </span>
                </div>
                {% include 'components/forms/target-corpus-fields.twig' %}
            </div>
        </div>

        {% elseif is_specialized_mode(calculator_type|default('')) %}
        {% set meta = calculator_mode_meta(calculator_type) %}
        {% set hdr = meta.form_header|default({}) %}
        {% set theme_map = {
            'emerald': {
                'wrapper': 'bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-emerald-600',
                'header': 'bg-emerald-50/90 border border-emerald-200/80',
                'icon_bg': 'bg-emerald-600 text-white',
                'title': 'text-emerald-950',
                'badge': 'text-emerald-800 bg-white border border-emerald-200/80'
            },
            'indigo': {
                'wrapper': 'bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-indigo-600',
                'header': 'bg-indigo-50/90 border border-indigo-200/80',
                'icon_bg': 'bg-indigo-600 text-white',
                'title': 'text-indigo-950',
                'badge': 'text-indigo-800 bg-white border border-indigo-200/80'
            },
            'amber': {
                'wrapper': 'bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-amber-600',
                'header': 'bg-amber-50/90 border border-amber-200/80',
                'icon_bg': 'bg-amber-600 text-white',
                'title': 'text-amber-950',
                'badge': 'text-amber-900 bg-white border border-amber-200/80'
            },
            'teal': {
                'wrapper': 'bg-slate-50/75 border border-slate-200/85 border-l-[3px] border-l-teal-600',
                'header': 'bg-teal-50/90 border border-teal-200/80',
                'icon_bg': 'bg-teal-600 text-white',
                'title': 'text-teal-950',
                'badge': 'text-teal-800 bg-white border border-teal-200/80'
            }
        } %}
        {% set tc = theme_map[hdr.theme|default('emerald')]|default(theme_map.emerald) %}
        <input type="hidden" id="enable_swp" name="enable_swp" value="{{ meta.enable_swp_default ? '1' : '0' }}">
        <div class="space-y-3 flex-1 min-h-0">
            <div class="space-y-3 {{ tc.wrapper }} rounded-2xl p-2.5 sm:p-3 shadow-card transition-all">
                <div class="flex items-center justify-between px-3.5 py-2 rounded-xl {{ tc.header }} shadow-flat">
                    <div class="flex items-center gap-2 text-slate-800">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full {{ tc.icon_bg }} text-micro font-black shadow-flat">{{ hdr.icon|default('✦') }}</span>
                        <span class="text-ui-xs font-black {{ tc.title }}">{{ hdr.prefix|default('') }}</span>
                        <span class="text-ui-xs font-bold text-slate-700">{{ hdr.subtitle|default('') }}</span>
                    </div>
                    <span class="text-micro font-black {{ tc.badge }} px-2.5 py-0.5 rounded-full shadow-flat">
                        {{ hdr.badge|default('') }}
                    </span>
                </div>
                {% include meta.form_partial %}
            </div>
        </div>
        {% endif %}

        <!-- Non-Shifting Contextual Milestone Bridges Dock (Anchored below inputs to avoid mid-drag layout shifts) -->
        <div id="contextual-bridges-dock" class="space-y-2">
            <div id="contextual-sip-milestone-bridge" class="hidden p-2 sm:p-2.5 rounded-2xl bg-emerald-50/80 border border-emerald-200/85 shadow-flat transition-all" role="region" aria-label="Related Milestone Blueprint">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 text-micro sm:text-ui-xs font-bold text-slate-800 min-w-0">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-600 text-white shadow-flat shrink-0">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" stroke-width="2.2"/>
                                <circle cx="12" cy="12" r="4" stroke-width="2.2"/>
                            </svg>
                        </span>
                        <span id="sip-bridge-message" class="truncate font-semibold text-slate-900">Dedicated Wealth Blueprint available</span>
                    </div>
                    <a id="sip-bridge-link" href="#" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-caption shadow-flat shrink-0 transition-transform active:scale-95">
                        <span id="sip-bridge-action">Explore</span>
                        <span>↗</span>
                    </a>
                </div>
            </div>

            <div id="contextual-swp-milestone-bridge" class="hidden p-2 sm:p-2.5 rounded-2xl bg-amber-50/80 border border-amber-200/85 shadow-flat transition-all" role="region" aria-label="Related Retirement Milestone Blueprint">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 text-micro sm:text-ui-xs font-bold text-slate-800 min-w-0">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-amber-600 text-white shadow-flat shrink-0">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        </span>
                        <span id="swp-bridge-message" class="truncate font-semibold text-slate-900">Dedicated Pension Blueprint available</span>
                    </div>
                    <a id="swp-bridge-link" href="#" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-extrabold text-caption shadow-flat shrink-0 transition-transform active:scale-95">
                        <span id="swp-bridge-action">View Guide</span>
                        <span>↗</span>
                    </a>
                </div>
            </div>

            <div id="contextual-corpus-milestone-bridge" class="hidden p-2 sm:p-2.5 rounded-2xl bg-amber-50/80 border border-amber-200/85 shadow-flat transition-all" role="region" aria-label="Related SWP Milestone Blueprint">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 text-micro sm:text-ui-xs font-bold text-slate-800 min-w-0">
                        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-amber-600 text-white shadow-flat shrink-0">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        </span>
                        <span id="corpus-bridge-message" class="truncate font-semibold text-slate-900">Dedicated Corpus Blueprint available</span>
                    </div>
                    <a id="corpus-bridge-link" href="#" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-extrabold text-caption shadow-flat shrink-0 transition-transform active:scale-95">
                        <span id="corpus-bridge-action">View Guide</span>
                        <span>↗</span>
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>
