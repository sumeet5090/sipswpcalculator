{% import "components/form/input-range-pair.twig" as inputs %}

<script type="application/json" id="calculator-app-state">
    {{ calc_config|json_island }}
</script>

<div id="{{ container_id|default('calculator-app') }}"
     data-js="calculator-app"
     data-mode="sip"
     class="glass-card p-4">
    <form method="post" novalidate id="calculator-form">
        <!-- SECURITY: Honeypot field (hidden from real users, catches bots) -->
        <div style="position: absolute; left: -9999px; top: -9999px;" aria-hidden="true">
            <label for="website_url">Leave this field empty</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
        </div>

        <!-- Segmented Tab Bar -->
        <div class="flex bg-slate-100/90 p-1.5 rounded-2xl border border-slate-200/70 mb-4" role="tablist">
            <button type="button" id="tab-sip" role="tab" aria-selected="true"
                class="flex-1 flex items-center justify-center gap-1.5 py-2 text-xs font-bold uppercase tracking-widest rounded-xl transition-all duration-200 bg-white text-emerald-700 shadow-sm border border-slate-200/30">
                <span class="flex items-center justify-center w-4 h-4 rounded-full bg-emerald-100 text-emerald-800 text-[9px] font-black">1</span>
                SIP Details
            </button>
            <button type="button" id="tab-swp" role="tab" aria-selected="false"
                class="flex-1 flex items-center justify-center gap-1.5 py-2 text-xs font-bold uppercase tracking-widest rounded-xl transition-all duration-200 text-slate-500 hover:text-slate-700">
                <span class="flex items-center justify-center w-4 h-4 rounded-full bg-slate-200/80 text-slate-600 text-[9px] font-black">2</span>
                SWP Details
            </button>
        </div>

        <!-- SIP Panel -->
        <div id="panel-sip" role="tabpanel" aria-labelledby="tab-sip">
            <div class="relative">
                <div class="mb-4 relative z-10 bg-[var(--glass-bg)] p-4 sm:p-5 rounded-3xl border border-[var(--glass-border)] shadow-xl backdrop-blur-xl">
                    <div class="space-y-3">
                        <!-- Initial Lumpsum -->
                        {% include 'components/forms/lumpsum-fields.twig' %}

                        <!-- SIP Fields -->
                        {% include 'components/forms/sip-fields.twig' %}
                    </div>
                </div>
            </div>
        </div><!-- /panel-sip -->

        <!-- SWP Panel -->
        <div id="panel-swp" role="tabpanel" aria-labelledby="tab-swp" class="hidden">
            <div class="relative">
                <div class="relative z-10 bg-[var(--glass-bg)] p-4 sm:p-5 rounded-3xl border border-[var(--glass-border)] shadow-xl backdrop-blur-xl">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-xs font-bold text-rose-400 tracking-widest uppercase">SWP Config</span>
                        <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="enable_swp" name="enable_swp"
                                class="sr-only peer"
                                aria-label="Enable Systematic Withdrawal Plan (SWP)"
                                aria-controls="swp-fields"
                                aria-expanded="{{ enable_swp ? 'true' : 'false' }}"
                                {% if enable_swp %}checked{% endif %}>
                            <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-rose-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-500">
                            </div>
                        </label>
                    </div>

                    <div id="swp-fields" class="space-y-4 transition-all duration-300" {% if not enable_swp %}style="display: none; opacity: 0.5; pointer-events: none;" aria-hidden="true"{% endif %}>
                        <!-- SWP Fields -->
                        {% include 'components/forms/swp-fields.twig' %}
                    </div>
                </div>
            </div>
        </div><!-- /panel-swp -->
    </form>
</div>
