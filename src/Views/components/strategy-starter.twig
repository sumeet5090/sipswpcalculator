<!-- Strategy Starter: Consolidated 1-Click Blueprints & 3-Step Guided Wizard -->
<div id="strategy-starter-container" class="mt-2 mb-3">
    <div class="flex items-center justify-between gap-2 p-1.5 sm:p-2 rounded-2xl bg-white/95 bg-gradient-to-r from-emerald-50/70 via-slate-50/90 to-blue-50/70 border border-slate-200/90 shadow-card backdrop-blur-md overflow-x-auto no-scrollbar">
        <div class="flex items-center gap-1.5 shrink-0 pl-1 text-caption font-bold text-slate-500 uppercase tracking-wider">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" stroke-width="2"/>
                <circle cx="12" cy="12" r="5" stroke-width="2"/>
                <circle cx="12" cy="12" r="1" fill="currentColor"/>
            </svg>
            <span class="hidden sm:inline">Presets:</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 flex-nowrap overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar" role="toolbar" aria-label="Strategy Blueprints">
            <!-- 1. First ₹1 Crore Rush -->
            <button type="button" 
                class="persona-btn snap-center shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-emerald-200/90 bg-emerald-50/70 hover:bg-emerald-100 text-slate-800 hover:text-emerald-900 text-ui-xs font-bold shadow-flat active:scale-95 transition-all cursor-pointer group"
                data-persona="first_crore"
                data-title="First ₹1 Crore Rush"
                aria-pressed="false"
                data-sip="25000"
                data-years="9"
                data-rate="12"
                data-stepup="10"
                data-lumpsum="0"
                data-enable-swp="false">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" stroke-width="2"/>
                    <circle cx="12" cy="12" r="5" stroke-width="2"/>
                    <circle cx="12" cy="12" r="1" fill="currentColor"/>
                </svg>
                <span class="font-extrabold text-slate-800">₹1 Cr Sprint</span>
                <span class="hidden md:inline text-micro text-emerald-700 bg-emerald-200/60 px-1.5 py-0.5 rounded font-financial-mono">9 Yrs</span>
            </button>

            <!-- 2. FIRE Early Retirement -->
            <button type="button" 
                class="persona-btn snap-center shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-blue-200/90 bg-blue-50/70 hover:bg-blue-100 text-slate-800 hover:text-blue-900 text-ui-xs font-bold shadow-flat active:scale-95 transition-all cursor-pointer group"
                data-persona="fire_retirement"
                data-title="FIRE Early Retirement"
                aria-pressed="false"
                data-sip="50000"
                data-years="15"
                data-rate="12"
                data-stepup="10"
                data-lumpsum="0"
                data-enable-swp="true"
                data-swp="120000"
                data-swp-years="25"
                data-swp-rate="8"
                data-swp-hike="6">
                <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                <span class="font-extrabold text-slate-800">FIRE Pension</span>
                <span class="hidden md:inline text-micro text-blue-700 bg-blue-200/60 px-1.5 py-0.5 rounded font-financial-mono">15+25 Yrs</span>
            </button>

            <!-- 3. Child Higher Education -->
            <button type="button" 
                class="persona-btn snap-center shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-indigo-200/90 bg-indigo-50/70 hover:bg-indigo-100 text-slate-800 hover:text-indigo-900 text-ui-xs font-bold shadow-flat active:scale-95 transition-all cursor-pointer group"
                data-persona="child_education"
                data-title="Child Higher Education"
                aria-pressed="false"
                data-sip="15000"
                data-years="18"
                data-rate="12"
                data-stepup="10"
                data-lumpsum="100000"
                data-enable-swp="false">
                <svg class="w-3.5 h-3.5 text-indigo-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/>
                </svg>
                <span class="font-extrabold text-slate-800">Child Edu</span>
                <span class="hidden md:inline text-micro text-indigo-700 bg-indigo-200/60 px-1.5 py-0.5 rounded font-financial-mono">18 Yrs</span>
            </button>

            <!-- 4. Senior Capital Preservation -->
            <button type="button" 
                class="persona-btn snap-center shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-amber-200/90 bg-amber-50/70 hover:bg-amber-100 text-slate-800 hover:text-amber-900 text-ui-xs font-bold shadow-flat active:scale-95 transition-all cursor-pointer group"
                data-persona="capital_preservation"
                data-title="Senior Citizen Monthly Income"
                aria-pressed="false"
                data-sip="0"
                data-years="0"
                data-rate="8"
                data-stepup="0"
                data-lumpsum="5000000"
                data-corpus="5000000"
                data-enable-swp="true"
                data-swp="35000"
                data-swp-years="20"
                data-swp-rate="8"
                data-swp-hike="0">
                <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="font-extrabold text-slate-800">Senior SWP</span>
                <span class="hidden md:inline text-micro text-amber-700 bg-amber-200/60 px-1.5 py-0.5 rounded font-financial-mono">₹35k/mo</span>
            </button>
        </div>

        <!-- Guided Wizard Trigger Button -->
        <button
            type="button"
            id="toggle-guided-wizard-btn"
            aria-expanded="false"
            aria-controls="wealth-guided-wizard-drawer"
            class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-ui-xs font-extrabold bg-emerald-600 hover:bg-emerald-500 text-white shadow-flat active:scale-95 transition-all cursor-pointer"
        >
            <svg class="w-3.5 h-3.5 text-emerald-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span id="wizard-toggle-text">3-Step Wizard</span>
            <span id="wizard-toggle-icon" class="text-micro font-bold text-emerald-200 transition-transform duration-200">▾</span>
        </button>
    </div>

    <!-- Modal 3-Step Guided Wizard (Fixed overlay modal, zero layout shift) -->
    <div id="wealth-guided-wizard-drawer" class="hidden fixed inset-0 z-modal flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm transition-all duration-300" hidden style="display: none;" aria-hidden="true">
        <div class="bg-white/98 text-slate-800 rounded-3xl p-5 sm:p-7 shadow-modal border border-slate-200/90 w-full max-w-2xl relative overflow-hidden max-h-[90vh] overflow-y-auto">
            <!-- Modal Header -->
            <div class="flex items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-100 text-emerald-800 text-sm font-black">
                        <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </span>
                    <div>
                        <h4 class="text-sm sm:text-base font-extrabold text-slate-900">Interactive Wealth Readiness Wizard</h4>
                        <p class="text-caption text-slate-500">Answer 3 quick questions to discover your personalized strategy</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span id="quiz-step-label" class="text-micro font-bold text-growth-emphasis bg-growth-surface px-2.5 py-0.5 rounded-full border border-growth-border">Step 1 of 3</span>
                    <button type="button" id="close-guided-wizard-btn" class="text-slate-400 hover:text-slate-700 w-7 h-7 flex items-center justify-center text-xs font-bold rounded-lg hover:bg-slate-100 cursor-pointer" aria-label="Close Guided Wizard">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Step 1: Target Milestone -->
            <div id="quiz-step-1" class="quiz-step space-y-2.5">
                <h5 class="text-xs font-bold text-slate-800">1. What is your primary investment goal?</h5>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-goal="first_crore" data-years="9" data-stepup="10">
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 mb-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><circle cx="12" cy="12" r="5" stroke-width="2"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
                        </span>
                        <strong class="text-xs text-slate-900 block">First ₹1 Crore</strong>
                        <span class="text-micro text-slate-500">Wealth Sprint</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-blue-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-goal="fire" data-years="15" data-enable-swp="true" data-swp="100000">
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-xl bg-blue-50 border border-blue-200 text-blue-700 mb-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                        </span>
                        <strong class="text-xs text-slate-900 block">FIRE Retirement</strong>
                        <span class="text-micro text-slate-500">Pension Freedom</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-indigo-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-goal="education" data-years="18" data-stepup="10">
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-700 mb-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>
                        </span>
                        <strong class="text-xs text-slate-900 block">Child Education</strong>
                        <span class="text-micro text-slate-500">College Corpus</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-amber-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-goal="senior" data-years="0" data-enable-swp="true" data-corpus="5000000" data-swp="35000">
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 mb-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        </span>
                        <strong class="text-xs text-slate-900 block">Senior Income</strong>
                        <span class="text-micro text-slate-500">Monthly SWP</span>
                    </button>
                </div>
            </div>

            <!-- Step 2: Monthly Capacity -->
            <div id="quiz-step-2" class="quiz-step space-y-2.5 hidden">
                <div class="flex items-center justify-between">
                    <h5 class="text-xs font-bold text-slate-800">2. How much can you comfortably invest every month?</h5>
                    <button type="button" class="quiz-back-btn text-caption font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 cursor-pointer" data-target-step="1">
                        <span>←</span> <span>Back</span>
                    </button>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-sip="5000">
                        <strong class="text-xs text-slate-900 block">₹5,000 / mo</strong>
                        <span class="text-micro text-slate-500">₹60k per year</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-sip="15000">
                        <strong class="text-xs text-slate-900 block">₹15,000 / mo</strong>
                        <span class="text-micro text-slate-500">₹1.80L per year</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-sip="25000">
                        <strong class="text-xs text-slate-900 block">₹25,000 / mo</strong>
                        <span class="text-micro text-slate-500">₹3.00L per year</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer shadow-flat" data-sip="50000">
                        <strong class="text-xs text-slate-900 block">₹50,000+ / mo</strong>
                        <span class="text-micro text-slate-500">₹6.00L per year</span>
                    </button>
                </div>
            </div>

            <!-- Step 3: Horizon & Execution -->
            <div id="quiz-step-3" class="quiz-step space-y-2.5 hidden">
                <div class="flex items-center justify-between">
                    <h5 class="text-xs font-bold text-slate-800">3. Select your target accumulation tenure:</h5>
                    <button type="button" class="quiz-back-btn text-caption font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 cursor-pointer" data-target-step="2">
                        <span>←</span> <span>Back</span>
                    </button>
                </div>
                <div class="grid grid-cols-3 gap-2.5 mb-3">
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer shadow-flat" data-tenure="5">
                        <strong class="text-xs text-slate-900 block">5 Years</strong>
                        <span class="text-micro text-slate-500">Short Horizon</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer shadow-flat" data-tenure="10">
                        <strong class="text-xs text-slate-900 block">10 Years</strong>
                        <span class="text-micro text-slate-500">Medium Horizon</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer shadow-flat" data-tenure="15">
                        <strong class="text-xs text-slate-900 block">15+ Years</strong>
                        <span class="text-micro text-slate-500">Max Compounding</span>
                    </button>
                </div>
                
                <button type="button" id="apply-quiz-plan-btn" 
                    class="w-full py-2.5 px-5 rounded-2xl font-bold bg-growth hover:bg-growth-emphasis text-white shadow-flat active:scale-98 transition-all cursor-pointer text-xs sm:text-sm flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    <span>Calculate &amp; View Custom Plan</span>
                </button>
            </div>
        </div>
    </div>
</div>
