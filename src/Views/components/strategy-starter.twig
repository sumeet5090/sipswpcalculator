<!-- Strategy Starter: Consolidated 1-Click Blueprints & 3-Step Guided Wizard -->
<div id="strategy-starter-container" class="mt-6 mb-8">
    <!-- Header with 1-Click Title and Wizard Accordion Toggle -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div>
            <h3 class="text-sm sm:text-base font-extrabold text-slate-900 flex items-center gap-2">
                <span>🚀</span>
                <span>Strategy Starter &amp; Financial Blueprints</span>
            </h3>
            <p class="text-xs text-slate-500">Select a one-tap popular goal preset or launch the guided wizard</p>
        </div>

        <!-- Guided Wizard Toggle Button -->
        <button
            type="button"
            id="toggle-guided-wizard-btn"
            aria-expanded="false"
            aria-controls="wealth-guided-wizard-drawer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition-all cursor-pointer shadow-2xs active:scale-95 self-start sm:self-auto"
        >
            <span class="text-sm">🪄</span>
            <span id="wizard-toggle-text">Need Guidance? Open 3-Step Wizard</span>
            <span id="wizard-toggle-icon" class="text-[10px] font-bold text-emerald-600 transition-transform duration-200">▼</span>
        </button>
    </div>

    <!-- Expandable 3-Step Guided Wizard Drawer (Hidden by default, expands on request) -->
    <div id="wealth-guided-wizard-drawer" class="hidden mb-6 bg-white/95 backdrop-blur-md text-slate-800 rounded-3xl p-5 sm:p-7 shadow-xl border border-emerald-200/80 relative overflow-hidden transition-all duration-300">
        <!-- Ambient Light Glow -->
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-teal-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
            <div class="flex items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 text-xs">🪄</span>
                    <div>
                        <h4 class="text-xs sm:text-sm font-extrabold text-slate-900">Interactive Wealth Readiness Wizard</h4>
                        <p class="text-[11px] text-slate-500">Answer 3 quick questions to discover your personalized strategy</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span id="quiz-step-label" class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">Step 1 of 3</span>
                    <button type="button" id="close-guided-wizard-btn" class="text-slate-400 hover:text-slate-700 p-1 text-xs font-bold rounded-md hover:bg-slate-100 cursor-pointer" aria-label="Close Guided Wizard">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Step 1: Target Milestone -->
            <div id="quiz-step-1" class="quiz-step space-y-2.5">
                <h5 class="text-xs font-bold text-slate-800">1. What is your primary investment goal?</h5>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="first_crore" data-years="9" data-stepup="10">
                        <span class="text-base block mb-1">🎯</span>
                        <strong class="text-xs text-slate-900 block">First ₹1 Crore</strong>
                        <span class="text-[10px] text-slate-500">Wealth Sprint</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-rose-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="fire" data-years="15" data-enable-swp="true" data-swp="100000">
                        <span class="text-base block mb-1">🏖️</span>
                        <strong class="text-xs text-slate-900 block">FIRE Retirement</strong>
                        <span class="text-[10px] text-slate-500">Pension Freedom</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-indigo-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="education" data-years="18" data-stepup="10">
                        <span class="text-base block mb-1">🎓</span>
                        <strong class="text-xs text-slate-900 block">Child Education</strong>
                        <span class="text-[10px] text-slate-500">College Corpus</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-amber-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="senior" data-years="0" data-enable-swp="true" data-corpus="5000000" data-swp="35000">
                        <span class="text-base block mb-1">🛡️</span>
                        <strong class="text-xs text-slate-900 block">Senior Income</strong>
                        <span class="text-[10px] text-slate-500">Monthly SWP</span>
                    </button>
                </div>
            </div>

            <!-- Step 2: Monthly Capacity -->
            <div id="quiz-step-2" class="quiz-step space-y-2.5 hidden">
                <div class="flex items-center justify-between">
                    <h5 class="text-xs font-bold text-slate-800">2. How much can you comfortably invest every month?</h5>
                    <button type="button" class="quiz-back-btn text-[11px] font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 cursor-pointer" data-target-step="1">
                        <span>←</span> <span>Back</span>
                    </button>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="5000">
                        <strong class="text-xs text-slate-900 block">₹5,000 / mo</strong>
                        <span class="text-[10px] text-slate-500">₹60k per year</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="15000">
                        <strong class="text-xs text-slate-900 block">₹15,000 / mo</strong>
                        <span class="text-[10px] text-slate-500">₹1.80L per year</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="25000">
                        <strong class="text-xs text-slate-900 block">₹25,000 / mo</strong>
                        <span class="text-[10px] text-slate-500">₹3.00L per year</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="50000">
                        <strong class="text-xs text-slate-900 block">₹50,000+ / mo</strong>
                        <span class="text-[10px] text-slate-500">₹6.00L per year</span>
                    </button>
                </div>
            </div>

            <!-- Step 3: Horizon & Execution -->
            <div id="quiz-step-3" class="quiz-step space-y-2.5 hidden">
                <div class="flex items-center justify-between">
                    <h5 class="text-xs font-bold text-slate-800">3. Select your target accumulation tenure:</h5>
                    <button type="button" class="quiz-back-btn text-[11px] font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 cursor-pointer" data-target-step="2">
                        <span>←</span> <span>Back</span>
                    </button>
                </div>
                <div class="grid grid-cols-3 gap-2.5 mb-3">
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer" data-tenure="5">
                        <strong class="text-xs text-slate-900 block">5 Years</strong>
                        <span class="text-[10px] text-slate-500">Short Horizon</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer" data-tenure="10">
                        <strong class="text-xs text-slate-900 block">10 Years</strong>
                        <span class="text-[10px] text-slate-500">Medium Horizon</span>
                    </button>
                    <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer" data-tenure="15">
                        <strong class="text-xs text-slate-900 block">15+ Years</strong>
                        <span class="text-[10px] text-slate-500">Max Compounding</span>
                    </button>
                </div>
                
                <button type="button" id="apply-quiz-plan-btn" 
                    class="w-full py-2.5 px-5 rounded-2xl font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-600/20 active:scale-98 transition-all cursor-pointer text-xs sm:text-sm flex items-center justify-center gap-2">
                    <span>⚡ Calculate &amp; View My Custom Plan</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Default 1-Click Persona Blueprint Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- 1. First ₹1 Crore Rush -->
        <button type="button" 
            class="persona-btn text-left p-3.5 rounded-2xl border border-slate-200/90 bg-white/95 hover:bg-emerald-50/50 hover:border-emerald-300 hover:shadow-md active:scale-98 transition-all cursor-pointer group"
            data-persona="first_crore"
            data-sip="25000"
            data-years="9"
            data-rate="12"
            data-stepup="10"
            data-lumpsum="0"
            data-enable-swp="false">
            <div class="flex items-center justify-between mb-1.5">
                <span class="text-lg">🎯</span>
                <span class="text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-200 group-hover:bg-emerald-600 group-hover:text-white transition-colors">9 Yrs Target</span>
            </div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-emerald-800 transition-colors">First ₹1 Crore Rush</h4>
            <p class="text-[11px] text-slate-500 mt-1 line-clamp-2">₹25k/mo SIP @ 12% CAGR with 10% annual top-up to cross ₹1 Cr fast.</p>
        </button>

        <!-- 2. FIRE Early Retirement -->
        <button type="button" 
            class="persona-btn text-left p-3.5 rounded-2xl border border-slate-200/90 bg-white/95 hover:bg-rose-50/50 hover:border-rose-300 hover:shadow-md active:scale-98 transition-all cursor-pointer group"
            data-persona="fire_retirement"
            data-sip="50000"
            data-years="15"
            data-rate="12"
            data-stepup="10"
            data-lumpsum="0"
            data-enable-swp="true"
            data-swp="120000"
            data-swp-years="25"
            data-swp-rate="8"
            data-swp-hike="6">
            <div class="flex items-center justify-between mb-1.5">
                <span class="text-lg">🏖️</span>
                <span class="text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded-md bg-rose-100 text-rose-800 border border-rose-200 group-hover:bg-rose-600 group-hover:text-white transition-colors">FIRE Plan</span>
            </div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-rose-800 transition-colors">FIRE Early Retirement</h4>
            <p class="text-[11px] text-slate-500 mt-1 line-clamp-2">15 Yrs Accumulation → 25 Yrs of inflation-adjusted monthly pension.</p>
        </button>

        <!-- 3. Child Higher Education -->
        <button type="button" 
            class="persona-btn text-left p-3.5 rounded-2xl border border-slate-200/90 bg-white/95 hover:bg-indigo-50/50 hover:border-indigo-300 hover:shadow-md active:scale-98 transition-all cursor-pointer group"
            data-persona="child_education"
            data-sip="15000"
            data-years="18"
            data-rate="12"
            data-stepup="10"
            data-lumpsum="100000"
            data-enable-swp="false">
            <div class="flex items-center justify-between mb-1.5">
                <span class="text-lg">🎓</span>
                <span class="text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded-md bg-indigo-100 text-indigo-800 border border-indigo-200 group-hover:bg-indigo-600 group-hover:text-white transition-colors">18 Yrs Goal</span>
            </div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-indigo-800 transition-colors">Child Higher Education</h4>
            <p class="text-[11px] text-slate-500 mt-1 line-clamp-2">₹15k/mo SIP + ₹1L seed corpus compounding to ₹1.5+ Cr for college fees.</p>
        </button>

        <!-- 4. Senior Capital Preservation -->
        <button type="button" 
            class="persona-btn text-left p-3.5 rounded-2xl border border-slate-200/90 bg-white/95 hover:bg-amber-50/50 hover:border-amber-300 hover:shadow-md active:scale-98 transition-all cursor-pointer group"
            data-persona="capital_preservation"
            data-sip="0"
            data-years="0"
            data-rate="8"
            data-stepup="0"
            data-lumpsum="5000000"
            data-corpus="5000000"
            data-enable-swp="true"
            data-swp="35000"
            data-swp-years="20"
            data-swp-rate="8"
            data-swp-hike="0">
            <div class="flex items-center justify-between mb-1.5">
                <span class="text-lg">🛡️</span>
                <span class="text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded-md bg-amber-100 text-amber-800 border border-amber-200 group-hover:bg-amber-600 group-hover:text-white transition-colors">Monthly SWP</span>
            </div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-amber-800 transition-colors">Senior Citizen Monthly Income</h4>
            <p class="text-[11px] text-slate-500 mt-1 line-clamp-2">₹50 Lakh corpus generating ₹35,000/mo steady tax-efficient retirement cashflow.</p>
        </button>
    </div>
</div>
