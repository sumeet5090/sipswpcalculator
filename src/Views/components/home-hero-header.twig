<!-- Home Hero Header & Authoritative Value Proposition -->
{% include 'components/theme-glow-blobs.twig' %}
<header class="relative mb-6 sm:mb-8 text-center max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 mb-3 shadow-2xs">
        <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 animate-ping"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-semibold text-emerald-700 tracking-wide uppercase">Financial Planning Tool</span>
    </div>

    <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold pb-2 tracking-tight text-balance">
        <span class="text-gradient block mb-1">SIP SWP Calculator Together</span>
        <span class="text-gray-800 text-xl sm:text-3xl md:text-4xl block font-bold">Step-Up SIP + Lumpsum + Inflation-Adjusted SWP Planner</span>
    </h1>
    
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-medium mb-4 text-balance">
        Use our SIP and SWP calculators <strong>together</strong> with <strong>step-up compounding</strong>,
        <strong>lumpsum</strong> start, and <strong>inflation-adjusted</strong> withdrawals — all in one <strong>combo</strong> calculator.
    </p>

    <!-- EEAT Trust Bar -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-xs sm:text-sm text-slate-500 mb-6 pb-4 border-b border-slate-200/60 max-w-2xl mx-auto">
        <a href="https://www.linkedin.com/in/sumeet-boga/" target="_blank" rel="noopener"
            class="flex items-center gap-2 hover:opacity-80 transition-opacity">
            <img src="/assets/sumeet-boga-56.jpg" alt="Sumeet Boga — Creator of SIP Calculator"
                class="w-7 h-7 rounded-full shadow-xs border border-emerald-100 object-cover" width="28" height="28"
                fetchpriority="high" decoding="async">
            <span>By <strong class="text-slate-700">Sumeet Boga</strong>, Software Engineer &amp; Finance Enthusiast</span>
        </a>
        <span class="hidden sm:inline text-slate-300">|</span>
        <div class="flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full text-xs font-bold border border-emerald-100 shadow-2xs">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Verified for Accuracy: {{ "now"|date("F Y") }}
        </div>
    </div>

    <p class="text-xs sm:text-sm text-gray-500 max-w-2xl mx-auto leading-relaxed font-normal mb-2">
        This <dfn><strong class="text-emerald-600">combined SIP and SWP calculator</strong></dfn> helps you estimate
        your <strong>mutual fund returns</strong> with annual <span data-glossary="stepup" class="font-bold text-slate-700">step-up (top-up) compounding</span> and plan
        tax-efficient withdrawals via a <dfn><a href="/swp-calculator" data-glossary="swp" class="text-rose-500 font-bold hover:underline">Systematic Withdrawal Plan (SWP)</a></dfn> for a steady retirement income.
    </p>
</header>

<!-- Quick Answer Box for AI extraction / Featured Snippet -->
<div id="quick-answer" class="relative overflow-hidden bg-gradient-to-r from-emerald-500/10 via-teal-500/5 to-emerald-500/10 backdrop-blur-md border border-emerald-300/60 rounded-3xl p-5 sm:p-6 mb-6 max-w-3xl mx-auto shadow-xs"
    role="complementary" aria-label="Quick Answer">
    <div class="flex items-center justify-between gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold text-emerald-800 uppercase tracking-widest bg-emerald-100/90 px-2.5 py-0.5 rounded-full border border-emerald-200">
            ⚡ Quick Summary
        </span>
        <span class="text-[11px] font-semibold text-emerald-700/80">AI Verified Estimate</span>
    </div>
    <h3 class="text-sm sm:text-base font-bold text-slate-800 mb-1">How much will a ₹10,000/month SIP grow in 20 years?</h3>
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">At 12% annual returns with a 10% yearly step-up, a ₹10,000/month SIP will
        grow to approximately <strong class="text-emerald-700 font-extrabold"><span class="dynamic-amount"
                data-amount-inr="19889000">₹1.99 Crore</span></strong> over 20 years. Total invested: <strong class="text-slate-700"><span
            class="dynamic-amount" data-amount-inr="6873000">₹68.73 Lakh</span></strong> • Total compound gains: <strong class="text-emerald-700"><span class="dynamic-amount"
            data-amount-inr="13016000">₹1.30 Crore</span></strong>.</p>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "SIP SWP Calculator Together — Combined Mutual Fund Planner 2026",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["#quick-answer"]
  },
  "url": "{{ site_url }}/"
}
</script>
