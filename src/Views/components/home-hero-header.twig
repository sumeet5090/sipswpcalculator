<!-- Home Hero Header & Authoritative Value Proposition -->
{% include 'components/theme-glow-blobs.twig' %}
<header class="relative mb-6 sm:mb-8 text-center max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 mb-3 shadow-flat">
        <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 animate-ping"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="text-micro font-bold text-growth-emphasis tracking-wider uppercase">Financial Planning Suite</span>
    </div>

    <h1 class="font-heading text-display-xl font-extrabold pb-2 tracking-tight text-balance">
        <span class="text-gradient block mb-1">SIP SWP Calculator Together</span>
        <span class="text-slate-800 text-heading-lg sm:text-display-xl block font-bold">Step-Up SIP + Lumpsum + Inflation-Adjusted SWP Planner</span>
    </h1>
    
    <p class="text-body sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-medium mb-4 text-balance">
        Use our SIP and SWP calculators <strong>together</strong> with <strong>step-up compounding</strong>,
        <strong>lumpsum</strong> start, and <strong>inflation-adjusted</strong> withdrawals — all in one <strong>combo</strong> calculator.
    </p>

    <!-- EEAT Trust Bar -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-ui-xs sm:text-ui-sm text-slate-500 mb-6 pb-4 border-b border-slate-200/60 max-w-2xl mx-auto">
        <a href="https://www.linkedin.com/in/sumeet-boga/" target="_blank" rel="noopener"
            class="flex items-center gap-2 hover:opacity-80 transition-opacity">
            <img src="/assets/sumeet-boga-56.jpg" alt="Sumeet Boga — Creator of SIP Calculator"
                class="w-7 h-7 rounded-full shadow-flat border border-emerald-100 object-cover" width="28" height="28"
                fetchpriority="high" decoding="async">
            <span>By <strong class="text-slate-800">Sumeet Boga</strong>, Software Engineer &amp; Finance Enthusiast</span>
        </a>
        <span class="hidden sm:inline text-slate-300">|</span>
        <div class="flex items-center gap-1.5 bg-growth-surface text-growth-emphasis px-2.5 py-0.5 rounded-full text-ui-xs font-bold border border-growth-border shadow-flat">
            <svg class="w-3.5 h-3.5 text-growth" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Verified for Accuracy: {{ "now"|date("F Y") }}
        </div>
    </div>

    <!-- Above-The-Fold Interactive Activation CTA & Social Proof -->
    <div class="flex flex-col items-center justify-center gap-2.5 mb-6 not-prose">
        <a href="#calculator-heading"
           class="inline-flex items-center gap-2 px-7 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-card shadow-emerald-600/20 hover:shadow-card-hover hover:-translate-y-0.5 transition-all text-sm sm:text-base cursor-pointer"
           aria-label="Start SIP and SWP calculation">
            <span>Start Free Calculation</span>
            <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
        </a>
        <p class="text-ui-xs text-slate-500 font-medium flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
            <span><strong class="font-bold text-slate-700 font-financial-mono">{{ weekly_calculations|default(2000)|number_format(0, '.', ',') }}+</strong> calculations run this week</span>
        </p>
    </div>

    <p class="text-ui-xs sm:text-ui-sm text-slate-500 max-w-2xl mx-auto leading-relaxed font-normal mb-2">
        This <dfn><strong class="text-growth font-semibold">combined SIP and SWP calculator</strong></dfn> helps you estimate
        your <strong>mutual fund returns</strong> with annual <span data-glossary="stepup" class="font-bold text-slate-700">step-up (top-up) compounding</span> and plan
        tax-efficient withdrawals via a <dfn><a href="/swp-calculator" data-glossary="swp" class="text-emerald-700 font-bold hover:underline">Systematic Withdrawal Plan (SWP)</a></dfn> for a steady retirement income.
    </p>

    <!-- Dedicated Sub-Calculator Exploration Hub (Passes PageRank & Disambiguates Intent) -->
    <nav class="mt-4 pt-4 border-t border-slate-200/80 flex flex-wrap items-center justify-center gap-2 text-xs" aria-label="Specialized Financial Calculators">
        <span class="text-slate-500 font-medium mr-1">Looking for a specialized tool?</span>
        <a href="/swp-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>🛡️</span>
            <span>Standalone SWP Calculator</span>
        </a>
        <a href="/target-corpus-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>🎯</span>
            <span>Target Corpus (Goal SIP)</span>
        </a>
        <a href="/retirement-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>🏖️</span>
            <span>Retirement Corpus Planner</span>
        </a>
        <a href="/sip-step-up-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>📈</span>
            <span>Step-Up SIP Planner</span>
        </a>
        <a href="/compound-interest-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>⏳</span>
            <span>Compound Interest</span>
        </a>
        <a href="/cagr-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>📊</span>
            <span>CAGR Return Tool</span>
        </a>
        <a href="/emi-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>🏡</span>
            <span>Loan EMI Calculator</span>
        </a>
        <a href="/inflation-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>🔥</span>
            <span>Inflation Impact Tool</span>
        </a>
        <a href="/ppf-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>🛡️</span>
            <span>PPF Growth Tool</span>
        </a>
        <a href="/fd-calculator" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/50 text-slate-700 hover:text-emerald-800 font-semibold shadow-flat transition-colors">
            <span>🏦</span>
            <span>Bank FD Calculator</span>
        </a>
    </nav>
</header>

<!-- Quick Answer Box for AI extraction / Featured Snippet -->
<div id="quick-answer" class="relative overflow-hidden bg-gradient-to-r from-emerald-500/10 via-teal-500/5 to-emerald-500/10 backdrop-blur-md border border-emerald-300/60 rounded-3xl p-5 sm:p-6 mb-6 max-w-3xl mx-auto shadow-card"
    role="complementary" aria-label="Quick Answer">
    <div class="flex items-center justify-between gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 text-micro font-bold text-growth-emphasis uppercase tracking-wider bg-growth-surface px-2.5 py-0.5 rounded-full border border-growth-border">
            ⚡ Quick Summary
        </span>
        <span class="text-caption font-semibold text-growth-emphasis/80">AI Verified Estimate</span>
    </div>
    <h3 class="text-heading-sm font-heading font-bold text-slate-800 mb-1">How much will a ₹10,000/month SIP grow in 20 years?</h3>
    <p class="text-ui-xs sm:text-ui-sm text-slate-600 leading-relaxed">At 12% annual returns with a 10% yearly step-up, a ₹10,000/month SIP will
        grow to approximately <strong class="text-growth-emphasis font-extrabold"><span class="dynamic-amount"
                data-amount-inr="19889000">₹1.99 Crore</span></strong> over 20 years. Total invested: <strong class="text-slate-800"><span
            class="dynamic-amount" data-amount-inr="6873000">₹68.73 Lakh</span></strong> • Total compound gains: <strong class="text-growth-emphasis"><span class="dynamic-amount"
            data-amount-inr="13016000">₹1.30 Crore</span></strong>.</p>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "SIP & SWP Calculator Together (2026) — Dual Planner",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["#quick-answer"]
  },
  "url": "{{ site_url }}/"
}
</script>
