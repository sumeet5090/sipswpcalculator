<!-- Historical Black Swan Stress-Testing & Crash Recovery Simulator -->
<div id="stress-test-simulator-card" class="p-5 sm:p-6 rounded-3xl bg-white/95 backdrop-blur-md text-slate-800 border border-slate-200 shadow-xl relative overflow-hidden spotlight-card">
    <!-- Ambient Glow -->
    <div class="absolute -left-16 -top-16 w-56 h-56 bg-rose-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2.5">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-rose-50 text-rose-600 border border-rose-200 text-sm font-black">📉</span>
                <div>
                    <h4 class="text-xs sm:text-sm font-extrabold text-slate-900">Historical Black Swan Crash Simulator</h4>
                    <p class="text-[11px] text-slate-500">Stress-test your portfolio against major Indian market shocks</p>
                </div>
            </div>
            <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                Stress-Test Engine
            </span>
        </div>

        <!-- Crash Selector Buttons -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4" role="tablist" aria-label="Black Swan Scenarios">
            <button type="button" class="stress-choice-btn p-2.5 rounded-xl bg-white border-2 border-emerald-500 text-slate-900 text-left transition-all cursor-pointer shadow-sm" data-scenario="baseline" data-drop="0" data-recovery="0" data-year="0">
                <strong class="text-xs block">Normal Growth</strong>
                <span class="text-[10px] text-emerald-700 font-semibold">Steady Compounding</span>
            </button>
            <button type="button" class="stress-choice-btn p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all cursor-pointer" data-scenario="lehman" data-drop="52" data-recovery="24" data-year="3">
                <strong class="text-xs block">2008 Lehman</strong>
                <span class="text-[10px] text-rose-600 font-semibold">-52% Drop (Yr 3)</span>
            </button>
            <button type="button" class="stress-choice-btn p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all cursor-pointer" data-scenario="covid" data-drop="38" data-recovery="8" data-year="5">
                <strong class="text-xs block">2020 COVID</strong>
                <span class="text-[10px] text-amber-700 font-semibold">-38% Drop (Yr 5)</span>
            </button>
            <button type="button" class="stress-choice-btn p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:border-slate-300 hover:bg-white text-slate-700 text-left transition-all cursor-pointer" data-scenario="dotcom" data-drop="30" data-recovery="36" data-year="2">
                <strong class="text-xs block">2000 Dot-Com</strong>
                <span class="text-[10px] text-indigo-700 font-semibold">3 Flat / Bear Yrs</span>
            </button>
        </div>

        <!-- Stress Metrics Display -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/80 mb-3">
            <div>
                <div class="text-[10px] uppercase font-bold text-slate-500">Max Temporary Drawdown</div>
                <div id="stress-preview-drawdown" class="text-sm font-extrabold text-rose-600 font-mono mt-0.5">₹ 0 (0%)</div>
            </div>
            <div>
                <div class="text-[10px] uppercase font-bold text-slate-500">Historical Breakeven Time</div>
                <div id="stress-preview-recovery" class="text-sm font-extrabold text-emerald-700 font-mono mt-0.5">0 Months (No Drop)</div>
            </div>
            <div>
                <div class="text-[10px] uppercase font-bold text-slate-500">Net Wealth After Rebound</div>
                <div id="stress-preview-final" class="text-sm font-extrabold text-slate-900 font-mono mt-0.5">₹ --</div>
            </div>
        </div>

        <!-- Rupee Cost Averaging Lesson Callout -->
        <div id="stress-lesson-callout" class="text-[11px] text-slate-700 p-2.5 rounded-xl bg-amber-50/80 border border-amber-200/80 flex items-start gap-2 mb-3">
            <span class="text-xs">💡</span>
            <span id="stress-lesson-text" class="text-slate-700">In a steady compounding market, monthly SIP systematically accumulates wealth with standard compound interest.</span>
        </div>

        <!-- Action Row: Plot on Chart -->
        <div class="flex items-center justify-between pt-1 border-t border-slate-100">
            <span class="text-[11px] text-slate-500 font-medium">Visualize historical shock recovery on Growth Curve:</span>
            <button type="button" id="toggle-plot-shock-btn"
                class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-xs font-bold transition-all cursor-pointer shadow-2xs active:scale-95 flex items-center gap-1.5">
                <span>📉 Plot Shock Trajectory on Chart</span>
            </button>
        </div>
    </div>
</div>
