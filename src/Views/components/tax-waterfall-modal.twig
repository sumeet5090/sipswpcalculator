<!-- Budget 2024 Section 112A Interactive Tax Waterfall Modal -->
<dialog id="tax-waterfall-modal"
    class="fixed inset-x-0 bottom-0 md:inset-0 md:m-auto z-50 p-0 w-full md:max-w-lg rounded-t-[32px] md:rounded-3xl border border-slate-200 bg-white/98 backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm shadow-2xl text-slate-800 max-h-[90dvh] md:max-h-[85vh] flex flex-col overflow-hidden animate-in slide-in-from-bottom md:zoom-in-95 duration-200"
    aria-labelledby="tax-waterfall-title">
    
    <!-- Mobile Tactile Sheet Grab Handle -->
    <div class="md:hidden flex items-center justify-center pt-3 pb-1 shrink-0">
        <div class="w-12 h-1.5 rounded-full bg-slate-300"></div>
    </div>

    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80 shrink-0">
        <div class="flex items-center gap-2.5">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-violet-100 text-violet-700 text-sm font-black shadow-2xs">⚖️</span>
            <div>
                <h3 id="tax-waterfall-title" class="text-sm sm:text-base font-extrabold text-slate-900">Budget 2024 LTCG Tax Waterfall</h3>
                <p class="text-[11px] text-slate-500 font-medium">Section 112A Equity Mutual Fund Tax Arithmetic</p>
            </div>
        </div>
        <button type="button" id="close-tax-waterfall-btn" class="text-slate-400 hover:text-slate-700 p-2 rounded-xl bg-slate-100 hover:bg-slate-200 transition-all cursor-pointer" aria-label="Close Modal">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <!-- Effective Wealth Retention Banner -->
    <div class="px-6 pt-4 pb-1 shrink-0">
        <div class="p-3.5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50/50 to-white border border-emerald-200 flex items-center justify-between shadow-2xs">
            <div>
                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Effective Net Retention</div>
                <div class="text-xs sm:text-sm font-extrabold text-emerald-900 mt-0.5">
                    You Keep <span id="tax-modal-retention-pct" class="font-mono text-emerald-700 font-black">96.4%</span> of Wealth
                </div>
            </div>
            <div class="px-2.5 py-1 rounded-xl bg-white border border-emerald-200 text-[10px] font-mono font-bold text-emerald-800 shadow-2xs">
                Effective Tax: <span id="tax-modal-effective-rate">3.6%</span>
            </div>
        </div>
    </div>

    <!-- Waterfall Steps Body (Scrollable) -->
    <div class="p-6 space-y-3.5 overflow-y-auto custom-scrollbar flex-1 text-xs sm:text-sm">
        <!-- Step 1 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-2xs">
            <div>
                <div class="font-bold text-slate-800">1. Total Compounded Capital Gains</div>
                <div class="text-[11px] text-slate-500">Gross profit generated by investment</div>
            </div>
            <div id="tax-modal-gross-gains" class="font-extrabold text-slate-900 font-mono">₹ --</div>
        </div>

        <!-- Step 2 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200/80 shadow-2xs">
            <div>
                <div class="font-bold text-emerald-900">2. Less: Statutory Annual Exemption</div>
                <div class="text-[11px] text-emerald-700">Section 112A tax-free threshold</div>
            </div>
            <div class="font-extrabold text-emerald-800 font-mono">- ₹1,25,000</div>
        </div>

        <!-- Step 3 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-2xs">
            <div>
                <div class="font-bold text-slate-800">3. Net Taxable Capital Gains</div>
                <div class="text-[11px] text-slate-500">Gains exceeding the ₹1.25L exemption</div>
            </div>
            <div id="tax-modal-taxable-gains" class="font-extrabold text-slate-900 font-mono">₹ --</div>
        </div>

        <!-- Step 4 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-rose-50 border border-rose-200/80 shadow-2xs">
            <div>
                <div class="font-bold text-rose-900">4. Statutory Tax Payable @ 12.5%</div>
                <div class="text-[11px] text-rose-700">Budget 2024 LTCG equity mutual fund rate</div>
            </div>
            <div id="tax-modal-tax-amount" class="font-extrabold text-rose-700 font-mono">- ₹ --</div>
        </div>

        <!-- Step 5 -->
        <div class="flex items-center justify-between p-4 rounded-2xl bg-violet-50 border border-violet-200 shadow-2xs">
            <div>
                <div class="font-extrabold text-violet-950 text-xs sm:text-sm">5. Net Take-Home Compounded Wealth</div>
                <div class="text-[11px] text-violet-700">Final post-tax maturity corpus in your bank</div>
            </div>
            <div id="tax-modal-net-corpus" class="font-black text-violet-900 text-sm sm:text-base font-mono">₹ --</div>
        </div>

        <!-- Section 112A Tax-Harvesting Strategy Alpha -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200 space-y-2 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-extrabold text-emerald-900 flex items-center gap-1.5">
                    <span>💡</span>
                    <span>Annual Tax-Harvesting Alpha</span>
                </span>
                <span id="tax-modal-harvest-savings" class="text-xs font-black font-mono text-emerald-700">Save ₹ --</span>
            </div>
            <p class="text-[11px] text-emerald-950 leading-relaxed">
                By systematically booking and reinvesting up to ₹1,25,000 in capital gains each financial year, your cost basis resets tax-free, cutting cumulative statutory tax to <strong id="tax-modal-harvest-effective" class="font-mono text-emerald-900">₹ --</strong> at maturity.
            </p>
        </div>
    </div>

    <!-- Statutory Reference Footer -->
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 text-[11px] text-slate-500 flex items-center justify-between shrink-0">
        <span>Finance (No. 2) Act, 2024 Reference</span>
        <button type="button" id="close-tax-waterfall-footer-btn" class="font-bold text-emerald-700 hover:text-emerald-800 cursor-pointer">Done</button>
    </div>
</dialog>
