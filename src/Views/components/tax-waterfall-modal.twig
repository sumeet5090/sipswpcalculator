<!-- Budget 2024 Section 112A Interactive Tax Waterfall Modal -->
<dialog id="tax-waterfall-modal"
    class="fixed inset-0 m-auto z-50 rounded-3xl shadow-2xl p-0 w-full max-w-lg border border-slate-200 bg-white/95 backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm overflow-hidden text-slate-800"
    aria-labelledby="tax-waterfall-title">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80">
        <div class="flex items-center gap-2.5">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-violet-100 text-violet-700 text-sm font-black">⚖️</span>
            <div>
                <h3 id="tax-waterfall-title" class="text-sm sm:text-base font-extrabold text-slate-900">Budget 2024 LTCG Tax Waterfall</h3>
                <p class="text-[11px] text-slate-500">Section 112A Equity Mutual Fund Tax Arithmetic</p>
            </div>
        </div>
        <button type="button" id="close-tax-waterfall-btn" class="text-slate-400 hover:text-slate-700 p-1.5 rounded-lg hover:bg-slate-200/60 transition-colors cursor-pointer" aria-label="Close Modal">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <!-- Waterfall Steps Body -->
    <div class="p-6 space-y-4 text-xs sm:text-sm">
        <!-- Step 1 -->
        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/80">
            <div>
                <div class="font-bold text-slate-800">1. Total Compounded Capital Gains</div>
                <div class="text-[11px] text-slate-500">Gross profit generated by investment</div>
            </div>
            <div id="tax-modal-gross-gains" class="font-extrabold text-slate-900 font-mono">₹ --</div>
        </div>

        <!-- Step 2 -->
        <div class="flex items-center justify-between p-3 rounded-xl bg-emerald-50 border border-emerald-200/80">
            <div>
                <div class="font-bold text-emerald-900">2. Less: Statutory Annual Exemption</div>
                <div class="text-[11px] text-emerald-700">Section 112A tax-free threshold</div>
            </div>
            <div class="font-extrabold text-emerald-800 font-mono">- ₹1,25,000</div>
        </div>

        <!-- Step 3 -->
        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/80">
            <div>
                <div class="font-bold text-slate-800">3. Net Taxable Capital Gains</div>
                <div class="text-[11px] text-slate-500">Gains exceeding the ₹1.25L exemption</div>
            </div>
            <div id="tax-modal-taxable-gains" class="font-extrabold text-slate-900 font-mono">₹ --</div>
        </div>

        <!-- Step 4 -->
        <div class="flex items-center justify-between p-3 rounded-xl bg-rose-50 border border-rose-200/80">
            <div>
                <div class="font-bold text-rose-900">4. Statutory Tax Payable @ 12.5%</div>
                <div class="text-[11px] text-rose-700">Budget 2024 LTCG equity mutual fund rate</div>
            </div>
            <div id="tax-modal-tax-amount" class="font-extrabold text-rose-700 font-mono">- ₹ --</div>
        </div>

        <!-- Step 5 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-violet-50 border border-violet-200 shadow-2xs">
            <div>
                <div class="font-extrabold text-violet-950 text-xs sm:text-sm">5. Net Take-Home Compounded Wealth</div>
                <div class="text-[11px] text-violet-700">Final post-tax maturity corpus in your bank</div>
            </div>
            <div id="tax-modal-net-corpus" class="font-black text-violet-900 text-sm sm:text-base font-mono">₹ --</div>
        </div>
    </div>

    <!-- Statutory Reference Footer -->
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 text-[11px] text-slate-500 flex items-center justify-between">
        <span>Finance (No. 2) Act, 2024 Reference</span>
        <button type="button" id="close-tax-waterfall-footer-btn" class="font-bold text-emerald-700 hover:text-emerald-800 cursor-pointer">Close</button>
    </div>
</dialog>
