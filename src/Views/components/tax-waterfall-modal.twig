<!-- Budget 2024 Section 112A Interactive Tax Waterfall Modal -->
<dialog id="tax-waterfall-modal"
    class="rounded-3xl border border-slate-200 bg-white/98 backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm shadow-modal text-slate-800 overflow-hidden"
    aria-labelledby="tax-waterfall-title">

    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80 shrink-0">
        <div class="flex items-center gap-2.5">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-tax-surface text-tax-emphasis text-sm font-black shadow-flat">⚖️</span>
            <div>
                <h3 id="tax-waterfall-title" class="text-sm sm:text-base font-extrabold text-slate-900">Budget 2024 LTCG Tax Waterfall</h3>
                <p class="text-caption text-slate-500 font-medium">Section 112A Equity Mutual Fund Tax Arithmetic</p>
            </div>
        </div>
        <button type="button" id="close-tax-waterfall-btn" onclick="document.getElementById('tax-waterfall-modal')?.close()" class="text-slate-400 hover:text-slate-700 p-2 rounded-xl bg-slate-100 hover:bg-slate-200 transition-all cursor-pointer" aria-label="Close Modal">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <!-- Effective Wealth Retention Banner -->
    <div class="px-6 pt-4 pb-1 shrink-0">
        <div class="p-3.5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50/50 to-white border border-emerald-200 flex items-center justify-between shadow-flat">
            <div>
                <div class="text-micro font-bold text-slate-500 uppercase tracking-wider">Effective Net Retention</div>
                <div class="text-xs sm:text-sm font-extrabold text-growth-emphasis mt-0.5">
                    You Keep <span id="tax-modal-retention-pct" class="font-financial-mono text-growth-emphasis font-black">96.4%</span> of Wealth
                </div>
            </div>
            <div class="px-2.5 py-1 rounded-xl bg-white border border-emerald-200 text-micro font-financial-mono font-bold text-growth-emphasis shadow-flat">
                Effective Tax: <span id="tax-modal-effective-rate">3.6%</span>
            </div>
        </div>
    </div>

    <!-- Waterfall Steps Body (Scrollable) -->
    <div class="p-6 space-y-3.5 overflow-y-auto custom-scrollbar flex-1 text-xs sm:text-sm">
        <!-- Step 1 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-flat">
            <div>
                <div class="font-bold text-slate-800">1. Total Compounded Capital Gains</div>
                <div class="text-caption text-slate-500">Gross profit generated by investment</div>
            </div>
            <div id="tax-modal-gross-gains" class="font-extrabold text-slate-900 font-financial-mono">₹ --</div>
        </div>

        <!-- Step 2 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-growth-surface border border-growth-border shadow-flat">
            <div>
                <div class="font-bold text-growth-emphasis">2. Less: Statutory Annual Exemption</div>
                <div class="text-caption text-growth-emphasis">Section 112A tax-free threshold</div>
            </div>
            <div class="font-extrabold text-growth-emphasis font-financial-mono">- ₹1,25,000</div>
        </div>

        <!-- Step 3 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 shadow-flat">
            <div>
                <div class="font-bold text-slate-800">3. Net Taxable Capital Gains</div>
                <div class="text-caption text-slate-500">Gains exceeding the ₹1.25L exemption</div>
            </div>
            <div id="tax-modal-taxable-gains" class="font-extrabold text-slate-900 font-financial-mono">₹ --</div>
        </div>

        <!-- Step 4 -->
        <div class="flex items-center justify-between p-3.5 rounded-2xl bg-payout-surface border border-payout-border shadow-flat">
            <div>
                <div class="font-bold text-payout-emphasis">4. Statutory Tax Payable @ 12.5%</div>
                <div class="text-caption text-payout">Budget 2024 LTCG equity mutual fund rate</div>
            </div>
            <div id="tax-modal-tax-amount" class="font-extrabold text-payout font-financial-mono">- ₹ --</div>
        </div>

        <!-- Step 5 -->
        <div class="flex items-center justify-between p-4 rounded-2xl bg-tax-surface border border-tax-border shadow-flat">
            <div>
                <div class="font-extrabold text-tax-emphasis text-xs sm:text-sm">5. Net Take-Home Compounded Wealth</div>
                <div class="text-caption text-tax">Final post-tax maturity corpus in your bank</div>
            </div>
            <div id="tax-modal-net-corpus" class="font-black text-tax-emphasis text-sm sm:text-base font-financial-mono">₹ --</div>
        </div>

        <!-- Section 112A Tax-Harvesting Strategy Alpha -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200 space-y-2 shadow-flat">
            <div class="flex items-center justify-between">
                <span class="text-ui-xs font-extrabold text-growth-emphasis flex items-center gap-1.5">
                    <span>💡</span>
                    <span>Annual Tax-Harvesting Alpha</span>
                </span>
                <span id="tax-modal-harvest-savings" class="text-ui-xs font-black font-financial-mono text-growth-emphasis">Save ₹ --</span>
            </div>
            <p class="text-caption text-emerald-950 leading-relaxed">
                By systematically booking and reinvesting up to ₹1,25,000 in capital gains each financial year, your cost basis resets tax-free, cutting cumulative statutory tax to <strong id="tax-modal-harvest-effective" class="font-financial-mono text-growth-emphasis">₹ --</strong> at maturity.
            </p>
        </div>
    </div>

    <!-- Statutory Reference Footer -->
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 text-caption text-slate-500 flex items-center justify-between shrink-0">
        <span>Finance (No. 2) Act, 2024 Reference</span>
        <button type="button" id="close-tax-waterfall-footer-btn" onclick="document.getElementById('tax-waterfall-modal')?.close()" class="font-bold text-growth hover:text-growth-emphasis cursor-pointer">Done</button>
    </div>
</dialog>
