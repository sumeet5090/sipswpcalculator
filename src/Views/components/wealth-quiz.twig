<!-- Interactive Wealth Readiness Wizard & Goal Finder -->
<div id="wealth-quiz-card" class="mt-8 bg-white/95 backdrop-blur-md text-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-200 relative overflow-hidden spotlight-card">
    <!-- Ambient Glow Background -->
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-teal-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
            <div class="flex items-center gap-2.5">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200 text-sm">🪄</span>
                <div>
                    <h3 class="text-base sm:text-lg font-extrabold text-slate-900">Interactive Wealth Readiness Wizard</h3>
                    <p class="text-xs text-slate-500">Discover your customized SIP & SWP investment strategy in 3 simple clicks</p>
                </div>
            </div>
            <div class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                <span id="quiz-step-label">Step 1 of 3</span>
            </div>
        </div>

        <!-- Step 1: Primary Goal -->
        <div id="quiz-step-1" class="quiz-step space-y-3">
            <h4 class="text-xs sm:text-sm font-bold text-slate-800">1. What is your primary investment goal?</h4>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="first_crore" data-years="9" data-stepup="10">
                    <span class="text-base block mb-1">🎯</span>
                    <strong class="text-xs text-slate-900 block">First ₹1 Crore</strong>
                    <span class="text-[10px] text-slate-500">Wealth Sprint</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-rose-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="fire" data-years="15" data-enable-swp="true" data-swp="100000">
                    <span class="text-base block mb-1">🏖️</span>
                    <strong class="text-xs text-slate-900 block">FIRE Retirement</strong>
                    <span class="text-[10px] text-slate-500">Pension Freedom</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-indigo-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="education" data-years="18" data-stepup="10">
                    <span class="text-base block mb-1">🎓</span>
                    <strong class="text-xs text-slate-900 block">Child Education</strong>
                    <span class="text-[10px] text-slate-500">College Corpus</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-amber-500 hover:bg-white text-left transition-all cursor-pointer" data-goal="senior" data-years="0" data-enable-swp="true" data-corpus="5000000" data-swp="35000">
                    <span class="text-base block mb-1">🛡️</span>
                    <strong class="text-xs text-slate-900 block">Senior Income</strong>
                    <span class="text-[10px] text-slate-500">Monthly SWP</span>
                </button>
            </div>
        </div>

        <!-- Step 2: Monthly Capacity -->
        <div id="quiz-step-2" class="quiz-step space-y-3 hidden">
            <h4 class="text-xs sm:text-sm font-bold text-slate-800">2. How much can you comfortably invest every month?</h4>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="5000">
                    <strong class="text-xs text-slate-900 block">₹5,000 / mo</strong>
                    <span class="text-[10px] text-slate-500">₹60k per year</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="15000">
                    <strong class="text-xs text-slate-900 block">₹15,000 / mo</strong>
                    <span class="text-[10px] text-slate-500">₹1.80L per year</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="25000">
                    <strong class="text-xs text-slate-900 block">₹25,000 / mo</strong>
                    <span class="text-[10px] text-slate-500">₹3.00L per year</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-left transition-all cursor-pointer" data-sip="50000">
                    <strong class="text-xs text-slate-900 block">₹50,000+ / mo</strong>
                    <span class="text-[10px] text-slate-500">₹6.00L per year</span>
                </button>
            </div>
        </div>

        <!-- Step 3: Horizon & Execution -->
        <div id="quiz-step-3" class="quiz-step space-y-3 hidden">
            <h4 class="text-xs sm:text-sm font-bold text-slate-800">3. Select your target accumulation tenure:</h4>
            <div class="grid grid-cols-3 gap-2.5 mb-4">
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer" data-tenure="5">
                    <strong class="text-xs text-slate-900 block">5 Years</strong>
                    <span class="text-[10px] text-slate-500">Short Horizon</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer" data-tenure="10">
                    <strong class="text-xs text-slate-900 block">10 Years</strong>
                    <span class="text-[10px] text-slate-500">Medium Horizon</span>
                </button>
                <button type="button" class="quiz-choice p-3 rounded-2xl bg-slate-50/90 border border-slate-200 hover:border-emerald-500 hover:bg-white text-center transition-all cursor-pointer" data-tenure="15">
                    <strong class="text-xs text-slate-900 block">15+ Years</strong>
                    <span class="text-[10px] text-slate-500">Maximum Compounding</span>
                </button>
            </div>
            
            <button type="button" id="apply-quiz-plan-btn" 
                class="w-full py-3 px-6 rounded-2xl font-extrabold bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/20 active:scale-98 transition-all cursor-pointer text-xs sm:text-sm flex items-center justify-center gap-2">
                <span>⚡ Calculate &amp; View My Custom Plan</span>
            </button>
        </div>
    </div>
</div>
