<!-- Side-by-Side Scenario Snapshot & Comparison Matrix (Delta DNA) -->
<div id="scenario-diff-card" class="mt-3 p-3.5 sm:p-4 rounded-3xl bg-gradient-to-br from-indigo-50/80 via-white to-emerald-50/60 border border-indigo-200/90 shadow-sm backdrop-blur-md hidden transition-all duration-300">
    <div class="flex flex-col gap-3">
        <!-- Header: Snapshot Identity & Overall Variance Badge -->
        <div class="flex items-center justify-between gap-2 border-b border-indigo-100/80 pb-2">
            <div class="flex items-center gap-2 min-w-0">
                <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-indigo-600 text-white text-xs font-black shrink-0 shadow-2xs">
                    📊
                </span>
                <div class="min-w-0">
                    <h4 class="text-xs font-black text-indigo-950 uppercase tracking-tight">
                        Scenario Comparison vs Baseline
                    </h4>
                    <p id="scenario-diff-text" class="text-[10.5px] text-slate-500 truncate">
                        Modifying parameters to compare against saved snapshot.
                    </p>
                </div>
            </div>
            
            <div class="flex items-center gap-1.5 shrink-0">
                <span id="scenario-diff-pct" class="text-xs font-black px-2.5 py-0.5 rounded-lg bg-emerald-600 text-white shadow-2xs">
                    +0%
                </span>
            </div>
        </div>

        <!-- Live Side-by-Side Micro Delta Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-center text-[11px] font-mono">
            <div class="p-2 rounded-xl bg-white/90 border border-slate-200/80">
                <span class="text-[9px] font-bold text-slate-400 block uppercase">Baseline Corpus</span>
                <strong id="scenario-baseline-corpus" class="text-slate-800 font-extrabold">₹ --</strong>
            </div>
            <div class="p-2 rounded-xl bg-white/90 border border-slate-200/80">
                <span class="text-[9px] font-bold text-slate-400 block uppercase">Active Corpus</span>
                <strong id="scenario-active-corpus" class="text-emerald-900 font-extrabold">₹ --</strong>
            </div>
            <div class="col-span-2 sm:col-span-1 p-2 rounded-xl bg-emerald-50/90 border border-emerald-200/90">
                <span class="text-[9px] font-bold text-emerald-800 block uppercase">Net Wealth Delta</span>
                <strong id="scenario-delta-val" class="text-emerald-700 font-black">+₹ --</strong>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="flex items-center justify-between gap-2 pt-1 border-t border-indigo-100/60">
            <button type="button" id="scenario-clear-btn" class="text-[10px] font-bold text-slate-500 hover:text-slate-800 px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer">
                ✕ Clear Snapshot
            </button>
            <button type="button" id="scenario-share-diff-btn" class="text-[10px] font-black text-indigo-900 bg-indigo-100/90 hover:bg-indigo-200 border border-indigo-200 px-3 py-1 rounded-lg transition flex items-center gap-1 cursor-pointer shadow-2xs">
                <span>🔗</span> <span>Share Comparison</span>
            </button>
        </div>
    </div>
</div>

