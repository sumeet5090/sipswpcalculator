<!-- Side-by-Side Scenario Snapshot & Comparison Matrix (Delta DNA) -->
<div id="scenario-comparison-panel" class="hidden" style="display: none;">
<div id="scenario-diff-card" class="mt-3 p-3.5 sm:p-4 rounded-3xl bg-white border border-indigo-200/85 shadow-card hidden transition-all duration-300" style="display: none;">
    <div class="flex flex-col gap-3">
        <!-- Header: Snapshot Identity & Overall Variance Badge -->
        <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2">
            <div class="flex items-center gap-2 min-w-0">
                <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-indigo-600 text-white shrink-0 shadow-flat">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </span>
                <div class="min-w-0">
                    <h4 class="text-xs font-black text-indigo-950 uppercase tracking-tight">
                        Scenario Comparison vs Baseline
                    </h4>
                    <p id="scenario-diff-text" class="text-caption text-slate-500 truncate">
                        Modifying parameters to compare against saved snapshot.
                    </p>
                </div>
            </div>
            
            <div class="flex items-center gap-1.5 shrink-0">
                <span id="scenario-diff-pct" class="text-xs font-black px-2.5 py-0.5 rounded-lg bg-growth text-white shadow-flat">
                    +0%
                </span>
            </div>
        </div>

        <!-- Live Side-by-Side Micro Delta Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-center text-caption font-financial-mono">
            <div class="p-2 rounded-xl bg-white/90 border border-slate-200/80">
                <span class="text-micro font-bold text-slate-500 block uppercase">Baseline Corpus</span>
                <strong id="scenario-baseline-corpus" class="text-slate-800 font-extrabold">₹ --</strong>
            </div>
            <div class="p-2 rounded-xl bg-white/90 border border-slate-200/80">
                <span class="text-micro font-bold text-slate-500 block uppercase">Active Corpus</span>
                <strong id="scenario-active-corpus" class="text-growth-emphasis font-extrabold">₹ --</strong>
            </div>
            <div class="col-span-2 sm:col-span-1 p-2 rounded-xl bg-growth-surface border border-growth-border">
                <span class="text-micro font-bold text-growth-emphasis block uppercase">Net Wealth Delta</span>
                <strong id="scenario-delta-val" class="text-growth-emphasis font-black">+₹ --</strong>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="flex items-center justify-between gap-2 pt-1 border-t border-indigo-100/60">
            <button type="button" id="scenario-clear-btn" class="text-micro font-bold text-slate-500 hover:text-slate-800 px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition cursor-pointer shadow-flat">
                ✕ Clear Snapshot
            </button>
            <button type="button" id="scenario-share-diff-btn" class="text-micro font-black text-indigo-900 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 px-3 py-1 rounded-lg transition flex items-center gap-1.5 cursor-pointer shadow-flat">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                <span>Share Comparison</span>
            </button>
        </div>
    </div>
</div>
</div>

