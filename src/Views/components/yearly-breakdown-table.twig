<div class="mt-8 space-y-4">
    <!-- ========================================================================= -->
    <!-- TIER 1: UNIFIED BIFURCATED CONTROL & CONVERSION DISPATCH HUB              -->
    <!-- ========================================================================= -->
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3.5 pb-3.5 border-b border-slate-100">
        <!-- Left Operational Dock (Title · Horizon Density · Column Mode) -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <div class="flex items-center gap-2 mr-1">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-growth-surface text-growth-emphasis text-ui-sm border border-growth-border shadow-flat font-extrabold">📊</span>
                <div>
                    <h2 id="yearly-breakdown" class="font-heading text-heading-sm sm:text-heading-md font-extrabold text-slate-900 tracking-tight leading-tight">
                        Yearly Cashflow Ledger
                    </h2>
                    <p class="text-caption font-medium text-slate-500 hidden sm:block">Annual compounding progression & cashflows</p>
                </div>
            </div>

            <!-- Segmented Horizon & Column Density Strip -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-1.5 sm:gap-0">
                <div class="inline-flex items-center bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/90 shadow-flat gap-0.5" role="tablist" aria-label="Table Row Density">
                    <!-- Horizon Toggle -->
                    <button type="button" id="table-density-5y" role="tab" aria-selected="true"
                        class="px-2.5 py-1.5 sm:py-1 text-caption font-bold rounded-lg transition-all bg-white text-growth-emphasis shadow-flat border border-slate-200/60 cursor-pointer min-h-[40px] sm:min-h-0">
                        5Y Milestones
                    </button>
                    <button type="button" id="table-density-all" role="tab" aria-selected="false"
                        class="px-2.5 py-1.5 sm:py-1 text-caption font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900 cursor-pointer min-h-[40px] sm:min-h-0">
                        All Years
                    </button>
                </div>

                <span class="hidden sm:block w-px h-3.5 bg-slate-200 mx-1.5"></span>

                <div class="inline-flex items-center bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/90 shadow-flat gap-0.5" role="tablist" aria-label="Table Column Density">
                    <!-- Column Mode Toggle -->
                    <button type="button" id="table-col-essential" role="tab" aria-selected="true"
                        class="px-2.5 py-1.5 sm:py-1 text-caption font-bold rounded-lg transition-all bg-white text-growth-emphasis shadow-flat border border-slate-200/60 cursor-pointer min-h-[40px] sm:min-h-0">
                        <span class="sm:hidden">4 Col</span><span class="hidden sm:inline">Summary (4 Col)</span>
                    </button>
                    <button type="button" id="table-col-audit" role="tab" aria-selected="false"
                        class="px-2.5 py-1.5 sm:py-1 text-caption font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900 cursor-pointer min-h-[40px] sm:min-h-0">
                        <span class="sm:hidden">11 Col</span><span class="hidden sm:inline">Audit (11 Col)</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Dispatch & Conversion Hub (High-Prominence Action Pod) -->
        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-start sm:justify-end">
            <!-- CSV Export Button -->
            <button type="submit" id="downloadCsvBtn" name="action" value="download_csv" form="calculator-form" formaction="/download-csv"
                class="px-3.5 py-2 rounded-xl bg-growth-surface hover:bg-emerald-100 text-growth-emphasis border border-growth-border text-ui-xs font-extrabold transition-all duration-150 shadow-flat hover:shadow-subtle hover:border-emerald-300 active:scale-95 cursor-pointer flex items-center gap-1.5"
                title="Export complete schedule to spreadsheet (.csv)">
                <svg class="w-3.5 h-3.5 text-growth" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <span>Export CSV</span>
            </button>

            <!-- Branded Advisor Report Modal Trigger -->
            <button type="button" id="customizePdfModalBtn" aria-haspopup="dialog" aria-expanded="false"
                aria-controls="pdfModal"
                class="hidden md:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-tax-surface hover:bg-violet-100 text-tax-emphasis border border-tax-border text-ui-xs font-bold transition-all duration-150 shadow-flat hover:shadow-subtle hover:border-violet-300 active:scale-95 cursor-pointer"
                title="Add Client Name, Advisor Logo & Branding to PDF">
                <span>🎨</span>
                <span class="text-caption font-bold">Branded PDF</span>
            </button>

            <!-- Save Plan to Browser Storage Button -->
            <button type="button" id="saveCalculationBtn"
                class="px-3.5 py-2 rounded-xl bg-amber-50/90 hover:bg-amber-100/90 text-amber-900 border border-amber-200 text-ui-xs font-extrabold transition-all duration-150 shadow-flat hover:shadow-subtle hover:border-amber-300 active:scale-95 cursor-pointer flex items-center gap-1.5"
                title="Save current calculation to this browser for future reference">
                <span id="saveBtnIcon">💾</span>
                <span id="saveBtnText">Save Plan</span>
            </button>

            <!-- Share Scenario Button -->
            <button type="button" id="shareCalcBtn" aria-expanded="false"
                class="px-3.5 py-2 rounded-xl bg-indigo-50/90 hover:bg-indigo-100/90 text-indigo-900 border border-indigo-200 text-ui-xs font-extrabold transition-all duration-150 shadow-flat hover:shadow-subtle hover:border-indigo-300 active:scale-95 cursor-pointer flex items-center gap-1.5"
                title="Share this investment calculation link or WhatsApp proposal">
                <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                </svg>
                <span id="shareBtnText">Share Plan</span>
            </button>

            <!-- 1-Click Fast PDF Download Hero Button -->
            <button type="button" id="openPdfModalBtn"
                class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-700 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white text-ui-xs font-extrabold transition-all duration-150 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 active:scale-95 cursor-pointer flex items-center gap-2"
                title="Instant 1-Click Institutional PDF Report Download">
                <svg class="w-4 h-4 text-emerald-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Download PDF Plan</span>
            </button>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TIER 2: INSTITUTIONAL HIGH-DENSITY LEDGER GRID                             -->
    <!-- ========================================================================= -->
    <div class="bg-white/95 backdrop-blur-md rounded-3xl overflow-hidden border border-slate-200/80 shadow-card">
        <!-- Desktop Table View with Sticky Year Pin Elevation -->
        <div id="table-scroll-wrapper" class="hidden sm:block max-h-[600px] overflow-y-auto overflow-x-auto custom-scrollbar">
            <table id="results-table" class="w-full text-ui-xs sm:text-ui-sm relative border-separate border-spacing-0">
                <thead id="breakdown-head"
                    class="bg-slate-50/98 backdrop-blur-md text-caption uppercase font-extrabold text-slate-600 sticky top-0 z-20 shadow-[0_1px_3px_rgba(0,0,0,0.05)] border-b border-slate-200">
                    <tr>
                        <th scope="col" id="th-year" class="px-4 sm:px-5 py-3.5 text-left sticky left-0 z-30 bg-slate-50 shadow-[3px_0_8px_-2px_rgba(15,23,42,0.05)] border-b border-slate-200 font-extrabold text-slate-900 whitespace-nowrap min-w-[5rem]">Year</th>
                        <th scope="col" id="th-begin-balance" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 whitespace-nowrap">Start Corpus</th>
                        <th scope="col" id="th-sip-monthly" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-growth whitespace-nowrap">Monthly SIP</th>
                        <th scope="col" id="th-annual-sip" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-growth whitespace-nowrap">Annual SIP</th>
                        <th scope="col" id="th-total-invested" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 whitespace-nowrap">Total Invested</th>
                        <th scope="col" id="th-swp-monthly" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-payout whitespace-nowrap">Monthly SWP</th>
                        <th scope="col" id="th-annual-swp" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-payout whitespace-nowrap">Annual SWP</th>
                        <th scope="col" id="th-total-withdrawn" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-slate-600 whitespace-nowrap">Total Withdrawn</th>
                        <th scope="col" id="th-interest" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-growth whitespace-nowrap">Annual Gain</th>
                        <th scope="col" id="th-tax" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-tax whitespace-nowrap">LTCG Tax (§112A)</th>
                        <th scope="col" id="th-end-corpus" class="px-4 sm:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 font-extrabold text-slate-900 whitespace-nowrap">End Corpus</th>
                    </tr>
                </thead>
                <tbody id="breakdown-body" class="divide-y divide-slate-100 text-slate-600 font-financial-mono"></tbody>
            </table>
        </div>

        <!-- ========================================================================= -->
        <!-- TIER 3: MOBILE COMPACT AUDIT CARDS & PROGRESSIVE DISCLOSURE               -->
        <!-- ========================================================================= -->
        <div id="mobile-breakdown-cards" class="sm:hidden space-y-2.5 p-3.5"></div>

        <!-- Mobile Progressive Disclosure Footer -->
        <div class="sm:hidden p-3 border-t border-slate-100 flex justify-center bg-slate-50/50">
            <button type="button" id="mobile-expand-all-years-btn" 
                class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-ui-xs border border-slate-200 shadow-flat transition-all flex items-center justify-center gap-1.5 active:scale-98 cursor-pointer">
                <span>📜</span>
                <span id="expand-btn-text">Show All Years Breakdown</span>
            </button>
        </div>
    </div>
</div>
