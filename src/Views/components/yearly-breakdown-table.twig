<div class="mt-8 space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <h2 id="yearly-breakdown" class="text-lg sm:text-xl font-bold text-slate-800 flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                    </path>
                </svg>
                Yearly Breakdown
            </h2>

            <!-- Column Density Switcher (Essential 4-Col vs Full Audit 11-Col) -->
            <div class="inline-flex bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/80" role="tablist" aria-label="Column Density">
                <button type="button" id="table-col-essential" role="tab" aria-selected="true"
                    class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 bg-white text-emerald-700 shadow-sm border border-slate-200/40 cursor-pointer">
                    Essential (4 Col)
                </button>
                <button type="button" id="table-col-audit" role="tab" aria-selected="false"
                    class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 text-slate-500 hover:text-slate-700 cursor-pointer">
                    Full Audit (11 Col)
                </button>
            </div>

            <!-- Time Horizon Density Toggle (All Years vs 5Y Milestones) -->
            <div class="inline-flex bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/80" role="tablist" aria-label="Table View Density">
                <button type="button" id="table-density-all" role="tab" aria-selected="false"
                    class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 text-slate-500 hover:text-slate-700 cursor-pointer">
                    All Years
                </button>
                <button type="button" id="table-density-5y" role="tab" aria-selected="true"
                    class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 bg-white text-emerald-700 shadow-sm border border-slate-200/40 cursor-pointer">
                    5Y Milestones
                </button>
            </div>

            <!-- Quick Year Search -->
            <div class="relative hidden sm:block">
                <input type="number" id="table-year-search" placeholder="Jump to Yr..." min="1" max="50"
                    class="w-24 bg-slate-100/90 text-slate-700 placeholder-slate-400 text-[11px] font-bold px-2.5 py-1 rounded-lg border border-slate-200/80 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all"
                    aria-label="Filter or Jump to Year">
            </div>

            <!-- Heatmap Intensity Toggle -->
            <button type="button" id="table-heatmap-toggle"
                class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 text-[11px] font-bold rounded-lg border border-slate-200/80 bg-slate-50 text-slate-600 hover:bg-slate-100 transition-all cursor-pointer shadow-2xs"
                title="Toggle Interest Compounding Heatmap">
                <span>🔥</span>
                <span>Heatmap</span>
            </button>
        </div>
        <div class="flex items-center gap-2.5">
            <!-- CSV Export Button -->
            <button type="submit" id="downloadCsvBtn" name="action" value="download_csv" form="calculator-form" formaction="/download-csv"
                class="text-xs sm:text-sm px-4 py-2.5 inline-flex items-center gap-2 rounded-xl font-bold bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 hover:text-slate-900 transition-all duration-200 shadow-sm hover:shadow active:scale-95 cursor-pointer">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <span>CSV Export</span>
            </button>

            <!-- 1-Click Fast PDF Download Hero Button -->
            <button type="button" id="openPdfModalBtn"
                class="text-xs sm:text-sm px-4 sm:px-5 py-2.5 inline-flex items-center gap-2 rounded-xl font-extrabold bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white transition-all duration-200 shadow-md hover:shadow-lg active:scale-95 cursor-pointer"
                title="Instant 1-Click PDF Plan Download">
                <svg class="w-4 h-4 text-emerald-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Download PDF</span>
            </button>

            <!-- Optional Custom Branded Advisor Report Modal Trigger -->
            <button type="button" id="customizePdfModalBtn" aria-haspopup="dialog" aria-expanded="false"
                aria-controls="pdfModal"
                class="text-xs sm:text-sm px-3 sm:px-3.5 py-2.5 inline-flex items-center gap-1.5 rounded-xl font-bold bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 hover:text-slate-900 transition-all duration-200 shadow-sm hover:shadow active:scale-95 cursor-pointer"
                title="Add Client Name, Advisor Logo & Branding">
                <span class="text-xs">🎨</span>
                <span class="hidden md:inline text-[11px] font-semibold">Branded Report</span>
            </button>

            <!-- Share Scenario Button -->
            <button type="button" id="shareCalcBtn" aria-expanded="false"
                class="text-xs sm:text-sm px-4 py-2.5 inline-flex items-center gap-2 rounded-xl font-bold bg-white text-emerald-700 border border-emerald-200 hover:bg-emerald-50 hover:border-emerald-300 transition-all duration-200 shadow-sm active:scale-95 cursor-pointer">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                </svg>
                <span id="shareBtnText">Share</span>
            </button>
        </div>
    </div>

    <!-- Thermal Compounding Velocity Legend (revealed when heatmap is active) -->
    <div id="heatmap-legend" class="hidden flex-wrap items-center gap-3 text-[10px] font-semibold text-slate-600 px-3.5 py-2 rounded-2xl bg-slate-50 border border-slate-200/80 mb-3">
        <span class="font-bold text-slate-700">Compounding Velocity:</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-emerald-50 border border-emerald-200"></span> 1× (Linear Principal)</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-emerald-200 border border-emerald-300"></span> 2–3× (Acceleration)</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-emerald-500 border border-emerald-600"></span> &gt;5× (Compounding Hyperdrive)</span>
    </div>

    <div class="bg-white/95 backdrop-blur-md rounded-3xl overflow-hidden border border-slate-200/80 shadow-md">
        <!-- Desktop Table View -->
        <div id="table-scroll-wrapper" class="hidden sm:block max-h-[600px] overflow-y-auto overflow-x-auto custom-scrollbar">
            <table id="results-table" class="w-full text-sm text-left relative">
                <thead id="breakdown-head"
                    class="bg-slate-50/95 backdrop-blur-md text-xs uppercase font-bold text-slate-600 sticky top-0 z-10 shadow-[0_1px_3px_rgba(0,0,0,0.05)]">
                    <tr>
                        <th scope="col" class="px-6 py-4 bg-slate-50/95 border-b border-slate-200">Year</th>
                        <th scope="col" class="px-6 py-4 bg-slate-50/95 border-b border-slate-200 whitespace-nowrap col-secondary">Start Corpus</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 text-emerald-700 whitespace-nowrap col-secondary">Monthly SIP</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 text-emerald-700 whitespace-nowrap col-secondary">Annual SIP</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 whitespace-nowrap">Total Invested</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 text-rose-700 whitespace-nowrap swp-col col-secondary" {{ not enable_swp ? 'style="display:none"' : '' }}>Monthly SWP</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 text-rose-700 whitespace-nowrap swp-col col-secondary" {{ not enable_swp ? 'style="display:none"' : '' }}>Annual SWP</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 text-slate-600 whitespace-nowrap swp-col" {{ not enable_swp ? 'style="display:none"' : '' }}>Total Withdrawn</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 text-emerald-700 whitespace-nowrap">Interest</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 text-rose-700 whitespace-nowrap tax-col col-secondary" style="display:none">LTCG Tax</th>
                        <th scope="col" class="px-6 py-4 text-right bg-slate-50/95 border-b border-slate-200 font-bold text-slate-800 whitespace-nowrap">End Corpus</th>
                    </tr>
                </thead>
                <tbody id="breakdown-body" class="divide-y divide-slate-100 text-slate-600"></tbody>
            </table>
        </div>

        <!-- Mobile Milestone Cards View (Prevents 11-column horizontal scroll trap on small screens) -->
        <div id="mobile-breakdown-cards" class="sm:hidden space-y-2.5 p-3.5 max-h-[600px] overflow-y-auto custom-scrollbar"></div>
    </div>
</div>
