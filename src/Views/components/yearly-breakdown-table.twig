{% set isStudio = in_studio|default(false) %}
<div id="yearly-breakdown" class="{{ isStudio ? 'scroll-mt-24' : 'mt-2 space-y-4 scroll-mt-24' }}">
    <!-- ========================================================================= -->
    <!-- TIER 1: UNIFIED BIFURCATED CONTROL & CONVERSION DISPATCH HUB              -->
    <!-- ========================================================================= -->
    <div class="{{ isStudio ? 'hidden sm:flex flex-col xl:flex-row items-start xl:items-center justify-between gap-3 px-4 sm:px-5 py-3 bg-slate-50 border-b border-slate-200/80' : 'flex flex-col xl:flex-row items-start xl:items-center justify-between gap-3.5 pb-3.5 border-b border-slate-100' }}">
        <!-- Left Operational Dock (Title · Horizon Density · Column Mode) -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            {% if not isStudio %}
            <div class="flex items-center gap-2 mr-1">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-growth-surface text-growth-emphasis text-ui-sm border border-growth-border shadow-flat font-extrabold">
                    <svg class="w-4 h-4 text-growth" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </span>
                <div>
                    <h2 class="font-heading text-heading-sm sm:text-heading-md font-extrabold text-slate-900 tracking-tight leading-tight">
                        Yearly Cashflow Ledger
                    </h2>
                    <p class="text-caption font-medium text-slate-500 hidden sm:block">Annual compounding progression &amp; cashflows</p>
                </div>
            </div>
            {% endif %}

            <!-- Segmented Horizon & Column Density Strip (Desktop / Tablet) -->
            <div class="hidden sm:flex items-center gap-1.5">
                <div class="inline-flex items-center bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/90 shadow-flat gap-0.5" role="tablist" aria-label="Table Row Density">
                    <!-- Horizon Toggle -->
                    <button type="button" id="table-density-5y" role="tab" aria-selected="true"
                        class="px-3 py-1 text-caption font-bold rounded-lg transition-all bg-white text-growth-emphasis shadow-flat border border-slate-200/60 cursor-pointer flex items-center justify-center">
                        5Y Milestones
                    </button>
                    <button type="button" id="table-density-all" role="tab" aria-selected="false"
                        class="px-3 py-1 text-caption font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900 cursor-pointer flex items-center justify-center">
                        All Years
                    </button>
                </div>

                <span class="w-px h-3.5 bg-slate-200 mx-1.5"></span>

                <div class="inline-flex items-center bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/90 shadow-flat gap-0.5" role="tablist" aria-label="Table Column Density">
                    <!-- Column Mode Toggle -->
                    <button type="button" id="table-col-essential" role="tab" aria-selected="true"
                        class="px-2.5 py-1 text-caption font-bold rounded-lg transition-all bg-white text-growth-emphasis shadow-flat border border-slate-200/60 cursor-pointer">
                        Summary (4 Col)
                    </button>
                    <button type="button" id="table-col-audit" role="tab" aria-selected="false"
                        class="px-2.5 py-1 text-caption font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900 cursor-pointer">
                        Audit (11 Col)
                    </button>
                </div>
            </div>
        </div>

        <!-- Desktop Dispatch & Conversion Hub (Consolidated Executive Action Hub >= sm) -->
        <div class="hidden sm:flex flex-wrap items-center gap-2 w-full xl:w-auto justify-start xl:justify-end">
            <!-- Consolidated Export & Share Dropdown -->
            <details class="relative inline-block text-left group" id="export-share-dropdown">
                <summary class="list-none inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200/90 text-ui-xs font-bold transition-all shadow-flat active:scale-95 cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                    </svg>
                    <span>Export &amp; Share</span>
                    <svg class="w-3.5 h-3.5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </summary>
                <div class="absolute right-0 mt-1.5 w-60 rounded-2xl bg-white border border-slate-200/90 shadow-modal py-1.5 z-30 space-y-0.5">
                    {% if calculator_type not in ['ppf', 'fd', 'emi', 'inflation', 'cagr', 'compound_interest'] %}
                    <!-- 1. CSV Export Button -->
                    <button type="submit" id="downloadCsvBtn" name="action" value="download_csv" form="calculator-form" formaction="/download-csv"
                        class="w-full px-3.5 py-2 text-left text-ui-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-emerald-700 transition-colors flex items-center gap-2.5 cursor-pointer"
                        title="Export complete schedule to spreadsheet (.csv)">
                        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                        </svg>
                        <span>Export CSV / Excel</span>
                    </button>

                    <!-- 2. Branded Advisor Report Modal Trigger -->
                    <button type="button" id="customizePdfModalBtn" aria-haspopup="dialog" aria-expanded="false" aria-controls="pdfModal"
                        class="w-full px-3.5 py-2 text-left text-ui-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-violet-700 transition-colors flex items-center gap-2.5 cursor-pointer"
                        title="Add Client Name, Advisor Logo & Branding to PDF">
                        <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 4 4 0 014-4c1.1 0 2.1.4 2.8 1.1L12 16l2.2-2.2c.7-.7 1.7-1.1 2.8-1.1a4 4 0 014 4 4 4 0 01-4 4H7z"/>
                        </svg>
                        <span class="text-caption font-bold">Branded PDF Report</span>
                    </button>
                    {% endif %}

                    <!-- 3. Social Card Download Button -->
                    <button type="button" id="downloadSocialCardBtn"
                        class="w-full px-3.5 py-2 text-left text-ui-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-teal-700 transition-colors flex items-center gap-2.5 cursor-pointer"
                        title="Generate and download a branded 1080x1080 social card for WhatsApp, Instagram, or Twitter">
                        <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <span id="socialCardBtnText">Download Share Card</span>
                    </button>

                    <!-- 4. Share Scenario Button -->
                    <button type="button" id="shareCalcBtn" aria-expanded="false"
                        class="w-full px-3.5 py-2 text-left text-ui-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-indigo-700 transition-colors flex items-center gap-2.5 cursor-pointer"
                        title="Share this investment calculation link or WhatsApp proposal">
                        <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                        </svg>
                        <span id="shareBtnText">Share Plan Link / QR</span>
                    </button>

                    <!-- 5. Save Plan to Browser Storage Button -->
                    <button type="button" id="saveCalculationBtn"
                        class="w-full px-3.5 py-2 text-left text-ui-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-amber-700 transition-colors flex items-center gap-2.5 cursor-pointer"
                        title="Save current calculation to this browser for future reference">
                        <span id="saveBtnIcon" class="flex items-center">
                            <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                            </svg>
                        </span>
                        <span id="saveBtnText">Save Plan Snapshot</span>
                    </button>
                </div>
            </details>

            {% if calculator_type not in ['ppf', 'fd', 'emi', 'inflation', 'cagr', 'compound_interest'] %}
            <!-- 1-Click Fast PDF Download Hero Button -->
            <button type="button" id="openPdfModalBtn"
                class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-700 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white text-ui-xs font-extrabold transition-all duration-150 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 active:scale-95 cursor-pointer flex items-center gap-2"
                title="Instant 1-Click Institutional PDF Report Download">
                <svg class="w-4 h-4 text-emerald-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Download PDF Plan</span>
            </button>
            {% endif %}
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TIER 2: INSTITUTIONAL HIGH-DENSITY LEDGER GRID                             -->
    <!-- ========================================================================= -->
    <div class="{{ isStudio ? 'bg-white/95 rounded-b-3xl overflow-hidden' : 'bg-white/95 rounded-3xl overflow-hidden border border-slate-200/80 shadow-card' }}">
        <!-- Desktop Table View with Sticky Year Pin Elevation -->
        <div id="table-scroll-wrapper" class="hidden sm:block max-h-[600px] overflow-y-auto overflow-x-auto custom-scrollbar">
            <table id="results-table" class="w-full text-ui-xs sm:text-ui-sm relative border-separate border-spacing-0">
                <thead id="breakdown-head"
                    class="bg-slate-50 text-caption uppercase font-extrabold text-slate-600 sticky top-0 z-20 shadow-[0_1px_3px_rgba(0,0,0,0.05)] border-b border-slate-200">
                    <tr>
                        <th scope="col" id="th-year" class="px-3.5 lg:px-5 py-3.5 text-left sticky left-0 z-30 table-sticky-col-0 bg-slate-50 shadow-[3px_0_8px_-2px_rgba(15,23,42,0.05)] border-b border-slate-200 font-extrabold text-slate-900 whitespace-nowrap min-w-[5rem]">Year</th>
                        <th scope="col" id="th-begin-balance" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 whitespace-nowrap">Start Corpus</th>
                        <th scope="col" id="th-sip-monthly" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-growth whitespace-nowrap">Monthly SIP</th>
                        <th scope="col" id="th-annual-sip" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-growth whitespace-nowrap">Annual SIP</th>
                        <th scope="col" id="th-total-invested" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 whitespace-nowrap">Total Invested</th>
                        <th scope="col" id="th-swp-monthly" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-payout whitespace-nowrap">Monthly SWP</th>
                        <th scope="col" id="th-annual-swp" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-payout whitespace-nowrap">Annual SWP</th>
                        <th scope="col" id="th-total-withdrawn" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-slate-600 whitespace-nowrap">Total Withdrawn</th>
                        <th scope="col" id="th-interest" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-growth whitespace-nowrap">Annual Gain</th>
                        <th scope="col" id="th-tax" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 text-tax whitespace-nowrap">LTCG Tax (§112A)</th>
                        <th scope="col" id="th-end-corpus" class="px-3.5 lg:px-5 py-3.5 text-right bg-slate-50 border-b border-slate-200 font-extrabold text-slate-900 whitespace-nowrap">End Corpus</th>
                    </tr>
                </thead>
                <tbody id="breakdown-body" class="divide-y divide-slate-100 text-slate-600 font-financial-mono"></tbody>
            </table>
        </div>

        <!-- Desktop Progressive Disclosure Card Footer (Institutional Milestone Cap) -->
        <div id="desktop-table-footer" class="hidden sm:flex items-center justify-between px-5 py-3 bg-slate-50/90 border-t border-slate-200/80 text-caption font-semibold text-slate-600">
            <span id="desktop-table-milestone-counter">Showing 9 Milestone Years</span>
            <button type="button" id="desktop-toggle-all-years-btn"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-slate-200/90 hover:border-slate-300 hover:bg-slate-50 text-slate-700 font-bold transition-all shadow-flat hover:shadow-subtle active:scale-95 cursor-pointer text-caption">
                <span id="desktop-toggle-all-years-text">View All 40 Years</span>
                <svg id="desktop-toggle-all-years-icon" class="w-3.5 h-3.5 text-slate-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>
        </div>

        <!-- ========================================================================= -->
        <!-- TIER 3: MOBILE SWIPEABLE CAROUSEL & COMPACT LIST MODES                    -->
        <!-- ========================================================================= -->
        <div class="sm:hidden flex items-center justify-between px-3.5 pt-3 pb-2 border-b border-slate-100">
            <span class="text-caption font-bold text-slate-500 uppercase tracking-wider">Breakdown View:</span>
            <div class="inline-flex bg-slate-100 p-0.5 rounded-xl border border-slate-200/80 shadow-flat" role="tablist">
                <button type="button" id="mobile-view-carousel-btn" role="tab" aria-selected="true"
                    class="px-3 py-1.5 text-caption font-bold rounded-lg transition-all bg-white text-growth-emphasis shadow-flat border border-slate-200/60 cursor-pointer min-h-[40px] flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                    <span>Cards</span>
                </button>
                <button type="button" id="mobile-view-list-btn" role="tab" aria-selected="false"
                    class="px-3 py-1.5 text-caption font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900 cursor-pointer min-h-[40px] flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    <span>Table</span>
                </button>
            </div>
        </div>

        <!-- 3A: Swipeable Milestone Carousel -->
        <div id="mobile-breakdown-carousel-wrapper" class="sm:hidden p-3 min-h-[140px]">
            <div id="mobile-breakdown-cards" class="flex gap-3 overflow-x-auto snap-x snap-mandatory no-scrollbar pb-2">
                {% if initial_schedule %}
                    {% for row in initial_schedule %}
                        <div data-card-year="{{ row.year }}" class="snap-center shrink-0 w-[84vw] max-w-[320px] p-3.5 rounded-2xl bg-white border border-slate-200/90 shadow-subtle space-y-2 transition-all flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="{{ row.is_final ? 'px-2.5 py-1 rounded-lg text-ui-xs font-black bg-emerald-600 text-white shadow-flat' : 'px-2.5 py-0.5 rounded-lg text-ui-xs font-extrabold bg-emerald-50 text-emerald-800 border border-emerald-200' }}">
                                    Year {{ row.year }}{{ row.is_final ? ' (Maturity)' : '' }}
                                </span>
                                <div class="flex items-center gap-1.5">
                                    <span class="text-body font-black font-financial-mono tabular-nums text-slate-900 whitespace-nowrap">{{ row.combined_total }}</span>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-ui-xs pt-1.5 border-t border-slate-100">
                                <div>
                                    <span class="text-slate-500 block text-caption font-semibold">Total Invested</span>
                                    <span class="font-bold font-financial-mono tabular-nums text-slate-800 whitespace-nowrap text-ui-xs">{{ row.cumulative_invested }}</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-emerald-700 block text-caption font-semibold">Annual Gain</span>
                                    <span class="font-extrabold font-financial-mono tabular-nums text-emerald-700 whitespace-nowrap text-ui-xs">+{{ row.interest }}</span>
                                </div>
                                {% if row.has_withdrawals %}
                                    <div class="col-span-2 pt-1 border-t border-slate-100 flex items-center justify-between text-ui-xs">
                                        <span class="text-rose-700 text-caption font-semibold">Total Withdrawn</span>
                                        <span class="font-extrabold font-financial-mono tabular-nums text-rose-700 whitespace-nowrap text-ui-xs">{{ row.cumulative_withdrawals }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
            <!-- Dynamic Carousel Dots Indicator -->
            <div id="mobile-carousel-dots" class="flex items-center justify-center gap-1.5 mt-2">
                {% if initial_schedule %}
                    {% for row in initial_schedule %}
                        <span class="{{ loop.first ? 'w-4 h-1.5 rounded-full bg-emerald-600 transition-all' : 'w-1.5 h-1.5 rounded-full bg-slate-300 transition-all' }}"></span>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <!-- 3B: Mobile Compact Table List (Toggled) -->
        <div id="mobile-breakdown-list-wrapper" class="hidden sm:hidden overflow-x-auto p-2" hidden style="display: none;" aria-hidden="true">
            <table class="w-full text-ui-xs text-left font-financial-mono">
                <thead>
                    <tr class="border-b border-slate-200 text-slate-500 uppercase text-micro">
                        <th class="py-2 px-2 text-left">Yr</th>
                        <th class="py-2 px-2 text-right">Invested</th>
                        <th class="py-2 px-2 text-right">Gains</th>
                        <th class="py-2 px-2 text-right">Corpus</th>
                    </tr>
                </thead>
                <tbody id="mobile-compact-list-body" class="divide-y divide-slate-100">
                    {% if initial_schedule %}
                        {% for row in initial_schedule %}
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-2.5 px-2 font-bold text-slate-800 text-left">Yr {{ row.year }}</td>
                                <td class="py-2.5 px-2 text-right text-slate-600 font-mono">{{ row.cumulative_invested }}</td>
                                <td class="py-2.5 px-2 text-right text-emerald-700 font-bold font-mono">+{{ row.interest }}</td>
                                <td class="py-2.5 px-2 text-right font-extrabold text-slate-900 font-mono">{{ row.combined_total }}</td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>

        <!-- Mobile Progressive Disclosure Footer -->
        <div class="sm:hidden p-3 border-t border-slate-100 flex justify-center bg-slate-50/50">
            <button type="button" id="mobile-expand-all-years-btn" 
                class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-ui-xs border border-slate-200 shadow-flat transition-all flex items-center justify-center gap-1.5 active:scale-98 cursor-pointer min-h-[44px]">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                <span id="expand-btn-text">Show All Years Breakdown</span>
            </button>
        </div>
    </div>
</div>
<script>
    document.addEventListener('click', function(e) {
        var dropdown = document.getElementById('export-share-dropdown');
        if (dropdown && dropdown.hasAttribute('open') && !dropdown.contains(e.target)) {
            dropdown.removeAttribute('open');
        }
    });
</script>
