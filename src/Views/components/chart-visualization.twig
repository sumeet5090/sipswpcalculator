<div class="space-y-4">
    <!-- Morphological Summary Cards Grid (Auto-adapts between 3-card SIP and 4-card SWP/Hybrid modes) -->
    <div id="summary-cards-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 transition-all duration-300">
        <!-- Card 1: Total Invested -->
        <div class="bg-white/95 rounded-2xl border border-slate-200/90 shadow-[0_2px_12px_-2px_rgba(0,0,0,0.04)] p-3.5 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-slate-300 group">
            <div class="text-[10px] sm:text-xs font-bold text-slate-600 uppercase tracking-wider mb-1 leading-tight flex items-center justify-center gap-1">
                <span class="text-xs">💰</span>
                <span>Total Invested</span>
            </div>
            <div id="summary-invested" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-slate-900 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>

        <!-- Card 2: Compounding Gains -->
        <div class="bg-white/95 rounded-2xl border border-emerald-200/90 shadow-[0_2px_12px_-2px_rgba(4,120,87,0.06)] p-3.5 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-emerald-300 group">
            <div id="title-interest-container" class="flex items-center justify-center gap-1 mb-1">
                <span id="title-interest" class="text-[10px] sm:text-xs font-bold text-emerald-800 uppercase tracking-wider leading-tight flex items-center gap-0.5">
                    <span>↗</span>
                    <span>Compound Gains</span>
                </span>
                <span id="summary-gain-badge" class="hidden sm:inline-flex items-center text-[9px] font-black px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200/80">
                    +0%
                </span>
            </div>
            <div id="summary-interest" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-emerald-700 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>

        <!-- Card 3: Total Withdrawn (Morphs visible only in SWP mode) -->
        <div id="card-withdrawn" class="hidden bg-white/95 rounded-2xl border border-rose-200/90 shadow-[0_2px_12px_-2px_rgba(190,18,60,0.06)] p-3.5 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-rose-300 group">
            <div class="text-[10px] sm:text-xs font-bold text-rose-800 uppercase tracking-wider mb-1 leading-tight flex items-center justify-center gap-0.5">
                <span>↘</span>
                <span>Total Payouts</span>
            </div>
            <div id="summary-withdrawn" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-rose-700 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>

        <!-- Card 4: Final Corpus / Net Wealth -->
        <div class="bg-white/95 rounded-2xl border-2 border-emerald-600/80 shadow-[0_4px_20px_-2px_rgba(4,120,87,0.12)] p-3.5 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-xl hover:border-emerald-700 relative group">
            <div id="title-corpus" class="text-[10px] sm:text-xs font-bold text-emerald-800 uppercase tracking-wider mb-1 leading-tight flex items-center justify-center gap-1">
                <span>💎</span>
                <span>Final Corpus</span>
            </div>
            <div id="summary-corpus" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-emerald-800 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
            <div id="post-tax-statutory-pill" class="hidden mt-1 text-[10px] font-bold text-violet-800 bg-violet-50 border border-violet-200/90 px-2 py-0.5 rounded-md truncate">
                ⚖️ Budget 2024 §112A Net
            </div>
        </div>
    </div>

    <!-- Unified Compounding Alpha Beacon & Dynamic Insight Dock -->
    <div id="contextual-alpha-radar" class="hidden items-center justify-between p-3 sm:p-3.5 rounded-2xl bg-white/95 border border-slate-200/90 shadow-2xs transition-all">
        <div class="flex items-center gap-2.5 min-w-0">
            <span id="contextual-radar-icon" class="text-base shrink-0 flex items-center justify-center w-7 h-7 rounded-xl bg-slate-100">⚡</span>
            <div id="contextual-radar-text" class="text-xs text-slate-800 font-medium truncate"></div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button type="button" id="alpha-drawer-toggle" 
                class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-bold text-slate-600 bg-slate-100/80 hover:bg-slate-200/80 border border-slate-200/80 transition cursor-pointer"
                aria-expanded="false" aria-controls="alpha-secondary-insights" title="View all financial compounding insights">
                <span>Insights</span>
                <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <button type="button" id="contextual-radar-action" class="hidden px-2.5 py-1 rounded-xl text-xs font-bold bg-white text-slate-800 border border-slate-200 hover:bg-slate-50 transition-all cursor-pointer"></button>
        </div>
    </div>

    <!-- Expandable Secondary Insights Drawer (Preserves all DOM IDs for telemetry & parity) -->
    <div id="alpha-secondary-insights" class="hidden flex-wrap items-center gap-2 px-1 py-2 bg-slate-50/80 rounded-xl border border-slate-200/60 -mt-2 transition-all">
        <div id="daily-lifestyle-multiplier-badge" class="hidden items-center gap-1.5 text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-900 border border-emerald-200/90 shadow-2xs">
            <span>⚡</span>
            <span id="daily-accrual-amount" class="font-extrabold font-mono text-emerald-800">₹0 / day</span>
            <span class="text-slate-400">•</span>
            <span id="daily-lifestyle-equiv" class="font-medium text-slate-700">Daily compounding velocity</span>
        </div>
        <span id="summary-delay-cost-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-rose-50 text-rose-900 border border-rose-200/80 shadow-2xs"></span>
        <span id="summary-crossover-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-100/90 text-emerald-900 border border-emerald-200 shadow-2xs"></span>
        <span id="summary-longevity-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-100/90 text-emerald-900 border border-emerald-200 shadow-2xs"></span>
        <span id="summary-ratio-pill" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-900 border border-indigo-200/80 shadow-2xs"></span>
        <span id="summary-doubling-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-amber-50 text-amber-900 border border-amber-200/80 shadow-2xs"></span>
        <span id="summary-daily-accrual" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-teal-50 text-teal-900 border border-teal-200/80 shadow-2xs"></span>
    </div>

    <!-- Empathetic SWR Longevity Guardian Alert (Zero-CLS Container) -->
    <div id="swp-longevity-guardian-alert" class="hidden p-3.5 sm:p-4 rounded-2xl bg-amber-50/90 border border-amber-200/90 shadow-2xs transition-all">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div class="flex items-start gap-2.5">
                <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-amber-100 text-amber-900 text-sm font-black shrink-0 mt-0.5">🛡️</span>
                <div>
                    <h4 class="text-xs sm:text-sm font-extrabold text-amber-950 flex items-center gap-1.5">
                        <span>Corpus Depletion Risk at</span>
                        <span id="swp-depletion-year-text" class="text-rose-700 underline underline-offset-2">Year --</span>
                    </h4>
                    <p class="text-[11px] text-amber-950 leading-relaxed mt-0.5">
                        Current withdrawal outpaces portfolio compounding. Reduce to a mathematically sustainable rate of <strong id="swp-safe-amount-text" class="font-mono text-amber-950 font-bold">₹ --/mo</strong> for complete horizon protection.
                    </p>
                </div>
            </div>
            <button type="button" id="auto-heal-swp-btn" class="w-full sm:w-auto px-3.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shrink-0 shadow-sm transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5">
                <span>✨</span>
                <span>Auto-Heal Safe SWP</span>
            </button>
        </div>
    </div>

    <!-- Chart Card -->
    <div class="relative z-10 bg-[var(--glass-bg)] rounded-3xl border border-[var(--glass-border)] shadow-2xl backdrop-blur-xl overflow-hidden transition-all duration-300 hover:shadow-emerald-500/10 p-4 sm:p-6">
        <!-- 3-Tier Consolidated Glassmorphic Control Dock -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-100">
            <!-- Cluster 1: Heading, Institutional Micro-Seal & View Mode Switcher -->
            <div class="flex flex-wrap items-center gap-2.5">
                <span class="text-xs font-extrabold text-emerald-800 tracking-wider uppercase">Wealth Projection</span>
                
                <!-- AMFI Institutional Micro-Seal -->
                <button type="button" onclick="document.getElementById('sebiBenchmarkModal')?.showModal()"
                    class="group inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100/90 hover:bg-emerald-50 border border-slate-200/90 hover:border-emerald-300 text-[10px] text-slate-700 font-semibold transition-all cursor-pointer shadow-2xs"
                    title="Click to view regulatory modeling assumptions & AMFI benchmark standards">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 group-hover:animate-pulse"></span>
                    <span class="text-slate-800 font-bold">AMFI Aligned</span>
                    <span class="text-slate-400 font-normal">| Budget '24 Net</span>
                </button>

                <!-- View Mode Switcher -->
                <div class="inline-flex bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/80" role="tablist" aria-label="Chart View">
                    <button type="button" id="chart-view-line" role="tab" aria-selected="true"
                        class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 bg-white text-emerald-800 shadow-sm border border-slate-200/40 cursor-pointer">
                        📈 Growth Curve
                    </button>
                    <button type="button" id="chart-view-donut" role="tab" aria-selected="false"
                        class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 text-slate-600 hover:text-slate-800 cursor-pointer">
                        🍩 Allocation Split
                    </button>
                </div>
            </div>
            
            <!-- Cluster 2 & 3: Analytical Overlays Strip & Utility Actions -->
            <div class="flex flex-wrap items-center gap-2">
                <!-- Analytical Overlays Pill Strip -->
                <div class="inline-flex items-center bg-slate-100/80 p-0.5 rounded-xl border border-slate-200/70 text-xs">
                    <!-- Corridor Overlay -->
                    <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg cursor-pointer hover:bg-white/60 transition text-[11px] font-semibold text-slate-700" title="Toggle 10th-90th Percentile Historical Nifty Volatility Corridor">
                        <input type="checkbox" id="show_historical_corridor" class="sr-only peer" aria-label="Show Historical Volatility Corridor">
                        <span class="w-2 h-2 rounded-full border border-slate-300 bg-slate-200 peer-checked:bg-emerald-500 peer-checked:border-emerald-500 transition-colors"></span>
                        <span class="peer-checked:text-emerald-900 peer-checked:font-bold">± Corridor</span>
                    </label>

                    <!-- Post-Tax LTCG Overlay -->
                    <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg cursor-pointer hover:bg-white/60 transition text-[11px] font-semibold text-slate-700" title="Toggle Section 112A Post-Tax Returns">
                        <input type="checkbox" id="show_post_tax" class="sr-only peer" aria-label="Show Post-Tax Returns">
                        <span class="w-2 h-2 rounded-full border border-slate-300 bg-slate-200 peer-checked:bg-emerald-500 peer-checked:border-emerald-500 transition-colors"></span>
                        <span class="peer-checked:text-emerald-900 peer-checked:font-bold">§112A LTCG</span>
                    </label>

                    <!-- Wealth Map Stacked Overlay -->
                    <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg cursor-pointer hover:bg-white/60 transition text-[11px] font-semibold text-slate-700" title="Toggle Stacked Wealth Map View">
                        <input type="checkbox" id="show_wealth_map" class="sr-only peer" aria-label="Show Wealth Map">
                        <span class="w-2 h-2 rounded-full border border-slate-300 bg-slate-200 peer-checked:bg-indigo-500 peer-checked:border-indigo-500 transition-colors"></span>
                        <span class="peer-checked:text-indigo-900 peer-checked:font-bold">Wealth Map</span>
                    </label>
                </div>

                <!-- Cluster 3: Action Buttons -->
                <button type="button" id="snapshot-scenario-btn" 
                    class="text-[11px] font-bold px-2.5 py-1 rounded-xl border border-slate-200/90 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 transition-all cursor-pointer inline-flex items-center gap-1 shadow-2xs min-h-[30px]"
                    title="Snapshot current scenario to compare changes">
                    <span>📸</span>
                    <span>Snapshot</span>
                </button>

                <button type="button" id="open-tax-waterfall-btn"
                    class="text-[11px] font-bold px-2.5 py-1 rounded-xl border border-violet-200 bg-violet-50 hover:bg-violet-100 text-violet-800 transition-all cursor-pointer inline-flex items-center gap-1 shadow-2xs min-h-[30px]"
                    title="View Section 112A Tax Waterfall Breakdown">
                    <span>⚖️</span>
                    <span>Tax Waterfall</span>
                </button>
            </div>
        </div>

        <!-- Mobile & Desktop Pinned Heads-Up Inspection Ribbon (Zero Thumb Occlusion) -->
        <div id="chart-inspection-ribbon" class="hidden mb-2 px-3 py-2 rounded-xl bg-emerald-50/95 border border-emerald-200/90 shadow-2xs flex flex-wrap items-center justify-between gap-2 text-xs transition-all duration-150 backdrop-blur-md">
            <div class="flex items-center gap-1.5">
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="ribbon-inspect-year" class="font-extrabold text-emerald-950 font-mono">Year --</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-slate-700 font-medium">Invested: <strong id="ribbon-inspect-invested" class="text-slate-900 font-mono font-bold">₹ --</strong></span>
                <span class="text-slate-700 font-medium">Gains: <strong id="ribbon-inspect-gains" class="text-emerald-800 font-mono font-bold">+₹ --</strong></span>
                <span class="text-slate-700 font-medium">Corpus: <strong id="ribbon-inspect-corpus" class="text-emerald-900 font-mono font-extrabold">₹ --</strong></span>
            </div>
        </div>

        <div class="h-[280px] sm:h-[350px] lg:h-[calc(100vh-340px)] min-h-[300px] max-h-[480px] w-full min-w-0 relative z-10" tabindex="0" id="chart-canvas-container" aria-label="Interactive Wealth Projection Chart. Use Left and Right arrow keys to inspect yearly progression.">
            <canvas id="corpusChart" role="img" aria-label="Investment growth projection line chart"></canvas>
        </div>

        <!-- Accessible Semantic Screen-Reader Data Ledger (WCAG 1.1.1 & 4.1.2) -->
        <table class="sr-only" aria-label="Investment Growth Cashflow Ledger">
            <caption>Annual wealth progression projection table for assistive technologies</caption>
            <thead>
                <tr>
                    <th scope="col">Year</th>
                    <th scope="col">Invested Principal</th>
                    <th scope="col">Estimated Gains</th>
                    <th scope="col">Projected Corpus</th>
                </tr>
            </thead>
            <tbody id="a11y-chart-table-body"></tbody>
        </table>

        <!-- Benchmark Comparison Strip with Enhanced Touch Targets -->
        <div class="flex flex-wrap items-center justify-between gap-2 mt-4 pt-3 border-t border-slate-100">
            <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wider">Compare Against Historical Benchmarks:</span>
            <div class="inline-flex flex-wrap items-center gap-1.5" role="group" aria-label="Historical Benchmarks">
                <button type="button" class="benchmark-chip text-[11px] font-semibold px-3 py-1.5 rounded-xl border border-slate-200/90 bg-slate-50 text-slate-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer is-active bg-emerald-600 text-white border-emerald-600" data-benchmark="none">None</button>
                <button type="button" class="benchmark-chip text-[11px] font-semibold px-3 py-1.5 rounded-xl border border-slate-200/90 bg-slate-50 text-slate-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer" data-benchmark="nifty">📈 Nifty 50 (12%)</button>
                <button type="button" class="benchmark-chip text-[11px] font-semibold px-3 py-1.5 rounded-xl border border-slate-200/90 bg-slate-50 text-slate-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer" data-benchmark="gold">🥇 Gold (9%)</button>
                <button type="button" class="benchmark-chip text-[11px] font-semibold px-3 py-1.5 rounded-xl border border-slate-200/90 bg-slate-50 text-slate-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer" data-benchmark="fd">🏦 Fixed Deposit (6.5%)</button>
            </div>
        </div>
    </div>

    <!-- Milestones Section -->
    <div id="milestones-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
</div>
