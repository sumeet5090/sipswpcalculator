<div class="space-y-4">
    <!-- Delay Cost Banner -->
    <div id="delay-cost-banner" style="display: none;" class="bg-rose-50 border border-rose-200 rounded-xl p-4 flex items-center justify-between shadow-sm animate-pulse">
        <div class="flex items-center gap-3">
            <div class="bg-rose-100 p-2 rounded-full text-rose-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
                <p class="text-xs font-bold text-rose-800 uppercase tracking-wider">Opportunity Cost</p>
                <p class="text-sm text-rose-600 font-medium">Waiting 1 year to start this SIP will cost you <strong id="delay-cost-amount" class="text-rose-700 font-bold font-mono">₹0</strong> in future wealth.</p>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white/90 backdrop-blur-md rounded-2xl border border-slate-200/80 shadow-[0_2px_12px_-2px_rgba(0,0,0,0.04)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-slate-300">
            <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest mb-1 truncate">
                Total Invested
            </div>
            <div id="summary-invested" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-slate-700 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>
        <div class="bg-white/90 backdrop-blur-md rounded-2xl border border-emerald-200/80 shadow-[0_2px_12px_-2px_rgba(16,185,129,0.08)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-emerald-300">
            <div id="title-interest-container" class="flex items-center justify-center gap-1 mb-1">
                <span id="title-interest" class="text-[10px] sm:text-xs font-bold text-emerald-700 uppercase tracking-widest truncate">
                    Total Gains
                </span>
                <span id="summary-gain-badge" class="hidden sm:inline-flex items-center text-[9px] font-black px-1.5 py-0.2 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                    +0%
                </span>
            </div>
            <div id="summary-interest" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-emerald-600 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>
        <div class="bg-white/90 backdrop-blur-md rounded-2xl border border-rose-200/80 shadow-[0_2px_12px_-2px_rgba(244,63,94,0.08)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-rose-300">
            <div class="text-[10px] sm:text-xs font-bold text-rose-500 uppercase tracking-widest mb-1 truncate">
                Total Withdrawn
            </div>
            <div id="summary-withdrawn" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-rose-500 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>
        <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white rounded-2xl border border-slate-700/80 shadow-[0_4px_20px_-2px_rgba(15,23,42,0.25)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-xl hover:border-emerald-500/40">
            <div id="title-corpus" class="text-[10px] sm:text-xs font-bold text-emerald-400 uppercase tracking-widest mb-1 truncate">
                Final Corpus
            </div>
            <div id="summary-corpus" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-white font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>
    </div>

    <!-- Chart Card -->
    <div class="relative z-10 bg-[var(--glass-bg)] rounded-3xl border border-[var(--glass-border)] shadow-2xl backdrop-blur-xl overflow-hidden transition-all duration-300 hover:shadow-emerald-500/10 p-4 sm:p-6">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-4">
            <span class="text-xs font-bold text-emerald-600 tracking-widest uppercase">Wealth Projection</span>
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-slate-500">Show Post-Tax Returns (LTCG)</span>
                <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="show_post_tax" class="sr-only peer" aria-label="Show Post-Tax Returns">
                    <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
                </label>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-slate-500">Wealth Map</span>
                <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="show_wealth_map" class="sr-only peer" aria-label="Show Wealth Map">
                    <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500"></div>
                </label>
            </div>
        </div>
        <div class="h-[280px] sm:h-[350px] lg:h-[calc(100vh-340px)] min-h-[300px] max-h-[480px] w-full min-w-0 relative z-10">
            <canvas id="corpusChart" role="img" aria-label="Investment growth projection line chart"></canvas>
        </div>
    </div>

    <!-- Milestones Section -->
    <div id="milestones-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
</div>
