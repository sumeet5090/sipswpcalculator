{% set lastRow = combined|last|default({
    'cumulative_invested': 0,
    'combined_total': 0,
    'cumulative_withdrawals': 0
}) %}

{% set totalGains = (lastRow.combined_total + (lastRow.cumulative_withdrawals|default(0))) - (lastRow.cumulative_invested|default(0)) %}

{% set years_data_val = years_data is defined ? years_data|array_values : [] %}
{% set cumulative_numbers_val = cumulative_numbers is defined ? cumulative_numbers|array_values : [] %}
{% set combined_numbers_val = combined_numbers is defined ? combined_numbers|array_values : [] %}
{% set swp_numbers_val = swp_numbers is defined ? swp_numbers|array_values : [] %}

<div class="space-y-4">
    <!-- Delay Cost Banner -->
    <div id="delay-cost-banner" style="display: none;" class="bg-rose-50 border border-rose-200 rounded-xl p-4 flex items-center justify-between shadow-sm animate-pulse">
        <div class="flex items-center gap-3">
            <div class="bg-rose-100 p-2 rounded-full text-rose-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
                <p class="text-xs font-bold text-rose-800 uppercase tracking-wider">Opportunity Cost</p>
                <p class="text-sm text-rose-600 font-medium">Waiting 1 year to start this SIP will cost you <strong id="delay-cost-amount" class="text-rose-700 font-bold font-mono">₹0</strong> in future wealth.</p>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="glass-card p-2.5 sm:p-4 text-center overflow-hidden">
            <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest mb-1 truncate">
                Total Invested
            </div>
            <div id="summary-invested" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-emerald-600 font-mono transition-numbers truncate">
                {{ lastRow.cumulative_invested|formatInr }}
            </div>
        </div>
        <div class="glass-card p-2.5 sm:p-4 text-center overflow-hidden">
            <div id="title-interest" class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest mb-1 truncate">
                Total Gains
            </div>
            <div id="summary-interest" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-emerald-600 font-mono transition-numbers truncate">
                {{ totalGains|formatInr }}
            </div>
        </div>
        <div class="glass-card p-2.5 sm:p-4 text-center overflow-hidden">
            <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest mb-1 truncate">
                Total Withdrawn
            </div>
            <div id="summary-withdrawn" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-rose-500 font-mono transition-numbers truncate">
                {{ lastRow.cumulative_withdrawals|default(0)|formatInr }}
            </div>
        </div>
        <div class="glass-card p-2.5 sm:p-4 text-center border-2 border-emerald-100 overflow-hidden">
            <div id="title-corpus" class="text-[10px] sm:text-xs font-bold text-emerald-600 uppercase tracking-widest mb-1 truncate">
                Final Corpus
            </div>
            <div id="summary-corpus" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-slate-800 font-mono transition-numbers truncate">
                {{ lastRow.combined_total|formatInr }}
            </div>
        </div>
    </div>

    <!-- Chart Card -->
    <div class="relative z-10 bg-[var(--glass-bg)] rounded-3xl border border-[var(--glass-border)] shadow-2xl backdrop-blur-xl overflow-hidden transition-all duration-300 hover:shadow-emerald-500/10 p-4 sm:p-6">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-4">
            <span class="text-xs font-bold text-emerald-600 tracking-widest uppercase">Wealth Projection</span>
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-slate-500">Show Post-Tax Returns (LTCG)</span>
                <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="show_post_tax" class="sr-only peer" aria-label="Show Post-Tax Returns">
                    <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
                </label>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-slate-500">Wealth Map</span>
                <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="show_wealth_map" class="sr-only peer" aria-label="Show Wealth Map">
                    <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500"></div>
                </label>
            </div>
        </div>
        <div class="h-[280px] sm:h-[350px] lg:h-[calc(100vh-340px)] min-h-[300px] max-h-[480px] w-full relative z-10">
            <canvas id="corpusChart" width="800" height="450"
                data-years="{{ years_data_val|json_encode|escape('html_attr') }}"
                data-cumulative="{{ cumulative_numbers_val|json_encode|escape('html_attr') }}"
                data-corpus="{{ combined_numbers_val|json_encode|escape('html_attr') }}"
                data-swp="{{ swp_numbers_val|json_encode|escape('html_attr') }}"></canvas>
        </div>
    </div>

    <!-- Milestones Section -->
    <div id="milestones-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
</div>
