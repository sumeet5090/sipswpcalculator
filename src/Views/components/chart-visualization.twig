<div class="space-y-4">
    <!-- Summary Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white/90 backdrop-blur-md rounded-2xl border border-slate-200/80 shadow-[0_2px_12px_-2px_rgba(0,0,0,0.04)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-slate-300">
            <div class="text-[10px] sm:text-xs font-bold text-slate-600 uppercase tracking-wider mb-1 leading-tight flex items-center justify-center gap-1">
                <span>💰</span>
                <span>Total Invested</span>
            </div>
            <div id="summary-invested" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-slate-800 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>
        <div class="bg-white/90 backdrop-blur-md rounded-2xl border border-emerald-200/80 shadow-[0_2px_12px_-2px_rgba(4,120,87,0.08)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-emerald-300">
            <div id="title-interest-container" class="flex items-center justify-center gap-1 mb-1">
                <span id="title-interest" class="text-[10px] sm:text-xs font-bold text-emerald-700 uppercase tracking-wider leading-tight flex items-center gap-0.5">
                    <span>↗</span>
                    <span>Total Gains</span>
                </span>
                <span id="summary-gain-badge" class="hidden sm:inline-flex items-center text-[9px] font-black px-1.5 py-0.2 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                    +0%
                </span>
            </div>
            <div id="summary-interest" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-emerald-700 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>
        <div class="bg-white/90 backdrop-blur-md rounded-2xl border border-rose-200/80 shadow-[0_2px_12px_-2px_rgba(190,18,60,0.08)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-md hover:border-rose-300">
            <div class="text-[10px] sm:text-xs font-bold text-rose-700 uppercase tracking-wider mb-1 leading-tight flex items-center justify-center gap-0.5">
                <span>↘</span>
                <span>Total Withdrawn</span>
            </div>
            <div id="summary-withdrawn" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-rose-700 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
        </div>
        <div class="bg-white/95 backdrop-blur-md rounded-2xl border-2 border-emerald-600/80 shadow-[0_4px_20px_-2px_rgba(4,120,87,0.15)] p-3 sm:p-4 text-center overflow-hidden transition-all duration-200 hover:shadow-xl hover:border-emerald-700">
            <div id="title-corpus" class="text-[10px] sm:text-xs font-bold text-emerald-700 uppercase tracking-wider mb-1 leading-tight flex items-center justify-center gap-1">
                <span>💎</span>
                <span>Final Corpus</span>
            </div>
            <div id="summary-corpus" class="text-sm sm:text-base md:text-lg xl:text-xl font-extrabold text-emerald-700 font-mono tabular-nums transition-numbers truncate">
                ₹ --
            </div>
            <div id="post-tax-statutory-pill" class="hidden mt-1 text-[10px] font-bold text-violet-700 bg-violet-50 border border-violet-200 px-2 py-0.5 rounded-md truncate">
                ⚖️ Budget 2024 §112A Net
            </div>
        </div>
    </div>

    <!-- Responsive SEBI / AMFI Statutory Methodology Strip -->
    <div class="flex items-center justify-between px-3.5 py-2 rounded-2xl bg-slate-50 border border-slate-200/80 text-[11px] text-slate-700 shadow-2xs">
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-emerald-100 text-emerald-800 text-[9px] font-black">✓</span>
            <span class="font-bold text-slate-800">SEBI / AMFI Aligned Standard</span>
            <span class="text-slate-300">|</span>
            <span class="hidden sm:inline text-slate-600 font-medium">CAGR / Annuity-Due Compounding Model</span>
        </div>
        <button type="button" onclick="document.getElementById('sebiBenchmarkModal')?.showModal()"
            class="font-bold text-emerald-700 hover:text-emerald-800 underline underline-offset-2 cursor-pointer text-xs"
            aria-label="Verify SEBI Benchmark Assumptions">
            Verify Assumptions
        </button>
    </div>

    <!-- Single Prioritized Contextual Insight Radar -->
    <div id="contextual-alpha-radar" class="hidden items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200 shadow-2xs transition-all">
        <div class="flex items-center gap-2.5">
            <span id="contextual-radar-icon" class="text-base shrink-0">⚡</span>
            <div id="contextual-radar-text" class="text-xs text-slate-800"></div>
        </div>
        <button type="button" id="contextual-radar-action" class="hidden px-2.5 py-1 rounded-xl text-xs font-bold bg-white text-slate-800 border border-slate-200 hover:bg-slate-50 transition-all cursor-pointer shrink-0"></button>
    </div>

    <!-- Velocity & Feasibility Badges Row (Preserved for backward DOM parity) -->
    <div class="flex flex-wrap items-center gap-2 px-1 -mt-1">
        <div id="daily-lifestyle-multiplier-badge" class="hidden items-center gap-1.5 text-[11px] font-bold px-3 py-1 rounded-xl bg-gradient-to-r from-emerald-50 to-teal-50 text-emerald-900 border border-emerald-200/90 shadow-2xs">
            <span>⚡</span>
            <span id="daily-accrual-amount" class="font-extrabold font-mono text-emerald-700">₹0 / day</span>
            <span class="text-slate-400">•</span>
            <span id="daily-lifestyle-equiv" class="font-medium text-slate-700">Daily compounding velocity at maturity</span>
        </div>
        <span id="summary-delay-cost-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-rose-50 text-rose-800 border border-rose-200/80 shadow-2xs"></span>
        <span id="summary-crossover-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-100/90 text-emerald-800 border border-emerald-200 shadow-2xs"></span>
        <span id="summary-longevity-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-100/90 text-emerald-800 border border-emerald-200 shadow-2xs"></span>
        <span id="summary-ratio-pill" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-200/80 shadow-2xs"></span>
        <span id="summary-doubling-badge" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-amber-50 text-amber-800 border border-amber-200/80 shadow-2xs"></span>
        <span id="summary-daily-accrual" class="hidden items-center text-[11px] font-bold px-2.5 py-1 rounded-lg bg-teal-50 text-teal-800 border border-teal-200/80 shadow-2xs"></span>
    </div>

    <!-- Empathetic SWR Longevity Guardian Alert (Appears when SWP causes premature capital exhaustion) -->
    <div id="swp-longevity-guardian-alert" class="hidden p-3.5 sm:p-4 rounded-2xl bg-amber-50/90 border border-amber-200/90 shadow-2xs transition-all">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div class="flex items-start gap-2.5">
                <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-amber-100 text-amber-800 text-sm font-black shrink-0 mt-0.5">🛡️</span>
                <div>
                    <h4 class="text-xs sm:text-sm font-extrabold text-amber-950 flex items-center gap-1.5">
                        <span>Corpus Depletion Risk at</span>
                        <span id="swp-depletion-year-text" class="text-rose-700 underline underline-offset-2">Year --</span>
                    </h4>
                    <p class="text-[11px] text-amber-900 leading-relaxed mt-0.5">
                        Current withdrawal outpaces portfolio compounding. Reduce to a mathematically sustainable rate of <strong id="swp-safe-amount-text" class="font-mono text-amber-950 font-bold">₹ --/mo</strong> for complete horizon protection.
                    </p>
                </div>
            </div>
            <button type="button" id="auto-heal-swp-btn" class="w-full sm:w-auto px-3.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shrink-0 shadow-sm transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5">
                <span>✨</span>
                <span>Auto-Heal Safe SWP</span>
            </button>
        </div>
    </div>

    <!-- Chart Card -->
    <div class="relative z-10 bg-[var(--glass-bg)] rounded-3xl border border-[var(--glass-border)] shadow-2xl backdrop-blur-xl overflow-hidden transition-all duration-300 hover:shadow-emerald-500/10 p-4 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-xs font-bold text-emerald-700 tracking-widest uppercase">Wealth Projection</span>
                
                <!-- Contextual AMFI/SEBI Mutual Fund Regulatory Indicator & Privacy Pill -->
                <button type="button" onclick="document.getElementById('sebiBenchmarkModal')?.showModal()"
                    class="hidden md:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100/90 hover:bg-slate-200/90 border border-slate-200/90 text-[10px] text-slate-700 font-medium transition-colors cursor-pointer"
                    title="Click to view regulatory modeling assumptions & AMFI benchmark standards">
                    <svg class="w-3 h-3 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    <span>SEBI/AMFI Aligned</span>
                </button>

                <button type="button" onclick="document.getElementById('sebiBenchmarkModal')?.showModal()"
                    class="hidden lg:inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 hover:bg-emerald-100 border border-emerald-200/80 text-[10px] text-emerald-800 font-bold transition-colors cursor-pointer"
                    title="All math executes locally in your browser. Zero financial data is tracked or transmitted.">
                    <span>🔒</span>
                    <span>100% Private (No Tracking)</span>
                </button>

                <!-- View Mode Switcher -->
                <div class="inline-flex bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/80" role="tablist" aria-label="Chart View">
                    <button type="button" id="chart-view-line" role="tab" aria-selected="true"
                        class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 bg-white text-emerald-700 shadow-sm border border-slate-200/40 cursor-pointer">
                        📈 Growth Curve
                    </button>
                    <button type="button" id="chart-view-donut" role="tab" aria-selected="false"
                        class="px-2.5 py-1 text-[11px] font-bold rounded-lg transition-all duration-150 text-slate-500 hover:text-slate-700 cursor-pointer">
                        🍩 Allocation Split
                    </button>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
                <button type="button" id="snapshot-scenario-btn" 
                    class="text-[11px] font-bold px-2.5 py-1 rounded-lg border border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all cursor-pointer inline-flex items-center gap-1.5 shadow-2xs"
                    title="Snapshot current scenario to compare changes">
                    <span>📸</span>
                    <span>Snapshot</span>
                </button>

                <button type="button" id="open-tax-waterfall-btn"
                    class="text-[11px] font-bold px-2.5 py-1 rounded-lg border border-violet-200 bg-violet-50 text-violet-700 hover:bg-violet-100 hover:text-violet-900 transition-all cursor-pointer inline-flex items-center gap-1 shadow-2xs"
                    title="View Section 112A Tax Waterfall Breakdown">
                    <span>⚖️</span>
                    <span>Tax Breakdown</span>
                </button>

                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-600">Corridor</span>
                    <label class="toggle-switch relative inline-flex items-center cursor-pointer" title="Toggle 10th-90th Percentile Historical Nifty Volatility Corridor (10.2% - 15.8%)">
                        <input type="checkbox" id="show_historical_corridor" class="sr-only peer" aria-label="Show Historical Volatility Corridor">
                        <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
                    </label>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-600">Post-Tax (LTCG)</span>
                    <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="show_post_tax" class="sr-only peer" aria-label="Show Post-Tax Returns">
                        <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
                    </label>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-600">Wealth Map</span>
                    <label class="toggle-switch relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="show_wealth_map" class="sr-only peer" aria-label="Show Wealth Map">
                        <div class="w-9 h-5 bg-slate-200 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400 peer-focus-visible:ring-offset-2 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500"></div>
                    </label>
                </div>
            </div>
        </div>
        <!-- Mobile & Desktop Pinned Heads-Up Inspection Ribbon (Zero Thumb Occlusion) -->
        <div id="chart-inspection-ribbon" class="hidden mb-2 px-3 py-1.5 rounded-xl bg-emerald-50/90 border border-emerald-200/90 shadow-2xs flex flex-wrap items-center justify-between gap-2 text-xs transition-all duration-150 backdrop-blur-md">
            <div class="flex items-center gap-1.5">
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="ribbon-inspect-year" class="font-extrabold text-emerald-950 font-mono">Year --</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-slate-600 font-medium">Invested: <strong id="ribbon-inspect-invested" class="text-slate-900 font-mono font-bold">₹ --</strong></span>
                <span class="text-slate-600 font-medium">Gains: <strong id="ribbon-inspect-gains" class="text-emerald-700 font-mono font-bold">+₹ --</strong></span>
                <span class="text-slate-600 font-medium">Corpus: <strong id="ribbon-inspect-corpus" class="text-emerald-800 font-mono font-extrabold">₹ --</strong></span>
            </div>
        </div>

        <div class="h-[280px] sm:h-[350px] lg:h-[calc(100vh-340px)] min-h-[300px] max-h-[480px] w-full min-w-0 relative z-10">
            <canvas id="corpusChart" role="img" aria-label="Investment growth projection line chart"></canvas>
        </div>

        <!-- Accessible Semantic Screen-Reader Data Ledger (WCAG 1.1.1 & 4.1.2) -->
        <table class="sr-only" aria-label="Investment Growth Cashflow Ledger">
            <caption>Annual wealth progression projection table for assistive technologies</caption>
            <thead>
                <tr>
                    <th scope="col">Year</th>
                    <th scope="col">Invested Principal</th>
                    <th scope="col">Estimated Gains</th>
                    <th scope="col">Projected Corpus</th>
                </tr>
            </thead>
            <tbody id="a11y-chart-table-body"></tbody>
        </table>

        <!-- Benchmark Comparison Toggle -->
        <div class="flex flex-wrap items-center justify-between gap-2 mt-4 pt-3 border-t border-slate-100/80">
            <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">Compare Against Historical Benchmarks:</span>
            <div class="inline-flex flex-wrap items-center gap-1.5" role="group" aria-label="Historical Benchmarks">
                <button type="button" class="benchmark-chip text-[10px] font-semibold px-2.5 py-1 rounded-lg border border-slate-200/90 bg-slate-50 text-slate-600 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer is-active bg-emerald-600 text-white border-emerald-600" data-benchmark="none">None</button>
                <button type="button" class="benchmark-chip text-[10px] font-semibold px-2.5 py-1 rounded-lg border border-slate-200/90 bg-slate-50 text-slate-600 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer" data-benchmark="nifty">📈 Nifty 50 (12%)</button>
                <button type="button" class="benchmark-chip text-[10px] font-semibold px-2.5 py-1 rounded-lg border border-slate-200/90 bg-slate-50 text-slate-600 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer" data-benchmark="gold">🥇 Gold (9%)</button>
                <button type="button" class="benchmark-chip text-[10px] font-semibold px-2.5 py-1 rounded-lg border border-slate-200/90 bg-slate-50 text-slate-600 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 transition-all cursor-pointer" data-benchmark="fd">🏦 Fixed Deposit (6.5%)</button>
            </div>
        </div>
    </div>

    <!-- Milestones Section -->
    <div id="milestones-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
</div>
