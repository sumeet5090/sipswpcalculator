<div class="space-y-4">
    {% set isFourCardMode = enable_swp or calculator_type in ['swp', 'combo', 'emi'] %}
    {% set card1Title = 'Total Invested' %}
    {% set card1Sub = 'Principal Capital' %}
    {% if calculator_type == 'emi' %}
        {% set card1Title = 'Loan Amount' %}
        {% set card1Sub = 'Principal Borrowed' %}
    {% elseif calculator_type == 'inflation' %}
        {% set card1Title = "Today's Cost" %}
        {% set card1Sub = 'Current Living Expense' %}
    {% elseif calculator_type == 'cagr' %}
        {% set card1Title = 'Initial Value' %}
        {% set card1Sub = 'Starting Investment' %}
    {% elseif calculator_type == 'fd' %}
        {% set card1Title = 'Deposit Amount' %}
        {% set card1Sub = 'Bank FD Principal' %}
    {% elseif calculator_type == 'ppf' %}
        {% set card1Title = 'Total PPF Deposit' %}
        {% set card1Sub = 'Statutory Contributions' %}
    {% elseif calculator_type == 'compound_interest' %}
        {% set card1Title = 'Principal Invested' %}
        {% set card1Sub = 'Starting Capital' %}
    {% endif %}

    {% set card2Title = 'Compound Gains' %}
    {% if calculator_type == 'emi' %}
        {% set card2Title = 'Total Interest' %}
    {% elseif calculator_type == 'inflation' %}
        {% set card2Title = 'Cost Escalation' %}
    {% elseif calculator_type == 'cagr' %}
        {% set card2Title = 'Absolute Gain' %}
    {% elseif calculator_type == 'fd' %}
        {% set card2Title = 'Interest Earned' %}
    {% elseif calculator_type == 'ppf' %}
        {% set card2Title = 'Tax-Free Interest' %}
    {% elseif calculator_type == 'compound_interest' %}
        {% set card2Title = 'Compound Interest' %}
    {% endif %}

    {% set card3Title = 'Total Payouts' %}
    {% set card3Sub = 'Systematic Cashflow' %}
    {% if calculator_type == 'emi' %}
        {% set card3Title = 'Total Payment' %}
        {% set card3Sub = 'Principal + Interest' %}
    {% endif %}

    {% set card4Title = 'Final Wealth Corpus' %}
    {% if calculator_type == 'emi' %}
        {% set card4Title = 'Monthly EMI' %}
    {% elseif calculator_type == 'inflation' %}
        {% set card4Title = 'Future Living Cost' %}
    {% elseif calculator_type == 'cagr' %}
        {% set card4Title = 'CAGR Return' %}
    {% elseif calculator_type == 'fd' %}
        {% set card4Title = 'Maturity Value' %}
    {% elseif calculator_type == 'ppf' %}
        {% set card4Title = 'Maturity Corpus' %}
    {% elseif calculator_type == 'compound_interest' %}
        {% set card4Title = 'Maturity Value' %}
    {% endif %}

    <!-- Fluid Quantum Wealth Ribbon Grid (Institutional Scoreboard: 3 Clean White Cards + 1 Dark Executive Anchor) -->
    <div class="p-1.5 sm:p-2 rounded-3xl bg-slate-100/90 border border-slate-200/90 shadow-subtle">
        <div id="summary-cards-grid" class="grid grid-cols-2 {% if isFourCardMode %}xl:grid-cols-4{% else %}xl:grid-cols-3{% endif %} gap-2 sm:gap-2.5 transition-all duration-300">
            <!-- Card 1: Total Invested / Principal -->
            <div id="card-invested" role="button" tabindex="0" title="Click to view initial investment milestone in Cashflow Ledger" class="bg-white rounded-2xl border border-slate-200/90 shadow-flat px-3 py-3 text-left overflow-hidden transition-all duration-200 hover:shadow-card hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 group flex flex-col justify-between min-w-0 cursor-pointer">
                <div class="flex items-center justify-between gap-1 mb-1">
                    <span id="title-invested" class="text-caption font-bold text-slate-500 uppercase tracking-wider leading-tight">
                        {{ initial_kpis and initial_kpis.is_dual_mode ? 'Total SIP Invested' : card1Title }}
                    </span>
                    <span id="summary-invested-compact" class="hidden text-micro font-bold px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200/80 tabular-nums"></span>
                </div>
                <div id="summary-invested-headline" class="text-ui-base sm:text-ui-lg font-black text-slate-900 font-financial-mono tabular-nums leading-tight py-0.5 text-left">
                    {{ initial_kpis and initial_kpis.invested_compact ? initial_kpis.invested_compact : '₹ --' }}
                </div>
                <div class="flex items-center justify-between gap-1 text-micro font-medium text-slate-500 font-financial-mono tracking-tight mt-0.5">
                    <div id="summary-invested" class="text-ui-xs font-bold text-slate-700 font-financial-mono whitespace-nowrap overflow-visible" aria-label="{{ initial_kpis and initial_kpis.invested_exact ? initial_kpis.invested_exact : '₹ --' }}">
                        <span class="sr-only">{{ initial_kpis and initial_kpis.invested_exact ? initial_kpis.invested_exact : '₹ --' }}</span>
                        <span aria-hidden="true" data-nosnippet="true">{{ initial_kpis and initial_kpis.invested_exact ? initial_kpis.invested_exact : '₹ --' }}</span>
                    </div>
                    <span id="subtitle-invested" class="text-slate-400 truncate">{{ initial_kpis and initial_kpis.is_dual_mode ? (initial_kpis.sip_years ~ ' Yrs Accumulation') : card1Sub }}</span>
                </div>
            </div>

            <!-- Card 2: Compounding Gains / Interest (Morphs into Phase 1 SIP Maturity in Dual Mode) -->
            <div id="card-maturity" role="button" tabindex="0" title="Click to view Phase 1 SIP Maturity milestone in Cashflow Ledger" class="bg-white rounded-2xl border border-slate-200/90 shadow-flat px-3 py-3 text-left overflow-hidden transition-all duration-200 hover:shadow-card hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 group flex flex-col justify-between relative min-w-0 cursor-pointer">
                <div id="title-interest-container" class="flex items-center justify-between gap-1 mb-1">
                    <span id="title-interest" class="text-caption font-bold text-slate-500 uppercase tracking-wider leading-tight">
                        {{ initial_kpis and initial_kpis.is_dual_mode ? 'Phase 1 SIP Maturity' : card2Title }}
                    </span>
                    <span id="summary-gain-badge" class="inline-flex items-center text-micro font-bold px-1.5 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200/80 tabular-nums">
                        {{ initial_kpis and initial_kpis.is_dual_mode ? ('+' ~ initial_kpis.maturity_gain_pct ~ '%') : '+0%' }}
                    </span>
                </div>
                <div id="summary-interest-headline" class="text-ui-base sm:text-ui-lg font-black text-slate-900 font-financial-mono tabular-nums leading-tight py-0.5 text-left">
                    {{ initial_kpis and initial_kpis.maturity_compact ? initial_kpis.maturity_compact : '₹ --' }}
                </div>
                <div class="flex items-center justify-between gap-1 text-micro font-medium text-emerald-700 font-financial-mono tracking-tight mt-0.5">
                    <div id="summary-interest" class="text-ui-xs font-bold text-slate-700 font-financial-mono whitespace-nowrap overflow-visible" aria-label="{{ initial_kpis and initial_kpis.maturity_exact ? initial_kpis.maturity_exact : '₹ --' }}">
                        <span class="sr-only">{{ initial_kpis and initial_kpis.maturity_exact ? initial_kpis.maturity_exact : '₹ --' }}</span>
                        <span aria-hidden="true" data-nosnippet="true">{{ initial_kpis and initial_kpis.maturity_exact ? initial_kpis.maturity_exact : '₹ --' }}</span>
                    </div>
                    <span id="summary-interest-compact" class="text-emerald-800 font-bold hidden"></span>
                    <span id="subtitle-interest" class="text-slate-400 truncate">{{ initial_kpis and initial_kpis.is_dual_mode ? ('+' ~ initial_kpis.maturity_gains_compact ~ ' Gains @ Yr ' ~ initial_kpis.sip_years) : 'Compound Growth' }}</span>
                </div>
            </div>

            <!-- Card 3: Total Withdrawn / Payment (Morphs visible only in SWP/Combo/EMI mode) -->
            <div id="card-withdrawn" role="button" tabindex="0" title="Click to view Phase 2 SWP Retirement cashflows in Ledger" class="{% if not isFourCardMode %}hidden {% endif %}bg-white rounded-2xl border border-slate-200/90 shadow-flat px-3 py-3 text-left overflow-hidden transition-all duration-200 hover:shadow-card hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500/40 group flex flex-col justify-between min-w-0 cursor-pointer">
                <div class="flex items-center justify-between gap-1 mb-1">
                    <span id="title-withdrawn" class="text-caption font-bold text-slate-500 uppercase tracking-wider leading-tight">
                        {{ initial_kpis and initial_kpis.is_dual_mode ? 'Phase 2 Total SWP Paid' : card3Title }}
                    </span>
                    <span id="summary-withdrawn-compact" class="hidden text-micro font-bold px-1.5 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200/80 tabular-nums"></span>
                </div>
                <div id="summary-withdrawn-headline" class="text-ui-base sm:text-ui-lg font-black text-slate-900 font-financial-mono tabular-nums leading-tight py-0.5 text-left">
                    {{ initial_kpis and initial_kpis.withdrawn_compact ? initial_kpis.withdrawn_compact : '₹ --' }}
                </div>
                <div class="flex items-center justify-between gap-1 text-micro font-medium text-slate-500 font-financial-mono tracking-tight mt-0.5">
                    <div id="summary-withdrawn" class="text-ui-xs font-bold text-slate-700 font-financial-mono whitespace-nowrap overflow-visible" aria-label="{{ initial_kpis and initial_kpis.withdrawn_exact ? initial_kpis.withdrawn_exact : '₹ --' }}">
                        <span class="sr-only">{{ initial_kpis and initial_kpis.withdrawn_exact ? initial_kpis.withdrawn_exact : '₹ --' }}</span>
                        <span aria-hidden="true" data-nosnippet="true">{{ initial_kpis and initial_kpis.withdrawn_exact ? initial_kpis.withdrawn_exact : '₹ --' }}</span>
                    </div>
                    <span id="subtitle-withdrawn" class="text-slate-400 truncate">{{ initial_kpis and initial_kpis.is_dual_mode ? (initial_kpis.swp_years ~ ' Yrs Retirement') : card3Sub }}</span>
                </div>
            </div>

            <!-- Card 4: Final Corpus / Net Wealth / EMI (Institutional Executive Anchor - Pure Light Mode) -->
            <div id="card-corpus" role="button" tabindex="0" title="Click to view final wealth corpus in Cashflow Ledger" class="{% if isFourCardMode %}col-span-1{% else %}col-span-2 xl:col-span-1{% endif %} bg-emerald-50/90 rounded-2xl border-2 border-emerald-600 shadow-card px-3.5 py-3 text-left overflow-hidden transition-all duration-200 hover:shadow-card-hover hover:border-emerald-700 ring-2 ring-emerald-500/15 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 relative group flex flex-col justify-between min-w-0 cursor-pointer">
                <div id="title-corpus" class="text-caption font-extrabold text-slate-700 uppercase tracking-wider mb-1 leading-tight flex items-center justify-between gap-1">
                    <span id="title-corpus-text">{{ initial_kpis and initial_kpis.is_dual_mode ? ('Final Corpus @ Yr ' ~ initial_kpis.total_years) : card4Title }}</span>
                    <span id="summary-corpus-compact" class="hidden text-micro font-black text-emerald-950 bg-emerald-200/90 border border-emerald-300 px-2 py-0.5 rounded-full shadow-flat"></span>
                    <span class="text-micro font-extrabold text-white bg-emerald-600 border border-emerald-700/80 px-2 py-0.5 rounded-full shadow-flat">
                        Net Corpus
                    </span>
                </div>
                <div id="summary-corpus-headline" class="text-ui-base sm:text-ui-lg font-black text-slate-900 font-financial-mono tabular-nums leading-tight py-0.5 text-left">
                    {{ initial_kpis and initial_kpis.corpus_compact ? initial_kpis.corpus_compact : '₹ --' }}
                </div>
                <div class="flex items-center justify-between gap-1 text-micro font-medium text-slate-600 font-financial-mono tracking-tight mt-0.5">
                    <div id="summary-corpus" class="text-ui-xs font-extrabold text-slate-800 font-financial-mono whitespace-nowrap overflow-visible" aria-label="{{ initial_kpis and initial_kpis.corpus_exact ? initial_kpis.corpus_exact : '₹ --' }}">
                        <span class="sr-only">{{ initial_kpis and initial_kpis.corpus_exact ? initial_kpis.corpus_exact : '₹ --' }}</span>
                        <span aria-hidden="true" data-nosnippet="true">{{ initial_kpis and initial_kpis.corpus_exact ? initial_kpis.corpus_exact : '₹ --' }}</span>
                    </div>
                    <span id="subtitle-corpus" class="text-slate-500 truncate font-semibold">{{ initial_kpis and initial_kpis.is_dual_mode ? ('+' ~ initial_kpis.lifetime_gains_compact ~ ' Lifetime Gains') : '' }}</span>
                    <div id="post-tax-statutory-pill" class="hidden text-micro font-bold text-slate-700 bg-white border border-slate-200 px-1.5 py-0.5 rounded whitespace-nowrap">
                        §112A Net
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if calculator_type not in ['emi', 'ppf', 'fd', 'cagr', 'compound_interest', 'inflation'] %}
    <!-- Real Purchasing Power & Peace-of-Mind Telemetry Strip (Dynamic Risk Empathy) -->
    <div id="purchasing-power-telemetry-strip" class="p-3 sm:p-3.5 rounded-2xl bg-gradient-to-r from-teal-50/70 via-emerald-50/40 to-white border border-teal-200/80 shadow-card flex flex-col gap-2 sm:gap-2.5 transition-all">
        <!-- Row 1: Header (Icon, Reality Metric & Peace-of-Mind Score Pill) -->
        <div class="w-full flex items-center justify-between gap-2 flex-wrap xl:flex-nowrap">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-teal-50 border border-teal-200/80 text-teal-800 text-ui-sm font-extrabold shrink-0 shadow-flat">
                    <svg class="w-4 h-4 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                    </svg>
                </div>
                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-caption font-extrabold text-slate-500 uppercase tracking-wider">Inflation-Adjusted Reality:</span>
                    <strong id="real-purchasing-corpus" class="text-ui-xs sm:text-ui-sm font-black font-financial-mono text-slate-900">₹ --</strong>
                </div>
            </div>
            <!-- Score & Resilience Badge -->
            <div class="flex items-center gap-2 shrink-0 ml-auto xl:ml-0">
                <span id="peace-of-mind-badge" class="text-ui-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 whitespace-nowrap shadow-flat flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                    <span>Bulletproof Resilience</span>
                </span>
                <div class="text-right flex items-center gap-1 px-2 py-0.5 rounded-lg bg-teal-50/80 border border-teal-200/60">
                    <span class="text-micro font-bold uppercase tracking-wider text-slate-500">Score</span>
                    <span id="peace-of-mind-score" class="text-ui-xs font-black font-financial-mono text-emerald-800">85/100</span>
                </div>
            </div>
        </div>

        <!-- Row 2: Full-Width Contextual Safe Withdrawal Insight Paragraph -->
        <p id="purchasing-power-anchor" class="text-caption text-slate-600 leading-relaxed font-medium whitespace-normal break-words text-left w-full pl-0 sm:pl-9">
            Perpetual sovereign wealth: provides ₹1,20,000/mo lifetime safe withdrawal with zero capital erosion.
        </p>
    </div>
    {% endif %}

    <!-- Empathetic SWR Longevity Guardian Alert (Zero-CLS Container) -->
    <div id="swp-longevity-guardian-alert" class="hidden p-3.5 sm:p-4 rounded-2xl bg-amber-50/90 border border-amber-200/90 shadow-subtle transition-all">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div class="flex items-start gap-2.5">
                <span class="flex items-center justify-center w-7 h-7 rounded-xl bg-amber-100 text-amber-900 text-ui-sm font-extrabold shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </span>
                <div>
                    <div class="flex items-center gap-1.5">
                        <h4 class="text-ui-xs sm:text-ui-sm font-extrabold text-amber-950 flex items-center gap-1.5">
                            <span>Corpus Depletion Risk at</span>
                            <span id="swp-depletion-year-text" class="text-payout font-bold underline underline-offset-2">Year --</span>
                        </h4>
                        <div class="relative inline-flex items-center group/tip shrink-0">
                            <button type="button" 
                                class="w-3.5 h-3.5 rounded-full bg-amber-200/80 hover:bg-amber-300 text-amber-900 text-micro font-extrabold inline-flex items-center justify-center border border-amber-300/80 transition-colors cursor-help focus:outline-none focus:ring-1 focus:ring-amber-500"
                                aria-label="How Auto-Heal Works">
                                ℹ
                            </button>
                            <div role="tooltip" 
                                class="absolute left-0 sm:left-1/2 sm:-translate-x-1/2 bottom-full mb-2 hidden group-hover/tip:block group-focus-within/tip:block w-72 max-w-[85vw] p-2.5 bg-white text-slate-700 text-caption leading-relaxed rounded-xl shadow-modal border border-slate-200/90 z-50 pointer-events-none transition-all text-left">
                                <strong class="text-slate-900 block font-bold mb-0.5">How Auto-Heal Works:</strong>
                                Uses a 40-iteration binary search to calculate the exact maximum monthly payout you can safely withdraw without running out of money before your target tenure ends.
                            </div>
                        </div>
                    </div>
                    <p class="text-caption text-amber-950 leading-relaxed mt-0.5">
                        Current withdrawal outpaces portfolio compounding. Reduce to a mathematically sustainable rate of <strong id="swp-safe-amount-text" class="font-financial-mono text-amber-950 font-bold">₹ --/mo</strong> for complete horizon protection.
                    </p>
                </div>
            </div>
            <button type="button" id="auto-heal-swp-btn" class="w-full sm:w-auto px-3.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-ui-xs shrink-0 shadow-flat transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-amber-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span>Auto-Heal Safe SWP</span>
            </button>
        </div>
    </div>

    <!-- Chart Card -->
    <div id="chart-card" class="relative z-10 bg-white rounded-3xl border border-slate-200/90 shadow-card overflow-hidden transition-shadow duration-300 hover:shadow-card-hover p-3.5 sm:p-4 xl:p-5 flex flex-col gap-2.5 xl:gap-3">
        
        <!-- ========================================================================= -->
        <!-- TIER 1: UNIFIED MASTER COMMAND DOCK (Identity · Mode · Headline Context)  -->
        <!-- ========================================================================= -->
        <header class="flex flex-col xl:flex-row xl:items-center justify-between gap-2 xl:gap-3 pb-2 xl:pb-3 border-b border-slate-100">
            <!-- Left: Identity & Live Financial Context -->
            <div class="flex flex-col gap-0.5 min-w-0">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.6)] animate-pulse shrink-0"></span>
                    <h3 class="font-heading text-ui-base sm:text-heading-sm font-extrabold text-slate-900 tracking-tight truncate">
                        Wealth Growth Trajectory
                    </h3>
                    {% if calculator_type not in ['emi', 'inflation'] %}
                    <button type="button" onclick="document.getElementById('sebiBenchmarkModal')?.showModal()"
                        class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-100/90 hover:bg-growth-surface border border-slate-200 hover:border-growth-border text-micro text-slate-600 hover:text-growth-emphasis transition-all cursor-pointer shadow-flat shrink-0"
                        title="Click to view AMFI/SEBI regulatory modeling assumptions">
                        <span class="font-bold">AMFI Aligned</span>
                        <span class="text-slate-400 text-micro">ℹ️</span>
                    </button>
                    {% endif %}
                </div>
                <div class="sr-only" aria-live="polite">
                    <span>Projected: <strong class="text-slate-900 font-financial-mono font-bold" id="chart-header-gross">₹ --</strong></span>
                    <span>•</span>
                    <span class="text-growth-emphasis font-bold font-financial-mono" id="chart-header-gain">+₹ -- Gains</span>
                </div>
            </div>

            <!-- Right: View Mode Switcher & Primary Action Tools -->
            <div class="flex items-center justify-between xl:justify-end gap-1.5 w-full xl:w-auto self-start xl:self-center shrink-0">
                <!-- Segmented View Mode Switcher -->
                <div class="inline-flex bg-slate-100/90 p-0.5 rounded-xl border border-slate-200/80 shadow-flat" role="tablist" aria-label="Chart View Mode">
                    <button type="button" id="chart-view-line" role="tab" aria-selected="true"
                        class="px-3 py-1.5 min-h-[44px] sm:min-h-0 text-caption font-bold rounded-lg transition-all duration-150 bg-white text-growth-emphasis shadow-flat border border-slate-200/60 cursor-pointer flex items-center justify-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                        <span>Line</span>
                    </button>
                    <button type="button" id="chart-view-donut" role="tab" aria-selected="false"
                        class="px-3 py-1.5 min-h-[44px] sm:min-h-0 text-caption font-bold rounded-lg transition-all duration-150 text-slate-600 hover:text-slate-900 cursor-pointer flex items-center justify-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9" stroke-width="2"/>
                            <circle cx="12" cy="12" r="4" stroke-width="2"/>
                        </svg>
                        <span>Split</span>
                    </button>
                </div>

                <!-- Action Tools Sheet Trigger (< xl) -->
                <button type="button" onclick="document.getElementById('mobile-actions-sheet')?.showModal()"
                    class="xl:hidden inline-flex items-center gap-1.5 px-3.5 py-1.5 min-h-[44px] sm:min-h-0 rounded-xl border border-slate-200/80 bg-slate-50 hover:bg-white text-slate-700 text-ui-xs font-bold transition-all active:scale-95 cursor-pointer shadow-flat"
                    aria-label="Open Chart Actions and Tools">
                    <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                    </svg>
                    <span>Tools</span>
                    <span class="text-micro font-extrabold text-slate-400">•••</span>
                </button>

                <!-- Desktop Primary & Utility Action Buttons (>= xl) -->
                <div class="hidden xl:inline-flex items-center gap-1">
                    <button type="button" id="header-share-btn" onclick="document.getElementById('qr-share-modal')?.showModal()"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-emerald-200/90 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-ui-xs font-bold transition-all active:scale-95 cursor-pointer shadow-flat"
                        title="Share Wealth Plan or Export Wealth Horizon Pass">
                        <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                        </svg>
                        <span>Share Plan</span>
                    </button>
                    {% if calculator_type not in ['ppf', 'fd', 'emi', 'inflation', 'cagr', 'compound_interest'] %}
                    <button type="button" id="snapshot-scenario-btn" 
                        class="p-1.5 rounded-xl border border-slate-200/80 bg-slate-50 hover:bg-white text-slate-700 hover:text-slate-900 transition-all active:scale-95 cursor-pointer shadow-flat"
                        title="Snapshot scenario for comparison">
                        <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </button>
                    {% endif %}
                    {% if calculator_type not in ['emi', 'ppf', 'fd', 'inflation'] %}
                    <button type="button" id="open-tax-waterfall-btn" 
                        class="p-1.5 rounded-xl border border-tax-border bg-tax-surface hover:bg-violet-100 text-tax-emphasis transition-all active:scale-95 cursor-pointer shadow-flat"
                        title="Open Section 112A Tax Waterfall Modal">
                        <svg class="w-4 h-4 text-tax-emphasis" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                        </svg>
                    </button>
                    {% endif %}
                    <button type="button" id="open-embed-modal-btn" 
                        onclick="document.getElementById('embedModal')?.showModal()"
                        class="p-1.5 rounded-xl border border-slate-200/80 bg-slate-50 hover:bg-white text-slate-700 hover:text-slate-900 transition-all active:scale-95 cursor-pointer shadow-flat"
                        title="Embed this calculator widget on your website">
                        <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- ========================================================================= -->
        <!-- TIER 2: REAL-TIME TIMELINE INSPECTION HUD DOCK                            -->
        <!-- ========================================================================= -->
        <div id="chart-inspection-hud" class="flex flex-col xl:flex-row xl:items-center justify-between gap-2 px-3 py-2 xl:px-3.5 xl:py-2.5 rounded-2xl bg-slate-50/90 border border-slate-200/80 text-ui-xs text-slate-600 transition-all">
            <div class="flex items-center gap-2 shrink-0">
                <span id="hud-timeline-indicator" class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                <span id="hud-year-label" class="font-bold text-slate-800 tracking-tight whitespace-nowrap">Interactive Timeline</span>
            </div>
            <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-financial-mono text-caption sm:text-ui-xs">
                <span id="hud-invested-metric" class="text-slate-500 font-medium whitespace-nowrap">Invested: ₹ --</span>
                <span class="text-slate-300 hidden sm:inline select-none" aria-hidden="true">•</span>
                <span id="hud-gains-metric" class="text-growth-emphasis font-bold whitespace-nowrap">Gains: ₹ --</span>
                <span class="text-slate-300 hidden sm:inline select-none" aria-hidden="true">•</span>
                <span id="hud-total-metric" class="text-slate-900 font-black whitespace-nowrap">Total: ₹ --</span>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- TIER 3: INTERACTIVE CANVAS CONTAINER & ACCESSIBLE LEDGER                  -->
        <!-- ========================================================================= -->
        <div class="h-[250px] sm:h-[290px] md:h-[260px] lg:h-[320px] xl:h-[395px] w-full min-w-0 relative z-10" 
            tabindex="0" id="chart-canvas-container" 
            aria-label="Interactive Wealth Projection Chart. Use Left and Right arrow keys to inspect yearly progression.">
            <canvas id="corpusChart" class="w-full h-full block" role="img" aria-label="Investment growth projection line chart"></canvas>
        </div>

        <!-- Mobile Tactile Thumb Scrubber (Decoupled from canvas to prevent thumb occlusion) -->
        <div id="mobile-chart-scrubber-container" class="sm:hidden mt-2.5 px-2 py-2 bg-slate-50 rounded-2xl border border-slate-200/80 shadow-flat">
            <div class="flex items-center justify-between text-micro font-financial-mono text-slate-600 mb-1 px-1">
                <span class="font-bold">Yr 1</span>
                <span id="scrubber-active-indicator" class="font-bold text-growth-emphasis bg-growth-surface px-2.5 py-0.5 rounded-full border border-growth-border shadow-flat">
                    Scrub Timeline
                </span>
                <span id="scrubber-max-indicator" class="font-bold">Yr --</span>
            </div>
            <input type="range" id="mobile-chart-scrubber" min="1" max="30" value="30" step="1"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-400/30"
                aria-label="Scrub through investment timeline years">
        </div>

        <!-- Accessible Semantic Screen-Reader Data Ledger (WCAG 1.1.1 & 4.1.2) -->
        <table class="sr-only" aria-label="Investment Growth Cashflow Ledger">
            <caption>Annual wealth progression projection table for assistive technologies</caption>
            <thead>
                <tr>
                    <th scope="col">Year</th>
                    <th scope="col">Invested Principal</th>
                    <th scope="col">Estimated Gains</th>
                    <th scope="col">Projected Corpus</th>
                </tr>
            </thead>
            <tbody id="a11y-chart-table-body"></tbody>
        </table>

        <!-- ========================================================================= -->
        <!-- TIER 4: REFINED HISTORICAL BENCHMARK & ANALYTICAL LENSES CONSOLE          -->
        <!-- ========================================================================= -->
        <footer class="mt-1 xl:mt-2 pt-2.5 xl:pt-3 border-t border-slate-100 flex flex-col xl:flex-row xl:items-center justify-between gap-2.5 xl:gap-3">
            <!-- Left Console: Opportunity Cost Benchmark Selector (Single-Choice Segmented Dock) -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2.5 min-w-0">
                <div class="flex items-center gap-1.5 shrink-0">
                    <span class="text-micro font-extrabold text-slate-500 uppercase tracking-wider">Benchmark</span>
                    <span class="text-micro font-medium text-slate-400 hidden sm:inline">•</span>
                </div>
                <div class="inline-flex items-center p-1 rounded-xl bg-slate-100/90 border border-slate-200/70 shadow-flat gap-1 max-w-full overflow-x-auto no-scrollbar" role="group" aria-label="Historical Return Benchmarks">
                    <button type="button" class="benchmark-chip px-2.5 py-1 text-ui-xs font-bold rounded-lg transition-all duration-150 cursor-pointer whitespace-nowrap shrink-0 inline-flex items-center justify-center is-active bg-white text-growth-emphasis border border-slate-200/80 shadow-flat" data-benchmark="none">
                        None
                    </button>
                    <button type="button" class="benchmark-chip px-2.5 py-1 text-ui-xs font-semibold rounded-lg transition-all duration-150 cursor-pointer whitespace-nowrap shrink-0 inline-flex items-center justify-center bg-transparent text-slate-600 border border-transparent hover:text-slate-900 hover:bg-white/60" data-benchmark="nifty">
                        <span>Nifty 50</span>
                        <span class="benchmark-rate ml-1 text-micro text-slate-400 font-financial-mono font-normal">12%</span>
                    </button>
                    <button type="button" class="benchmark-chip px-2.5 py-1 text-ui-xs font-semibold rounded-lg transition-all duration-150 cursor-pointer whitespace-nowrap shrink-0 inline-flex items-center justify-center bg-transparent text-slate-600 border border-transparent hover:text-slate-900 hover:bg-white/60" data-benchmark="gold">
                        <span>Gold</span>
                        <span class="benchmark-rate ml-1 text-micro text-slate-400 font-financial-mono font-normal">9%</span>
                    </button>
                    <button type="button" class="benchmark-chip px-2.5 py-1 text-ui-xs font-semibold rounded-lg transition-all duration-150 cursor-pointer whitespace-nowrap shrink-0 inline-flex items-center justify-center bg-transparent text-slate-600 border border-transparent hover:text-slate-900 hover:bg-white/60" data-benchmark="fd">
                        <span>Bank FD</span>
                        <span class="benchmark-rate ml-1 text-micro text-slate-400 font-financial-mono font-normal">6.5%</span>
                    </button>
                </div>
            </div>

            <!-- Right Console: Analytical Projection Lenses (Multi-Toggle Segmented Dock) -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2.5 min-w-0 xl:self-center">
                <div class="flex items-center justify-between sm:justify-start gap-1.5 shrink-0">
                    <span class="text-micro font-extrabold text-slate-500 uppercase tracking-wider">Analysis Lenses</span>
                    <span id="active-lens-indicator" class="inline-flex items-center text-micro font-bold text-slate-500 bg-slate-100/90 px-2 py-0.5 rounded-full border border-slate-200/70 shrink-0">
                        Standard View
                    </span>
                </div>

                <div class="inline-flex items-center p-1 rounded-xl bg-slate-100/90 border border-slate-200/70 shadow-flat gap-1 max-w-full overflow-x-auto no-scrollbar" role="group" aria-label="Analytical Projection Lenses">
                    {% if calculator_type not in ['ppf', 'fd', 'emi'] %}
                    <!-- Lens: Section 112A LTCG Tax -->
                    <label id="overlay-chip-post-tax" 
                        class="group relative inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg cursor-pointer select-none transition-all duration-150 text-ui-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-white active:scale-95 border border-transparent has-checked:bg-white has-checked:text-violet-900 has-checked:shadow-flat has-checked:border-violet-200 has-checked:font-bold shrink-0" 
                        title="Toggle Section 112A Post-Tax Net Returns [Shift+T]">
                        <input type="checkbox" id="show_post_tax" class="sr-only peer" aria-label="Show Post-Tax Returns">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-300 peer-checked:bg-violet-600 transition-colors"></span>
                        <span>Post-Tax</span>
                        <span id="tax-telemetry-pill" class="text-micro font-financial-mono text-slate-400 peer-checked:text-violet-700 font-medium">12.5%</span>
                    </label>
                    {% endif %}

                    <!-- Lens: Corridor -->
                    <label id="overlay-chip-corridor" 
                        class="group relative inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg cursor-pointer select-none transition-all duration-150 text-ui-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-white active:scale-95 border border-transparent has-checked:bg-white has-checked:text-emerald-950 has-checked:shadow-flat has-checked:border-emerald-200 has-checked:font-bold shrink-0" 
                        title="Toggle Historical Volatility Range (10th-90th Percentile) [Shift+C]">
                        <input type="checkbox" id="show_historical_corridor" class="sr-only peer" aria-label="Show Historical Volatility Corridor">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-300 peer-checked:bg-emerald-600 transition-colors"></span>
                        <span>Volatility Range</span>
                        <span id="corridor-telemetry-pill" class="text-micro font-financial-mono text-slate-400 peer-checked:text-emerald-700 font-medium">10–90%</span>
                    </label>

                    <!-- Lens: Wealth Map (Stacked Decomposition) -->
                    <label id="overlay-chip-wealth-map" 
                        class="group relative inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg cursor-pointer select-none transition-all duration-150 text-ui-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-white active:scale-95 border border-transparent has-checked:bg-white has-checked:text-indigo-950 has-checked:shadow-flat has-checked:border-indigo-200 has-checked:font-bold shrink-0" 
                        title="Toggle Principal vs Gains Decomposition [Shift+M]">
                        <input type="checkbox" id="show_wealth_map" class="sr-only peer" aria-label="Show Wealth Map">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-300 peer-checked:bg-indigo-600 transition-colors"></span>
                        <span>Breakdown</span>
                        <span id="wealth-map-telemetry-pill" class="text-micro font-financial-mono text-slate-400 peer-checked:text-indigo-700 font-medium">Stack</span>
                    </label>
                </div>
            </div>
        </footer>
    </div>

    <!-- Milestones Section -->
    <div id="milestones-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
</div>


