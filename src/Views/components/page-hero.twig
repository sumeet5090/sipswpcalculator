<header class="text-center mb-10 md:mb-16 pt-4 relative overflow-hidden {{ hero.extra_class|default('') }}">
    <!-- Soft Light Ambient Aurora Halo -->
    <div class="absolute left-1/2 -top-12 -translate-x-1/2 w-full max-w-3xl h-36 bg-gradient-to-r from-emerald-400/10 via-teal-300/8 to-indigo-300/6 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
        {% if hero.badge is defined and hero.badge %}
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-micro font-bold bg-white text-emerald-800 border border-emerald-200/80 shadow-subtle mb-4">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="tracking-wider uppercase">{{ hero.badge }}</span>
            </div>
        {% endif %}

        <h1 class="font-heading text-display-xl font-extrabold tracking-tight text-slate-900 pb-2">
            {{ hero.title_prefix|default('') }}
            {% if hero.title_highlight is defined and hero.title_highlight %}
                <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-indigo-600 bg-clip-text text-transparent">{{ hero.title_highlight }}</span>
            {% endif %}
            {{ hero.title_suffix|default('') }}
        </h1>

        {% if hero.description is defined and hero.description %}
            <p class="mt-2 text-ui-sm sm:text-body text-slate-600 max-w-2xl mx-auto leading-relaxed">
                {{ hero.description }}
            </p>
        {% endif %}

        <!-- Feature Trust Micro-Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-micro font-bold text-slate-600">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/95 border border-slate-200/80 text-slate-700 shadow-flat">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span>SEBI &amp; AMFI Compliant</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/95 border border-slate-200/80 text-slate-700 shadow-flat">
                <svg class="w-3.5 h-3.5 text-indigo-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                </svg>
                <span>2026 LTCG Tax Rules (§112A)</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/95 border border-slate-200/80 text-slate-700 shadow-flat">
                <svg class="w-3.5 h-3.5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span>Instant Zero-Lag Math</span>
            </span>
        </div>
    </div>
</header>
