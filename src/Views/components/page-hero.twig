<header class="text-center mb-14 md:mb-20 pt-6 {{ hero.extra_class|default('') }}">
    {% if hero.badge is defined and hero.badge %}
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100/60 uppercase tracking-widest mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            {{ hero.badge }}
        </span>
    {% endif %}
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight pb-3">
        {{ hero.title_prefix|default('') }}
        {% if hero.title_highlight is defined and hero.title_highlight %}
            <span class="bg-gradient-to-r from-emerald-600 to-teal-500 bg-clip-text text-transparent">{{ hero.title_highlight }}</span>
        {% endif %}
        {{ hero.title_suffix|default('') }}
    </h1>
    {% if hero.description is defined and hero.description %}
        <p class="mt-4 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed font-medium">
            {{ hero.description }}
        </p>
    {% endif %}
</header>
