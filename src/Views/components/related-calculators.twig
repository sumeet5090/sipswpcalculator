{# Renders contextual cross-links to related calculator pages #}
{% if related_calculators is defined and related_calculators|length > 0 %}
<section class="mt-12 mb-8" aria-label="Related Calculators">
    <div class="flex items-center gap-2.5 mb-5">
        <div class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200/80 flex items-center justify-center text-emerald-700 text-sm font-bold shadow-flat">
            🧭
        </div>
        <div>
            <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Explore Related Financial Calculators</h2>
            <p class="text-xs text-slate-500 font-medium">Complementary planning tools for Indian mutual fund investors</p>
        </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 not-prose">
        {% for calc in related_calculators %}
        <a href="{{ calc.href }}" class="group relative bg-white/95 border border-slate-200/90 rounded-xl p-5 hover:border-emerald-400 hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between overflow-hidden">
            <div class="absolute -top-10 -right-10 w-24 h-24 bg-emerald-400/5 rounded-full blur-xl group-hover:bg-emerald-400/10 transition-colors pointer-events-none"></div>
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100">Tool</span>
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                </div>
                <h3 class="text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition-colors leading-snug mb-1.5">{{ calc.title }}</h3>
                <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">{{ calc.description }}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center text-xs font-semibold text-emerald-700 group-hover:text-emerald-800">
                <span>Open Calculator</span>
                <span class="ml-1 opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </div>
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}
