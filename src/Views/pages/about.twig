{% extends 'layouts/base.twig' %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sumeet Boga",
  "url": "{{ site_url }}/about",
  "jobTitle": "Software Engineer & Finance Enthusiast",
  "description": "Creator of SIP & SWP Calculator. Passionate about making financial planning accessible through technology.",
  "knowsAbout": ["Systematic Investment Plans", "Systematic Withdrawal Plans", "Mutual Fund Investing", "Financial Planning", "Tax-Efficient Investing", "Web Development"],
  "sameAs": ["https://www.linkedin.com/in/sumeet-boga/"]
}
</script>
<style>
    .profile-card:hover .profile-ring {
        transform: scale(1.03);
        border-color: #059669;
    }
    .timeline-dot::after {
        content: '';
        position: absolute;
        width: 8px;
        height: 8px;
        background-color: #059669;
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>
{% endblock %}

{% block content %}
{% include 'components/theme-glow-blobs.twig' %}

<div class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 relative">
    
    {% set hero = {
        'badge': 'Meet the Builder',
        'title_prefix': 'About ',
        'title_highlight': 'Me',
        'title_suffix': ' & The Project',
        'description': 'The engineering journey behind a transparent, ad-free financial planning suite built for smart investors.'
    } %}
    {% include 'components/page-hero.twig' %}

    <!-- Creator Bio Card & Introduction -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch mb-12">
        
        <!-- Interactive Profile Card -->
        <div class="md:col-span-4 flex flex-col items-center text-center p-6 sm:p-8 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle relative overflow-hidden group profile-card">
            <div class="relative w-28 h-28 mb-5">
                <div class="absolute inset-0 rounded-full border border-dashed border-slate-300 profile-ring transition-transform duration-300"></div>
                <img src="/assets/sumeet-boga.jpg" alt="Sumeet Boga — Creator of SIP & SWP Calculator"
                     class="absolute inset-1.5 w-25 h-25 rounded-full object-cover border border-slate-200/80 shadow-flat">
            </div>

            <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 leading-tight">Sumeet Boga</h2>
            <p class="text-ui-sm text-emerald-700 font-semibold mt-1 mb-3">Software Engineer &amp; Builder</p>
            
            <p class="text-xs sm:text-ui-sm text-slate-600 leading-relaxed mb-6">
                Combining tech expertise with personal finance passion to build fast, secure calculators.
            </p>

            <a href="https://www.linkedin.com/in/sumeet-boga/" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 text-ui-sm font-bold rounded-xl text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-flat">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
                Connect on LinkedIn
            </a>
        </div>

        <!-- Professional Story -->
        <div class="md:col-span-8 p-6 sm:p-8 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle flex flex-col justify-between">
            <div>
                <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-4 flex items-center gap-2.5">
                    <span class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                        </svg>
                    </span>
                    The Vision Behind the Tools
                </h3>
                <div class="text-slate-600 space-y-3.5 leading-relaxed text-ui-sm sm:text-base">
                    <p>
                        In personal finance, clarity is everything. Unfortunately, many online calculators are slow, complex, or designed to capture your contact details and pitch you insurance policies.
                    </p>
                    <p>
                        I wanted a clean tool that did two things exceptionally well: model <strong class="text-slate-900 font-semibold">Step-up Systematic Investment Plans (SIP)</strong> to match salary increments, and simulation-test a <strong class="text-slate-900 font-semibold">Systematic Withdrawal Plan (SWP)</strong> for retirement income under inflation.
                    </p>
                    <p>
                        Unable to find a transparent, lightweight suite, I decided to build it. This calculator utilizes 100% local, client-side browser logic to keep your numbers completely private, running smoothly without any corporate telemetry.
                    </p>
                </div>
            </div>
            
            <div class="mt-6 pt-5 border-t border-slate-200/70 flex flex-wrap gap-x-6 gap-y-2 text-xs font-semibold text-slate-600">
                <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 100% Free &amp; Open Logic</span>
                <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Local-First Architecture</span>
                <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Verified Math</span>
            </div>
        </div>
    </section>

    <!-- Project Milestones / Timeline -->
    <section class="mb-12">
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 text-center mb-8">Project Journey &amp; Milestones</h3>
        <div class="relative max-w-2xl mx-auto pl-8 border-l border-slate-200/90 space-y-8">
            
            <!-- Milestone 1 -->
            <div class="relative">
                <span class="absolute -left-12 top-1 w-8 h-8 rounded-full border border-emerald-200/90 bg-emerald-50 flex items-center justify-center timeline-dot"></span>
                <h4 class="text-base font-bold text-slate-900">Conception &amp; Engine Prototype</h4>
                <span class="text-micro text-emerald-800 font-bold bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-md inline-block mt-1 mb-2 uppercase tracking-wider">Q2 2024</span>
                <p class="text-ui-sm text-slate-600 leading-relaxed">
                    Designed the initial compound interest and step-up algorithms. Verified formulas against Excel sheets and standard financial reference papers to ensure absolute math consistency.
                </p>
            </div>
            
            <!-- Milestone 2 -->
            <div class="relative">
                <span class="absolute -left-12 top-1 w-8 h-8 rounded-full border border-slate-200/90 bg-slate-50 flex items-center justify-center timeline-dot"></span>
                <h4 class="text-base font-bold text-slate-900">SIP + SWP Unified Simulator</h4>
                <span class="text-micro text-slate-600 font-bold bg-slate-100 border border-slate-200/80 px-2 py-0.5 rounded-md inline-block mt-1 mb-2 uppercase tracking-wider">Q1 2025</span>
                <p class="text-ui-sm text-slate-600 leading-relaxed">
                    Launched the first integrated calculator that maps the wealth accumulation phase (SIP) directly into the retired distribution phase (SWP) in a single visual chart.
                </p>
            </div>
            
            <!-- Milestone 3 -->
            <div class="relative">
                <span class="absolute -left-12 top-1 w-8 h-8 rounded-full border border-emerald-200/90 bg-emerald-50 flex items-center justify-center timeline-dot"></span>
                <h4 class="text-base font-bold text-slate-900">Advanced Mutual Fund Taxation Engine</h4>
                <span class="text-micro text-emerald-800 font-bold bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-md inline-block mt-1 mb-2 uppercase tracking-wider">Q1 2026</span>
                <p class="text-ui-sm text-slate-600 leading-relaxed">
                    Integrated accurate LTCG and STCG tax rules (compliant with Indian tax policies) so users can model tax-efficient withdrawal structures instead of raw returns.
                </p>
            </div>
        </div>
    </section>

    <!-- Key Pillars / Feature Grid -->
    <section class="mb-12">
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 text-center mb-8">What Makes This Suite Unique</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            
            <!-- Pillar 1 -->
            <div class="p-5 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle hover:shadow-card hover:border-slate-300/90 transition-all duration-200 flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-center text-emerald-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-ui-sm mb-1">True Annual Step-Up</h4>
                    <p class="text-xs sm:text-ui-sm text-slate-600 leading-relaxed">
                        Increment your investments on a set percentage yearly. This realistic simulation mirrors actual career progression and wage hikes over time.
                    </p>
                </div>
            </div>

            <!-- Pillar 2 -->
            <div class="p-5 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle hover:shadow-card hover:border-slate-300/90 transition-all duration-200 flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-center text-emerald-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-ui-sm mb-1">Unified Accumulation &amp; Drawdown</h4>
                    <p class="text-xs sm:text-ui-sm text-slate-600 leading-relaxed">
                        Transition seamlessly from compounding your savings into receiving a tax-efficient retirement salary, all mapped out visually.
                    </p>
                </div>
            </div>

            <!-- Pillar 3 -->
            <div class="p-5 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle hover:shadow-card hover:border-slate-300/90 transition-all duration-200 flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-amber-50 border border-amber-200/80 flex items-center justify-center text-amber-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-ui-sm mb-1">Inflation Adjustments</h4>
                    <p class="text-xs sm:text-ui-sm text-slate-600 leading-relaxed">
                        Avoid purchasing power erosion. Adjust retirement income yearly so your real spending capacity remains constant across decades.
                    </p>
                </div>
            </div>

            <!-- Pillar 4 -->
            <div class="p-5 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle hover:shadow-card hover:border-slate-300/90 transition-all duration-200 flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-200/80 flex items-center justify-center text-indigo-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-ui-sm mb-1">100% Client-Side Privacy</h4>
                    <p class="text-xs sm:text-ui-sm text-slate-600 leading-relaxed">
                        Your parameters are yours alone. Calculations occur inside your browser session. No data is stored, sold, or shared with third parties.
                    </p>
                </div>
            </div>

        </div>
    </section>

    <!-- Accuracy & Disclaimer -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-12">
        
        <!-- Accuracy Details -->
        <div class="p-6 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle">
            <div class="flex items-center gap-3 mb-3.5">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-50 border border-emerald-200/80 text-emerald-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </span>
                <h4 class="font-bold text-slate-900 text-ui-sm">Commitment to Accuracy</h4>
            </div>
            
            <p class="text-xs sm:text-ui-sm text-slate-600 leading-relaxed mb-4">
                Financial models and calculations are calibrated using framework policies and regulatory math guidelines established by key financial institutions:
            </p>
            
            <ul class="grid grid-cols-3 gap-2 text-xs font-bold text-slate-700 mb-4">
                <li>
                    <a href="https://www.amfiindia.com/" target="_blank" rel="noopener noreferrer" class="flex flex-col p-2.5 bg-slate-50/90 hover:bg-emerald-50 border border-slate-200/80 hover:border-emerald-200 rounded-xl text-center group transition-colors">
                        <span class="group-hover:text-emerald-700 transition-colors">AMFI</span>
                        <span class="text-micro text-slate-500 font-medium mt-0.5">India</span>
                    </a>
                </li>
                <li>
                    <a href="https://www.sebi.gov.in/" target="_blank" rel="noopener noreferrer" class="flex flex-col p-2.5 bg-slate-50/90 hover:bg-emerald-50 border border-slate-200/80 hover:border-emerald-200 rounded-xl text-center group transition-colors">
                        <span class="group-hover:text-emerald-700 transition-colors">SEBI</span>
                        <span class="text-micro text-slate-500 font-medium mt-0.5">Regulations</span>
                    </a>
                </li>
                <li>
                    <a href="https://incometaxindia.gov.in/" target="_blank" rel="noopener noreferrer" class="flex flex-col p-2.5 bg-slate-50/90 hover:bg-emerald-50 border border-slate-200/80 hover:border-emerald-200 rounded-xl text-center group transition-colors">
                        <span class="group-hover:text-emerald-700 transition-colors">ITD</span>
                        <span class="text-micro text-slate-500 font-medium mt-0.5">Tax Laws</span>
                    </a>
                </li>
            </ul>
            
            <span class="text-micro text-emerald-800 bg-emerald-50 border border-emerald-200/80 px-2.5 py-1 rounded-md font-bold inline-block uppercase tracking-wider">
                Last math audit: March 2026
            </span>
        </div>

        <!-- Disclaimer Details -->
        <div class="p-6 fintech-glass-card border border-slate-200/90 rounded-2xl shadow-subtle flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3.5">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-slate-100 border border-slate-200/80 text-slate-600">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </span>
                    <h4 class="font-bold text-slate-900 text-ui-sm">Regulatory Disclaimer</h4>
                </div>
                
                <p class="text-xs sm:text-ui-sm text-slate-600 leading-relaxed">
                    This suite is built for educational and planning purposes only. The mathematical simulations do not account for external costs like exit loads, scheme expense ratios, or severe market downturns. I am not a SEBI-registered advisor; consult an official advisor before executing investments.
                </p>
            </div>
            
            <div class="mt-4 pt-4 border-t border-slate-200/70 text-xs font-semibold text-slate-600 flex items-center justify-between">
                <span>Have math feedback?</span>
                <a href="mailto:help@sipswpcalculator.com" class="text-emerald-700 hover:text-emerald-800 font-bold underline transition-colors">
                    help@sipswpcalculator.com
                </a>
            </div>
        </div>
        
    </section>

    <!-- Bottom CTA: Quick Navigation -->
    <section class="p-8 fintech-glass-card bg-gradient-to-br from-emerald-50/70 via-white to-teal-50/40 text-slate-900 rounded-2xl border border-emerald-200/90 shadow-subtle relative overflow-hidden text-center">
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-2">Ready to plan your financial milestones?</h3>
        <p class="text-slate-600 text-ui-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
            Jump straight into one of our high-fidelity calculators and map your path to wealth.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
            <a href="/sip-calculator" class="inline-flex items-center justify-center gap-2 py-2.5 px-5 text-ui-sm font-bold bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl transition-colors shadow-flat w-full sm:w-auto">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                SIP Compounding Tool
            </a>
            <a href="/swp-calculator" class="inline-flex items-center justify-center gap-2 py-2.5 px-5 text-ui-sm font-bold bg-white hover:bg-slate-50 border border-slate-200/90 text-slate-700 hover:text-slate-900 rounded-xl transition-colors shadow-flat w-full sm:w-auto">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Retirement Drawdown
            </a>
        </div>
    </section>

</div>
{% endblock %}
