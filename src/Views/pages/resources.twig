{% extends 'layouts/base.twig' %}

{% block head %}
    <style>
        .archive-sidebar-active {
            color: #047857 !important;
            background-color: #ecfdf5 !important;
            border-left-color: #059669 !important;
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    {% if breadcrumbs is defined %}
    <script type="application/ld+json">{{ breadcrumbs|raw }}</script>
    {% endif %}
{% endblock %}

{% block content %}
{% include 'components/theme-glow-blobs.twig' %}

{% set hero = {
    'badge': 'Library & Guides',
    'title_prefix': 'Research & ',
    'title_highlight': 'Resources',
    'description': 'Expert insights, deep-dives on Systematic Investment Plans, retirement math, and honest instrument comparisons.'
} %}
{% include 'components/page-hero.twig' %}

{% if selected_category is defined and selected_category %}
    {% set cat_meta = categories[selected_category]|default({}) %}
    {% set cat_display_name = cat_meta.title|default(selected_category|capitalize) %}
    <!-- Visual Breadcrumb Navigation (aligned with JSON-LD BreadcrumbList schema) -->
    <nav aria-label="Breadcrumb" class="mb-6 -mt-4">
        <ol role="list" class="flex items-center space-x-1.5 sm:space-x-2 text-xs sm:text-sm text-slate-500 flex-wrap">
            <li>
                <a href="/" class="hover:text-emerald-600 transition-colors inline-flex items-center">
                    <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z" clip-rule="evenodd" />
                    </svg>
                    <span class="sr-only">Home</span>
                </a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4 flex-shrink-0 text-slate-300 mx-0.5 sm:mx-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                    <a href="/resources" class="hover:text-emerald-600 transition-colors whitespace-nowrap">Resources</a>
                </div>
            </li>
            <li class="min-w-0">
                <div class="flex items-center min-w-0">
                    <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4 flex-shrink-0 text-slate-300 mx-0.5 sm:mx-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-slate-800 font-semibold truncate" aria-current="page">{{ cat_display_name }}</span>
                </div>
            </li>
        </ol>
    </nav>
{% endif %}

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pb-16 relative">
    <!-- Sidebar Navigation -->
    <aside class="lg:col-span-3 sticky top-24 hidden lg:block">
        <nav aria-label="Archive Categories" class="fintech-glass-card rounded-2xl border border-slate-200/90 p-3 shadow-subtle">
            <h3 class="text-micro font-bold text-slate-500 uppercase tracking-wider mb-3 px-3 pt-1">
                Explore Categories
            </h3>
            <ul class="space-y-1">
                {% for id, cat in categories %}
                    <li>
                        <a href="#{{ id }}" class="archive-sidebar-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-ui-sm font-semibold text-slate-600 border-l-2 border-transparent hover:bg-slate-50 hover:text-slate-900 transition-all">
                            {{ cat.icon|raw }}
                            <span>{{ cat.title }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <main class="lg:col-span-9">
        <!-- Mobile Navigation (Horizontal Scroll) -->
        <div class="lg:hidden sticky top-16 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/90 -mx-4 px-4 py-2.5 mb-8">
            <nav class="flex gap-2 overflow-x-auto no-scrollbar whitespace-nowrap text-micro font-bold text-slate-600 uppercase tracking-wider">
                {% for id, cat in categories %}
                    <a href="#{{ id }}" class="archive-sidebar-link px-3 py-1.5 bg-slate-50 rounded-lg border border-slate-200/90 hover:bg-slate-100 transition-colors">
                        {{ cat.title }}
                    </a>
                {% endfor %}
            </nav>
        </div>

        <div class="flex flex-col gap-12 lg:gap-16">
            {% for cat_id, cat in categories %}
                {% set accent_color = cat.accent %}
                {% set icon_badge_class = 'bg-emerald-50 text-emerald-700 border border-emerald-200/80' %}
                {% set post_arrow_class = 'bg-slate-100 text-slate-600 group-hover:bg-emerald-600 group-hover:text-white' %}
                {% set post_title_hover = 'group-hover:text-emerald-700' %}
                {% if accent_color == 'indigo' %}
                    {% set icon_badge_class = 'bg-indigo-50 text-indigo-700 border border-indigo-200/80' %}
                    {% set post_arrow_class = 'bg-slate-100 text-slate-600 group-hover:bg-indigo-600 group-hover:text-white' %}
                    {% set post_title_hover = 'group-hover:text-indigo-700' %}
                {% elseif accent_color == 'amber' %}
                    {% set icon_badge_class = 'bg-amber-50 text-amber-800 border border-amber-200/80' %}
                    {% set post_arrow_class = 'bg-slate-100 text-slate-600 group-hover:bg-amber-600 group-hover:text-white' %}
                    {% set post_title_hover = 'group-hover:text-amber-800' %}
                {% endif %}
                <section id="{{ cat_id }}" class="scroll-mt-32 {{ not loop.first ? 'pt-10 border-t border-slate-200/80' : '' }}">
                <!-- Section Header -->
                <div class="flex flex-col gap-3.5 mb-6 pb-4 border-b border-slate-200/80">
                    <div class="flex items-start sm:items-center gap-3.5">
                        <div class="w-10 h-10 rounded-xl {{ icon_badge_class }} flex items-center justify-center shadow-flat shrink-0">
                            {{ cat.icon|raw }}
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight leading-snug mb-0.5">{{ cat.title }}</h2>
                            <p class="text-slate-600 text-xs sm:text-ui-sm font-normal max-w-2xl leading-relaxed">{{ cat.desc }}</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-micro font-bold text-slate-500 uppercase tracking-wider mr-1">Tools:</span>
                        {% if cat_id == 'growth' %}
                            <a href="/sip-calculator" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">SIP</a>
                            <a href="/sip-step-up-calculator" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">Step-Up</a>
                            <a href="/lumpsum-calculator" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">Lumpsum</a>
                            <a href="/my-first-crore-calculator" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">1 Cr Goal</a>
                            <a href="/sip-5000-per-month" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">₹5k SIP</a>
                            <a href="/sip-10000-per-month" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">₹10k SIP</a>
                            <a href="/compound-interest-calculator" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">CI</a>
                            <a href="/cagr-calculator" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-micro font-bold transition-all shadow-flat">CAGR</a>
                        {% elseif cat_id == 'retirement' %}
                            <a href="/" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">SIP + SWP</a>
                            <a href="/swp-calculator" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">SWP</a>
                            <a href="/retirement-calculator" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">Retirement</a>
                            <a href="/target-corpus-calculator" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">Target Corpus</a>
                            <a href="/reach-5-crore-via-sip" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">5 Cr Goal</a>
                            <a href="/nps-calculator" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">NPS</a>
                            <a href="/post-retirement-calculator" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">Post-Ret</a>
                            <a href="/epf-calculator" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">EPF</a>
                            <a href="/gratuity-calculator" class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-micro font-bold transition-all shadow-flat">Gratuity</a>
                        {% elseif cat_id == 'comparison' %}
                            <a href="/fd-calculator" class="px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-micro font-bold transition-all shadow-flat">FD</a>
                            <a href="/ppf-calculator" class="px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-micro font-bold transition-all shadow-flat">PPF</a>
                            <a href="/emi-calculator" class="px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-micro font-bold transition-all shadow-flat">EMI</a>
                            <a href="/inflation-calculator" class="px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-micro font-bold transition-all shadow-flat">Inflation</a>
                            <a href="/tax-harvesting-calculator" class="px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-micro font-bold transition-all shadow-flat">Tax Harvest</a>
                            <a href="/income-tax-calculator" class="px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-micro font-bold transition-all shadow-flat">Income Tax</a>
                        {% endif %}
                    </div>
                </div>

                <!-- Posts Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
                    {% set posts = posts_by_cat[cat_id]|default([]) %}
                    {% set featured_rendered_count = 0 %}
                    {% for post in posts %}
                        {% set is_featured = false %}
                        {% if post.featured|default(false) and featured_rendered_count < 2 %}
                            {% set is_featured = true %}
                            {% set featured_rendered_count = featured_rendered_count + 1 %}
                        {% endif %}
                        {% set tag_badge_class = 'text-emerald-800 bg-emerald-50 border border-emerald-200' %}
                        {% if accent_color == 'indigo' %}
                            {% set tag_badge_class = 'text-indigo-800 bg-indigo-50 border border-indigo-200' %}
                        {% elseif accent_color == 'amber' %}
                            {% set tag_badge_class = 'text-amber-800 bg-amber-50 border border-amber-200' %}
                        {% endif %}
                        <article class="group relative fintech-glass-card flex flex-col transition-all {{ is_featured ? 'md:col-span-2' : '' }} rounded-2xl border border-slate-200/90 shadow-subtle hover:shadow-card hover:border-slate-300/90 overflow-hidden">
                            <div class="flex items-center justify-between px-5 py-3 bg-slate-50/70 border-b border-slate-200/70">
                                <span class="text-micro font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md {{ tag_badge_class }}">
                                    {{ post.tag }}
                                </span>
                                <span class="text-micro font-semibold text-slate-500 uppercase tracking-wider">
                                    {{ post.read_time }} Read
                                </span>
                            </div>
                            <div class="flex flex-col h-full {{ is_featured ? 'p-5 sm:p-6' : 'p-5' }}">
                                <h3 class="{{ is_featured ? 'text-lg sm:text-xl' : 'text-base sm:text-lg' }} font-bold text-slate-900 {{ post_title_hover }} transition-colors leading-snug mb-2.5">
                                    <a href="{{ post.href }}" class="after:absolute after:inset-0">
                                        {{ post.title }}
                                    </a>
                                </h3>
                                
                                <p class="text-slate-600 leading-relaxed text-xs sm:text-ui-sm line-clamp-3 mb-5">
                                    {{ post.desc }}
                                </p>
                                
                                <div class="mt-auto flex items-center justify-between pt-4 border-t border-slate-200/60">
                                    <span class="text-micro font-bold text-slate-500 uppercase tracking-wider">{{ post.date }} Edition</span>
                                    <div class="w-7 h-7 rounded-lg {{ post_arrow_class }} flex items-center justify-center transition-colors shadow-flat">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                    </div>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.archive-sidebar-link');

        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -70% 0px',
            threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const id = entry.target.getAttribute('id');
                    navLinks.forEach(link => {
                        const href = link.getAttribute('href');
                        if (href === '#' + id) {
                            link.classList.add('archive-sidebar-active');
                        } else {
                            link.classList.remove('archive-sidebar-active');
                        }
                    });
                }
            });
        }, observerOptions);

        sections.forEach(section => observer.observe(section));
    });
</script>
{% endblock %}
