{% extends 'layouts/base.twig' %}

{% block content %}
<main class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-4">
            <span>🔍</span>
            <span>Error 404 — Page Not Found</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">Looking for a Financial Calculator?</h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
            The page you requested might have been relocated or updated. Jump directly to one of our free, AMFI-compliant investment planning tools below:
        </p>
    </div>

    <!-- Calculator Grid Hub -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
        <a href="/sip-calculator" class="group p-5 bg-white/95 rounded-2xl border border-slate-200/90 shadow-subtle hover:border-emerald-400 hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100">Accumulation</span>
                    <span class="text-slate-400 group-hover:text-emerald-600 transition-colors">→</span>
                </div>
                <h2 class="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors mb-1">SIP Calculator</h2>
                <p class="text-xs text-slate-600 leading-relaxed">Calculate returns on regular monthly mutual fund SIPs with compound interest.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-emerald-700">Open Tool &rarr;</div>
        </a>

        <a href="/swp-calculator" class="group p-5 bg-white/95 rounded-2xl border border-slate-200/90 shadow-subtle hover:border-rose-400 hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-rose-700 uppercase tracking-wider bg-rose-50 px-2 py-0.5 rounded-md border border-rose-100">Retirement</span>
                    <span class="text-slate-400 group-hover:text-rose-600 transition-colors">→</span>
                </div>
                <h2 class="text-base font-bold text-slate-900 group-hover:text-rose-700 transition-colors mb-1">SWP Calculator</h2>
                <p class="text-xs text-slate-600 leading-relaxed">Plan monthly retirement cashflows, corpus longevity, and safe withdrawal rates.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-rose-700">Open Tool &rarr;</div>
        </a>

        <a href="/lumpsum-calculator" class="group p-5 bg-white/95 rounded-2xl border border-slate-200/90 shadow-subtle hover:border-emerald-400 hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100">One-Time</span>
                    <span class="text-slate-400 group-hover:text-emerald-600 transition-colors">→</span>
                </div>
                <h2 class="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors mb-1">Lumpsum Calculator</h2>
                <p class="text-xs text-slate-600 leading-relaxed">Simulate maturity returns for one-time capital investments in equity mutual funds.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-emerald-700">Open Tool &rarr;</div>
        </a>

        <a href="/cagr-calculator" class="group p-5 bg-white/95 rounded-2xl border border-slate-200/90 shadow-subtle hover:border-teal-400 hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-teal-700 uppercase tracking-wider bg-teal-50 px-2 py-0.5 rounded-md border border-teal-100">Analytics</span>
                    <span class="text-slate-400 group-hover:text-teal-600 transition-colors">→</span>
                </div>
                <h2 class="text-base font-bold text-slate-900 group-hover:text-teal-700 transition-colors mb-1">CAGR Calculator</h2>
                <p class="text-xs text-slate-600 leading-relaxed">Calculate annualized Compound Annual Growth Rate for any multi-year investment.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-teal-700">Open Tool &rarr;</div>
        </a>

        <a href="/sip-step-up-calculator" class="group p-5 bg-white/95 rounded-2xl border border-slate-200/90 shadow-subtle hover:border-emerald-400 hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100">Growth</span>
                    <span class="text-slate-400 group-hover:text-emerald-600 transition-colors">→</span>
                </div>
                <h2 class="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors mb-1">Step-Up SIP Calculator</h2>
                <p class="text-xs text-slate-600 leading-relaxed">Explore the wealth multiplier of increasing your monthly investment annually.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-emerald-700">Open Tool &rarr;</div>
        </a>

        <a href="/retirement-calculator" class="group p-5 bg-white/95 rounded-2xl border border-slate-200/90 shadow-subtle hover:border-indigo-400 hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-indigo-700 uppercase tracking-wider bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-100">Retirement FIRE</span>
                    <span class="text-slate-400 group-hover:text-indigo-600 transition-colors">→</span>
                </div>
                <h2 class="text-base font-bold text-slate-900 group-hover:text-indigo-700 transition-colors mb-1">Retirement Calculator</h2>
                <p class="text-xs text-slate-600 leading-relaxed">Model accumulation and drawdown together with inflation-adjusted monthly pensions.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-indigo-700">Open Tool &rarr;</div>
        </a>
    </div>

    <!-- Quick Action Centered Links -->
    <div class="text-center space-x-3">
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-bold shadow-card shadow-emerald-600/20 transition-all">
            <span>🏠</span>
            <span>Return to Homepage</span>
        </a>
        <a href="/resources" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold shadow-flat transition-all">
            <span>📚</span>
            <span>Browse Educational Guides</span>
        </a>
    </div>
</main>
{% endblock %}
